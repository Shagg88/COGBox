diff --git a/src/ui/shaders/immediate_hdr.ps.hlsl b/src/ui/shaders/immediate_hdr.ps.hlsl
new file mode 100644
--- /dev/null
+++ b/src/ui/shaders/immediate_hdr.ps.hlsl
@@ -0,0 +1,22 @@
+// COGBox's host overlays are authored in SDR sRGB. The HDR10 swapchain expects
+// PQ/BT.2020; writing SDR white (1.0) directly would mean 10,000 nits.
+Texture2D<float4> uiTexture : register(t0);
+SamplerState uiSampler : register(s0);
+float4 main(float2 uv : TEXCOORD0, float4 vertexColor : COLOR0) : SV_Target0 {
+  float4 color = saturate(uiTexture.SampleLevel(uiSampler, uv, 0.0) * vertexColor);
+  color = float4(isfinite(color.r) ? color.r : 0.0,
+                 isfinite(color.g) ? color.g : 0.0,
+                 isfinite(color.b) ? color.b : 0.0,
+                 isfinite(color.a) ? color.a : 0.0);
+  float3 linearColor = float3(
+      color.r <= 0.04045 ? color.r / 12.92 : pow((color.r + 0.055) / 1.055, 2.4),
+      color.g <= 0.04045 ? color.g / 12.92 : pow((color.g + 0.055) / 1.055, 2.4),
+      color.b <= 0.04045 ? color.b / 12.92 : pow((color.b + 0.055) / 1.055, 2.4));
+  const float3x3 to2020 = float3x3(0.6274040, 0.3292820, 0.0433136,
+                                   0.0690970, 0.9195400, 0.0113612,
+                                   0.0163916, 0.0880132, 0.8955950);
+  float3 nits = clamp(mul(to2020, linearColor) * 203.0, 0.0, 203.0);
+  float3 power = pow(nits / 10000.0, 0.1593017578125);
+  float3 pq = pow((0.8359375 + 18.8515625 * power) / (1.0 + 18.6875 * power), 78.84375);
+  return float4(pq, color.a);
+}
