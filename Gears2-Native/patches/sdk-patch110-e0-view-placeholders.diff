+#ifdef REX_BASE_MEMORY_WIN_USE_DESKTOP_FUNCTIONS
+namespace {
+// COGBox patch 110 (rexglue 34f9923): VirtualAlloc2 and MapViewOfFile3 need Windows 10 1803; the desktop SDK's import
+// libraries don't provide them, so they are resolved from kernelbase.dll.
+using VirtualAlloc2Function = PVOID(WINAPI*)(HANDLE process, PVOID base_address, SIZE_T size, ULONG allocation_type,
+                                             ULONG protect, void* extended_parameters, ULONG parameter_count);
+using MapViewOfFile3Function = PVOID(WINAPI*)(HANDLE file_mapping, HANDLE process, PVOID base_address, ULONG64 offset,
+                                              SIZE_T view_size, ULONG allocation_type, ULONG protect,
+                                              void* extended_parameters, ULONG parameter_count);
+struct PlaceholderFunctions {
+  VirtualAlloc2Function alloc = nullptr;
+  MapViewOfFile3Function map = nullptr;
+};
+const PlaceholderFunctions& GetPlaceholderFunctions() {
+  static const PlaceholderFunctions functions = [] {
+    PlaceholderFunctions resolved;
+    if (HMODULE kernelbase = GetModuleHandleW(L"kernelbase.dll")) {
+      resolved.alloc = reinterpret_cast<VirtualAlloc2Function>(GetProcAddress(kernelbase, "VirtualAlloc2"));
+      resolved.map = reinterpret_cast<MapViewOfFile3Function>(GetProcAddress(kernelbase, "MapViewOfFile3"));
+    }
+    if (!resolved.alloc || !resolved.map) {
+      resolved = {};
+    }
+    return resolved;
+  }();
+  return functions;
+}
+}  // namespace
+#endif
+
+void* MapFileViewPageAligned(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                             size_t file_offset) {
+#ifdef REX_BASE_MEMORY_WIN_USE_DESKTOP_FUNCTIONS
+  if (access == PageAccess::kNoAccess || file_offset % page_size() != 0) {
+    return nullptr;
+  }
+  const PlaceholderFunctions& functions = GetPlaceholderFunctions();
+  if (!functions.alloc || !functions.map) {
+    static bool logged = false;  // Memory::Initialize tries 32 bases
+    if (!logged) {
+      logged = true;
+      REXSYS_ERROR("MapFileViewPageAligned: VirtualAlloc2 / MapViewOfFile3 not available (Windows 10 1803 or newer needed)");
+    }
+    return nullptr;
+  }
+  HANDLE process = GetCurrentProcess();
+  void* placeholder = functions.alloc(process, base_address, length, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER,
+                                      PAGE_NOACCESS, nullptr, 0);
+  if (!placeholder) {
+    return nullptr;  // usually the address is taken; Memory::Initialize tries another base
+  }
+  void* mapping = functions.map(reinterpret_cast<HANDLE>(handle), process, placeholder, ULONG64(file_offset), length,
+                                MEM_REPLACE_PLACEHOLDER, ULONG(ToWin32ProtectFlags(access)), nullptr, 0);
+  if (!mapping) {
+    // The placeholder was free, so the mapping itself failed: say why once (not an address clash).
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      REXSYS_ERROR("MapFileViewPageAligned: MapViewOfFile3 failed at offset 0x{:X} (error {})", file_offset,
+                   static_cast<unsigned long>(GetLastError()));
+    }
+    VirtualFree(placeholder, 0, MEM_RELEASE);
+    return nullptr;
+  }
+  return mapping;
+#else
+  // The app path already maps through placeholders (MapFileView).
+  return MapFileView(handle, base_address, length, access, file_offset);
+#endif
+}
