   SetHostBanFolder({});
   CHECK(HostBanFile(0x4D530A26).empty());
 }
+
+TEST_CASE("HostBan: patch 91 - the real 24-byte entries win over ids that line up at a shorter stride", "[net][hostban]") {
+  constexpr uint32_t kGears2 = 0x4D53082D;
+  // real entries: a quit (0x166 = 1) and no demerits (0x165 = 0)
+  auto v = Settings({{0x10, 7}, {0x166, 1}, {0x20, 9}, {0x165, 0}, {0x30, 5}, {0x40, 6}});
+  // read at stride 16 with the id at +0, other fields also spell 0x165 / 0x166 with a value of 0 (Gears 2 has such a
+  // table next to its settings): byte 48 (entry 2's owner) and byte 80 (entry 3's type), values at 56 and 88
+  Put32(v, 48, 0x165);
+  Put32(v, 56, 0);
+  Put32(v, 80, 0x166);
+  Put32(v, 88, 0);
+  CHECK(HostPenaltyFromSettings(v.data(), v.size(), 6, kGears2) == 1);
+}
