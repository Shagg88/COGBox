From 3334141bb35fdb26f553cf3cccd9db1d1bbfd5e0 Mon Sep 17 00:00:00 2001
From: Shagg <shagg.dev88@gmail.com>
Date: Sat, 14 Nov 2026 10:57:04 -0800
Subject: [PATCH] patch102 (#288): the processor count follows the process
 affinity mask

---
 src/core/threading.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/core/threading.cpp b/src/core/threading.cpp
index fd06c66..5eadf37 100644
--- a/src/core/threading.cpp
+++ b/src/core/threading.cpp
@@ -9,10 +9,16 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <bit>
 #include <thread>
 
+#include <rex/platform.h>
 #include <rex/thread.h>
 
+#if REX_PLATFORM_WIN32
+#include "platform_win.h"
+#endif
+
 namespace rex::thread {
 
 // =============================================================================
@@ -23,6 +29,16 @@ uint32_t logical_processor_count() {
   static uint32_t value = 0;
   if (!value) {
     value = std::thread::hardware_concurrency();
+#if REX_PLATFORM_WIN32
+    // COGBox SDK patch 102 (GitHub #288 test): the processors this process may run on, when fewer - a process started
+    // with an affinity mask (start /affinity, Task Manager, a launcher) gets the few-core paths of patches 94 / 96, and a
+    // 4-thread PC can be simulated on a big one. One processor group only (masks beyond 64 are not counted).
+    DWORD_PTR process_mask = 0, system_mask = 0;
+    if (GetProcessAffinityMask(GetCurrentProcess(), &process_mask, &system_mask) && process_mask) {
+      const uint32_t allowed = uint32_t(std::popcount(uint64_t(process_mask)));
+      if (allowed && allowed < value) value = allowed;
+    }
+#endif
   }
   return value;
 }
