+// COGBox SDK patch 112: Open matches through matchmaking (Gears 3).
+namespace {
+constexpr uint32_t kGears3 = 0x4D5308AB;
+constexpr uint64_t kMe = 0x0009000000000001ull;
+LobbyInfo OpenMatch(const std::string& code, int64_t playlist) {
+  LobbyInfo l;
+  l.lobby_id = "open";
+  l.room_code = code;
+  l.title_id = kGears3;
+  l.host_uuid = "host";
+  l.host_xuid = 0x0009000000000042ull;
+  l.region = "europe";   // not the searcher's region: the normal search would not list it
+  l.session_info = Info(0x42);
+  l.qos_data = {7, 8};
+  l.properties = {{kPlaylistProperty, playlist}};
+  return l;
+}
+LobbyInfo Other(const std::string& id, int64_t playlist) {
+  LobbyInfo l;
+  l.lobby_id = id;
+  l.title_id = kGears3;
+  l.host_uuid = "other-" + id;
+  l.host_xuid = 0x0009000000000050ull;
+  l.properties = {{kPlaylistProperty, playlist}};
+  return l;
+}
+}  // namespace
+
+TEST_CASE("Sessions: Open matches - a search of the match's playlist finds only that match, from any region",
+          "[net][sessions]") {
+  Fixture f;
+  f.backend.by_code["COG-AB12"] = OpenMatch("COG-AB12", 15);
+  f.backend.listed = {Other("x", 15)};
+  f.sessions.Prefer("COG-AB12", std::chrono::steady_clock::now() + std::chrono::minutes(3));
+  auto found = f.sessions.Search(kGears3, kMe, 15);
+  REQUIRE(found.size() == 1);
+  CHECK(found[0].lobby_id == "open");
+  CHECK(f.remembered[0x0009000000000042ull] == "host");   // the signaling can reach its host
+  std::array<uint8_t, 8> kid;
+  kid.fill(0x42);
+  REQUIRE(f.sessions.QosFor(kid).has_value());
+  CHECK(*f.sessions.QosFor(kid) == std::vector<uint8_t>{7, 8});
+  // a search that names no playlist finds it too, and it is looked up again each time (fresh QoS, still open)
+  CHECK(f.sessions.Search(kGears3, kMe).size() == 1);
+  CHECK(f.backend.looked_up.size() == 2);
+}
+
