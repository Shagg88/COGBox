+  REQUIRE(found.size() == 1);
+  CHECK(found[0].lobby_id == "open");
+  found = f.sessions.Search(kGears3, kMe, 15);   // the shortened time is over
+  REQUIRE(found.size() == 1);
+  CHECK(found[0].lobby_id == "x");
+}
+
+TEST_CASE("Sessions: Open matches - joining the match ends the preference; another host's beacon does not",
+          "[net][sessions]") {
+  Fixture f;
+  f.backend.by_code["COG-AB12"] = OpenMatch("COG-AB12", 15);
+  f.backend.listed = {Other("x", 15)};
+  f.sessions.Prefer("COG-AB12", std::chrono::steady_clock::now() + std::chrono::minutes(3));
+  f.sessions.OnBeaconConnect(0x0009000000000042ull);   // before the search found it: not that join yet
+  REQUIRE(f.sessions.Search(kGears3, kMe, 15).size() == 1);
+  CHECK(f.sessions.Search(kGears3, kMe, 15)[0].lobby_id == "open");
+  f.sessions.OnBeaconConnect(0x0009000000000050ull);   // some other host
+  CHECK(f.sessions.Search(kGears3, kMe, 15)[0].lobby_id == "open");
+  f.sessions.OnBeaconConnect(0x0009000000000042ull);   // the match's host: joined
+  auto found = f.sessions.Search(kGears3, kMe, 15);
+  REQUIRE(found.size() == 1);
+  CHECK(found[0].lobby_id == "x");
+}
