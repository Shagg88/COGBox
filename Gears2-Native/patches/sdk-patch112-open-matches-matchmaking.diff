+// was started for it (--net_prefer_lobby) and has its intros and menus first - up to 15 minutes, 3 once it searches.
+void PreferLobby(const std::string& room_code, bool at_start) {
+  OnlineSessions* s = ActiveOnlineSessions();
+  if (!s) {
+    REXKRNL_WARN("cogbox_online: Open matches: online play is not running, so {} can't be found by matchmaking",
+                 room_code);
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (at_start) {
+    s->Prefer(room_code, now + OnlineSessions::kPreferStartupLifetime, OnlineSessions::kPreferLifetime);
+  } else {
+    s->Prefer(room_code, now + OnlineSessions::kPreferLifetime);
+  }
+  REXKRNL_INFO("cogbox_online: Open matches: Versus > Social matchmaking finds only {} (choose its playlist) for the "
+               "next {} minutes", room_code, at_start ? 15 : 3);
+}
