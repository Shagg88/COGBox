-  auto apply = [](double percentage, const JoystickValue& max, int16_t& axis_x, int16_t& axis_y) {
+  // Radial, rescaled from its edge (as the dead zones of common emulators). COGBox patch 114 (review of the launcher's
+  // per-stick sliders, 16 Nov): the old cutoffs were cos / sin of the angle WITHOUT abs, so a push left or down (a
+  // negative axis) never fell inside the dead zone - it only worked to the right and up. Now: the stick's distance from
+  // the centre, as a fraction of its range per axis; inside the dead zone both axes are 0; outside, the distance is
+  // rescaled so the output starts at 0 at the edge and still reaches full at the stick's limit (no jump).
+  // The range is the axis' own +-32767: the drivers' capability values are not ranges (SDL reports 0xFFFF, XInput a
+  // resolution mask such as 0xFFC0), so the old percentages were about twice what they said.
+  auto apply = [](double percentage, const JoystickValue&, int16_t& axis_x, int16_t& axis_y) {
     if (percentage <= 0.0 || percentage >= 1.0) {
       return;
     }
-    const double deadzone_x = max.first * percentage;
-    const double deadzone_y = max.second * percentage;
-    const double theta = std::atan2(static_cast<double>(axis_y), static_cast<double>(axis_x));
-    const double cutoff_x = std::cos(theta) * deadzone_x;
-    const double cutoff_y = std::sin(theta) * deadzone_y;
-    if (axis_x > -cutoff_x && axis_x < cutoff_x) {
+    constexpr double kRange = 32767.0;
+    const double nx = static_cast<double>(axis_x) / kRange, ny = static_cast<double>(axis_y) / kRange;
+    const double r = std::sqrt(nx * nx + ny * ny);
+    if (r <= percentage) {
       axis_x = 0;
-    }
-    if (axis_y > -cutoff_y && axis_y < cutoff_y) {
       axis_y = 0;
+      return;
     }
+    const double scale = std::min(1.0, (r - percentage) / (1.0 - percentage)) / r;
+    axis_x = static_cast<int16_t>(std::clamp(std::lround(nx * scale * kRange), -32768L, 32767L));
+    axis_y = static_cast<int16_t>(std::clamp(std::lround(ny * scale * kRange), -32768L, 32767L));
   };
 
