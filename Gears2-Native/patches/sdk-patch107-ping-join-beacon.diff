+std::optional<uint64_t> VirtualPeerManager::XuidOfVip(uint32_t vip) const {   // patch 107
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto p = peers_.find(vip);
+  if (p == peers_.end()) return std::nullopt;
+  return p->second.xuid;
+}
