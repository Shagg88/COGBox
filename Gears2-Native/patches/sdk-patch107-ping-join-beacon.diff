   if (!NetOnline()) {
     return std::nullopt;
   }
+  // COGBox SDK patch 107: a connect to a peer's join beacon names the host matchmaking put us with (the FPS bar's ping)
+  if (port == OnlineSessions::kBeaconPort || port == OnlineSessions::kRankedBeaconPort) {
