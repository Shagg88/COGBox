   CHECK(f.mgr.PingMs(42, f.t0 + 5s).has_value());
   CHECK_FALSE(f.mgr.PingMs(42, f.t0 + 9s).has_value());   // acks stopped: no stale number
 }
+
+TEST_CASE("Peers: patch 107 - a virtual IP names its peer's XUID", "[net][peers]") {
+  VirtualPeerManager mgr;
+  uint32_t a = mgr.AddPeer(0x0009000000000001ull, 1);
+  REQUIRE(mgr.XuidOfVip(a).has_value());
+  CHECK(*mgr.XuidOfVip(a) == 0x0009000000000001ull);
+  CHECK_FALSE(mgr.XuidOfVip(a + 1).has_value());
+}
