+void OnlineSessions::OnBeaconConnect(uint64_t host_xuid) {   // patch 107
+  if (!host_xuid) return;
+  std::lock_guard<std::mutex> lock(mutex_);
+  target_host_ = host_xuid;
+  target_since_ = std::chrono::steady_clock::now();
+}
