diff --git a/tests/unit/net/online_sessions_test.cpp b/tests/unit/net/online_sessions_test.cpp
index d10af7a..1642da6 100644
--- a/tests/unit/net/online_sessions_test.cpp
+++ b/tests/unit/net/online_sessions_test.cpp
@@ -584,3 +584,15 @@ TEST_CASE("Sessions: patch 93 - the target host is forgotten on request", "[net]
   f.sessions.ForgetTargetHost();
   CHECK_FALSE(f.sessions.TargetHostXuid().has_value());
 }
+
+TEST_CASE("Sessions: patch 107 - a join beacon the game connects to is the host it plays with", "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x52), 0xF2, 0x701);   // our own party, still hosted
+  const auto before = std::chrono::steady_clock::now();
+  f.sessions.OnBeaconConnect(0x0009111111111111ull);   // matchmaking put us in someone else's match (TCP to its 8700)
+  REQUIRE(f.sessions.TargetHostXuid().has_value());
+  CHECK(*f.sessions.TargetHostXuid() == 0x0009111111111111ull);
+  CHECK(f.sessions.TargetHostSince() >= before);   // forgotten 30 s after its game packets stop, as a looked-up host
+  f.sessions.OnBeaconConnect(0);                    // no peer known for that address: nothing changes
+  CHECK(*f.sessions.TargetHostXuid() == 0x0009111111111111ull);
+}
diff --git a/tests/unit/net/peer_manager_test.cpp b/tests/unit/net/peer_manager_test.cpp
