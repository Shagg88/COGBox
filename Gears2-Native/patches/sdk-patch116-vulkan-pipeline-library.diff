+// COGBox SDK patch 116: per device, what was enabled for our renderer beyond the Properties structure (1 = the
+// graphicsPipelineLibrary feature, 2 = Vulkan 1.3 pipelineCreationCacheControl).
+static std::map<VkDevice, uint32_t>& GplDevices() {
+  static std::map<VkDevice, uint32_t> s;
+  return s;
+}
+static bool CogboxDeviceHas(VkDevice device, uint32_t bit) {
+  std::lock_guard<std::mutex> lock(GplDevicesMutex());
+  const auto it = device ? GplDevices().find(device) : GplDevices().end();
+  return it != GplDevices().end() && (it->second & bit) != 0;
+}
+bool CogboxGraphicsPipelineLibraryEnabled(VkDevice device) { return CogboxDeviceHas(device, 1); }
+bool CogboxPipelineCreationCacheControlEnabled(VkDevice device) { return CogboxDeviceHas(device, 2); }
