+// COGBox SDK patch 71 (0.4.9 split-screen): players 2-4 keep their own title-specific profile settings (the game's
+// options / controls blob). Player 1's are the files <setting id> in the game's user content folder (UserProfile::
+// SaveSetting); player N's sit next to them as <setting id>.p<N>. Before: players 2-4 read player 1's settings and
+// their writes were dropped. A player with no file yet reads the setting as unset (the game uses its defaults).
+static std::filesystem::path ExtraUserSettingPath(uint32_t user_index, uint32_t setting_id) {
+  char name[32];
+  std::snprintf(name, sizeof name, "%08X.p%u", setting_id, user_index + 1);
+  return REX_KERNEL_STATE()->content_manager()->ResolveGameUserContentPath() / name;
+}
+// The read's size pass reserves the setting ID's fixed size (Key.size) per setting, so a file longer than that is never
+// handed out (an edited or damaged file): it reads as unset. Shorter is what the game itself wrote and fits.
+static bool LoadExtraUserSetting(uint32_t user_index, uint32_t setting_id, std::vector<uint8_t>* bytes) {
+  std::ifstream f(ExtraUserSettingPath(user_index, setting_id), std::ios::binary);
+  if (!f) return false;
+  UserProfile::Setting::Key key;
+  key.value = setting_id;
+  bytes->assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+  if (bytes->size() > key.size) {
+    REXKRNL_WARN("SDK patch 71: player {} setting {:08X} file is {} bytes, more than the setting's {} - read as unset",
+                 user_index + 1, setting_id, bytes->size(), static_cast<uint32_t>(key.size));
+    bytes->clear();
+    return false;
+  }
+  return true;
+}
+static void SaveExtraUserSetting(uint32_t user_index, uint32_t setting_id, const std::vector<uint8_t>& bytes) {
+  const auto path = ExtraUserSettingPath(user_index, setting_id);
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  // Written to <name>.tmp and renamed over the file, so a crash or a full disk mid-write never leaves a cut file.
+  auto tmp = path;
+  tmp += ".tmp";
+  bool ok;
+  {
+    std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+    if (f) f.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    if (f) f.flush();
+    ok = static_cast<bool>(f);
+  }
+  if (ok) {
+    std::error_code rec;
+    std::filesystem::rename(tmp, path, rec);   // replaces the old file (MoveFileEx REPLACE_EXISTING)
+    ok = !rec;
+  }
+  if (!ok) std::filesystem::remove(tmp, ec);   // the old file stays as it was
+  if (!ok) REXKRNL_ERROR("SDK patch 71: couldn't save player {} setting {:08X}", user_index + 1, setting_id);
+  else REXKRNL_INFO("SDK patch 71: player {} setting {:08X} saved ({} bytes)", user_index + 1, setting_id, bytes.size());
 }
 
