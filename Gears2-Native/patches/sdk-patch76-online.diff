+// COGBox SDK patch 65 (social step 4): the games' XFriends list from the master server's friends.
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+
+#include <rex/kernel/xam/net/xfriends.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+uint32_t Be32(const uint8_t* b) { return uint32_t(b[0]) << 24 | uint32_t(b[1]) << 16 | uint32_t(b[2]) << 8 | b[3]; }
+uint64_t Be64(const uint8_t* b) { return uint64_t(Be32(b)) << 32 | Be32(b + 4); }
+}  // namespace
+
+TEST_CASE("XFriends: the server's friends list", "[net][xfriends]") {
+  const auto list = ParseFriendsList(R"({"friends":[
+    {"uuid":"a","tag":"Profile Test#7876","xuid":"2600470373891559","presence":{"state":"joinable","title_id":"4D5308AB","lobby_id":"x"}},
+    {"uuid":"b","tag":"Dom#0002","xuid":"2533274790395905","presence":{"state":"offline"}}],"incoming":[],"outgoing":[]})");
+  REQUIRE(list.size() == 2);
+  CHECK(list[0].xuid == 2600470373891559ull);
+  CHECK(list[0].name == "Profile Test");
+  CHECK(list[0].state == "joinable");
+  CHECK(list[0].title_id == 0x4D5308ABu);
+  CHECK(list[1].state == "offline");
+  CHECK(ParseFriendsList("nonsense").empty());
+}
+
+TEST_CASE("XFriends: XONLINE_FRIEND (196 bytes)", "[net][xfriends]") {
+  FriendEntry f;
+  f.xuid = 0x00094A2A1F897AE7ull;
+  f.name = "Profile Test";
+  f.state = "joinable";
+  f.title_id = 0x4D5308AB;
+  const auto r = EncodeXOnlineFriend(f);
+  REQUIRE(r.size() == 196);
+  CHECK(Be64(&r[0]) == 0x00094A2A1F897AE7ull);
+  CHECK(std::string(reinterpret_cast<const char*>(&r[8])) == "Profile Test");
+  CHECK(Be32(&r[24]) == (kFriendOnline | kFriendPlaying | kFriendJoinable));
+  CHECK(Be32(&r[36]) == 0x4D5308ABu);
+  f.state = "offline";
+  CHECK(Be32(&EncodeXOnlineFriend(f)[24]) == 0u);
+  f.state = "online";
+  CHECK(Be32(&EncodeXOnlineFriend(f)[24]) == kFriendOnline);
+}
+
+TEST_CASE("XFriends: parameter block entries (the XDK's packed call arguments)", "[net][xfriends]") {
+  std::array<uint8_t, 516> block{};
+  auto put32 = [&](size_t at, uint32_t v) { for (int i = 3; i >= 0; --i, v >>= 8) block[at + i] = uint8_t(v); };
+  for (uint32_t i = 0; i < 5; ++i) {
+    put32(16 * i, 4);
+    put32(16 * i + 12, 0x70180000 + i * 4);
+  }
+  put32(512, 5);
+  CHECK(ParamBlockPointer(block.data(), block.size(), 3) == 0x7018000Cu);
+  CHECK(ParamBlockPointer(block.data(), block.size(), 5) == 0u);   // beyond the count
+}
+
+TEST_CASE("XStorageBuildServerPath: a path for the item, UTF-16BE with its terminator, cut to the buffer",
+          "[net][storage]") {
+  const auto p = rex::kernel::xam::net::StorageServerPath(2, "replay.dat");
+  CHECK(p == u"cogbox://storage/2/replay.dat");
+  const auto be = rex::kernel::xam::net::EncodeWideBE(p, 64);
+  REQUIRE(be.size() == (p.size() + 1) * 2);
+  CHECK(be[0] == 0);
+  CHECK(be[1] == 'c');
+  CHECK(be[be.size() - 1] == 0);
+  CHECK(rex::kernel::xam::net::EncodeWideBE(p, 5).size() == 10);  // 4 characters and the terminator
+}
+
+TEST_CASE("the game's invite goes to the friends whose XUID is in its request", "[net]") {
+  const std::string json =
+      R"({"friends":[{"uuid":"u-b","tag":"B#1","xuid":"2814749767106611"},{"uuid":"u-c","tag":"C#2","xuid":"77"}]})";
+  std::vector<uint8_t> blob(64, 0);
+  for (int i = 0; i < 8; ++i) blob[13 + i] = uint8_t(2814749767106611ull >> (8 * (7 - i)));   // any position, big-endian
+  CHECK(FriendUuidsInRequest(json, blob) == std::vector<std::string>{"u-b"});
+  CHECK(FriendUuidsInRequest(json, std::vector<uint8_t>(64, 0)).empty());
+  CHECK(FriendUuidsInRequest("not json", blob).empty());
+}
+
+TEST_CASE("a joinable friend's record carries the session, and its room code is found by that session", "[net]") {
+  const std::string json = R"({"friends":[{"uuid":"u","tag":"F#1","xuid":"7","presence":{"state":"joinable","title_id":"4D5308AB",)"
+                           R"("session_id":"05A97B7DD04F1EDF","room_code":"COG-ABCD"}}]})";
+  const auto list = ParseFriendsList(json);
+  REQUIRE(list.size() == 1);
+  const auto rec = EncodeXOnlineFriend(list[0]);
+  const std::array<uint8_t, 8> id{0x05, 0xA9, 0x7B, 0x7D, 0xD0, 0x4F, 0x1E, 0xDF};
+  CHECK(std::equal(id.begin(), id.end(), rec.begin() + 28));
+  RememberFriendSessions(list);
+  CHECK(RoomCodeForFriendSession(id) == "COG-ABCD");
+  CHECK(RoomCodeForFriendSession({1, 2, 3, 4, 5, 6, 7, 8}).empty());
+}
+
+namespace {
+std::vector<uint8_t> InviteRequest(std::vector<uint64_t> words) {
+  std::vector<uint8_t> v;
+  for (uint64_t w : words) for (int i = 7; i >= 0; --i) v.push_back(uint8_t(w >> (8 * i)));
+  v.resize(1596, 0);
+  return v;
+}
+}  // namespace
+
+TEST_CASE("An invite request names its players by XUID", "[net][friends]") {
+  CHECK(InviteTargetXuids(InviteRequest({1, 0x0009F092F3861533ull})) == std::vector<uint64_t>{0x0009F092F3861533ull});
+  CHECK(InviteTargetXuids(InviteRequest({2, 0x0009000000000001ull, 0x0009000000000002ull})).size() == 2);
+}
+
+TEST_CASE("Anything else is not read as an invite list", "[net][friends]") {
+  CHECK(InviteTargetXuids(InviteRequest({0})).empty());
+  CHECK(InviteTargetXuids(InviteRequest({1, 0xDEADBEEFull})).empty());  // not an online XUID
+  CHECK(InviteTargetXuids(InviteRequest({9999, 0x0009000000000001ull})).empty());
+  CHECK(InviteTargetXuids({1, 2, 3}).empty());
+}
