+static void CogboxTraceCaller(uint32_t message) {
+  if (!rex::kernel::xam::net::NetTraceOn() ||
+      (message != 0x000B0013 && message != 0x000B0011 && message != 0x000B0015 && message != 0x000B0010 &&
+       message != 0x00058023 && message != 0x00058020 && message != 0x000B001B)) {
+    return;
+  }
+#if REX_PLATFORM_WIN32
+  if (message == 0x000B0010) {  // session create: find the viewport client now, so a later error reads it at once
+    const auto t0 = std::chrono::steady_clock::now();
+    const std::string p = Ue3ProgressMessage();
+    REXKRNL_INFO("cogbox_net_trace: viewport progress message at session create ({} us): {}",
+                 std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count(),
+                 p.empty() ? "(off)" : p);
+    return;
+  }
+#endif
+  auto* ctx = rex::runtime::current_ppc_context();
+  if (!ctx) {
+    return;
+  }
+  const std::string chain = CogboxGuestCallChain();
+  REXKRNL_INFO("cogbox_net_trace: msg {:08X} called from {}", message, chain);  // with the script functions, strings
+#if REX_PLATFORM_WIN32
+  const std::string progress = Ue3ProgressMessage();
+  if (!progress.empty()) {
+    REXKRNL_INFO("cogbox_net_trace: msg {:08X} viewport progress message: {}", message, progress);
+  }
+#endif
+}
