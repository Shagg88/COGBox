+bool ApplyClaim(const std::filesystem::path& profile_dir, const std::string& display_name,
+                const std::string& discriminator, uint64_t xuid, const std::string& token);
+
+// The 360 gamertag rule: ASCII letters, digits and single spaces, trimmed, at most 15 characters.
+std::string NormalizeGamertag(const std::string& raw);
+// Player 1's name in the games: the online account's name (pass it only once the identity is claimed), else the
+// --user_gamertag setting, else the local profile's name; each normalised, the first that is not empty.
+std::string ChoosePlayer1Name(const std::string& account_name, const std::string& cvar_name,
+                              const std::string& profile_name);
 
 }  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/invites.h b/include/rex/kernel/xam/net/invites.h
new file mode 100644
index 0000000..bba0cc5
--- /dev/null
+++ b/include/rex/kernel/xam/net/invites.h
@@ -0,0 +1,91 @@
+// COGBox SDK patch 65 (social step 4): an accepted game invite or friend join, as the 360 delivered it - the
+// XN_LIVE_INVITE_ACCEPTED notification, then XInviteGetAcceptedInfo (XLIVEBASE 0x00058023) reading an XINVITE_INFO.
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <functional>
+#include <optional>
+#include <string>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+
+namespace rex::kernel::xam::net {
+
+constexpr uint32_t kXnLiveInviteAccepted = 0x02000002;
+
+struct PendingInvite {
+  uint32_t title_id = 0;
+  uint64_t inviter_xuid = 0;
+  std::array<uint8_t, 60> session_info{};  // the host's XSESSION_INFO (XNKID, XNADDR, XNKEY)
+  bool from_game_invite = false;
+  std::chrono::steady_clock::time_point at{};
+  LobbyInfo lobby;  // the whole lobby: XSessionSearchByID answers with it
+};
+
+// XINVITE_INFO (84 bytes, big-endian): xuidInvitee @0, xuidInviter @8, dwTitleID @16, hostInfo @20, fFromGameInvite @80.
+std::array<uint8_t, 84> EncodeInviteInfo(const PendingInvite& invite, uint64_t invitee_xuid);
+
+// The one pending invite (a newer one replaces it); it is readable for 2 minutes (games read it more than once).
+class Invites {
+ public:
+  static constexpr auto kLifetime = std::chrono::minutes(2);
+  static Invites& Get();
+  void Set(const PendingInvite& invite);
+  std::optional<PendingInvite> Find(uint32_t title_id, std::chrono::steady_clock::time_point now) const;
+  void Clear();
+  // A 360 keeps an accepted invite until the game takes it: it is announced again until the game reads it (a game
+  // still at its title screen has no listener yet and would miss a single broadcast).
+  bool NeedsAnnouncing(std::chrono::steady_clock::time_point now) const;
+  void MarkRead();
+  // The invited lobby, if its XNKID (the first 8 bytes of its XSESSION_INFO) is this one and the invite is current.
+  std::optional<LobbyInfo> LobbyForSessionId(const std::array<uint8_t, 8>& xnkid,
+                                             std::chrono::steady_clock::time_point now) const;
+  bool IsCurrent(std::chrono::steady_clock::time_point set_at) const;  // the invite set at that time is still the one
+
+ private:
+  mutable std::mutex mutex_;
+  std::optional<PendingInvite> invite_;
+  bool read_ = false;
+};
+
+// Where XInviteGetAcceptedInfo wants its XINVITE_INFO: the call's second argument is the XDK's parameter block
+// (Gears 3 TU6 sub_82B1EED8 / sub_82B1ED48): 16-byte entries {u32 type (4 = pointer), pad, u64 value}, the count at
+// +512; entry 0 = &user index, entry 1 = the XINVITE_INFO. 0 when the block does not look like that.
+uint32_t InviteInfoAddress(const uint8_t* param_block, size_t size);
+
+// XSessionSearchByID's 20-byte request (Gears 3 trace): user index @0, the XNKID itself @4, results size @12,
+// results buffer @16. Any other length: nullopt (not guessed at).
+struct SearchByIdRequest {
+  std::array<uint8_t, 8> xnkid{};
+  uint32_t results_size = 0;
+  uint32_t results_ptr = 0;
+};
+std::optional<SearchByIdRequest> ParseSearchByIdRequest(const uint8_t* buf, uint32_t len);
+
+// A server message telling this game to join a lobby: {type:'join', room_code, inviter_xuid (decimal), from_game_invite}.
+struct JoinEvent {
+  std::string room_code;
+  uint64_t inviter_xuid = 0;
+  bool from_game_invite = false;
+};
+std::optional<JoinEvent> ParseJoinEvent(const std::string& json);
+
+// What accepting needs from the running game (online start-up sets the real ones; tests their own).
+struct InviteHooks {
+  std::function<uint32_t()> running_title;                                // 0 = not known yet
+  std::function<void(uint32_t notification_id)> broadcast;                // XNotify to the game
+  std::function<void(uint64_t host_xuid, const std::string& host_uuid)> remember_host;  // for signaling
+};
+void SetInviteHooks(InviteHooks hooks);
+inline void SetInviteHooksForTest(InviteHooks hooks) { SetInviteHooks(std::move(hooks)); }
+
+// The game is told it accepted joining this lobby: refused (false, nothing set) for another game's lobby; otherwise
+// the host is remembered, the invite is pending, and XN_LIVE_INVITE_ACCEPTED is broadcast.
+// The peer to punch to for a lobby joined without an invite (the game's own Join).
+void RememberInviteHost(const LobbyInfo& lobby);
+bool AcceptInvite(const LobbyInfo& lobby, const std::string& room_code, bool from_game_invite);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/live_emulation.h b/include/rex/kernel/xam/net/live_emulation.h
new file mode 100644
index 0000000..de98ed0
--- /dev/null
+++ b/include/rex/kernel/xam/net/live_emulation.h
@@ -0,0 +1,33 @@
+// COGBox SDK patch 65: LIVE emulation (--net_live_emulation) and the online trace (--cogbox_net_trace).
+//
+// With emulation on and an online XUID from the master server, a signed-in profile looks signed in to Xbox LIVE
+// (state 2), online XUID requests get the server XUID (offline ones keep the profile's), and privileges are granted.
+// Without a claimed XUID it stays off: a LIVE profile with XUID 0 is the Gears 3 duplicate-XUID bug. The XUID is the
+// one taken at start-up (SetEmulationXuid), so the Gears 3 saves are always signed for the XUID the game is given.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace rex::kernel::xam::net {
+
+// The online XUID the emulation uses: the identity's at start-up, when the saves were signed for it (0 = off).
+// A claim made while the game runs takes effect on the next start.
+void SetEmulationXuid(uint64_t xuid);
+
+bool LiveEmulationOn();
+uint32_t EmulatedSigninState(uint32_t real_state);
+uint64_t EmulatedOnlineXuid(uint64_t real_xuid);
+uint32_t EmulatedPrivilege(uint32_t real_value);
+// X_USER_SIGNIN_INFO dwInfoFlags: XUSER_INFO_FLAG_LIVE_ENABLED (0x1) added, as for a LIVE profile.
+uint32_t EmulatedSigninInfoFlags(uint32_t real_flags);
+
+bool NetTraceOn();
+// "01 AB ..." for at most max bytes, then " ...(<len> bytes)" when cut.
+std::string HexDump(const uint8_t* data, size_t len, size_t max);
+// Logs one XAM app message (cogbox_net_trace:), with the buffer before and after the call.
+void TraceAppMessage(uint32_t app_id, uint32_t message, uint32_t buffer_ptr, uint32_t buffer_len,
+                     const uint8_t* buffer_before, size_t before_len, const uint8_t* buffer_after, uint32_t result);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/master_client.h b/include/rex/kernel/xam/net/master_client.h
new file mode 100644
index 0000000..dd2d233
--- /dev/null
+++ b/include/rex/kernel/xam/net/master_client.h
@@ -0,0 +1,84 @@
+// COGBox SDK patch 65: the master-server client over WinHTTP (system TLS; Wine / Proton implement it). REST calls
+// block for at most 2 s; the signaling WebSocket runs on its own thread and reconnects every 5 s when it drops.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+
+namespace rex::kernel::xam::net {
+
+class MasterClient {
+ public:
+  static MasterClient& Get();
+
+  // "https://host[:port]" (or "http://..." for a local test server). false for anything else.
+  bool Configure(const std::string& base_url);
+  bool Configured() const;
+
+  // Claims (or re-claims) the identity loaded from identity_dir and saves the answer there.
+  bool Claim(const std::filesystem::path& identity_dir, const std::string& gamertag);
+  // The account takes this name (the launcher's player name); the server picks its #discriminator. Saved like a claim.
+  bool Rename(const std::filesystem::path& identity_dir, const std::string& name);
+
+  std::optional<std::string> CreateLobby(const LobbyInfo& lobby, std::string* room_code);  // -> lobby_id
+  bool DeleteLobby(const std::string& lobby_id);
+  bool SetLobbyQos(const std::string& lobby_id, const std::vector<uint8_t>& qos_data);
+  bool SetLobbyInviteOnly(const std::string& lobby_id, bool invite_only);
+  bool SetLobbyPlayers(const std::string& lobby_id, uint32_t players);
+  std::optional<std::pair<int, int>> Population(uint32_t title_id);  // games online worldwide, and in our region
+  bool UpdateLobbySettings(const std::string& lobby_id, const std::vector<IdValue>& properties,
+                           const std::vector<IdValue>& contexts);
+  std::vector<LobbyInfo> SearchLobbies(uint32_t title_id);
+  std::optional<LobbyInfo> LookupRoomCode(const std::string& room_code);
+  // The account's friends (GET /api/v1/friends) as the master server answers it; empty body on failure.
+  std::string FriendsJson();
+
+  // Opens /ws/signal with the identity's uuid and token; every text message goes to on_message (on that thread).
+  void StartSignaling(std::function<void(const std::string&)> on_message);
+  bool SignalingConnected() const { return ws_connected_; }
+  // Asked just before each signaling connect for the game's title id (friends see it); 0 = not known yet (the game
+  // module is not loaded when online start-up runs, so it cannot be read then).
+  void SetRegion(const std::string& region) { region_ = NormalizeRegion(region); }  // before the first request
+  void SetTitleIdSource(std::function<uint32_t()> source) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    title_source_ = std::move(source);
+  }
+  bool Send(const std::string& text);
+
+  // COGBox social step 5: an authenticated request for the in-game Social page (any method / path / JSON body).
+  // status 0 when no server is configured or it did not answer.
+  struct Result {
+    int status = 0;
+    std::string body;
+  };
+  Result Call(const std::string& method, const std::string& path, const std::string& body);
+
+ private:
+  std::string region_ = "global";
+  struct Response {
+    int status = 0;
+    std::string body;
+  };
+  Response Request(const wchar_t* method, const std::string& path, const std::string& body, bool with_auth);
+  void SignalingLoop(std::function<void(const std::string&)> on_message);
+
+  mutable std::mutex mutex_;
+  std::wstring host_;
+  uint16_t port_ = 0;
+  bool secure_ = true;
+  std::atomic<bool> ws_connected_{false};
+  std::function<uint32_t()> title_source_;  // guarded by mutex_
+  std::atomic<bool> ws_started_{false};
+  std::mutex ws_send_mutex_;
+  void* ws_handle_ = nullptr;  // HINTERNET of the open WebSocket, guarded by ws_send_mutex_
+};
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/master_protocol.h b/include/rex/kernel/xam/net/master_protocol.h
new file mode 100644
index 0000000..795ab28
--- /dev/null
+++ b/include/rex/kernel/xam/net/master_protocol.h
@@ -0,0 +1,79 @@
+// COGBox SDK patch 65: the master server's JSON (tools/master-server): claim, lobbies and the candidate messages.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+namespace rex::kernel::xam::net {
+
+struct ClaimResult {
+  std::string uuid;
+  std::string display_name;
+  std::string discriminator;
+  uint64_t xuid = 0;
+  std::string token;  // only in the first claim's answer
+};
+
+struct IdValue {
+  uint32_t id = 0;
+  int64_t value = 0;
+};
+
+struct LobbyInfo {
+  std::string lobby_id;
+  std::string host_uuid;
+  uint64_t host_xuid = 0;
+  std::string host_name;  // goes into the results as X_PROPERTY_GAMER_HOSTNAME
+  uint32_t title_id = 0;
+  std::string room_code;
+  std::array<uint8_t, 60> session_info{};  // XSESSION_INFO: XNKID (8), XNADDR (36), XNKEY (16)
+  std::string region = "global";
+  bool is_public = true;
+  uint32_t max_players = 8;
+  uint32_t current_players = 1;
+  std::vector<IdValue> properties;
+  std::vector<IdValue> contexts;
+  std::vector<uint8_t> qos_data;  // the host's XNetQosListen block (Gears: the host's name and settings)
+};
+
+// Outgoing: peer_uuid is the target. Incoming: peer_uuid / peer_xuid are the sender, as the server stamped them.
+struct CandidateMessage {
+  std::string peer_uuid;
+  uint64_t peer_xuid = 0;
+  uint64_t session_token = 0;
+  uint64_t launch_id = 0;  // new each time the sender's game starts; 0 from a build or server without it
+  uint16_t port = 0;  // the sender's local game port these candidates belong to
+  std::vector<Candidate> candidates;
+};
+
+std::string ClaimRequestJson(const std::string& uuid, const std::string& token, const std::string& display_name);
+std::optional<ClaimResult> ParseClaim(const std::string& body);
+// POST /api/v1/auth/rename (the answer reads like a re-claim: no token).
+std::string RenameRequestJson(const std::string& display_name);
+
+std::string LobbyCreateJson(const LobbyInfo& lobby);
+std::vector<LobbyInfo> ParseLobbyList(const std::string& body);          // GET /api/v1/lobbies
+std::optional<LobbyInfo> ParseLobbyLookup(const std::string& body);      // GET /api/v1/lobbies/lookup/:code
+std::optional<std::string> ParseLobbyCreated(const std::string& body, std::string* room_code);  // -> lobby_id
+
+std::string LobbyQosJson(const std::vector<uint8_t>& qos_data);  // PATCH /api/v1/lobbies/:id
+std::string LobbySettingsJson(const std::vector<IdValue>& properties, const std::vector<IdValue>& contexts);
+
+std::string CandidatesJson(const CandidateMessage& m);
+std::optional<CandidateMessage> ParseCandidates(const std::string& message);
+
+// Percent-encodes everything but A-Z a-z 0-9 - _ . ~
+std::string UrlEncode(const std::string& s);
+// The signaling WebSocket's path: /ws/signal?uuid=..&token=..&role=game[&title_id=<8 upper hex>] (title 0: none).
+// The role and title let the server keep a launcher and a game connection side by side and show friends which game.
+// A launcher region (oceania, us-e, us-w, europe); anything else is "global", the Any region choice.
+std::string NormalizeRegion(const std::string& region);
+std::string LobbySearchPath(uint32_t title_id, const std::string& region);
+std::string SignalingPath(const std::string& uuid, const std::string& token, uint32_t title_id, const std::string& region = "global");
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/online_sessions.h b/include/rex/kernel/xam/net/online_sessions.h
new file mode 100644
index 0000000..0baebc9
--- /dev/null
+++ b/include/rex/kernel/xam/net/online_sessions.h
@@ -0,0 +1,124 @@
+// COGBox SDK patch 65: the games' XSession calls -> master-server lobbies.
+//
+// Player 1's contexts / properties (XUserSetContext / XUserSetProperty) go with every lobby. A host session that uses
+// matchmaking and has public slots is registered (in the background); XSessionDelete names its session only by the
+// nonce we wrote at create, so lobbies are kept by nonce. A search returns the title's lobbies without this player's
+// own, and tells the signaling which uuid each host XUID belongs to.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+
+namespace rex::kernel::xam::net {
+
+class SessionBackend {
+ public:
+  virtual ~SessionBackend() = default;
+  virtual std::optional<std::string> CreateLobby(const LobbyInfo& lobby, std::string* room_code) = 0;
+  virtual bool DeleteLobby(const std::string& lobby_id) = 0;
+  virtual std::vector<LobbyInfo> SearchLobbies(uint32_t title_id) = 0;
+  virtual bool SetLobbyQos(const std::string& lobby_id, const std::vector<uint8_t>& qos_data) = 0;
+  virtual bool UpdateLobbySettings(const std::string& lobby_id, const std::vector<IdValue>& properties,
+                                   const std::vector<IdValue>& contexts) = 0;
+  // An Invite Only party: its lobby stays for invites, but Join friend is refused.
+  virtual bool SetLobbyInviteOnly(const std::string& lobby_id, bool invite_only) { return true; }
+  virtual bool SetLobbyPlayers(const std::string& lobby_id, uint32_t players) { return true; }
+};
+
+// XamSessionRefObjByHandle's made-up session objects: 0xDEADF00D, or one per session. Never memory: the kernel must
+// not look inside them, or it releases whatever object those bytes happen to name.
+constexpr bool IsFakeSessionObject(uint32_t object) { return object == 0xDEADF00Du || (object & 0xFFFF0000u) == 0xDEAD0000u; }
+
+constexpr uint32_t kXSessionCreateHost = 0x00000001;
+constexpr uint32_t kXSessionCreateUsesStats = 0x00000004;
+constexpr uint32_t kXSessionCreateUsesMatchmaking = 0x00000008;
+constexpr uint32_t kXSessionCreateJoinInProgressDisabled = 0x00000100;
+// Party sessions (Gears 2 0x022F, Gears 3 / Judgment 0x082B) carry one of these; the match session does not.
+constexpr uint32_t kXSessionCreateJoinViaPresenceDisabled = 0x00000200;
+constexpr uint32_t kXSessionCreateJoinViaPresenceFriendsOnly = 0x00000800;
+
+class OnlineSessions {
+ public:
+  // A session with private slots only (a private match) is hosted: its pregame lobby lets friends in (xam_msg.cpp).
+  bool HostingPrivateMatch() const;
+  using RememberHostFn = std::function<void(uint64_t host_xuid, const std::string& host_uuid)>;
+  using RunFn = std::function<void(std::function<void()>)>;  // runs a backend job (off the game thread)
+
+  OnlineSessions(SessionBackend& backend, RememberHostFn remember, RunFn run)
+      : backend_(backend), remember_(std::move(remember)), run_(std::move(run)) {}
+
+  void OnSetContext(uint32_t user_index, uint32_t id, uint32_t value);
+  void OnSetProperty(uint32_t user_index, uint32_t id, int64_t value);
+  void OnCreate(uint32_t title_id, uint32_t flags, uint32_t public_slots, uint32_t private_slots,
+                const std::array<uint8_t, 60>& session_info, uint64_t nonce, uint32_t handle = 0);
+  // The games delete with a zero nonce, so the session's object (XamSessionRefObjByHandle) says which one it is.
+  void OnDelete(uint64_t nonce, uint32_t handle = 0);
+  // XSessionModify's flags: a hosted party the player made Invite Only, or changed back.
+  void OnSessionFlags(uint32_t handle, uint32_t flags);
+  // XSessionJoinRemote / XSessionLeaveRemote on a session we host: its lobby's player count (the host plus these).
+  void OnMembersJoined(uint32_t handle, const std::vector<uint64_t>& xuids);
+  void OnMembersLeft(uint32_t handle, const std::vector<uint64_t>& xuids);
+  // The game put a TCP socket bound to `port` (before any bind offset) into listen. UE3 titles (Gears 2 / 3 /
+  // Judgment) take joins on a party beacon at TCP 8700, which they open well after creating the session (26 s in a
+  // traced Gears 2 run); a lobby listed before that sends guests to a closed port and they give up. So once a title
+  // has listened on TCP at all, its lobbies are held until 8700 listens. Titles that never listen (Gears 1) list at once.
+  void OnTcpListen(uint16_t port);
+  static constexpr uint16_t kBeaconPort = 8700;
+  static constexpr uint16_t kRankedBeaconPort = 8675;  // Gears 3's Ranked matches (traced)
+  // XSessionModify / XSessionStart: player 1's current properties and contexts go to every hosted lobby (the games
+  // set most of them after the create).
+  void OnModify();
+  std::vector<LobbyInfo> Search(uint32_t title_id, uint64_t own_xuid);
+  // A lobby the game found another way (XSessionSearchByID for an accepted invite): its QoS block is answered too.
+  void AddFound(const LobbyInfo& lobby);
+  std::string RoomCode() const;  // of the newest registered lobby, empty when none
+
+  // XNetQosListen on a session we host (XNKID = the first 8 bytes of its XSESSION_INFO): the block goes with its lobby.
+  void OnQosListen(const std::array<uint8_t, 8>& xnkid, const std::vector<uint8_t>& data);
+  // The QoS block of a host from the last search (empty when it published none); nullopt if not one of them.
+  std::optional<std::vector<uint8_t>> QosFor(const std::array<uint8_t, 8>& xnkid) const;
+
+ private:
+  struct Hosted {
+    std::optional<std::string> lobby_id;  // empty until the server answered
+    std::string room_code;
+    std::array<uint8_t, 8> xnkid{};
+    std::optional<std::vector<uint8_t>> qos;  // set before the server answered: sent with the answer
+    bool settings_dirty = false;               // likewise for properties / contexts
+    std::optional<LobbyInfo> held;             // waiting for the join beacon (OnTcpListen)
+    bool invite_only = false;                  // sent with the server's answer when set before it
+    std::set<uint64_t> members;                // remote players; the lobby has these plus the host
+  };
+  void SendQos(const std::string& lobby_id, std::vector<uint8_t> data);
+  void MembersChanged(uint32_t handle, const std::vector<uint64_t>& xuids, bool joined);
+  void Publish(LobbyInfo l, uint64_t nonce);
+  // Must be called with mutex_ held.
+  void CurrentSettingsLocked(std::vector<IdValue>* properties, std::vector<IdValue>* contexts) const;
+
+  SessionBackend& backend_;
+  RememberHostFn remember_;
+  RunFn run_;
+  mutable std::mutex mutex_;
+  std::map<uint32_t, uint32_t> contexts_;
+  std::map<uint32_t, int64_t> properties_;
+  std::map<uint64_t, Hosted> hosted_;  // by nonce
+  std::map<uint32_t, uint64_t> nonce_by_handle_;  // every session hosted, by its session object
+  uint64_t newest_nonce_ = 0;
+  // The host's friends-only party session (Gears 3): a private match is joined through it, not the match session.
+  std::optional<uint64_t> friends_party_;  // the nonce of the hosted party listed for friends
+  std::optional<uint64_t> private_match_;  // the nonce of a hosted session with private slots only
+  bool tcp_seen_ = false;
+  bool beacon_listening_ = false;
+  std::map<std::array<uint8_t, 8>, std::vector<uint8_t>> searched_qos_;  // last search, by XNKID
+};
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/online_signaling.h b/include/rex/kernel/xam/net/online_signaling.h
new file mode 100644
index 0000000..24643a6
--- /dev/null
+++ b/include/rex/kernel/xam/net/online_signaling.h
@@ -0,0 +1,53 @@
+// COGBox SDK patch 65: who sends candidates to whom.
+//
+// A guest learns a host from the lobby list (its XUID and uuid). When the game turns the host's XNADDR into a virtual
+// IP, the guest offers the candidates of each of its game sockets. The host gets an offer from a guest it has never
+// seen: it adds the peer, starts punching and answers once with its own candidates. Answers are never answered.
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+namespace rex::kernel::xam::net {
+
+class OnlineSignaling {
+ public:
+  using SendFn = std::function<void(const CandidateMessage&)>;
+  // Gives the game an XNADDR for a guest it only knows from signaling (xnaddr_online's RegisterPeerXnAddr).
+  using RegisterXnAddrFn = std::function<void(uint32_t vip, uint64_t xuid, uint64_t token, uint32_t ina)>;
+  OnlineSignaling(VirtualPeerManager& mgr, SendFn send, RegisterXnAddrFn register_xnaddr)
+      : mgr_(mgr), send_(std::move(send)), register_xnaddr_(std::move(register_xnaddr)) {}
+
+  void SetLaunchId(uint64_t id) { launch_id_ = id; }
+  void RememberHost(uint64_t xuid, const std::string& uuid);  // from lobby lists / room codes
+  void OnNewPeer(uint32_t vip, uint64_t xuid, uint64_t token);  // xnaddr_online's new-peer callback
+  void OnCandidates(const CandidateMessage& in, VirtualPeerManager::Clock::time_point now);
+  // Offers that found no game socket yet (the game resolved the peer before binding); call when a socket registers.
+  void RetryPendingOffers();
+  // A game socket opened, or its public address changed, after peers were offered to (UE3 opens its game-traffic
+  // socket only after the join): send that port's candidates to each of them so they can punch to it.
+  void OfferPort(uint16_t port);
+
+ private:
+  size_t SendOurs(const std::string& uuid, uint64_t xuid, uint64_t token);  // messages sent (0: no socket with candidates yet)
+
+  VirtualPeerManager& mgr_;
+  SendFn send_;
+  RegisterXnAddrFn register_xnaddr_;
+  std::mutex mutex_;
+  std::map<uint64_t, std::string> uuid_by_xuid_;
+  std::set<uint64_t> offered_;  // XUIDs we already sent our candidates to
+  std::map<uint64_t, uint64_t> offered_token_;  // their session tokens
+  std::map<uint64_t, uint64_t> launch_by_xuid_;  // the launch each peer last told us about
+  uint64_t launch_id_ = 0;  // this game's
+  std::map<uint64_t, uint64_t> pending_;  // XUID -> session token, waiting for a game socket
+};
+
+}  // namespace rex::kernel::xam::net
