diff --git a/tests/unit/net/master_client_cli.cpp b/tests/unit/net/master_client_cli.cpp
new file mode 100644
index 0000000..65f9a8a
--- /dev/null
+++ b/tests/unit/net/master_client_cli.cpp
@@ -0,0 +1,83 @@
+// COGBox SDK patch 65: a manual check of MasterClient against a running master server (not shipped, not a unit test).
+//   cogbox_master_cli <base_url> <scratch dir>
+// Two identities claim, A creates a lobby, B finds it by search and by room code, A sends B candidates over signaling,
+// A deletes the lobby. Prints PASS or the first FAIL.
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <thread>
+
+#include <rex/kernel/xam/net/identity.h>
+#include <rex/kernel/xam/net/master_client.h>
+
+using namespace rex::kernel::xam::net;
+namespace fs = std::filesystem;
+
+#define CHECK_OR_FAIL(cond, what)              \
+  do {                                         \
+    if (!(cond)) {                             \
+      std::printf("FAIL: %s\n", what);         \
+      return 1;                                \
+    }                                          \
+    std::printf("ok: %s\n", what);             \
+  } while (0)
+
+int main(int argc, char** argv) {
+  if (argc < 3) {
+    std::printf("usage: cogbox_master_cli <base_url> <scratch dir>\n");
+    return 2;
+  }
+  const fs::path dir_a = fs::path(argv[2]) / "a";
+  const fs::path dir_b = fs::path(argv[2]) / "b";
+  auto& mc = MasterClient::Get();
+  CHECK_OR_FAIL(mc.Configure(argv[1]), "configure");
+
+  // B first (the process has one identity at a time; B's is kept by value).
+  LoadOrCreateIdentity(dir_b, "CliGuest");
+  CHECK_OR_FAIL(mc.Claim(dir_b, "CliGuest"), "claim B");
+  const ClientIdentity b = GetClientIdentity();
+  CHECK_OR_FAIL(mc.Claim(dir_b, "CliGuest") && GetClientIdentity().token == b.token, "re-claim B keeps its token");
+
+  LoadOrCreateIdentity(dir_a, "CliHost");
+  CHECK_OR_FAIL(mc.Claim(dir_a, "CliHost"), "claim A");
+  const ClientIdentity a = GetClientIdentity();
+  CHECK_OR_FAIL(a.authoritative_xuid != 0 && a.authoritative_xuid != b.authoritative_xuid, "distinct XUIDs");
+
+  LobbyInfo l;
+  l.title_id = 0x4D53082D;
+  l.session_info.fill(0x5A);
+  std::string room;
+  auto id = mc.CreateLobby(l, &room);
+  CHECK_OR_FAIL(id.has_value() && room.size() == 8, "create lobby");
+  bool found = false;
+  for (const auto& x : mc.SearchLobbies(0x4D53082D)) found |= x.lobby_id == *id && x.host_xuid == a.authoritative_xuid;
+  CHECK_OR_FAIL(found, "search finds it with the host XUID");
+  auto byCode = mc.LookupRoomCode(room);
+  CHECK_OR_FAIL(byCode && byCode->lobby_id == *id && byCode->session_info == l.session_info, "room code lookup");
+
+  // Signaling as A; B's side is checked by the server routing back to A: A sends to its own uuid.
+  std::atomic<bool> got{false};
+  mc.StartSignaling([&](const std::string& m) {
+    if (auto c = ParseCandidates(m); c && c->peer_xuid == a.authoritative_xuid) got = true;
+  });
+  for (int i = 0; i < 50 && !mc.SignalingConnected(); ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  CHECK_OR_FAIL(mc.SignalingConnected(), "signaling connects");
+  CandidateMessage m;
+  m.peer_uuid = a.uuid;
+  m.session_token = 0x1234;
+  m.port = 1000;
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_addr.s_addr = htonl(0xCB007107);
+  addr.sin_port = htons(40000);
+  m.candidates = {{addr, Candidate::Srflx}};
+  CHECK_OR_FAIL(mc.Send(CandidatesJson(m)), "send candidates");
+  for (int i = 0; i < 30 && !got; ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  CHECK_OR_FAIL(got, "candidates come back stamped with A's XUID");
+
+  CHECK_OR_FAIL(mc.DeleteLobby(*id), "delete lobby");
+  CHECK_OR_FAIL(!mc.LookupRoomCode(room).has_value(), "lobby gone");
+  std::printf("PASS\n");
+  std::fflush(stdout);
+  std::_Exit(0);  // the signaling thread never ends
+}
diff --git a/tests/unit/net/master_protocol_test.cpp b/tests/unit/net/master_protocol_test.cpp
new file mode 100644
index 0000000..590d2c2
--- /dev/null
+++ b/tests/unit/net/master_protocol_test.cpp
@@ -0,0 +1,180 @@
+// COGBox SDK patch 65: master-server JSON (matches tools/master-server: claim, lobbies, candidates).
+#include <catch2/catch_test_macros.hpp>
+
+#include <nlohmann/json.hpp>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+
+using namespace rex::kernel::xam::net;
+using nlohmann::json;
+
+namespace {
+sockaddr_in Addr(uint32_t ip, uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(ip);
+  a.sin_port = htons(port);
+  return a;
+}
+const std::string kSessionHex = std::string(16, '1') + std::string(72, '2') + std::string(32, '3');
+}  // namespace
+
+TEST_CASE("Protocol: claim request and answer", "[net][protocol]") {
+  json req = json::parse(ClaimRequestJson("uuid-1", "", "Marcus"));
+  CHECK(req["uuid"] == "uuid-1");
+  CHECK(req["display_name"] == "Marcus");
+  CHECK_FALSE(req.contains("token"));
+  json req2 = json::parse(ClaimRequestJson("uuid-1", "abc", "Marcus"));
+  CHECK(req2["token"] == "abc");
+
+  auto c = ParseClaim(R"({"uuid":"u","display_name":"Marcus","discriminator":"0042","tag":"Marcus#0042",
+                          "xuid":"2533274790395905","token":")" + std::string(64, 'a') + R"("})");
+  REQUIRE(c.has_value());
+  CHECK(c->discriminator == "0042");
+  CHECK(c->xuid == 2533274790395905ull);
+  CHECK(c->token == std::string(64, 'a'));
+  auto again = ParseClaim(R"({"uuid":"u","display_name":"Marcus","discriminator":"0042","xuid":"5"})");
+  REQUIRE(again.has_value());
+  CHECK(again->token.empty());  // a re-claim answer has no token: keep the stored one
+  CHECK_FALSE(ParseClaim(R"({"error":"token required"})").has_value());
+  CHECK_FALSE(ParseClaim("not json").has_value());
+}
+
+TEST_CASE("Protocol: a lobby round trips through create JSON and the server's answer", "[net][protocol]") {
+  LobbyInfo l;
+  l.title_id = 0x4D53082D;
+  for (int i = 0; i < 60; ++i) l.session_info[i] = uint8_t(i < 8 ? 0x11 : i < 44 ? 0x22 : 0x33);
+  l.region = "us-east";
+  l.max_players = 8;
+  l.properties = {{0x10000001, -5}};
+  l.contexts = {{0x0000000A, 3}};
+  json body = json::parse(LobbyCreateJson(l));
+  CHECK(body["title_id"] == "4D53082D");
+  CHECK(body["session_info"] == kSessionHex);
+  CHECK(body["properties"][0]["id"] == 0x10000001);
+  CHECK(body["properties"][0]["value"] == -5);
+  CHECK(body["contexts"][0]["value"] == 3);
+
+  const std::string answer = R"({"lobbies":[{"lobby_id":"L1","host_uuid":"H","host_xuid":"2533274790395905","host_name":"Dom",
+      "title_id":"4D53082D","room_code":"COG-AB12","session_info":")" + kSessionHex + R"(","region":"us-east",
+      "is_public":true,"max_players":8,"current_players":2,"properties":[{"id":268435457,"value":-5}],
+      "contexts":[{"id":10,"value":3}]}]})";
+  auto list = ParseLobbyList(answer);
+  REQUIRE(list.size() == 1);
+  CHECK(list[0].lobby_id == "L1");
+  CHECK(list[0].host_uuid == "H");
+  CHECK(list[0].host_xuid == 2533274790395905ull);
+  CHECK(list[0].host_name == "Dom");
+  CHECK(list[0].title_id == 0x4D53082D);
+  CHECK(list[0].room_code == "COG-AB12");
+  CHECK(list[0].session_info == l.session_info);
+  CHECK(list[0].current_players == 2);
+  REQUIRE(list[0].properties.size() == 1);
+  CHECK(list[0].properties[0].id == 0x10000001);
+  CHECK(list[0].properties[0].value == -5);
+
+  auto one = ParseLobbyLookup(R"({"lobby":)" + json::parse(answer)["lobbies"][0].dump() + "}");
+  REQUIRE(one.has_value());
+  CHECK(one->room_code == "COG-AB12");
+}
+
+TEST_CASE("Protocol: a lobby with a bad session_info is skipped", "[net][protocol]") {
+  auto list = ParseLobbyList(R"({"lobbies":[{"lobby_id":"L1","host_uuid":"H","host_xuid":"1","title_id":"4D53082D",
+      "room_code":"COG-AB12","session_info":"zz"}]})");
+  CHECK(list.empty());
+  CHECK(ParseLobbyList("garbage").empty());
+}
+
+TEST_CASE("Protocol: candidates out and in", "[net][protocol]") {
+  CandidateMessage m;
+  m.peer_uuid = "target";
+  m.session_token = 0x00C0FFEE00C0FFEEull;
+  m.port = 1000;
+  m.candidates = {{Addr(0xCB007107, 40000), Candidate::Srflx}, {Addr(0xC0A80105, 1000), Candidate::Host}};
+  json out = json::parse(CandidatesJson(m));
+  CHECK(out["type"] == "candidates");
+  CHECK(out["target_uuid"] == "target");
+  CHECK(out["session_token"] == "00c0ffee00c0ffee");
+  CHECK(out["port"] == 1000);
+  CHECK(out["candidates"][0]["ip"] == "203.0.113.7");
+  CHECK(out["candidates"][0]["port"] == 40000);
+  CHECK(out["candidates"][0]["kind"] == "srflx");
+  CHECK(out["candidates"][1]["kind"] == "host");
+
+  auto in = ParseCandidates(R"({"type":"candidates","from_uuid":"A","from_xuid":"2533274790395905",
+      "session_token":"00c0ffee00c0ffee","port":1001,"candidates":[{"ip":"203.0.113.9","port":41000,"kind":"upnp"}]})");
+  REQUIRE(in.has_value());
+  CHECK(in->peer_uuid == "A");
+  CHECK(in->peer_xuid == 2533274790395905ull);
+  CHECK(in->session_token == 0x00C0FFEE00C0FFEEull);
+  CHECK(in->port == 1001);
+  REQUIRE(in->candidates.size() == 1);
+  CHECK(ntohl(in->candidates[0].addr.sin_addr.s_addr) == 0xCB007109);
+  CHECK(ntohs(in->candidates[0].addr.sin_port) == 41000);
+  CHECK(in->candidates[0].kind == Candidate::Upnp);
+  CHECK_FALSE(ParseCandidates(R"({"type":"pong"})").has_value());
+}
+
+TEST_CASE("Protocol: the signaling path names the client and its game", "[net][protocol]") {
+  CHECK(SignalingPath("u-1", "t+/=", 0x4D5308AB) == "/ws/signal?uuid=u-1&token=t%2B%2F%3D&role=game&title_id=4D5308AB");
+  CHECK(SignalingPath("u-1", "t", 0) == "/ws/signal?uuid=u-1&token=t&role=game");
+}
+
+TEST_CASE("Protocol: rename request; its answer reads like a re-claim", "[net][protocol]") {
+  CHECK(RenameRequestJson("Flapper") == R"({"display_name":"Flapper"})");
+  auto r = ParseClaim(R"({"uuid":"u","display_name":"Flapper","discriminator":"0007","tag":"Flapper#0007","xuid":"5"})");
+  REQUIRE(r.has_value());
+  CHECK(r->display_name == "Flapper");
+  CHECK(r->discriminator == "0007");
+  CHECK(r->token.empty());
+}
+
+TEST_CASE("Protocol: a launch id goes out and comes back; old messages have none", "[net][master]") {
+  CandidateMessage m;
+  m.peer_uuid = "B";
+  m.session_token = 1;
+  m.launch_id = 0xFEDCBA9876543210ull;
+  m.port = 1000;
+  m.candidates = {{Addr(0xCB007107, 40000), Candidate::Srflx}};
+  json out = json::parse(CandidatesJson(m));
+  CHECK(out["launch_id"] == "fedcba9876543210");
+  const char* base = R"("type":"candidates","from_uuid":"A","from_xuid":"2533274790395905","session_token":"1","port":1000,
+    "candidates":[{"ip":"203.0.113.7","port":40000,"kind":"srflx"}])";
+  auto with = ParseCandidates(std::string("{") + base + R"(,"launch_id":"fedcba9876543210"})");
+  REQUIRE(with.has_value());
+  CHECK(with->launch_id == 0xFEDCBA9876543210ull);
+  auto without = ParseCandidates(std::string("{") + base + "}");
+  REQUIRE(without.has_value());
+  CHECK(without->launch_id == 0);
+}
+
+TEST_CASE("Protocol: only the launcher's four regions count; anything else is Any", "[net][master]") {
+  for (const char* r : {"oceania", "us-e", "us-w", "europe"}) CHECK(NormalizeRegion(r) == r);
+  CHECK(NormalizeRegion("") == "global");
+  CHECK(NormalizeRegion("mars") == "global");
+}
+
+TEST_CASE("Protocol: a region narrows the lobby search; Any does not", "[net][master]") {
+  CHECK(LobbySearchPath(0x4D5308AB, "global") == "/api/v1/lobbies?title_id=4D5308AB");
+  CHECK(LobbySearchPath(0x4D5308AB, "us-e") == "/api/v1/lobbies?title_id=4D5308AB&region=us-e");
+}
+
+TEST_CASE("Protocol: the game's socket says its region, unless Any", "[net][master]") {
+  CHECK(SignalingPath("u", "t", 0x4D5308AB, "europe") == "/ws/signal?uuid=u&token=t&role=game&title_id=4D5308AB&region=europe");
+  CHECK(SignalingPath("u", "t", 0x4D5308AB, "global") == "/ws/signal?uuid=u&token=t&role=game&title_id=4D5308AB");
+}
+
+TEST_CASE("Protocol: candidates go by XUID when there is no uuid", "[net][master]") {
+  CandidateMessage m;
+  m.peer_xuid = 2533274790395905ull;
+  m.session_token = 1;
+  m.port = 1000;
+  m.candidates = {{Addr(0xCB007107, 40000), Candidate::Srflx}};
+  json by_xuid = json::parse(CandidatesJson(m));
+  CHECK(by_xuid["target_xuid"] == "2533274790395905");
+  CHECK_FALSE(by_xuid.contains("target_uuid"));
+  m.peer_uuid = "B";
+  json by_uuid = json::parse(CandidatesJson(m));
+  CHECK(by_uuid["target_uuid"] == "B");
+  CHECK_FALSE(by_uuid.contains("target_xuid"));
+}
diff --git a/tests/unit/net/online_sessions_test.cpp b/tests/unit/net/online_sessions_test.cpp
new file mode 100644
index 0000000..4172c0d
--- /dev/null
+++ b/tests/unit/net/online_sessions_test.cpp
@@ -0,0 +1,415 @@
+// COGBox SDK patch 65: XSession calls -> master-server lobbies (create / delete by nonce / search).
+#include <catch2/catch_test_macros.hpp>
+
+#include <map>
+#include <tuple>
+#include <vector>
+
+#include <rex/kernel/xam/net/online_sessions.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+struct FakeBackend : SessionBackend {
+  std::vector<LobbyInfo> created;
+  std::vector<std::string> deleted;
+  std::vector<LobbyInfo> listed;
+  std::optional<std::string> CreateLobby(const LobbyInfo& l, std::string* room) override {
+    created.push_back(l);
+    if (room) *room = "COG-TEST";
+    return "lobby-" + std::to_string(created.size());
+  }
+  bool DeleteLobby(const std::string& id) override {
+    deleted.push_back(id);
+    return true;
+  }
+  std::vector<LobbyInfo> SearchLobbies(uint32_t) override { return listed; }
+  std::vector<std::pair<std::string, std::vector<uint8_t>>> qos_set;
+  bool SetLobbyQos(const std::string& id, const std::vector<uint8_t>& d) override {
+    qos_set.emplace_back(id, d);
+    return true;
+  }
+  std::vector<std::tuple<std::string, std::vector<IdValue>, std::vector<IdValue>>> settings;
+  bool UpdateLobbySettings(const std::string& id, const std::vector<IdValue>& props,
+                           const std::vector<IdValue>& ctxs) override {
+    settings.push_back({id, props, ctxs});
+    return true;
+  }
+  std::vector<std::pair<std::string, uint32_t>> players;
+  bool SetLobbyPlayers(const std::string& id, uint32_t n) override {
+    players.emplace_back(id, n);
+    return true;
+  }
+  std::vector<std::pair<std::string, bool>> invite_only;
+  bool SetLobbyInviteOnly(const std::string& id, bool on) override {
+    invite_only.emplace_back(id, on);
+    return true;
+  }
+};
+
+std::array<uint8_t, 60> Info(uint8_t seed) {
+  std::array<uint8_t, 60> a{};
+  a.fill(seed);
+  return a;
+}
+
+struct Fixture {
+  FakeBackend backend;
+  std::map<uint64_t, std::string> remembered;
+  OnlineSessions sessions{backend, [this](uint64_t xuid, const std::string& uuid) { remembered[xuid] = uuid; },
+                          [](std::function<void()> job) { job(); }};  // run jobs at once
+};
+
+constexpr uint32_t kTitle = 0x4D53082D;
+constexpr uint32_t kHostMatchmaking = 0x002D;  // the match session Gears 2 / 3 / Judgment host (traced)
+}  // namespace
+
+TEST_CASE("Sessions: a public matchmaking host session registers a lobby with its contexts and properties",
+          "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnSetContext(0, 0x800A, 1);
+  f.sessions.OnSetContext(0, 0x800B, 2);
+  f.sessions.OnSetContext(1, 0x800A, 7);  // another local player: not the host's
+  f.sessions.OnSetProperty(0, 0x1000001F, 4);
+  f.sessions.OnSetContext(0, 0x800A, 3);  // a later value replaces the earlier one
+  f.sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x11), 0xAAAA);
+  REQUIRE(f.backend.created.size() == 1);
+  const LobbyInfo& l = f.backend.created[0];
+  CHECK(l.title_id == kTitle);
+  CHECK(l.session_info == Info(0x11));
+  CHECK(l.max_players == 10);
+  CHECK(l.current_players == 1);
+  REQUIRE(l.contexts.size() == 2);
+  CHECK(l.contexts[0].id == 0x800A);
+  CHECK(l.contexts[0].value == 3);
+  REQUIRE(l.properties.size() == 1);
+  CHECK(l.properties[0].value == 4);
+  CHECK(f.sessions.RoomCode() == "COG-TEST");
+}
+
+TEST_CASE("Sessions: a session someone else hosts registers nothing", "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnCreate(kTitle, 0x082E, 10, 0, Info(2), 2);  // not host
+  CHECK(f.backend.created.empty());
+}
+
+TEST_CASE("Sessions: private and non-matchmaking hosted sessions are listed for friends only (social step 4)",
+          "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnCreate(kTitle, 0x002D, 0, 5, Info(1), 1);   // private match: private slots only
+  f.sessions.OnCreate(kTitle, 0x0027, 4, 0, Info(3), 3);   // no matchmaking flag (co-op)
+  REQUIRE(f.backend.created.size() == 2);
+  CHECK_FALSE(f.backend.created[0].is_public);
+  CHECK(f.backend.created[0].max_players == 5);
+  CHECK_FALSE(f.backend.created[1].is_public);
+  CHECK(f.backend.created[1].max_players == 4);
+  f.sessions.OnCreate(kTitle, 0x002D, 10, 0, Info(4), 4);  // public matchmaking stays public
+  REQUIRE(f.backend.created.size() == 3);
+  CHECK(f.backend.created[2].is_public);
+  f.sessions.OnCreate(kTitle, 0x0027, 0, 0, Info(5), 5);   // no slots at all: nothing to join
+  CHECK(f.backend.created.size() == 3);
+}
+
+TEST_CASE("Sessions: a friends-only party is listed for friends (Join friend joins the party); others are not",
+          "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnCreate(kTitle, 0x082B, 10, 0, Info(2), 2);  // Gears 3 / Judgment party, "Joinable Friends" (traced)
+  REQUIRE(f.backend.created.size() == 1);
+  CHECK_FALSE(f.backend.created[0].is_public);
+  CHECK(f.backend.created[0].session_info == Info(2));
+  f.sessions.OnCreate(kTitle, 0x002D, 10, 0, Info(3), 3);  // a public match while in that party: listed too
