+  if (!gnames) return {};
+  std::string out;
+  std::set<uint32_t> seen;
+  for (uint32_t a = sp; a < sp + 0x8000; a += 4) {
+    uint32_t w = 0, cls = 0, cls_name = 0, name = 0, outer = 0, outer_name = 0;
+    if (!GuestRead32(a, &w) || seen.count(w)) continue;
+    if (!GuestRead32(w + 52, &cls) || !GuestRead32(cls + 44, &cls_name)) continue;
+    if (Ue3Name(gnames, cls_name) != "Function") continue;
+    seen.insert(w);
+    if (!GuestRead32(w + 44, &name)) continue;
+    std::string n = Ue3Name(gnames, name);
+    if (GuestRead32(w + 40, &outer) && GuestRead32(outer + 44, &outer_name)) n = Ue3Name(gnames, outer_name) + "." + n;
+    // A frame's FFrame keeps its function (Node) next to its Object, Code and Locals pointers: read the function's
+    // string parameters (the error text of SetProgressMessage / NotifyConnectionError) from the words after it.
+    std::string params;
+    uint32_t child = 0;
+    GuestRead32(w + kUe3Children(), &child);
+    for (uint32_t g = 0; child && g < 32; ++g) {
+      uint32_t pcls = 0, pcls_name = 0, pname = 0, poff = 0;
+      if (GuestRead32(child + 52, &pcls) && GuestRead32(pcls + 44, &pcls_name) &&
+          Ue3Name(gnames, pcls_name) == "StrProperty" && GuestRead32(child + 44, &pname) &&
+          GuestRead32(child + kUe3PropOffset(), &poff)) {
+        for (uint32_t k = 4; k <= 20; k += 4) {
+          uint32_t locals = 0;
+          if (!GuestRead32(a + k, &locals) || !locals) continue;
+          const std::string v = Ue3String(locals + poff);
