+// COGBox SDK patch 65 (social step 4), Gears 3 / Judgment: a private match's pregame lobby joinable by friends, as on
+// a 360 with "Joinable Friends".
+// - GearPartyGame_Base.OnStartPartyComplete calls SetPartyInviteFlags(false, false, false, NumPublicConnections) once
+//   the party starts, so GearPersistentPartyBeaconHost.HandleGameSessionJIP refuses every friend (PRR_ReservationDenied)
+//   until the match loads. At a party start in the PrivateMatch state that statement is jumped over (the party keeps
+//   the player's Party Options); any other party start gets it back.
+// - A friend the host then accepts logs in with ?bIsFromInvite, and GearPreGameLobbyGame_Base.PreLogin refuses that
+//   with ArbitrationMessage ("The session has already started."). Its check is jumped over when the host sends a party
+//   beacon join answer after a private match's party start (CogboxPrivateMatchAllowLogin).
+// Both statements are found by what they do (ue3_script.h), not by one build's offsets.
+static std::atomic<bool> g_private_match_party{false};  // the last party start was a private match
+static std::atomic<uint32_t> g_party_flags_call{0};     // the jumped-over SetPartyInviteFlags statement, or 0
+static std::array<uint8_t, 3> g_party_flags_bytes{};    // its original first bytes
+static std::atomic<uint32_t> g_lobby_invite_check{0};   // the patched byte of the lobby's PreLogin, or 0
+
+// Both changes back as the game had them.
+void RestorePrivateMatchChanges() {
+  if (const uint32_t a = g_lobby_invite_check.exchange(0)) {
+    uint8_t* p = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(a);
+    if (GuestReadable(p, 1) && *p == 0x06) *p = 0x07;
+  }
+  if (const uint32_t a = g_party_flags_call.exchange(0)) {
+    uint8_t* p = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(a);
+    if (GuestReadable(p, 3) && p[0] == 0x06) std::memcpy(p, g_party_flags_bytes.data(), 3);
+  }
+}
+
+// A function's script bytes (UStruct::Script at +76 / +80), or nullptr.
+uint8_t* Ue3Script(uint32_t fn, uint32_t* data, uint32_t* count) {
+  for (uint32_t off : {kUe3Script(), 76u, 84u}) {
+    if (!fn || !GuestRead32(fn + off, data) || !GuestRead32(fn + off + 4, count) || !*data || !*count ||
+        *count > 65535) {
+      continue;
+    }
+    uint8_t* code = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(*data);
+    if (GuestReadable(code, *count) && code[*count - 1] == 0x53) return code;
+  }
+  return nullptr;
+}
+
+// The first function called `name` along a class chain whose script `has` accepts (the class's own first, then its
+// supers): its script bytes, or nullptr.
+template <typename Has>
+uint8_t* Ue3FindScript(uint32_t gnames, uint32_t cls, const char* name, Has has, uint32_t* data, uint32_t* count) {
+  for (uint32_t c = cls, g = 0; c && g < 16; ++g) {
+    uint32_t ch = 0;
+    GuestRead32(c + kUe3Children(), &ch);
+    for (uint32_t k = 0; ch && k < 4096; ++k) {
+      if (Ue3ObjectName(gnames, ch) == name) {
+        uint8_t* code = Ue3Script(ch, data, count);
+        if (code && has(code, *count)) return code;
+        break;
+      }
+      if (!GuestRead32(ch + kUe3Next(), &ch)) break;
+    }
+    if (!GuestRead32(c + kUe3Super(), &c)) break;
+  }
+  // by name: a Function called `name` whose owner (outer) is one of the chain's classes, nearest class first
+  const uint32_t objects = g_ue3_objects, ocount = g_ue3_ocount;
+  for (uint32_t c = cls, g = 0; objects && c && g < 16; ++g) {
+    for (uint32_t i = 0; i < ocount; ++i) {
+      uint32_t o = 0, outer = 0, oc = 0;
+      if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 40, &outer) || outer != c) continue;
+      if (!GuestRead32(o + 52, &oc) || Ue3ObjectName(gnames, oc) != "Function" || Ue3ObjectName(gnames, o) != name) {
+        continue;
+      }
+      uint8_t* code = Ue3Script(o, data, count);
+      if (code && has(code, *count)) return code;
+    }
+    if (!GuestRead32(c + kUe3Super(), &c)) break;
+  }
+  return nullptr;
+}
+
+// The name of the state an object is in (its StateFrame at +20 points at a State object), or "".
+std::string Ue3StateName(uint32_t gnames, uint32_t obj) {
+  uint32_t frame = 0;
+  if (!GuestRead32(obj + 20, &frame) || !frame) return {};
+  for (uint32_t k = 0; k < 64; k += 4) {
+    uint32_t node = 0, ncls = 0, ncls_name = 0;
+    if (GuestRead32(frame + k, &node) && node && GuestRead32(node + 52, &ncls) && GuestRead32(ncls + 44, &ncls_name) &&
+        Ue3Name(gnames, ncls_name) == "State") {
+      return Ue3ObjectName(gnames, node);
+    }
+  }
+  return {};
+}
+
+void CogboxKeepPrivatePartyJoinable() {
+#if REX_PLATFORM_WIN32
+  // every party start begins as "not a private match", with both changes back as the game had them: a start this
+  // code cannot read (another game, no party base) never leaves a private match's change behind
+  g_private_match_party = false;
+  RestorePrivateMatchChanges();
+  if (!rex::kernel::xam::net::NetOnline()) return;
+  uint32_t gnames = 0, gengine_var = 0;
+  if (!Ue3Globals(&gnames, &gengine_var)) return;
+  const uint32_t game = Ue3CurrentGame(gnames, gengine_var);
+  uint32_t game_cls = 0;
+  if (!game || !GuestRead32(game + 52, &game_cls)) return;
+  const std::string state = Ue3StateName(gnames, game);
+  REXKRNL_INFO("cogbox_online: party start in {} state {}", Ue3ObjectName(gnames, game_cls), state);
+  if (state != "PrivateMatch") return;
+  uint32_t data = 0, count = 0;
+  uint8_t* code = Ue3FindScript(
+      gnames, game_cls, "OnStartPartyComplete",
+      [](const uint8_t* c, uint32_t n) { return rex::kernel::xam::net::FindFalseFalseFalseCall(c, n).has_value(); },
+      &data, &count);
+  g_private_match_party = true;  // the lobby's login check is let through for friends (CogboxPrivateMatchAllowLogin)
+  const auto jump = code ? rex::kernel::xam::net::FindFalseFalseFalseCall(code, count) : std::nullopt;
+  if (!jump) {  // Gears 2 has no such call: its party beacon lets friends in already
+    REXKRNL_INFO("cogbox_online: private match: no party invite flags call to skip");
+    return;
+  }
+  std::memcpy(g_party_flags_bytes.data(), code + jump->at, 3);
+  code[jump->at] = 0x06;
+  code[jump->at + 1] = uint8_t(jump->target >> 8);
+  code[jump->at + 2] = uint8_t(jump->target);
+  g_party_flags_call = data + jump->at;
+  REXKRNL_INFO("cogbox_online: private match: the party stays joinable in the pregame lobby");
+#endif
+}
+
+void CogboxPrivateMatchAllowLogin() {
+#if REX_PLATFORM_WIN32
+  // a private match: a party started in the PrivateMatch state (Gears 3, Judgment), or a hosted session with
+  // private slots only (Gears 2, whose state is not read)
+  auto* sessions = rex::kernel::xam::net::ActiveOnlineSessions();
+  const bool private_match = g_private_match_party || (sessions && sessions->HostingPrivateMatch());
+  if (!private_match || g_lobby_invite_check) return;  // not a private match, or already let in
+  uint32_t gnames = 0, gengine_var = 0;
+  if (!Ue3Globals(&gnames, &gengine_var)) return;
+  const uint32_t game = Ue3CurrentGame(gnames, gengine_var);
+  uint32_t game_cls = 0, data = 0, count = 0;
+  if (!game || !GuestRead32(game + 52, &game_cls)) return;
+  uint8_t* code = Ue3FindScript(
+      gnames, game_cls, "PreLogin",
+      [](const uint8_t* c, uint32_t n) { return rex::kernel::xam::net::FindInviteOptionCheck(c, n).has_value(); },
+      &data, &count);
+  const auto at = code ? rex::kernel::xam::net::FindInviteOptionCheck(code, count) : std::nullopt;
+  if (!at || code[*at] != 0x07) return;
+  code[*at] = 0x06;
+  g_lobby_invite_check = data + *at;
+  REXKRNL_INFO("cogbox_online: private match: a friend joining the pregame lobby is let in");
+#endif
+}
