new file mode 100644
index 0000000..67da31c
--- /dev/null
+++ b/src/system/cogbox_save_sign.cpp
@@ -0,0 +1,195 @@
+// COGBox: Gears 3 save signatures (patch 58's converter, moved here and generalised by COGBox SDK patch 65).
+#include <rex/system/cogbox_save_sign.h>
+
+#include <cstdio>
+#include <cstring>
+
+#include <fmt/format.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/string.h>
+
+namespace rex::system {
+
+namespace {
+
+struct CogSha1 {
+  uint32_t h[5] = {0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u};
+  static uint32_t rol(uint32_t v, int n) { return (v << n) | (v >> (32 - n)); }
+  void block(const uint8_t* p) {
+    uint32_t w[80];
+    for (int i = 0; i < 16; ++i) w[i] = (uint32_t(p[4 * i]) << 24) | (uint32_t(p[4 * i + 1]) << 16) | (uint32_t(p[4 * i + 2]) << 8) | p[4 * i + 3];
+    for (int i = 16; i < 80; ++i) w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+    uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+    for (int i = 0; i < 80; ++i) {
+      uint32_t f, k;
+      if (i < 20) { f = (b & c) | (~b & d); k = 0x5A827999u; }
+      else if (i < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1u; }
+      else if (i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }
+      else { f = b ^ c ^ d; k = 0xCA62C1D6u; }
+      uint32_t t = rol(a, 5) + f + e + k + w[i];
+      e = d; d = c; c = rol(b, 30); b = a; a = t;
+    }
+    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+  }
+  std::array<uint8_t, 20> digest(const std::vector<uint8_t>& m) {
+    std::vector<uint8_t> x(m);
+    uint64_t bits = uint64_t(m.size()) * 8;
+    x.push_back(0x80);
+    while (x.size() % 64 != 56) x.push_back(0);
+    for (int i = 7; i >= 0; --i) x.push_back(uint8_t(bits >> (8 * i)));
+    for (size_t i = 0; i < x.size(); i += 64) block(&x[i]);
+    std::array<uint8_t, 20> out{};
+    for (int i = 0; i < 5; ++i) for (int j = 0; j < 4; ++j) out[4 * i + j] = uint8_t(h[i] >> (24 - 8 * j));
+    return out;
+  }
+};
+std::vector<uint8_t> CogReadAll(const std::filesystem::path& p) {
+  std::vector<uint8_t> v;
+  FILE* f = nullptr;
+#if REX_PLATFORM_WIN32
+  _wfopen_s(&f, p.c_str(), L"rb");
+#else
+  f = fopen(p.c_str(), "rb");
+#endif
+  if (!f) return v;
+  uint8_t buf[65536];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), f)) > 0) v.insert(v.end(), buf, buf + n);
+  fclose(f);
+  return v;
+}
+bool CogWriteAll(const std::filesystem::path& p, const std::vector<uint8_t>& v) {
+  FILE* f = nullptr;
+#if REX_PLATFORM_WIN32
+  _wfopen_s(&f, p.c_str(), L"wb");
+#else
+  f = fopen(p.c_str(), "wb");
+#endif
+  if (!f) return false;
+  bool ok = fwrite(v.data(), 1, v.size(), f) == v.size();
+  fclose(f);
+  return ok;
+}
+std::array<uint8_t, 20> CogSign(uint64_t key, const uint8_t* body, size_t len) {
+  std::vector<uint8_t> m(8 + len);
+  for (int i = 0; i < 8; ++i) m[i] = uint8_t(key >> (56 - 8 * i));
+  if (len) std::memcpy(m.data() + 8, body, len);
+  return CogSha1().digest(m);
+}
+
+const char* ResultText(ResignResult r) {
+  switch (r) {
+    case ResignResult::Resigned: return "done";
+    case ResignResult::AlreadyDone: return "already done";
+    case ResignResult::NotRecognised: return "signature not recognised, left alone";
+    case ResignResult::TooSmall: return "too small to hold a signature, left alone";
+    case ResignResult::NoBackup: return "no backup could be made, left alone";
+    default: return "WRITE FAILED (original untouched)";
+  }
+}
+
+void Convert(const std::vector<std::filesystem::path>& files, uint64_t from_key, uint64_t to_key, const char* suffix) {
+  const ResignResult r = CogResignSaveFiles(files, from_key, to_key, suffix);
+  if (r != ResignResult::AlreadyDone) {
+    REXLOG_INFO("cogbox_save_convert: {} - re-sign {:016X} -> {:016X}: {}", rex::path_to_utf8(files[0]), from_key,
+                to_key, ResultText(r));
+  }
+}
+
+}  // namespace
+
+std::array<uint8_t, 20> CogSaveSignature(uint64_t key, const uint8_t* body, size_t len) {
+  return CogSign(key, body, len);
+}
+
+ResignResult CogResignSaveFiles(const std::vector<std::filesystem::path>& files, uint64_t from_key, uint64_t to_key,
+                                const char* backup_suffix) {
+  std::vector<uint8_t> all;
+  std::vector<size_t> sizes;
+  for (auto& f : files) {
+    auto v = CogReadAll(f);
+    sizes.push_back(v.size());
+    all.insert(all.end(), v.begin(), v.end());
+  }
+  if (all.size() < 21 || sizes.empty() || sizes[0] < 20) {
+    return ResignResult::TooSmall;
+  }
+  const auto to_sig = CogSign(to_key, all.data() + 20, all.size() - 20);
+  if (std::memcmp(to_sig.data(), all.data(), 20) == 0) {
+    return ResignResult::AlreadyDone;
+  }
+  const auto from_sig = CogSign(from_key, all.data() + 20, all.size() - 20);
+  if (std::memcmp(from_sig.data(), all.data(), 20) != 0) {
+    return ResignResult::NotRecognised;
+  }
+  auto first = CogReadAll(files[0]);
+  auto backup = files[0];
+  backup += backup_suffix;
+  std::error_code ec;
+  if (!std::filesystem::exists(backup, ec)) {
+    ec.clear();
+    std::filesystem::copy_file(files[0], backup, ec);
+  }
+  if (ec || !std::filesystem::exists(backup, ec) || std::filesystem::file_size(backup, ec) != first.size()) {
+    return ResignResult::NoBackup;
+  }
+  std::memcpy(first.data(), to_sig.data(), 20);
+  // A temp file next to it, then replace the original in one step (no half-written save on a crash).
+  auto tmp = files[0];
+  tmp += ".cogbox-tmp";
+  bool ok = CogWriteAll(tmp, first) && std::filesystem::file_size(tmp, ec) == first.size() && !ec;
+  if (ok) {
+    std::filesystem::rename(tmp, files[0], ec);
+    ok = !ec;
+  }
+  if (!ok) {
+    std::filesystem::remove(tmp, ec);
+    return ResignResult::WriteFailed;
+  }
+  return ResignResult::Resigned;
+}
+
+void CogConvertGears3SaveSigning(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t from_key,
+                                 uint64_t to_key, const char* backup_suffix) {
+  if (root.empty() || !profile_xuid || from_key == to_key) {
+    return;
+  }
+  try {
+    std::error_code ec;
+    auto ps = root / fmt::format("{:016X}", profile_xuid) / "4D5308AB" / "00000001" / "PlayerStorage.dat" /
+              "PlayerStorage.dat";
+    if (std::filesystem::exists(ps, ec)) {
+      Convert({ps}, from_key, to_key, backup_suffix);
+    }
+    auto prof = root / "4D5308AB" / "profile";
+    if (!std::filesystem::is_directory(prof, ec)) {
+      return;
+    }
+    for (auto it = std::filesystem::directory_iterator(prof, ec); !ec && it != std::filesystem::directory_iterator();
+         it.increment(ec)) {
+      std::error_code dec;
+      if (!it->is_directory(dec) || dec) {
+        continue;
+      }
+      std::vector<std::filesystem::path> files;
+      for (const char* n : {"63E83FFF", "63E83FFE", "63E83FFD"}) {
+        auto f = it->path() / n;
+        if (std::filesystem::exists(f, ec)) {
+          files.push_back(f);
+        } else {
+          break;
+        }
+      }
+      if (!files.empty()) {
+        Convert(files, from_key, to_key, backup_suffix);
+      }
+    }
+  } catch (const std::exception& e) {
+    REXLOG_INFO("cogbox_save_convert: stopped ({}); saves left as they were", e.what());
+  } catch (...) {
+    REXLOG_INFO("cogbox_save_convert: stopped; saves left as they were");
+  }
+}
+
+}  // namespace rex::system
