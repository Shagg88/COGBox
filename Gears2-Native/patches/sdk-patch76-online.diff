+// COGBox SDK patch 65: VirtualPeerManager tests. No real sockets: sends go to a recording SendFn, time is passed in.
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <cstring>
+#include <vector>
+
+#include <rex/kernel/xam/net/punch.h>
+#include <rex/kernel/xam/net/stun.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+using namespace rex::kernel::xam::net;
+using namespace std::chrono_literals;
+
+namespace {
+
+struct Sent {
+  uint64_t handle;
+  std::vector<uint8_t> data;
+  sockaddr_in to;
+};
+
+sockaddr_in Addr(uint32_t ip, uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(ip);
+  a.sin_port = htons(port);
+  return a;
+}
+
+bool Same(const sockaddr_in& a, const sockaddr_in& b) {
+  return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port;
+}
+
+struct Fixture {
+  VirtualPeerManager mgr;
+  std::vector<Sent> sent;
+  VirtualPeerManager::Clock::time_point t0 = VirtualPeerManager::Clock::time_point{} + 1000s;
+
+  Fixture() {
+    mgr.SetSendFn([this](uint64_t h, const uint8_t* d, size_t n, const sockaddr_in& to) {
+      sent.push_back({h, std::vector<uint8_t>(d, d + n), to});
+    });
+  }
+
+  std::vector<Sent> PunchesTo(const sockaddr_in& to) const {
+    std::vector<Sent> out;
+    for (const auto& s : sent) {
+      auto p = DecodePunch(s.data.data(), s.data.size());
+      if (p && p->type == PunchType::Punch && Same(s.to, to)) out.push_back(s);
+    }
+    return out;
+  }
+};
+
+constexpr uint64_t kSock = 0x1234;
+constexpr uint16_t kLocalPort = 1001;
+constexpr uint16_t kPeerPort = 1000;
+constexpr uint64_t kToken = 0xABCDEF0011223344ull;
+const sockaddr_in kCandA = Addr(0xC0A80105, kPeerPort);  // 192.168.1.5 (host candidate, not reachable here)
+const sockaddr_in kCandB = Addr(0xCB007107, 40000);      // 203.0.113.7:40000 (server reflexive)
+
+}  // namespace
+
+TEST_CASE("Peers: virtual IPs are in 10.254.0.0/16 and stable per XUID", "[net][peers]") {
+  VirtualPeerManager mgr;
+  uint32_t a = mgr.AddPeer(0x0009000000000001ull, 1);
+  uint32_t b = mgr.AddPeer(0x0009000000000002ull, 2);
+  CHECK(VirtualPeerManager::IsVirtualIp(a));
+  CHECK(VirtualPeerManager::IsVirtualIp(b));
+  CHECK((a >> 16) == 0x0AFE);
+  CHECK(a != b);
+  CHECK(mgr.AddPeer(0x0009000000000001ull, 1) == a);
+  CHECK_FALSE(VirtualPeerManager::IsVirtualIp(0x0AFD0001));
+  CHECK_FALSE(VirtualPeerManager::IsVirtualIp(0xC0A80101));
+  CHECK(mgr.State(a) == PeerState::Pending);
+  CHECK(mgr.State(0x0AFE7777) == PeerState::Lost);  // unknown
+}
+
+TEST_CASE("Peers: the subnet holds 65534 peers, then AddPeer fails cleanly", "[net][peers]") {
+  VirtualPeerManager mgr;
+  for (uint64_t x = 1; x <= 65534; ++x) {
+    REQUIRE(mgr.AddPeer(x, x) != 0);
+  }
+  CHECK(mgr.AddPeer(70000, 70000) == 0);
+}
+
+TEST_CASE("Peers: probes go from every game socket to every candidate every 100 ms", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandA, Candidate::Host}, {kCandB, Candidate::Srflx}}, f.t0);
+  f.mgr.Tick(f.t0);
+  f.mgr.Tick(f.t0 + 50ms);   // too soon: no second round
+  f.mgr.Tick(f.t0 + 100ms);
+  auto to_a = f.PunchesTo(kCandA);
+  auto to_b = f.PunchesTo(kCandB);
+  CHECK(to_a.size() == 2);
+  REQUIRE(to_b.size() == 2);
+  CHECK(to_b[0].handle == kSock);
+  auto p = DecodePunch(to_b[0].data.data(), to_b[0].data.size());
+  CHECK(p->token == kToken);
+  CHECK(p->src_port == kLocalPort);
+  CHECK_FALSE(f.mgr.Route(vip, kPeerPort).has_value());
+}
+
+TEST_CASE("Peers: an ack selects the path, relabels it and connects", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandA, Candidate::Host}, {kCandB, Candidate::Srflx}}, f.t0);
+  f.mgr.Tick(f.t0);
+  auto ack = EncodePunch({PunchType::Ack, kToken, 0, kPeerPort});
+  CHECK(f.mgr.OnPacket(kSock, ack.data(), ack.size(), kCandB, f.t0 + 30ms));  // consumed
+  CHECK(f.mgr.State(vip) == PeerState::Connected);
+  auto route = f.mgr.Route(vip, kPeerPort);
+  REQUIRE(route.has_value());
+  CHECK(Same(*route, kCandB));
+  auto label = f.mgr.Relabel(kCandB);
+  REQUIRE(label.has_value());
+  CHECK(label->first == vip);
+  CHECK(label->second == kPeerPort);
+}
+
+TEST_CASE("Peers: a punch from an unlisted address (peer reflexive) is answered and selected", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  const sockaddr_in prflx = Addr(0xCB007107, 41234);  // same NAT, another port
+  auto punch = EncodePunch({PunchType::Punch, kToken, 9, kPeerPort});
+  CHECK(f.mgr.OnPacket(kSock, punch.data(), punch.size(), prflx, f.t0));
+  REQUIRE_FALSE(f.sent.empty());
+  auto reply = DecodePunch(f.sent.back().data.data(), f.sent.back().data.size());
+  REQUIRE(reply.has_value());
+  CHECK(reply->type == PunchType::Ack);
+  CHECK(reply->token == kToken);
+  CHECK(reply->src_port == kLocalPort);
+  CHECK(f.sent.back().handle == kSock);
+  CHECK(Same(f.sent.back().to, prflx));
+  CHECK(f.mgr.State(vip) == PeerState::Connected);
+  CHECK(Same(*f.mgr.Route(vip, kPeerPort), prflx));
+}
+
+TEST_CASE("Peers: a punch with an unknown token is consumed and ignored", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  auto punch = EncodePunch({PunchType::Punch, 0x999, 1, kPeerPort});
+  CHECK(f.mgr.OnPacket(kSock, punch.data(), punch.size(), kCandB, f.t0));
+  CHECK(f.sent.empty());
+  CHECK_FALSE(f.mgr.Relabel(kCandB).has_value());
+}
+
+TEST_CASE("Peers: 10 s without an answer makes the peer Lost and stops probing", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandB, Candidate::Srflx}}, f.t0);
+  f.mgr.Tick(f.t0 + 9900ms);
+  CHECK(f.mgr.State(vip) == PeerState::Pending);
+  f.mgr.Tick(f.t0 + 10s);
+  CHECK(f.mgr.State(vip) == PeerState::Lost);
+  const size_t before = f.sent.size();
+  f.mgr.Tick(f.t0 + 10200ms);
+  CHECK(f.sent.size() == before);
+}
+
+TEST_CASE("Peers: packets sent while pending are queued and flushed in order through the game socket",
+          "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandB, Candidate::Srflx}}, f.t0);
+  const uint8_t one[] = {1, 1, 1};
+  const uint8_t two[] = {2, 2};
+  auto d1 = f.mgr.OnSend(kSock, vip, kPeerPort, one, sizeof(one), f.t0);
+  auto d2 = f.mgr.OnSend(kSock, vip, kPeerPort, two, sizeof(two), f.t0 + 10ms);
+  CHECK(d1.action == SendAction::Queued);
+  CHECK(d2.action == SendAction::Queued);
+  f.sent.clear();
+  auto ack = EncodePunch({PunchType::Ack, kToken, 0, kPeerPort});
+  f.mgr.OnPacket(kSock, ack.data(), ack.size(), kCandB, f.t0 + 20ms);
+  std::vector<Sent> game;
+  for (const auto& s : f.sent) {
+    if (!DecodePunch(s.data.data(), s.data.size())) game.push_back(s);
+  }
+  REQUIRE(game.size() == 2);
+  CHECK(game[0].data == std::vector<uint8_t>(one, one + 3));
+  CHECK(game[1].data == std::vector<uint8_t>(two, two + 2));
+  CHECK(game[0].handle == kSock);
+  CHECK(Same(game[0].to, kCandB));
+  auto d3 = f.mgr.OnSend(kSock, vip, kPeerPort, one, sizeof(one), f.t0 + 30ms);
+  CHECK(d3.action == SendAction::Routed);
+  CHECK(Same(d3.to, kCandB));
+}
+
+TEST_CASE("Peers: the queue keeps 5 s and 1024 packets at most", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandB, Candidate::Srflx}}, f.t0);
+  const uint8_t old_pkt[] = {0xEE};
+  f.mgr.OnSend(kSock, vip, kPeerPort, old_pkt, 1, f.t0);
+  const uint8_t pkt[] = {0x01};
+  for (int i = 0; i < 1100; ++i) {
+    f.mgr.OnSend(kSock, vip, kPeerPort, pkt, 1, f.t0 + 6s);
+  }
+  f.sent.clear();
+  auto ack = EncodePunch({PunchType::Ack, kToken, 0, kPeerPort});
+  f.mgr.OnPacket(kSock, ack.data(), ack.size(), kCandB, f.t0 + 6s);
+  size_t game = 0;
+  for (const auto& s : f.sent) {
+    if (!DecodePunch(s.data.data(), s.data.size())) {
+      ++game;
+      CHECK(s.data[0] == 0x01);  // the 6 s old packet was dropped
+    }
+  }
+  CHECK(game == 1024);
+}
+
+TEST_CASE("Peers: a game packet sent to an unknown virtual IP passes through untouched", "[net][peers]") {
+  Fixture f;
+  const uint8_t pkt[] = {1};
+  CHECK(f.mgr.OnSend(kSock, 0x0AFE0909, 1000, pkt, 1, f.t0).action == SendAction::Dropped);
+  CHECK(f.mgr.OnSend(kSock, 0xC0A80101, 1000, pkt, 1, f.t0).action == SendAction::PassThrough);
+}
+
+TEST_CASE("Peers: STUN probes come from the game socket every 15 s and the answer is the srflx candidate",
+          "[net][peers][stun]") {
+  Fixture f;
+  const sockaddr_in stun = Addr(0x08080808, 3478);
+  f.mgr.SetStunServer(stun);
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  f.mgr.Tick(f.t0);
+  f.mgr.Tick(f.t0 + 14s);
+  f.mgr.Tick(f.t0 + 15s);
+  std::vector<Sent> probes;
+  for (const auto& s : f.sent) {
+    if (IsStunPacket(s.data.data(), s.data.size())) probes.push_back(s);
+  }
+  REQUIRE(probes.size() == 2);
+  CHECK(probes[0].handle == kSock);
+  CHECK(Same(probes[0].to, stun));
+
+  // The answer to the latest probe: XOR-MAPPED-ADDRESS 203.0.113.7:40000.
+  std::vector<uint8_t> resp = {0x01, 0x01, 0x00, 0x0c, 0x21, 0x12, 0xa4, 0x42};
+  resp.insert(resp.end(), probes[1].data.begin() + 8, probes[1].data.begin() + 20);
+  const uint16_t xport = 40000 ^ 0x2112;
+  const uint32_t xip = 0xCB007107 ^ 0x2112A442;
+  const uint8_t attr[] = {0x00, 0x20, 0x00, 0x08, 0x00, 0x01, uint8_t(xport >> 8), uint8_t(xport),
+                          uint8_t(xip >> 24), uint8_t(xip >> 16), uint8_t(xip >> 8), uint8_t(xip)};
+  resp.insert(resp.end(), attr, attr + sizeof(attr));
+  CHECK(f.mgr.OnPacket(kSock, resp.data(), resp.size(), stun, f.t0 + 15100ms));
+  bool found = false;
+  for (const auto& c : f.mgr.LocalCandidates(kLocalPort)) {
+    if (c.kind == Candidate::Srflx && Same(c.addr, kCandB)) found = true;
+  }
+  CHECK(found);
+}
