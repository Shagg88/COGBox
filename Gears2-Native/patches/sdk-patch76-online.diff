diff --git a/tests/unit/net/punch_loopback_test.cpp b/tests/unit/net/punch_loopback_test.cpp
new file mode 100644
index 0000000..a52e79a
--- /dev/null
+++ b/tests/unit/net/punch_loopback_test.cpp
@@ -0,0 +1,196 @@
+// COGBox SDK patch 65: two peers punch a path between real UDP sockets on 127.0.0.1, with a fake STUN server, and
+// exchange game packets through it. Candidates are swapped directly (no master server).
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#include <rex/kernel/xam/net/punch.h>
+#include <rex/kernel/xam/net/stun.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+using namespace rex::kernel::xam::net;
+using namespace std::chrono_literals;
+
+namespace {
+
+sockaddr_in Loopback(uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  a.sin_port = htons(port);
+  return a;
+}
+
+SOCKET OpenUdp() {
+  WSADATA wsa;
+  WSAStartup(MAKEWORD(2, 2), &wsa);
+  SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  sockaddr_in a = Loopback(0);
+  bind(s, reinterpret_cast<sockaddr*>(&a), sizeof(a));
+  u_long nb = 1;
+  ioctlsocket(s, FIONBIO, &nb);
+  return s;
+}
+
+uint16_t PortOf(SOCKET s) {
+  sockaddr_in a{};
+  int len = sizeof(a);
+  getsockname(s, reinterpret_cast<sockaddr*>(&a), &len);
+  return ntohs(a.sin_port);
+}
+
+void RealSend(uint64_t h, const uint8_t* d, size_t n, const sockaddr_in& to) {
+  sendto(SOCKET(h), reinterpret_cast<const char*>(d), int(n), 0, reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+}
+
+// Answers Binding Requests with the sender's address, or with `fake_mapped` when it is set (an unreachable public
+// address, as when a NAT has no hairpinning).
+struct FakeStun {
+  SOCKET s = OpenUdp();
+  std::optional<sockaddr_in> fake_mapped;
+  void Serve() {
+    uint8_t buf[512];
+    sockaddr_in from{};
+    int len = sizeof(from);
+    int n;
+    while ((n = recvfrom(s, reinterpret_cast<char*>(buf), sizeof(buf), 0, reinterpret_cast<sockaddr*>(&from), &len)) >=
+           20) {
+      sockaddr_in m = fake_mapped ? *fake_mapped : from;
+      const uint16_t xport = ntohs(m.sin_port) ^ 0x2112;
+      const uint32_t xip = ntohl(m.sin_addr.s_addr) ^ 0x2112A442;
+      std::vector<uint8_t> r = {0x01, 0x01, 0x00, 0x0c, 0x21, 0x12, 0xa4, 0x42};
+      r.insert(r.end(), buf + 8, buf + 20);
+      const uint8_t attr[] = {0x00, 0x20, 0x00, 0x08, 0x00, 0x01, uint8_t(xport >> 8), uint8_t(xport),
+                              uint8_t(xip >> 24), uint8_t(xip >> 16), uint8_t(xip >> 8), uint8_t(xip)};
+      r.insert(r.end(), attr, attr + sizeof(attr));
+      sendto(s, reinterpret_cast<const char*>(r.data()), int(r.size()), 0, reinterpret_cast<sockaddr*>(&from),
+             sizeof(from));
+      len = sizeof(from);
+    }
+  }
+  ~FakeStun() { closesocket(s); }
+};
+
+struct Side {
+  VirtualPeerManager mgr;
+  SOCKET s = OpenUdp();
+  uint16_t port = PortOf(s);
+  std::vector<std::vector<uint8_t>> game_packets;
+  std::vector<std::pair<uint32_t, uint16_t>> labels;
+  Side(const sockaddr_in& stun, bool with_host_candidate) {
+    mgr.SetSendFn(RealSend);
+    mgr.SetStunServer(stun);
+    mgr.RegisterSocket(uint64_t(s), port);
+    if (with_host_candidate) mgr.AddLocalCandidate(port, {Loopback(port), Candidate::Host});
+  }
+  ~Side() { closesocket(s); }
+  void Pump(VirtualPeerManager::Clock::time_point now) {
+    mgr.Tick(now);
+    uint8_t buf[1500];
+    sockaddr_in from{};
+    int len = sizeof(from);
+    int n;
+    while ((n = recvfrom(s, reinterpret_cast<char*>(buf), sizeof(buf), 0, reinterpret_cast<sockaddr*>(&from), &len)) >=
+           0) {
+      if (!mgr.OnPacket(uint64_t(s), buf, size_t(n), from, now)) {
+        game_packets.emplace_back(buf, buf + n);
+        if (auto l = mgr.Relabel(from)) labels.push_back(*l);
+      }
+      len = sizeof(from);
+    }
+  }
+  bool HasSrflx() const {
+    for (const auto& c : mgr.LocalCandidates(port)) {
+      if (c.kind == Candidate::Srflx) return true;
+    }
+    return false;
+  }
+};
+
+constexpr uint64_t kToken = 0x00C0FFEE00C0FFEEull;
+
+void RunUntil(FakeStun& stun, Side& a, Side& b, const std::function<bool()>& done, std::chrono::milliseconds limit) {
+  const auto end = VirtualPeerManager::Clock::now() + limit;
+  while (!done() && VirtualPeerManager::Clock::now() < end) {
+    stun.Serve();
+    const auto now = VirtualPeerManager::Clock::now();
+    a.Pump(now);
+    b.Pump(now);
+    std::this_thread::sleep_for(5ms);
+  }
+}
+
+}  // namespace
+
+TEST_CASE("Loopback: two peers punch, connect within 2 s and exchange 100 packets each way in order",
+          "[net][loopback]") {
+  FakeStun stun;
+  const sockaddr_in stun_addr = Loopback(PortOf(stun.s));
+  Side a(stun_addr, false);
+  Side b(stun_addr, false);
+  RunUntil(stun, a, b, [&] { return a.HasSrflx() && b.HasSrflx(); }, 2000ms);
+  REQUIRE(a.HasSrflx());
+  REQUIRE(b.HasSrflx());
+
+  const uint32_t vip_b = a.mgr.AddPeer(0xB, kToken);
+  const uint32_t vip_a = b.mgr.AddPeer(0xA, kToken);
+  const auto t = VirtualPeerManager::Clock::now();
+  a.mgr.SetRemoteCandidates(vip_b, b.port, b.mgr.LocalCandidates(b.port), t);
+  b.mgr.SetRemoteCandidates(vip_a, a.port, a.mgr.LocalCandidates(a.port), t);
+  RunUntil(stun, a, b,
+           [&] { return a.mgr.State(vip_b) == PeerState::Connected && b.mgr.State(vip_a) == PeerState::Connected; },
+           2000ms);
+  REQUIRE(a.mgr.State(vip_b) == PeerState::Connected);
+  REQUIRE(b.mgr.State(vip_a) == PeerState::Connected);
+
+  for (uint8_t i = 0; i < 100; ++i) {
+    const uint8_t pa[] = {0xA0, i};
+    const uint8_t pb[] = {0xB0, i};
+    auto da = a.mgr.OnSend(uint64_t(a.s), vip_b, b.port, pa, sizeof(pa), VirtualPeerManager::Clock::now());
+    auto db = b.mgr.OnSend(uint64_t(b.s), vip_a, a.port, pb, sizeof(pb), VirtualPeerManager::Clock::now());
+    REQUIRE(da.action == SendAction::Routed);
+    REQUIRE(db.action == SendAction::Routed);
+    RealSend(uint64_t(a.s), pa, sizeof(pa), da.to);
+    RealSend(uint64_t(b.s), pb, sizeof(pb), db.to);
+  }
+  RunUntil(stun, a, b, [&] { return a.game_packets.size() >= 100 && b.game_packets.size() >= 100; }, 2000ms);
+  REQUIRE(b.game_packets.size() == 100);
+  REQUIRE(a.game_packets.size() == 100);
+  for (uint8_t i = 0; i < 100; ++i) {
+    CHECK(b.game_packets[i] == std::vector<uint8_t>{0xA0, i});
+    CHECK(a.game_packets[i] == std::vector<uint8_t>{0xB0, i});
+  }
+  REQUIRE(b.labels.size() == 100);
+  CHECK(b.labels[0].first == vip_a);
+  CHECK(b.labels[0].second == a.port);
+}
+
+TEST_CASE("Loopback: on the same LAN the host candidate connects when the public address is unreachable",
+          "[net][loopback]") {
+  FakeStun stun;
+  sockaddr_in unreachable{};
+  unreachable.sin_family = AF_INET;
+  unreachable.sin_addr.s_addr = htonl(0xC0000201);  // 192.0.2.1 (TEST-NET-1, never routed)
+  unreachable.sin_port = htons(9);
+  stun.fake_mapped = unreachable;
+  const sockaddr_in stun_addr = Loopback(PortOf(stun.s));
+  Side a(stun_addr, true);
+  Side b(stun_addr, true);
+  RunUntil(stun, a, b, [&] { return a.HasSrflx() && b.HasSrflx(); }, 2000ms);
+  const uint32_t vip_b = a.mgr.AddPeer(0xB, kToken);
+  const uint32_t vip_a = b.mgr.AddPeer(0xA, kToken);
+  const auto t = VirtualPeerManager::Clock::now();
+  a.mgr.SetRemoteCandidates(vip_b, b.port, b.mgr.LocalCandidates(b.port), t);
+  b.mgr.SetRemoteCandidates(vip_a, a.port, a.mgr.LocalCandidates(a.port), t);
+  RunUntil(stun, a, b,
+           [&] { return a.mgr.State(vip_b) == PeerState::Connected && b.mgr.State(vip_a) == PeerState::Connected; },
+           2000ms);
+  REQUIRE(a.mgr.State(vip_b) == PeerState::Connected);
+  auto route = a.mgr.Route(vip_b, b.port);
+  REQUIRE(route.has_value());
+  CHECK(route->sin_addr.s_addr == htonl(INADDR_LOOPBACK));
+  CHECK(ntohs(route->sin_port) == b.port);
+}
diff --git a/tests/unit/net/qos_test.cpp b/tests/unit/net/qos_test.cpp
new file mode 100644
index 0000000..1683789
--- /dev/null
+++ b/tests/unit/net/qos_test.cpp
@@ -0,0 +1,117 @@
+// COGBox SDK patch 65: QoS. The host's XNetQosListen block rides with its lobby; XNetQosLookup answers each searched
+// host as contacted, with that block (XNQOS layout from the XDK: header 8, XNQOSINFO 24 each, big endian).
+#include <catch2/catch_test_macros.hpp>
+
+#include <nlohmann/json.hpp>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+#include <rex/kernel/xam/net/online_sessions.h>
+#include <rex/kernel/xam/net/qos.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+uint16_t Be16(const uint8_t* p) { return uint16_t(p[0] << 8 | p[1]); }
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+
+struct FakeBackend : SessionBackend {
+  std::vector<std::pair<std::string, std::vector<uint8_t>>> qos_set;
+  std::vector<LobbyInfo> listed;
+  std::optional<std::string> CreateLobby(const LobbyInfo&, std::string* room) override {
+    if (room) *room = "COG-QQQQ";
+    return std::string("lobby-1");
+  }
+  bool DeleteLobby(const std::string&) override { return true; }
+  std::vector<LobbyInfo> SearchLobbies(uint32_t) override { return listed; }
+  bool SetLobbyQos(const std::string& id, const std::vector<uint8_t>& data) override {
+    qos_set.push_back({id, data});
+    return true;
+  }
+  bool UpdateLobbySettings(const std::string&, const std::vector<IdValue>&, const std::vector<IdValue>&) override {
+    return true;
+  }
+};
+
+std::array<uint8_t, 60> InfoWithKid(uint8_t kid) {
+  std::array<uint8_t, 60> a{};
+  for (int i = 0; i < 8; ++i) a[i] = uint8_t(kid + i);
+  return a;
+}
+std::array<uint8_t, 8> Kid(uint8_t kid) {
+  std::array<uint8_t, 8> k{};
+  for (int i = 0; i < 8; ++i) k[i] = uint8_t(kid + i);
+  return k;
+}
+}  // namespace
+
+TEST_CASE("QoS: the lobby JSON carries qos_data both ways", "[net][qos]") {
+  CHECK(nlohmann::json::parse(LobbyQosJson({0xAB, 0x01}))["qos_data"] == "ab01");
+  const std::string kHex120 = std::string(120, '1');
+  auto list = ParseLobbyList(R"({"lobbies":[{"lobby_id":"L","host_uuid":"H","host_xuid":"5","title_id":"4D53082D",
+      "room_code":"COG-A","session_info":")" + kHex120 + R"(","qos_data":"c0ffee"}]})");
+  REQUIRE(list.size() == 1);
+  CHECK(list[0].qos_data == std::vector<uint8_t>{0xC0, 0xFF, 0xEE});
+}
+
+TEST_CASE("QoS: a Listen block goes to the hosted lobby with that XNKID, also when it comes before the server's answer",
+          "[net][qos]") {
+  FakeBackend backend;
+  std::vector<std::function<void()>> later;
+  OnlineSessions sessions{backend, [](uint64_t, const std::string&) {},
+                          [&](std::function<void()> job) { later.push_back(std::move(job)); }};
+  sessions.OnCreate(0x4D53082D, 0x002D, 10, 0, InfoWithKid(0x10), 1);
+  sessions.OnQosListen(Kid(0x10), {1, 2, 3});  // the lobby id is not known yet
+  sessions.OnQosListen(Kid(0x77), {9});         // not a lobby of ours
+  for (auto& job : later) job();
+  later.clear();
+  REQUIRE(backend.qos_set.size() == 1);
+  CHECK(backend.qos_set[0].first == "lobby-1");
+  CHECK(backend.qos_set[0].second == std::vector<uint8_t>{1, 2, 3});
+  sessions.OnQosListen(Kid(0x10), {4});
+  for (auto& job : later) job();
+  REQUIRE(backend.qos_set.size() == 2);
+  CHECK(backend.qos_set[1].second == std::vector<uint8_t>{4});
+}
+
+TEST_CASE("QoS: a lookup knows the hosts of the last search by XNKID", "[net][qos]") {
+  FakeBackend backend;
+  OnlineSessions sessions{backend, [](uint64_t, const std::string&) {}, [](std::function<void()> job) { job(); }};
+  LobbyInfo l;
+  l.lobby_id = "L";
+  l.host_uuid = "H";
+  l.host_xuid = 0x0009000000000002ull;
+  l.session_info = InfoWithKid(0x30);
+  l.qos_data = {7, 7};
+  backend.listed = {l};
+  sessions.Search(0x4D53082D, 0x0009000000000001ull);
+  auto found = sessions.QosFor(Kid(0x30));
+  REQUIRE(found.has_value());
+  CHECK(*found == std::vector<uint8_t>{7, 7});
+  CHECK_FALSE(sessions.QosFor(Kid(0x31)).has_value());
+}
+
+TEST_CASE("QoS: the XNQOS answer: one XNQOSINFO per target, data after the array", "[net][qos]") {
+  std::vector<std::optional<std::vector<uint8_t>>> targets = {std::vector<uint8_t>{0xAA, 0xBB, 0xCC}, std::nullopt,
+                                                              std::vector<uint8_t>{}};
+  const uint32_t base = 0x40001000;
+  auto bytes = BuildXnQos(targets, 4, base);
+  REQUIRE(bytes.size() == 8 + 24 * 3 + 3);
+  CHECK(Be32(bytes.data() + 0) == 3);  // cxnqos
+  CHECK(Be32(bytes.data() + 4) == 0);  // cxnqosPending
+  const uint8_t* a = bytes.data() + 8;
+  CHECK(a[0] == (0x01 | 0x02 | 0x08));  // COMPLETE | TARGET_CONTACTED | DATA_RECEIVED
+  CHECK(Be16(a + 2) == 4);              // probes sent
+  CHECK(Be16(a + 4) == 4);              // probes received
+  CHECK(Be16(a + 6) == 3);              // cbData
+  CHECK(Be32(a + 8) == base + 8 + 24 * 3);
+  CHECK(bytes[8 + 24 * 3] == 0xAA);
+  CHECK(Be16(a + 12) > 0);              // RTT min
+  CHECK(Be32(a + 16) > 0);              // up bits/s
+  const uint8_t* b = bytes.data() + 8 + 24;
+  CHECK(b[0] == 0x01);                  // COMPLETE only: not one of our hosts
+  CHECK(Be16(b + 4) == 0);
+  CHECK(Be32(b + 8) == 0);
+  const uint8_t* c = bytes.data() + 8 + 48;
+  CHECK(c[0] == (0x01 | 0x02));          // contacted, no data
+  CHECK(Be16(c + 6) == 0);
+}
diff --git a/tests/unit/net/save_resign_test.cpp b/tests/unit/net/save_resign_test.cpp
new file mode 100644
index 0000000..c706578
--- /dev/null
+++ b/tests/unit/net/save_resign_test.cpp
@@ -0,0 +1,101 @@
+// COGBox SDK patch 65: Gears 3 save signatures (SHA-1(online XUID, 8 bytes big endian + data) in the first 20 bytes)
+// re-signed between XUID 0 and the online XUID. Files live in COGBOX_NET_TEST_DIR (build tree, never AppData).
+#include <catch2/catch_test_macros.hpp>
+
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+#include <rex/system/cogbox_save_sign.h>
+
+namespace fs = std::filesystem;
+using namespace rex::system;
+
+namespace {
+constexpr uint64_t kXuid = 0x0009000012345678ull;
+
+std::vector<uint8_t> ReadFile(const fs::path& p) {
+  std::ifstream in(p, std::ios::binary);
+  return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+}
+void WriteFile(const fs::path& p, const std::vector<uint8_t>& v) {
+  std::ofstream out(p, std::ios::binary | std::ios::trunc);
+  out.write(reinterpret_cast<const char*>(v.data()), std::streamsize(v.size()));
+}
+// A save body signed with key.
+std::vector<uint8_t> MakeSave(uint64_t key) {
+  std::vector<uint8_t> body(300);
+  for (size_t i = 0; i < body.size(); ++i) body[i] = uint8_t(i * 7 + 3);
+  auto sig = CogSaveSignature(key, body.data(), body.size());
+  std::vector<uint8_t> file(sig.begin(), sig.end());
+  file.insert(file.end(), body.begin(), body.end());
+  return file;
+}
+fs::path FreshFile(const char* dir_name, const std::vector<uint8_t>& content) {
+  fs::path dir = fs::path(COGBOX_NET_TEST_DIR) / dir_name;
+  std::error_code ec;
+  if (fs::exists(dir / "PlayerStorage.dat")) fs::permissions(dir / "PlayerStorage.dat", fs::perms::all, fs::perm_options::add, ec);
+  fs::remove_all(dir, ec);
+  fs::create_directories(dir);
+  WriteFile(dir / "PlayerStorage.dat", content);
+  return dir / "PlayerStorage.dat";
+}
+}  // namespace
+
+TEST_CASE("Save sign: 0 -> online XUID re-signs and keeps the data", "[net][save]") {
+  const auto original = MakeSave(0);
+  auto f = FreshFile("resign_on", original);
+  CHECK(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::Resigned);
+  auto now = ReadFile(f);
+  CHECK(now == MakeSave(kXuid));
+  CHECK(std::equal(now.begin() + 20, now.end(), original.begin() + 20));
+  CHECK(ReadFile(fs::path(f) += ".pre-online") == original);
+  CHECK_FALSE(fs::exists(fs::path(f) += ".cogbox-tmp"));
+}
+
+TEST_CASE("Save sign: online XUID -> 0 gives back the original bytes", "[net][save]") {
+  const auto original = MakeSave(0);
+  auto f = FreshFile("resign_back", original);
+  REQUIRE(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::Resigned);
+  CHECK(CogResignSaveFiles({f}, kXuid, 0, ".pre-online") == ResignResult::Resigned);
+  CHECK(ReadFile(f) == original);
+}
+
+TEST_CASE("Save sign: a file already signed for the target is left alone", "[net][save]") {
+  auto f = FreshFile("resign_done", MakeSave(kXuid));
+  CHECK(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::AlreadyDone);
+  CHECK_FALSE(fs::exists(fs::path(f) += ".pre-online"));
+}
+
+TEST_CASE("Save sign: a file signed with neither key is left alone", "[net][save]") {
+  const auto other = MakeSave(0x1111);
+  auto f = FreshFile("resign_other", other);
+  CHECK(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::NotRecognised);
+  CHECK(ReadFile(f) == other);
+}
+
+TEST_CASE("Save sign: the backup is made once and never overwritten", "[net][save]") {
+  const auto original = MakeSave(0);
+  auto f = FreshFile("resign_backup_once", original);
+  REQUIRE(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::Resigned);
+  REQUIRE(CogResignSaveFiles({f}, kXuid, 0, ".pre-online") == ResignResult::Resigned);
+  REQUIRE(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::Resigned);
+  CHECK(ReadFile(fs::path(f) += ".pre-online") == original);
+}
+
+TEST_CASE("Save sign: a read-only save stops the run and stays as it was", "[net][save]") {
+  const auto original = MakeSave(0);
+  auto f = FreshFile("resign_readonly", original);
+  fs::permissions(f, fs::perms::owner_write | fs::perms::group_write | fs::perms::others_write,
+                  fs::perm_options::remove);
+  CHECK(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::WriteFailed);
+  fs::permissions(f, fs::perms::owner_write, fs::perm_options::add);
+  CHECK(ReadFile(f) == original);
+  CHECK_FALSE(fs::exists(fs::path(f) += ".cogbox-tmp"));
+}
+
+TEST_CASE("Save sign: a file too small to hold a signature is left alone", "[net][save]") {
+  auto f = FreshFile("resign_small", std::vector<uint8_t>(10, 0));
+  CHECK(CogResignSaveFiles({f}, 0, kXuid, ".pre-online") == ResignResult::TooSmall);
+}
diff --git a/tests/unit/net/session_marshal_test.cpp b/tests/unit/net/session_marshal_test.cpp
new file mode 100644
index 0000000..8704ab2
--- /dev/null
+++ b/tests/unit/net/session_marshal_test.cpp
@@ -0,0 +1,155 @@
+// COGBox SDK patch 65: lobbies -> the XSessionSearch results buffer, in the layout the traces confirmed
+// (XSESSION_SEARCHRESULT_HEADER, 92-byte results, 24-byte XUSER_PROPERTY, 8-byte XUSER_CONTEXT; all big endian).
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstring>
+#include <vector>
+
+#include <rex/kernel/xam/net/session_marshal.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+uint64_t Be64(const uint8_t* p) { return uint64_t(Be32(p)) << 32 | Be32(p + 4); }
+
+LobbyInfo MakeLobby(uint8_t seed) {
+  LobbyInfo l;
+  l.lobby_id = "L" + std::to_string(seed);
+  l.host_uuid = "H";
+  l.host_xuid = 0x0009000000000000ull | seed;
+  l.title_id = 0x4D53082D;
+  for (int i = 0; i < 60; ++i) l.session_info[i] = uint8_t(seed + i);
+  l.max_players = 10;
+  l.current_players = 3;
+  l.properties = {{0x1000001F, -7}, {0x20000005, 0x0102030405060708ll}};
+  l.contexts = {{0x800A, 1}, {0x800B, 2}, {5, 9}};
+  return l;
+}
+constexpr uint32_t kGuestBase = 0x49EE0000;
+}  // namespace
+
+TEST_CASE("Marshal: header, results, properties and contexts in the traced layout", "[net][marshal]") {
+  std::vector<LobbyInfo> lobbies = {MakeLobby(1), MakeLobby(0x40)};
+  std::vector<uint8_t> buf(8 + 1326 * 10, 0xCD);
+  auto r = MarshalSearchResults(lobbies, 10, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  CHECK(r.written == 2);
+  const uint8_t* p = buf.data();
+  CHECK(Be32(p + 0) == 2);
+  CHECK(Be32(p + 4) == kGuestBase + 8);
+  for (int i = 0; i < 2; ++i) {
+    const uint8_t* res = p + 8 + 92 * i;
+    for (int b = 0; b < 60; ++b) CHECK(res[b] == uint8_t(lobbies[i].session_info[b]));
+    CHECK(Be32(res + 60) == 7);   // open public = max - current
+    CHECK(Be32(res + 64) == 0);   // open private
+    CHECK(Be32(res + 68) == 3);   // filled public
+    CHECK(Be32(res + 72) == 0);   // filled private
+    CHECK(Be32(res + 76) == 4);   // cProperties: 2 + mu / sigma
+    CHECK(Be32(res + 80) == 3);   // cContexts
+    const uint32_t props = Be32(res + 84);
+    const uint32_t ctxs = Be32(res + 88);
+    REQUIRE(props >= kGuestBase + 8 + 92 * 2);
+    REQUIRE(ctxs + 3 * 8 <= kGuestBase + buf.size());
+    const uint8_t* pp = p + (props - kGuestBase);
+    CHECK(Be32(pp + 0) == 0x1000001F);
+    CHECK(pp[8] == 1);  // XUSER_DATA_TYPE_INT32
+    CHECK(int32_t(Be32(pp + 16)) == -7);
+    CHECK(Be32(pp + 24) == 0x20000005);
+    CHECK(pp[24 + 8] == 2);  // XUSER_DATA_TYPE_INT64
+    CHECK(Be64(pp + 24 + 16) == 0x0102030405060708ull);
+    const uint8_t* cp = p + (ctxs - kGuestBase);
+    CHECK(Be32(cp + 0) == 0x800A);
+    CHECK(Be32(cp + 4) == 1);
+    CHECK(Be32(cp + 16) == 5);
+    CHECK(Be32(cp + 20) == 9);
+  }
+}
+
+TEST_CASE("Marshal: no lobbies writes an empty header", "[net][marshal]") {
+  std::vector<uint8_t> buf(64, 0xCD);
+  auto r = MarshalSearchResults({}, 10, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  CHECK(r.written == 0);
+  CHECK(Be32(buf.data()) == 0);
+  CHECK(Be32(buf.data() + 4) == 0);
+  CHECK(buf[8] == 0xCD);
+}
+
+TEST_CASE("Marshal: never more than the caller's max results", "[net][marshal]") {
+  std::vector<LobbyInfo> lobbies = {MakeLobby(1), MakeLobby(2), MakeLobby(3)};
+  std::vector<uint8_t> buf(8 + 1326 * 10, 0);
+  auto r = MarshalSearchResults(lobbies, 2, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  CHECK(r.written == 2);
+  CHECK(Be32(buf.data()) == 2);
+}
+
+TEST_CASE("Marshal: a buffer too small writes nothing and reports the size needed", "[net][marshal]") {
+  std::vector<LobbyInfo> lobbies = {MakeLobby(1)};
+  const uint32_t needed = 8 + 92 + 4 * 24 + 3 * 8;  // 2 properties + mu / sigma, 3 contexts
+  std::vector<uint8_t> buf(needed - 1, 0xCD);
+  auto r = MarshalSearchResults(lobbies, 10, buf.data(), uint32_t(buf.size()), kGuestBase);
+  CHECK_FALSE(r.ok);
+  CHECK(r.required == needed);
+  for (uint8_t b : buf) REQUIRE(b == 0xCD);
+  std::vector<uint8_t> exact(needed, 0);
+  CHECK(MarshalSearchResults(lobbies, 10, exact.data(), needed, kGuestBase).ok);
+}
+
+TEST_CASE("Marshal: property types other than int32 / int64 are left out", "[net][marshal]") {
+  LobbyInfo l = MakeLobby(1);
+  l.properties = {{0x40000001, 5}, {0x1000001F, 4}};  // a string id (type 4) and an int32
+  std::vector<uint8_t> buf(8 + 1326, 0);
+  auto r = MarshalSearchResults({l}, 1, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  CHECK(Be32(buf.data() + 8 + 76) == 3);  // the int32 + mu / sigma
+  const uint32_t props = Be32(buf.data() + 8 + 84);
+  CHECK(Be32(buf.data() + (props - kGuestBase)) == 0x1000001F);
+}
+
+TEST_CASE("Marshal: the host's name is X_PROPERTY_GAMER_HOSTNAME, a UTF-16 string", "[net][marshal]") {
+  LobbyInfo l = MakeLobby(1);
+  l.properties = {};
+  l.contexts = {};
+  l.host_name = "Marcus";
+  std::vector<uint8_t> buf(8 + 1326, 0xCD);
+  auto r = MarshalSearchResults({l}, 1, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  CHECK(r.required == 8 + 92 + 3 * 24 + 14);  // name + mu / sigma, the string with its terminator
+  const uint8_t* res = buf.data() + 8;
+  REQUIRE(Be32(res + 76) == 3);
+  const uint8_t* prop = buf.data() + (Be32(res + 84) - kGuestBase);
+  CHECK(Be32(prop + 0) == 0x40008109);
+  CHECK(prop[8] == 4);                 // XUSER_DATA_TYPE_UNICODE
+  CHECK(Be32(prop + 16) == 14);        // cbData, bytes with the terminator
+  const uint8_t* s = buf.data() + (Be32(prop + 20) - kGuestBase);
+  CHECK(s[0] == 0);
+  CHECK(s[1] == 'M');
+  CHECK(s[11] == 's');
+  CHECK(s[12] == 0);
+  CHECK(s[13] == 0);
+}
+
+TEST_CASE("Marshal: every result carries the host's TrueSkill mu / sigma (LIVE's defaults)", "[net][marshal]") {
+  LobbyInfo l = MakeLobby(1);
+  l.properties = {};
+  l.contexts = {};
+  std::vector<uint8_t> buf(8 + 1326, 0);
+  auto r = MarshalSearchResults({l}, 1, buf.data(), uint32_t(buf.size()), kGuestBase);
+  REQUIRE(r.ok);
+  const uint8_t* res = buf.data() + 8;
+  REQUIRE(Be32(res + 76) == 2);
+  const uint8_t* p = buf.data() + (Be32(res + 84) - kGuestBase);
+  auto dbl = [](const uint8_t* q) {
+    uint64_t bits = Be64(q);
+    double d;
+    std::memcpy(&d, &bits, 8);
+    return d;
+  };
+  CHECK(Be32(p + 0) == 0x30008105);  // X_PROPERTY_GAMER_MU
+  CHECK(p[8] == 3);                  // XUSER_DATA_TYPE_DOUBLE
+  CHECK(dbl(p + 16) == 3.0);
+  CHECK(Be32(p + 24) == 0x30008106);  // X_PROPERTY_GAMER_SIGMA
+  CHECK(dbl(p + 24 + 16) == 1.0);
+}
