+void CogboxHostBanCheck(bool searching) {
+#if REX_PLATFORM_WIN32
+  constexpr uint32_t kGears2 = 0x4D53082D, kGears3 = 0x4D5308AB, kJudgment = 0x4D530A26;
+  const uint32_t title = REX_KERNEL_STATE()->title_id();
+  if (!rex::kernel::xam::net::NetOnline() || (title != kGears2 && title != kGears3 && title != kJudgment)) return;
+  if (searching) g_host_search_at = std::time(nullptr);
+  static std::once_flag started;
+  std::call_once(started, [] {
+    std::thread(HostBanThread).detach();  // the same check in all three; Gears 2 stores the two settings under other ids
+    if (REX_KERNEL_STATE()->title_id() != kGears2) std::thread(PopulationThread, REX_KERNEL_STATE()->title_id()).detach();  // Gears 2 has no counts
+  });
+#endif
+}
