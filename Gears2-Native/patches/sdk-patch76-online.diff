new file mode 100644
index 0000000..95fb930
--- /dev/null
+++ b/src/kernel/xam/net/ue3_script.cpp
@@ -0,0 +1,88 @@
+// COGBox SDK patch 65 (social step 4): see ue3_script.h.
+#include <rex/kernel/xam/net/ue3_script.h>
+
+#include <cstring>
+
+namespace rex::kernel::xam::net {
+
+std::optional<ScriptJump> FindFalseFalseFalseCall(const uint8_t* code, size_t n) {
+  // 1B, FName (index, number 0), 28 28 28, then the last argument up to EX_EndFunctionParms (16)
+  for (size_t i = 0; i + 13 <= n; ++i) {
+    if (code[i] != 0x1B || code[i + 5] || code[i + 6] || code[i + 7] || code[i + 8] || code[i + 9] != 0x28 ||
+        code[i + 10] != 0x28 || code[i + 11] != 0x28) {
+      continue;
+    }
+    for (size_t k = i + 12; k < n && k < i + 64; ++k) {
+      if (code[k] == 0x16) {
+        if (k + 1 >= n || k + 1 > 0xFFFF) return std::nullopt;
+        return ScriptJump{uint32_t(i), uint16_t(k + 1)};
+      }
+    }
+    return std::nullopt;
+  }
+  return std::nullopt;
+}
+
+std::optional<uint32_t> FindInviteOptionCheck(const uint8_t* code, size_t n) {
+  static const char kOption[] = "bIsFromInvite";   // EX_StringConst (1F) "bIsFromInvite\0"
+  const size_t len = sizeof(kOption);              // with its terminator
+  for (size_t s = 1; s + len <= n; ++s) {
+    if (code[s - 1] != 0x1F || std::memcmp(code + s, kOption, len) != 0) continue;
+    // the JumpIfNot before it whose target lies past the string, right after a return (04 then one byte)
+    for (size_t j = s > 64 ? s - 64 : 0; j < s; ++j) {
+      if (code[j] != 0x07 || j + 3 > n) continue;
+      const size_t target = size_t(code[j + 1]) << 8 | code[j + 2];
+      if (target > s + len && target <= n && target >= 2 && code[target - 2] == 0x04) return uint32_t(j);
+    }
+    return std::nullopt;
+  }
+  return std::nullopt;
+}
+
+bool SetPopulationScript(uint8_t* code, size_t n, int32_t worldwide, int32_t region) {
+  constexpr uint8_t kLet = 0x0F, kLocalOut = 0x48, kIntZero = 0x25, kIntConst = 0x1D, kReturn = 0x04, kNothing = 0x0B;
+  constexpr size_t kPatchedSize = 32;
+  if (n < kPatchedSize || code[0] != kLet || code[1] != kLocalOut) return false;
+  const auto put = [&](size_t at, int32_t v) {
+    code[at] = uint8_t(uint32_t(v) >> 24); code[at + 1] = uint8_t(uint32_t(v) >> 16);
+    code[at + 2] = uint8_t(uint32_t(v) >> 8); code[at + 3] = uint8_t(v);
+  };
+  if (code[10] == kIntConst) {  // already ours: only the numbers
+    put(11, worldwide);
+    put(26, region);
+    return true;
+  }
+  if (code[10] != kIntZero || code[11] != kLet || code[12] != kLocalOut || code[21] != kIntZero) return false;
+  uint8_t region_var[8];
+  std::memcpy(region_var, code + 13, 8);
+  code[15] = kLet;
+  code[16] = kLocalOut;
+  std::memcpy(code + 17, region_var, 8);
+  code[25] = kIntConst;
+  put(26, region);
+  code[30] = kReturn;
+  code[31] = kNothing;
+  put(11, worldwide);
+  code[10] = kIntConst;
+  return true;
+}
+
+std::optional<ScriptJump> FindRankedPopulationCall(const uint8_t* code, size_t n) {
+  static const char kId[] = "RankedPlaylistID";  // with its 0, as an EX_StringConst
+  const size_t id = sizeof(kId);
+  constexpr size_t kContext = 21;  // EX_Context, the local, the skip, the field and its size, before the call
+  for (size_t s = 1; s + id <= n; ++s) {
+    if (code[s - 1] != 0x1F || std::memcmp(code + s, kId, id) != 0) continue;
+    for (size_t c = s; c-- > kContext && s - c < 64;) {
+      if (code[c] != 0x1B || code[c - kContext] != 0x19 || code[c - kContext + 1] != 0x00) continue;
+      const size_t skip = size_t(code[c - 11]) << 8 | code[c - 10];
+      const size_t target = c + skip;
+      if (target > s && target < n && target <= 0xFFFF && code[target] == 0x0F) {
+        return ScriptJump{uint32_t(c - kContext), uint16_t(target)};
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/virtual_peer_manager.cpp b/src/kernel/xam/net/virtual_peer_manager.cpp
new file mode 100644
index 0000000..c414372
--- /dev/null
+++ b/src/kernel/xam/net/virtual_peer_manager.cpp
@@ -0,0 +1,570 @@
+// COGBox SDK patch 65: online peers as virtual IPs and the NAT path to each.
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+#include <algorithm>
+#include <random>
+
+#include <rex/kernel/xam/net/punch.h>
+#include <rex/kernel/xam/net/tunnel_core.h>
+#include <rex/logging.h>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+constexpr uint32_t kSubnet = 0x0AFE0000;  // 10.254.0.0/16
+constexpr uint32_t kMaxHosts = 65534;     // .0.1 to .255.254
+
+bool SameEndpoint(const sockaddr_in& a, const sockaddr_in& b) {
+  return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port;
+}
+
+StunTxId NewTxId() {
+  static std::mt19937_64 rng{std::random_device{}()};
+  StunTxId id;
+  for (auto& b : id) {
+    b = uint8_t(rng());
+  }
+  return id;
+}
+
+}  // namespace
+
+VirtualPeerManager& VirtualPeerManager::Get() {
+  // Never destroyed: worker threads may still call in while the process exits.
+  static VirtualPeerManager* instance = new VirtualPeerManager();
+  return *instance;
+}
+
+bool VirtualPeerManager::IsVirtualIp(uint32_t ip) {
+  return (ip & 0xFFFF0000u) == kSubnet;
+}
+
+uint64_t VirtualPeerManager::EndpointKey(const sockaddr_in& a) {
+  return uint64_t(ntohl(a.sin_addr.s_addr)) << 16 | ntohs(a.sin_port);
+}
+
+void VirtualPeerManager::SetSendFn(SendFn fn) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  send_fn_ = std::move(fn);
+}
+
+void VirtualPeerManager::SetStunServer(const sockaddr_in& server) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  stun_server_ = server;
+}
+
+void VirtualPeerManager::RegisterSocket(uint64_t native_handle, uint16_t local_port) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  sockets_[native_handle] = SocketInfo{local_port, {}, std::nullopt};
+}
+
+void VirtualPeerManager::SetPublicAddressFn(std::function<void(uint16_t port)> fn) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  public_address_fn_ = std::move(fn);
+}
+
+void VirtualPeerManager::UnregisterSocket(uint64_t native_handle) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  sockets_.erase(native_handle);
+}
+
+void VirtualPeerManager::AddLocalCandidate(uint16_t local_port, const Candidate& c) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto& list = local_candidates_[local_port];
+  if (c.kind == Candidate::Srflx || c.kind == Candidate::Upnp) {
+    list.erase(std::remove_if(list.begin(), list.end(), [&](const Candidate& x) { return x.kind == c.kind; }),
+               list.end());
+  } else if (std::any_of(list.begin(), list.end(), [&](const Candidate& x) { return SameEndpoint(x.addr, c.addr); })) {
+    return;
+  }
+  list.push_back(c);
+}
+
+std::vector<Candidate> VirtualPeerManager::LocalCandidates(uint16_t local_port) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = local_candidates_.find(local_port);
+  return it == local_candidates_.end() ? std::vector<Candidate>{} : it->second;
+}
+
+std::map<uint16_t, std::vector<Candidate>> VirtualPeerManager::AllLocalCandidates() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::map<uint16_t, std::vector<Candidate>> out;
+  for (const auto& [handle, s] : sockets_) {
+    auto it = local_candidates_.find(s.local_port);
+    out[s.local_port] = it == local_candidates_.end() ? std::vector<Candidate>{} : it->second;
+  }
+  return out;
+}
+
+std::vector<sockaddr_in> VirtualPeerManager::TunnelPaths(uint32_t vip, std::optional<uint16_t> tunnel_port) const {
+  const auto paths = Paths(vip);
+  const bool live = tunnel_port && std::any_of(paths.begin(), paths.end(), [&](const auto& p) { return p.first == *tunnel_port; });
+  std::vector<sockaddr_in> out;
+  for (const auto& [port, to] : paths) {
+    if (!live || port == *tunnel_port) out.push_back(to);
+  }
+  return out;
+}
+
+std::optional<uint16_t> VirtualPeerManager::FreshTunnelPort(uint16_t port, Clock::time_point last_frame, Clock::time_point now) {
+  if (now - last_frame >= kTunnelPortFresh) return std::nullopt;
+  return port;
+}
+
+void VirtualPeerManager::ResetPeer(uint32_t vip) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  if (it != peers_.end()) ResetPeerLocked(vip, it->second);
+}
+
+bool VirtualPeerManager::SilentLocked(const Peer& p, Clock::time_point now) const {
+  return p.state != PeerState::Pending && now - p.last_heard >= kPeerSilent;
+}
+
+void VirtualPeerManager::ResetPeerLocked(uint32_t vip, Peer& p) {
+  for (auto it = endpoint_to_peer_.begin(); it != endpoint_to_peer_.end();) {
+    it = it->second.first == vip ? endpoint_to_peer_.erase(it) : std::next(it);
+  }
+  p.state = PeerState::Pending;
+  p.ports.clear();
+  p.started.reset();
+  p.last_probe.reset();
+  p.queue.clear();
+  REXKRNL_INFO("cogbox_online: 10.254.{}.{} went silent and is back: connecting to it afresh", (vip >> 8) & 0xFF, vip & 0xFF);
+}
+
+bool VirtualPeerManager::ResetIfSilent(uint32_t vip, Clock::time_point now) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  if (it == peers_.end() || !SilentLocked(it->second, now)) {
+    return false;
+  }
+  ResetPeerLocked(vip, it->second);
+  return true;
+}
+
+uint32_t VirtualPeerManager::AddPeer(uint64_t peer_xuid, uint64_t session_token, bool* restarted, Clock::time_point now,
+                                     bool* token_changed) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (auto it = xuid_to_vip_.find(peer_xuid); it != xuid_to_vip_.end()) {
+    Peer& p = peers_[it->second];
+    if (token_changed) *token_changed = session_token != p.token;
+    if (session_token && p.token && session_token != p.token && SilentLocked(p, now)) {
+      ResetPeerLocked(it->second, p);
+      if (restarted) *restarted = true;
+    }
+    p.token = session_token;
+    return it->second;
+  }
+  if (peers_.size() >= kMaxHosts) {
+    return 0;
+  }
+  // Host parts are handed out in order and wrap; skip any still taken.
+  uint32_t vip = 0;
+  for (uint32_t tries = 0; tries < kMaxHosts; ++tries) {
+    const uint32_t candidate = kSubnet | next_host_;
+    next_host_ = next_host_ % kMaxHosts + 1;
+    if (!peers_.count(candidate)) {
+      vip = candidate;
+      break;
+    }
+  }
+  Peer& p = peers_[vip];
+  p.xuid = peer_xuid;
+  p.token = session_token;
+  REXKRNL_INFO("cogbox_online: peer {:016X} is 10.254.{}.{} (session token {:016X})", peer_xuid, (vip >> 8) & 0xFF,
+               vip & 0xFF, session_token);
+  xuid_to_vip_[peer_xuid] = vip;
+  return vip;
+}
+
+void VirtualPeerManager::SetRemoteCandidates(uint32_t vip, uint16_t peer_game_port, std::vector<Candidate> candidates,
+                                             Clock::time_point now) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  if (it == peers_.end()) {
+    return;
+  }
+  Peer& p = it->second;
+  REXKRNL_INFO("cogbox_online: 10.254.{}.{} port {}: {} candidate(s), punching", (vip >> 8) & 0xFF, vip & 0xFF,
+               peer_game_port, candidates.size());
+  PortPath& pp = p.ports[peer_game_port];
+  pp.candidates = std::move(candidates);
+  if (p.state == PeerState::Connected) {
+    for (const auto& [handle, sock] : sockets_) {
+      if (!pp.by_socket.count(handle)) pp.punching.emplace(handle, now);
+    }
+  }
+  if (p.state != PeerState::Connected) {
+    p.state = PeerState::Pending;
+    p.started = now;
+    p.last_probe.reset();
+  }
+}
+
+std::optional<sockaddr_in> VirtualPeerManager::Route(uint32_t vip, uint16_t peer_game_port) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  if (it == peers_.end()) {
+    return std::nullopt;
+  }
+  auto port = it->second.ports.find(peer_game_port);
+  return port == it->second.ports.end() ? std::nullopt : port->second.selected;
+}
+
+std::optional<std::pair<uint32_t, uint16_t>> VirtualPeerManager::Relabel(const sockaddr_in& from, Clock::time_point now,
+                                                                       uint64_t native_handle) {
+  std::vector<Outgoing> out;
+  std::optional<std::pair<uint32_t, uint16_t>> label;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = endpoint_to_peer_.find(EndpointKey(from));
+    if (it != endpoint_to_peer_.end()) {
+      label = it->second;
+      auto peer = peers_.find(it->second.first);
+      if (peer != peers_.end() && now > peer->second.last_heard) peer->second.last_heard = now;
+      if (native_handle && peer != peers_.end()) {
+        PortPath& pp = peer->second.ports[it->second.second];
+        if (!pp.by_socket.count(native_handle)) {
+          pp.by_socket[native_handle] = from;
+          pp.punching.erase(native_handle);
+          FlushLocked(it->second.first, peer->second, out);
+        }
+      }
+    }
+    if (!label) {
+    // Not punched yet: a packet from one of a peer's announced candidates is that peer's (a game socket opened after
+    // the join sends before it answers any punch). Never one of our own addresses.
+    for (const auto& [port, cands] : local_candidates_) {
+      for (const auto& c : cands) {
+        if (SameEndpoint(c.addr, from)) return std::nullopt;
+      }
+    }
+    for (auto& [vip, peer] : peers_) {
+      for (auto& [port, path] : peer.ports) {
+        for (const auto& c : path.candidates) {
+          if (!SameEndpoint(c.addr, from)) continue;
+          if (!path.selected) {
+            path.selected = from;
+            endpoint_to_peer_[EndpointKey(from)] = {vip, port};
+            REXKRNL_INFO("cogbox_online: 10.254.{}.{} game port {} opened by its own traffic", (vip >> 8) & 0xFF,
+                         vip & 0xFF, port);
+            if (peer.state != PeerState::Connected) {
+              peer.state = PeerState::Connected;
+              peer.last_keepalive = now;
+              peer.last_heard = now;
+            }
+            PruneQueue(peer, now);
+            FlushLocked(vip, peer, out);
+          }
+          if (native_handle && !path.by_socket.count(native_handle)) {
+            path.by_socket[native_handle] = from;
+            path.punching.erase(native_handle);
+            FlushLocked(vip, peer, out);
+          }
+          label = std::make_pair(vip, port);
+          break;
+        }
+        if (label) break;
+      }
+      if (label) break;
+    }
+    }
+  }
+  Send(out);
+  return label;
+}
+
+std::vector<std::pair<uint16_t, sockaddr_in>> VirtualPeerManager::Paths(uint32_t vip) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::vector<std::pair<uint16_t, sockaddr_in>> out;
+  auto it = peers_.find(vip);
+  if (it != peers_.end()) {
+    for (const auto& [port, path] : it->second.ports) {
+      if (path.selected) out.push_back({port, *path.selected});
+    }
+  }
+  return out;
+}
+
+uint32_t VirtualPeerManager::PunchSenderLocked(const sockaddr_in& from, uint64_t token) const {
+  // All players of a match share the host's token, so it only narrows the search.
+  if (auto known = endpoint_to_peer_.find(EndpointKey(from)); known != endpoint_to_peer_.end()) {
+    auto p = peers_.find(known->second.first);
+    if (p != peers_.end() && p->second.token == token) return known->second.first;
+  }
+  uint32_t only = 0, only_connecting = 0;
+  int count = 0, connecting = 0;
+  for (const auto& [vip, p] : peers_) {
+    if (p.token != token) continue;
+    bool announced = false;
+    for (const auto& [port, path] : p.ports) {
+      for (const auto& c : path.candidates) {
+        if (SameEndpoint(c.addr, from)) return vip;
+        announced = true;
+      }
+    }
+    only = vip;
+    ++count;
+    if (announced && p.state != PeerState::Connected) {
+      only_connecting = vip;
+      ++connecting;
+    }
+  }
+  if (count == 1) return only;
+  return connecting == 1 ? only_connecting : 0;  // an address no candidate lists: a NAT that picked a new port
+}
+
+bool VirtualPeerManager::IsPeerAddress(const sockaddr_in& from) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  for (const auto& [port, cands] : local_candidates_) {
+    for (const auto& c : cands) {
+      if (SameEndpoint(c.addr, from)) return false;  // one of our own sockets (two copies on one PC share the address)
+    }
+  }
+  for (const auto& [vip, peer] : peers_) {
+    for (const auto& [port, path] : peer.ports) {
+      for (const auto& c : path.candidates) {
+        if (c.addr.sin_addr.s_addr == from.sin_addr.s_addr) return true;
+      }
+      if (path.selected && path.selected->sin_addr.s_addr == from.sin_addr.s_addr) return true;
+    }
+  }
+  return false;
+}
+
+PeerState VirtualPeerManager::State(uint32_t vip) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  return it == peers_.end() ? PeerState::Lost : it->second.state;
+}
+
+void VirtualPeerManager::Send(std::vector<Outgoing>& out) {
+  SendFn fn;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    fn = send_fn_;
+  }
+  if (fn) {
+    for (const auto& o : out) {
+      fn(o.handle, o.data.data(), o.data.size(), o.to);
+    }
+  }
+  out.clear();
+}
+
+void VirtualPeerManager::PruneQueue(Peer& p, Clock::time_point now) {
+  while (!p.queue.empty() && now - p.queue.front().time >= kQueueMaxAge) {
+    p.queue.pop_front();
+  }
+}
+
+void VirtualPeerManager::FlushLocked(uint32_t, Peer& p, std::vector<Outgoing>& out) {
+  std::deque<Queued> keep;
+  for (auto& q : p.queue) {
+    auto port = p.ports.find(q.port);
+    if (port != p.ports.end() && (port->second.by_socket.count(q.handle) || port->second.selected)) {
+      auto own = port->second.by_socket.find(q.handle);
+      out.push_back({q.handle, std::move(q.data),
+                     own != port->second.by_socket.end() ? own->second : *port->second.selected});
+    } else {
+      keep.push_back(std::move(q));
+    }
+  }
+  p.queue = std::move(keep);
+}
+
+bool VirtualPeerManager::OnPacket(uint64_t native_handle, const uint8_t* data, size_t len, const sockaddr_in& from,
+                                  Clock::time_point now) {
+  if (IsStunPacket(data, len)) {
+    std::optional<uint16_t> changed;
+    std::function<void(uint16_t)> notify;
+    {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = sockets_.find(native_handle);
+    if (it != sockets_.end()) {
+      if (auto mapped = ParseStunBindingResponse(data, len, it->second.txid)) {
+        auto& list = local_candidates_[it->second.local_port];
+        const bool known = std::any_of(list.begin(), list.end(), [&](const Candidate& c) {
+          return c.kind == Candidate::Srflx && SameEndpoint(c.addr, *mapped);
+        });
+        if (!known) {
+          changed = it->second.local_port;
+          notify = public_address_fn_;
+        }
+        list.erase(std::remove_if(list.begin(), list.end(),
+                                  [](const Candidate& c) { return c.kind == Candidate::Srflx; }),
+                   list.end());
+        list.push_back({*mapped, Candidate::Srflx});
+      }
+    }
+    }
+    if (changed && notify) {
+      notify(*changed);
+    }
+    return true;
+  }
+  if (IsTunnelFrame(data, len)) {
+    return true;  // the stream tunnel's frames belong to its own socket; never the game's
+  }
+  auto punch = DecodePunch(data, len);
+  if (!punch) {
+    return false;
+  }
+  std::vector<Outgoing> out;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Our own punch coming back (both ends of a session share its token): never a peer.
+    for (const auto& [port, list] : local_candidates_) {
+      for (const auto& c : list) {
+        if (SameEndpoint(c.addr, from)) {
+          return true;
+        }
+      }
+    }
+    const uint32_t vip = PunchSenderLocked(from, punch->token);
+    if (!vip) {
+      return true;  // not a session of ours, or nothing says which of its players this is
+    }
+    Peer& p = peers_[vip];
+    PortPath& path = p.ports[punch->src_port];
+    if (!path.selected) {
+      path.selected = from;  // the first address that answers wins
+    }
+    endpoint_to_peer_[EndpointKey(from)] = {vip, punch->src_port};
+    if (!path.by_socket.count(native_handle)) {
+      path.by_socket[native_handle] = from;  // this socket's own route to that port
+    }
+    path.punching.erase(native_handle);
+    if (punch->type == PunchType::Punch) {
+      auto sock = sockets_.find(native_handle);
+      const uint16_t local_port = sock == sockets_.end() ? 0 : sock->second.local_port;
+      auto ack = EncodePunch({PunchType::Ack, punch->token, punch->seq, local_port});
+      out.push_back({native_handle, std::vector<uint8_t>(ack.begin(), ack.end()), from});
+    }
+    if (now > p.last_heard) p.last_heard = now;
+    if (p.state != PeerState::Connected) {
+      p.state = PeerState::Connected;
+      p.last_keepalive = now;
+      char ip[INET_ADDRSTRLEN] = {};
+      inet_ntop(AF_INET, &from.sin_addr, ip, sizeof(ip));
+      REXKRNL_INFO("cogbox_online: 10.254.{}.{} connected through {}:{} (game port {})", (vip >> 8) & 0xFF, vip & 0xFF,
+                   ip, ntohs(from.sin_port), punch->src_port);
+    }
+    PruneQueue(p, now);
+    FlushLocked(vip, p, out);
+  }
+  Send(out);
+  return true;
+}
+
+SendDecision VirtualPeerManager::OnSend(uint64_t native_handle, uint32_t vip, uint16_t port, const uint8_t* data,
+                                        size_t len, Clock::time_point now) {
+  if (!IsVirtualIp(vip)) {
+    return {SendAction::PassThrough, {}};
+  }
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = peers_.find(vip);
+  if (it == peers_.end()) {
+    return {SendAction::Dropped, {}};
+  }
+  Peer& p = it->second;
+  auto path = p.ports.find(port);
+  if (path != p.ports.end()) {
+    auto own = path->second.by_socket.find(native_handle);
+    if (own != path->second.by_socket.end()) {
+      return {SendAction::Routed, own->second};
+    }
+    if (path->second.selected) {
+      // Not proven from this socket yet: the shared route (fine on one PC or a LAN) while this socket punches its own.
+      if (!path->second.candidates.empty() && sockets_.count(native_handle)) {
+        path->second.punching.emplace(native_handle, now);
+      }
+      return {SendAction::Routed, *path->second.selected};
+    }
+  }
+  if (p.state == PeerState::Lost) {
+    return {SendAction::Dropped, {}};
+  }
+  PruneQueue(p, now);
+  if (p.queue.size() < kQueueMaxPackets) {
+    p.queue.push_back({native_handle, port, std::vector<uint8_t>(data, data + len), now});
+  }
+  return {SendAction::Queued, {}};
+}
+
+void VirtualPeerManager::Tick(Clock::time_point now) {
+  std::vector<Outgoing> out;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (stun_server_) {
+      for (auto& [handle, s] : sockets_) {
+        if (!s.last_stun || now - *s.last_stun >= kKeepaliveInterval) {
+          s.txid = NewTxId();
+          s.last_stun = now;
+          out.push_back({handle, BuildStunBindingRequest(s.txid), *stun_server_});
+        }
+      }
+    }
+    for (auto& [vip, p] : peers_) {
+      PruneQueue(p, now);
+      if (p.state == PeerState::Pending && p.started) {
+        if (now - *p.started >= kPunchTimeout) {
+          REXKRNL_WARN("cogbox_online: 10.254.{}.{} did not answer in 10 s (strict NAT on both sides?)",
+                       (vip >> 8) & 0xFF, vip & 0xFF);
+          p.state = PeerState::Lost;
+          p.queue.clear();
+          continue;
+        }
+        if (!p.last_probe || now - *p.last_probe >= kProbeInterval) {
+          p.last_probe = now;
+          for (const auto& [handle, s] : sockets_) {
+            for (const auto& [peer_port, path] : p.ports) {
+              for (const auto& c : path.candidates) {
+                auto pkt = EncodePunch({PunchType::Punch, p.token, p.seq++, s.local_port});
+                out.push_back({handle, std::vector<uint8_t>(pkt.begin(), pkt.end()), c.addr});
+              }
+            }
+          }
+        }
+      }
+      if (p.state == PeerState::Connected) {
+        for (auto& [peer_port, path] : p.ports) {
+          for (auto it = path.punching.begin(); it != path.punching.end();) {
+            if (path.by_socket.count(it->first) || !sockets_.count(it->first) || now - it->second >= kPunchTimeout) {
+              it = path.punching.erase(it);
+            } else {
+              ++it;
+            }
+          }
+          if (path.punching.empty() || (path.last_pair_probe && now - *path.last_pair_probe < kProbeInterval)) {
+            continue;
+          }
+          path.last_pair_probe = now;
+          for (const auto& [handle, since] : path.punching) {
+            const uint16_t local_port = sockets_[handle].local_port;
+            for (const auto& c : path.candidates) {
+              auto pkt = EncodePunch({PunchType::Punch, p.token, p.seq++, local_port});
+              out.push_back({handle, std::vector<uint8_t>(pkt.begin(), pkt.end()), c.addr});
+            }
+          }
+        }
+      }
+      if (p.state == PeerState::Connected && now - p.last_keepalive >= kKeepaliveInterval) {
+        p.last_keepalive = now;
+        for (const auto& [handle, s] : sockets_) {
+          for (const auto& [peer_port, path] : p.ports) {
+            if (path.selected) {
+              auto pkt = EncodePunch({PunchType::Keepalive, p.token, p.seq++, s.local_port});
+              out.push_back({handle, std::vector<uint8_t>(pkt.begin(), pkt.end()), *path.selected});
+            }
+          }
+        }
+      }
+    }
+  }
+  Send(out);
+}
