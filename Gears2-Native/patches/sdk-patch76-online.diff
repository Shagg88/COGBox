+std::vector<FriendEntry> ParseFriendsList(const std::string& json) {
+  std::vector<FriendEntry> out;
+  const auto j = nlohmann::json::parse(json, nullptr, false);
+  if (!j.is_object() || !j.contains("friends") || !j["friends"].is_array()) {
+    return out;
+  }
+  for (const auto& f : j["friends"]) {
+    if (!f.is_object() || !f.contains("xuid") || !f["xuid"].is_string()) continue;
+    FriendEntry e;
+    e.xuid = std::strtoull(f["xuid"].get<std::string>().c_str(), nullptr, 10);
+    const std::string tag = f.value("tag", "");
+    e.name = tag.substr(0, tag.find('#'));
+    if (f.contains("presence") && f["presence"].is_object()) {
+      e.state = f["presence"].value("state", "offline");
+      e.title_id = uint32_t(std::strtoul(f["presence"].value("title_id", "0").c_str(), nullptr, 16));
+      const std::string sid = f["presence"].value("session_id", "");
+      if (sid.size() == 16) {
+        for (size_t i = 0; i < 8; ++i) e.session_id[i] = uint8_t(std::strtoul(sid.substr(i * 2, 2).c_str(), nullptr, 16));
+      }
+      e.room_code = f["presence"].value("room_code", "");
+    }
+    if (e.xuid) out.push_back(e);
+  }
+  return out;
+}
+
+std::vector<std::string> FriendUuidsInRequest(const std::string& json, const std::vector<uint8_t>& request) {
+  std::vector<std::string> out;
+  const auto j = nlohmann::json::parse(json, nullptr, false);
+  if (!j.is_object() || !j.contains("friends") || !j["friends"].is_array()) return out;
+  for (const auto& f : j["friends"]) {
+    if (!f.is_object() || !f.contains("xuid") || !f["xuid"].is_string() || !f.contains("uuid") || !f["uuid"].is_string()) continue;
+    const uint64_t xuid = std::strtoull(f["xuid"].get<std::string>().c_str(), nullptr, 10);
+    if (!xuid) continue;
+    uint8_t be[8];
+    for (int i = 0; i < 8; ++i) be[i] = uint8_t(xuid >> (8 * (7 - i)));
+    if (std::search(request.begin(), request.end(), be, be + 8) != request.end()) out.push_back(f["uuid"].get<std::string>());
+  }
+  return out;
+}
+
+std::vector<uint64_t> InviteTargetXuids(const std::vector<uint8_t>& request) {
+  const auto be64 = [&](size_t at) {
+    uint64_t v = 0;
+    for (size_t i = 0; i < 8; ++i) v = v << 8 | request[at + i];
+    return v;
+  };
+  std::vector<uint64_t> out;
+  if (request.size() < 16) return out;
+  const uint64_t count = be64(0);
+  if (count == 0 || count > 16 || request.size() < 8 + count * 8) return out;
+  for (uint64_t i = 0; i < count; ++i) {
+    const uint64_t xuid = be64(8 + i * 8);
+    if (xuid >> 48 != 0x0009) return {};   // the COGBox server's online XUIDs
+    out.push_back(xuid);
+  }
+  return out;
+}
+
+namespace {
+std::mutex g_sessions_mutex;
+std::vector<std::pair<std::array<uint8_t, 8>, std::string>> g_sessions;
+}  // namespace
+
+void RememberFriendSessions(const std::vector<FriendEntry>& friends) {
+  std::lock_guard<std::mutex> lock(g_sessions_mutex);
+  g_sessions.clear();
+  for (const FriendEntry& f : friends) {
+    if (f.state == "joinable" && !f.room_code.empty()) g_sessions.emplace_back(f.session_id, f.room_code);
+  }
+}
+
+std::string RoomCodeForFriendSession(const std::array<uint8_t, 8>& session_id) {
+  std::lock_guard<std::mutex> lock(g_sessions_mutex);
+  for (const auto& s : g_sessions) {
+    if (s.first == session_id) return s.second;
+  }
+  return {};
+}
+
+std::array<uint8_t, 196> EncodeXOnlineFriend(const FriendEntry& f) {
+  std::array<uint8_t, 196> r{};
+  for (int i = 7; i >= 0; --i) r[i] = uint8_t(f.xuid >> (8 * (7 - i)));
+  for (size_t i = 0; i < f.name.size() && i < 15; ++i) r[8 + i] = uint8_t(f.name[i]);
+  uint32_t state = 0;
+  if (f.state == "online") state = kFriendOnline;
+  if (f.state == "playing") state = kFriendOnline | kFriendPlaying;
+  if (f.state == "joinable") state = kFriendOnline | kFriendPlaying | kFriendJoinable;
+  PutBe32(&r[24], state);
+  if (f.state == "joinable") std::copy(f.session_id.begin(), f.session_id.end(), r.begin() + 28);
+  if (f.state == "playing" || f.state == "joinable") PutBe32(&r[36], f.title_id);
+  return r;
+}
+
+uint32_t ParamBlockPointer(const uint8_t* block, size_t size, uint32_t index) {
+  if (!block || size < 516 || index >= Be32(block + 512) || 16 * size_t(index) + 16 > 512) {
+    return 0;
+  }
+  const uint8_t* e = block + 16 * index;
+  if (Be32(e) != 4 || Be32(e + 8) != 0) {
+    return 0;
+  }
+  return Be32(e + 12);
+}
+
+std::u16string StorageServerPath(uint32_t facility, const std::string& item) {
+  std::u16string out = u"cogbox://storage/";
+  for (char c : std::to_string(facility)) out += char16_t(c);
+  out += u'/';
+  for (char c : item) out += char16_t(static_cast<unsigned char>(c));
+  return out;
+}
+
+std::vector<uint8_t> EncodeWideBE(const std::u16string& s, size_t max_chars) {
+  std::vector<uint8_t> out;
+  if (max_chars == 0) return out;
+  const size_t n = std::min(s.size(), max_chars - 1);
+  for (size_t i = 0; i < n; ++i) {
+    out.push_back(uint8_t(s[i] >> 8));
+    out.push_back(uint8_t(s[i]));
+  }
+  out.push_back(0);
+  out.push_back(0);
+  return out;
+}
+
+}  // namespace rex::kernel::xam::net
