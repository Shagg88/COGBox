+// COGBox SDK patch 65: online XNADDRs ("CGB1" + XUID + session token in abOnline) and their virtual IPs.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstring>
+
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+#include <rex/kernel/xam/net/xnaddr_online.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+std::array<uint8_t, kXnAddrSize> MakeXnAddr(uint64_t xuid, uint64_t token) {
+  std::array<uint8_t, kXnAddrSize> a{};
+  a[0] = 192;  // ina 192.168.1.20
+  a[1] = 168;
+  a[2] = 1;
+  a[3] = 20;
+  a[10] = 0x02;  // abEnet
+  WriteOnlineMarker(a.data() + kXnAddrOnlineOffset, xuid, token);
+  return a;
+}
+}  // namespace
+
+TEST_CASE("XNADDR: the online marker round trips, big endian", "[net][xnaddr]") {
+  uint8_t ab[20] = {};
+  WriteOnlineMarker(ab, 0x0009000011112222ull, 0x3333444455556666ull);
+  CHECK(std::memcmp(ab, "CGB1", 4) == 0);
+  CHECK(ab[4] == 0x00);
+  CHECK(ab[5] == 0x09);
+  CHECK(ab[11] == 0x22);
+  CHECK(ab[12] == 0x33);
+  CHECK(ab[19] == 0x66);
+  uint64_t xuid = 0, token = 0;
+  REQUIRE(ReadOnlineMarker(ab, &xuid, &token));
+  CHECK(xuid == 0x0009000011112222ull);
+  CHECK(token == 0x3333444455556666ull);
+  uint8_t plain[20] = {};
+  CHECK_FALSE(ReadOnlineMarker(plain, &xuid, &token));
+}
+
+TEST_CASE("XNADDR: a CGB1 XNADDR gets a virtual IP and a pending peer; the VIP maps back", "[net][xnaddr]") {
+  auto xn = MakeXnAddr(0x0009AAAA00000001ull, 0x51);
+  uint32_t vip = XnAddrToVip(xn.data());
+  REQUIRE(vip != 0);
+  CHECK(VirtualPeerManager::IsVirtualIp(vip));
+  CHECK(XnAddrToVip(xn.data()) == vip);
+  CHECK(ConnectStatus(vip) == kXNetConnectPending);
+  std::array<uint8_t, kXnAddrSize> back{};
+  REQUIRE(VipToXnAddr(vip, back.data()));
+  CHECK(back == xn);
+}
+
+TEST_CASE("XNADDR: a plain (system link) XNADDR has no virtual IP", "[net][xnaddr]") {
+  std::array<uint8_t, kXnAddrSize> xn{};
+  xn[0] = 10;
+  CHECK(XnAddrToVip(xn.data()) == 0);
+  std::array<uint8_t, kXnAddrSize> out{};
+  CHECK_FALSE(VipToXnAddr(0x0AFEFFFE, out.data()));
+  CHECK(ConnectStatus(0x0AFEFFFE) == kXNetConnectLost);
+}
+
+TEST_CASE("XNADDR: a new online peer is announced once", "[net][xnaddr]") {
+  int calls = 0;
+  uint64_t seen_xuid = 0, seen_token = 0;
+  SetNewPeerCallback([&](uint32_t, uint64_t xuid, uint64_t token) {
+    ++calls;
+    seen_xuid = xuid;
+    seen_token = token;
+  });
+  auto xn = MakeXnAddr(0x0009BBBB00000002ull, 0x77);
+  XnAddrToVip(xn.data());
+  XnAddrToVip(xn.data());
+  SetNewPeerCallback(nullptr);
+  CHECK(calls == 1);
+  CHECK(seen_xuid == 0x0009BBBB00000002ull);
+  CHECK(seen_token == 0x77);
+}
