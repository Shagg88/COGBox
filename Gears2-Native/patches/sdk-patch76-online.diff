+// The guest call chain (link register, then the saved ones up the stack); empty without a guest context.
+std::string CogboxGuestCallChain() {
+  auto* ctx = rex::runtime::current_ppc_context();
+  if (!ctx) {
+    return {};
+  }
+  std::string chain = fmt::format("{:08X}", uint32_t(ctx->lr));
+  uint32_t sp = ctx->r1.u32;
+  for (int i = 0; i < 16 && sp >= 0x70000000u && sp < 0x80000000u; ++i) {
+    // guarded reads: the walk can reach the end of the thread's stack (an access violation in the Gears 3 trace)
+    uint32_t back = 0, lr = 0;
+#if REX_PLATFORM_WIN32
+    if (!GuestRead32(sp, &back)) break;
+#else
+    back = rex::memory::load_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(sp));
+#endif
+    if (back <= sp || back >= 0x80000000u) {
+      break;
+    }
+#if REX_PLATFORM_WIN32
+    if (!GuestRead32(back - 8, &lr)) break;
+#else
+    lr = rex::memory::load_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual(back - 8));
+#endif
+    chain += fmt::format(" <- {:08X}", lr);
+    sp = back;
+  }
+#if REX_PLATFORM_WIN32
+  const std::string fns = Ue3StackFunctions(ctx->r1.u32);
+  if (!fns.empty()) chain += " | script: " + fns;
+  const std::string strs = Ue3StackStrings(ctx->r1.u32);
+  if (!strs.empty()) chain += " | strings: " + strs;
+#endif
+  return chain;
+}
