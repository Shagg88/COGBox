diff --git a/include/rex/kernel/xam/net/qos.h b/include/rex/kernel/xam/net/qos.h
new file mode 100644
index 0000000..d996c69
--- /dev/null
+++ b/include/rex/kernel/xam/net/qos.h
@@ -0,0 +1,24 @@
+// COGBox SDK patch 65: the XNetQosLookup answer.
+//
+// XNQOS { cxnqos; cxnqosPending; XNQOSINFO axnqosinfo[] } and XNQOSINFO { bFlags; bReserved; cProbesXmit;
+// cProbesRecv; cbData; pbData; wRttMinInMsecs; wRttMedInMsecs; dwUpBitsPerSec; dwDnBitsPerSec } (24 bytes), big
+// endian. A host from our last search is "contacted" (it is reachable through the punched path), with its QoS block;
+// anything else is complete but not contacted.
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace rex::kernel::xam::net {
+
+constexpr uint8_t kXnQosComplete = 0x01;
+constexpr uint8_t kXnQosTargetContacted = 0x02;
+constexpr uint8_t kXnQosDataReceived = 0x08;
+
+// targets[i]: the block of target i (empty = contacted, no data), or nullopt = not one of our hosts.
+// The data blocks follow the XNQOSINFO array; pbData pointers are guest addresses from guest_base.
+std::vector<uint8_t> BuildXnQos(const std::vector<std::optional<std::vector<uint8_t>>>& targets, uint16_t probes,
+                                uint32_t guest_base);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/session_marshal.h b/include/rex/kernel/xam/net/session_marshal.h
new file mode 100644
index 0000000..e09d4c2
--- /dev/null
+++ b/include/rex/kernel/xam/net/session_marshal.h
@@ -0,0 +1,34 @@
+// COGBox SDK patch 65: lobbies -> an XSessionSearch results buffer (guest memory, big endian).
+//
+// XSESSION_SEARCHRESULT_HEADER { dwSearchResults; pResults } (8), then the XSESSION_SEARCHRESULT array (92 each:
+// XSESSION_INFO 60, open public / private, filled public / private, cProperties, cContexts, pProperties, pContexts),
+// then each result's XUSER_PROPERTY (24: id +0, XUSER_DATA type +8, value +16) and XUSER_CONTEXT (8) arrays.
+// Every title sizes the buffer as 8 + 1326 per result (traces, 2026-11-05).
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <rex/kernel/xam/net/master_protocol.h>
+
+namespace rex::kernel::xam::net {
+
+constexpr uint32_t kSearchHeaderSize = 8;
+constexpr uint32_t kSearchResultSize = 92;
+constexpr uint32_t kUserPropertySize = 24;
+constexpr uint32_t kUserContextSize = 8;
+
+struct MarshalResult {
+  bool ok = false;        // false: nothing written, buffer too small
+  uint32_t written = 0;   // results written
+  uint32_t required = 0;  // bytes the results need
+};
+
+// buf is the host view of the buffer at guest address guest_base (pointers inside it are guest addresses).
+// Only int32 (property type 1) and int64 (type 2) properties are written, plus the host's name as
+// X_PROPERTY_GAMER_HOSTNAME (0x40008109, UTF-16 big endian), which Xbox LIVE's search added to every result and
+// Gears 2 needs (it drops a result whose host name is empty).
+MarshalResult MarshalSearchResults(const std::vector<LobbyInfo>& lobbies, uint32_t max_results, uint8_t* buf,
+                                   uint32_t buf_len, uint32_t guest_base);
+
+}  // namespace rex::kernel::xam::net
