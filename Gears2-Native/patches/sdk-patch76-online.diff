+// COGBox SDK patch 65: with LIVE emulation a search answers "no sessions" (XSESSION_SEARCHRESULT_HEADER
+// { dwSearchResults = 0; pResults = 0 }) instead of leaving the caller's buffer as it was.
+void XgiApp::WriteEmptySearchResults(uint32_t results_ptr, uint32_t results_size) {
+  if (!rex::kernel::xam::net::LiveEmulationOn() || !results_ptr || results_size < 8 ||
+      !memory_->LookupHeap(results_ptr) || !memory_->LookupHeap(results_ptr + 7)) {
+    return;
+  }
+  uint8_t* p = memory_->TranslateVirtual(results_ptr);
+  memory::store_and_swap<uint32_t>(p + 0, 0);
+  memory::store_and_swap<uint32_t>(p + 4, 0);
+}
+
+// COGBox SDK patch 65: the title's lobbies from the master server, in the caller's buffer. false = not online, or
+// the buffer is not mapped / too small (then the caller answers "no sessions").
+// COGBox SDK patch 65: with --cogbox_net_trace, the search's own properties / contexts (what it asks for).
+void XgiApp::TraceSearchQuery(uint32_t proc_index, uint32_t num_props, uint32_t props_ptr, uint32_t num_ctx,
+                              uint32_t ctx_ptr) {
+  if (!rex::kernel::xam::net::NetTraceOn()) {
+    return;
+  }
+  std::string text;
+  if (num_props <= 32 && memory_->LookupHeap(props_ptr) && memory_->LookupHeap(props_ptr + num_props * 24)) {
+    const uint8_t* p = memory_->TranslateVirtual(props_ptr);
+    for (uint32_t i = 0; i < num_props; ++i, p += 24) {
+      text += fmt::format(" P{:08X}={}", memory::load_and_swap<uint32_t>(p),
+                          int32_t(memory::load_and_swap<uint32_t>(p + 16)));
+    }
+  }
+  if (num_ctx <= 32 && memory_->LookupHeap(ctx_ptr) && memory_->LookupHeap(ctx_ptr + num_ctx * 8)) {
+    const uint8_t* c = memory_->TranslateVirtual(ctx_ptr);
+    for (uint32_t i = 0; i < num_ctx; ++i, c += 8) {
+      text += fmt::format(" C{:08X}={}", memory::load_and_swap<uint32_t>(c), memory::load_and_swap<uint32_t>(c + 4));
+    }
+  }
+  REXKRNL_INFO("cogbox_net_trace: XSessionSearch query {}:{}", proc_index, text);
+}
