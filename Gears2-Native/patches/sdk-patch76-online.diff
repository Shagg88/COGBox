+  InviteHooks hooks;
+  {
+    std::lock_guard<std::mutex> lock(g_hooks_mutex);
+    hooks = g_hooks;
+  }
+  const uint32_t running = hooks.running_title ? hooks.running_title() : 0;
+  if (!running || running != lobby.title_id) {
+    REXKRNL_WARN("cogbox_online: invite to {} is for title {:08X}, this game is {:08X}: ignored", room_code,
+                 lobby.title_id, running);
+    return false;
+  }
+  if (hooks.remember_host) {
+    hooks.remember_host(lobby.host_xuid, lobby.host_uuid);
+  }
+  PendingInvite p;
+  p.title_id = lobby.title_id;
+  p.inviter_xuid = lobby.host_xuid;
+  p.session_info = lobby.session_info;
+  p.from_game_invite = from_game_invite;
+  p.at = std::chrono::steady_clock::now();
+  p.lobby = lobby;
+  Invites::Get().Set(p);
+  if (hooks.broadcast) {
+    hooks.broadcast(kXnLiveInviteAccepted);
+    // again every 10 s until the game reads it or it expires (a newer invite takes over the announcing)
+    const auto at = p.at;
+    std::thread([hooks, at] {
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        const auto now = std::chrono::steady_clock::now();
+        if (!Invites::Get().NeedsAnnouncing(now) || !Invites::Get().IsCurrent(at)) return;
+        REXKRNL_INFO("cogbox_online: announcing the accepted invite again (not read yet)");
+        hooks.broadcast(kXnLiveInviteAccepted);
+      }
+    }).detach();
+  }
+  REXKRNL_INFO("cogbox_online: invite accepted for {} (host {:016X})", room_code, lobby.host_xuid);
+  return true;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/live_emulation.cpp b/src/kernel/xam/net/live_emulation.cpp
new file mode 100644
index 0000000..8868cea
--- /dev/null
+++ b/src/kernel/xam/net/live_emulation.cpp
@@ -0,0 +1,90 @@
+// COGBox SDK patch 65: LIVE emulation and the online trace.
+#include <rex/kernel/xam/net/live_emulation.h>
+
+#include <atomic>
+#include <cstdio>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/net/identity.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(net_live_emulation, false, "Network",
+                    "COGBox online play: a signed-in profile looks signed in to Xbox LIVE with the master server's "
+                    "online XUID, so the games' LIVE menus open. Needs a claimed identity.");
+REXCVAR_DEFINE_BOOL(cogbox_net_trace, false, "Network",
+                    "COGBox online play: log every XAM app message (with its buffer), sign-in, XUID and privilege "
+                    "query, as cogbox_net_trace: lines.");
+
+namespace rex::kernel::xam::net {
+
+namespace {
+std::atomic<uint64_t> g_emulation_xuid{0};
+}  // namespace
+
+void SetEmulationXuid(uint64_t xuid) {
+  g_emulation_xuid = xuid;
+}
+
+bool LiveEmulationOn() {
+  if (!REXCVAR_GET(net_live_emulation)) {
+    return false;
+  }
+  if (g_emulation_xuid != 0) {
+    return true;
+  }
+  static std::atomic<bool> warned{false};
+  if (!warned.exchange(true)) {
+    REXKRNL_WARN("cogbox_online: LIVE emulation is off this run: no online XUID at start-up (a new claim counts from "
+                 "the next start)");
+  }
+  return false;
+}
+
+uint32_t EmulatedSigninState(uint32_t real_state) {
+  return real_state != 0 && LiveEmulationOn() ? 2 : real_state;
+}
+
+uint64_t EmulatedOnlineXuid(uint64_t real_xuid) {
+  return LiveEmulationOn() ? g_emulation_xuid.load() : real_xuid;
+}
+
+uint32_t EmulatedPrivilege(uint32_t real_value) {
+  return LiveEmulationOn() ? 1 : real_value;
+}
+
+uint32_t EmulatedSigninInfoFlags(uint32_t real_flags) {
+  return LiveEmulationOn() ? (real_flags | 0x1u) : real_flags;
+}
+
+bool NetTraceOn() {
+  return REXCVAR_GET(cogbox_net_trace);
+}
+
+std::string HexDump(const uint8_t* data, size_t len, size_t max) {
+  std::string out;
+  const size_t n = len < max ? len : max;
+  out.reserve(n * 3 + 20);
+  char b[4];
+  for (size_t i = 0; i < n; ++i) {
+    std::snprintf(b, sizeof(b), i ? " %02X" : "%02X", data[i]);
+    out += b;
+  }
+  if (len > max) {
+    out += " ...(" + std::to_string(len) + " bytes)";
+  }
+  return out;
+}
+
+void TraceAppMessage(uint32_t app_id, uint32_t message, uint32_t buffer_ptr, uint32_t buffer_len,
+                     const uint8_t* buffer_before, size_t before_len, const uint8_t* buffer_after, uint32_t result) {
+  REXKRNL_INFO("cogbox_net_trace: app {:08X} msg {:08X} buf {:08X} len {} -> {:08X}", app_id, message, buffer_ptr,
+               buffer_len, result);
+  if (buffer_before && before_len) {
+    REXKRNL_INFO("cogbox_net_trace:   in  {}", HexDump(buffer_before, before_len, 512));
+  }
+  if (buffer_after && before_len) {
+    REXKRNL_INFO("cogbox_net_trace:   out {}", HexDump(buffer_after, before_len, 512));
+  }
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/master_client.cpp b/src/kernel/xam/net/master_client.cpp
new file mode 100644
index 0000000..a98d898
--- /dev/null
+++ b/src/kernel/xam/net/master_client.cpp
@@ -0,0 +1,330 @@
+// COGBox SDK patch 65: the master-server client over WinHTTP.
+#include <nlohmann/json.hpp>
+
+#include <rex/kernel/xam/net/master_client.h>
+
+#if defined(_WIN32)
+#include <windows.h>
+#include <winhttp.h>
+#endif
+
+#include <chrono>
+#include <thread>
+
+#include <rex/kernel/xam/net/identity.h>
+#include <rex/logging.h>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+constexpr int kTimeoutMs = 2000;
+
+#if defined(_WIN32)
+std::wstring Widen(const std::string& s) {
+  if (s.empty()) return {};
+  int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), nullptr, 0);
+  std::wstring w(size_t(n), L'\0');
+  MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), w.data(), n);
+  return w;
+}
+
+struct Handle {
+  HINTERNET h = nullptr;
+  explicit Handle(HINTERNET x = nullptr) : h(x) {}
+  ~Handle() {
+    if (h) WinHttpCloseHandle(h);
+  }
+  Handle(const Handle&) = delete;
+  Handle& operator=(const Handle&) = delete;
+  operator HINTERNET() const { return h; }
+};
+
+HINTERNET Session() {
+  static HINTERNET s = [] {
+    HINTERNET h = WinHttpOpen(L"COGBox-online/1", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME,
+                              WINHTTP_NO_PROXY_BYPASS, 0);
+    if (h) WinHttpSetTimeouts(h, kTimeoutMs, kTimeoutMs, kTimeoutMs, kTimeoutMs);
+    return h;
+  }();
+  return s;
+}
+#endif
+
+}  // namespace
+
+MasterClient& MasterClient::Get() {
+  static MasterClient* c = new MasterClient();  // never destroyed: the signaling thread outlives main
+  return *c;
+}
+
+bool MasterClient::Configure(const std::string& base_url) {
+#if defined(_WIN32)
+  std::wstring url = Widen(base_url);
+  URL_COMPONENTS uc{};
+  uc.dwStructSize = sizeof(uc);
+  wchar_t host[256] = {};
+  uc.lpszHostName = host;
+  uc.dwHostNameLength = 256;
+  if (url.empty() || !WinHttpCrackUrl(url.c_str(), DWORD(url.size()), 0, &uc) ||
+      (uc.nScheme != INTERNET_SCHEME_HTTPS && uc.nScheme != INTERNET_SCHEME_HTTP)) {
+    REXKRNL_WARN("cogbox_online: master server address '{}' is not http(s)://host[:port]", base_url);
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(mutex_);
+  host_ = host;
+  port_ = uc.nPort;
+  secure_ = uc.nScheme == INTERNET_SCHEME_HTTPS;
+  return true;
+#else
+  (void)base_url;
+  return false;
+#endif
+}
+
+bool MasterClient::Configured() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return !host_.empty();
+}
+
+MasterClient::Result MasterClient::Call(const std::string& method, const std::string& path, const std::string& body) {
+  if (!Configured()) return {};
+  const Response r = Request(Widen(method).c_str(), path, body, true);
+  return {r.status, r.body};
+}
+
+MasterClient::Response MasterClient::Request(const wchar_t* method, const std::string& path, const std::string& body,
+                                             bool with_auth) {
+  Response r;
+#if defined(_WIN32)
+  std::wstring host;
+  uint16_t port;
+  bool secure;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    host = host_;
+    port = port_;
+    secure = secure_;
+  }
+  if (host.empty() || !Session()) {
+    return r;
+  }
+  Handle conn(WinHttpConnect(Session(), host.c_str(), port, 0));
+  if (!conn) return r;
+  Handle req(WinHttpOpenRequest(conn, method, Widen(path).c_str(), nullptr, WINHTTP_NO_REFERER,
+                                WINHTTP_DEFAULT_ACCEPT_TYPES, secure ? WINHTTP_FLAG_SECURE : 0));
+  if (!req) return r;
+  // Only with a body: Fastify refuses an empty JSON body (a DELETE has none).
+  std::wstring headers = body.empty() ? L"" : L"Content-Type: application/json\r\n";
+  if (with_auth) {
+    const ClientIdentity id = GetClientIdentity();
+    headers += Widen("Authorization: COGBox " + id.uuid + ":" + id.token + "\r\n");
+  }
+  const BOOL sent = WinHttpSendRequest(req, headers.c_str(), DWORD(-1), body.empty() ? nullptr : (void*)body.data(),
+                                       DWORD(body.size()), DWORD(body.size()), 0);
+  if (!sent || !WinHttpReceiveResponse(req, nullptr)) {
+    return r;
+  }
+  DWORD status = 0, len = sizeof(status);
+  WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &status,
+                      &len, WINHTTP_NO_HEADER_INDEX);
+  r.status = int(status);
+  for (;;) {
+    DWORD avail = 0;
+    if (!WinHttpQueryDataAvailable(req, &avail) || !avail) break;
+    std::string chunk(avail, '\0');
+    DWORD got = 0;
+    if (!WinHttpReadData(req, chunk.data(), avail, &got) || !got) break;
+    r.body.append(chunk.data(), got);
+    if (r.body.size() > (1u << 20)) break;  // 1 MB is far more than any answer
+  }
+#else
+  (void)method; (void)path; (void)body; (void)with_auth;
+#endif
+  return r;
+}
+
+bool MasterClient::Rename(const std::filesystem::path& identity_dir, const std::string& name) {
+  const ClientIdentity id = GetClientIdentity();
+  Response r = Request(L"POST", "/api/v1/auth/rename", RenameRequestJson(name), true);
+  auto c = r.status == 200 ? ParseClaim(r.body) : std::nullopt;
+  if (!c) {
+    REXKRNL_WARN("cogbox_online: rename to {} failed (HTTP {})", name, r.status);
+    return false;
+  }
+  ApplyClaim(identity_dir, c->display_name, c->discriminator, c->xuid, id.token);
+  REXKRNL_INFO("cogbox_online: account renamed to {}#{} (the launcher's player name)", c->display_name, c->discriminator);
+  return true;
+}
+
+bool MasterClient::Claim(const std::filesystem::path& identity_dir, const std::string& gamertag) {
+  const ClientIdentity id = GetClientIdentity();
+  const std::string name = gamertag.empty() ? id.display_name : gamertag;
+  Response r = Request(L"POST", "/api/v1/auth/claim", ClaimRequestJson(id.uuid, id.token, name), false);
+  auto c = r.status == 200 ? ParseClaim(r.body) : std::nullopt;
+  if (!c) {
+    REXKRNL_WARN("cogbox_online: claim failed (HTTP {})", r.status);
+    return false;
+  }
+  // A re-claim answer carries no token: keep the one we have.
+  ApplyClaim(identity_dir, c->display_name, c->discriminator, c->xuid, c->token.empty() ? id.token : c->token);
+  REXKRNL_INFO("cogbox_online: signed in as {}#{} (online XUID {:016X})", c->display_name, c->discriminator, c->xuid);
+  return true;
+}
+
+std::optional<std::string> MasterClient::CreateLobby(const LobbyInfo& lobby, std::string* room_code) {
+  LobbyInfo withRegion = lobby;
+  withRegion.region = region_;
+  Response r = Request(L"POST", "/api/v1/lobbies", LobbyCreateJson(withRegion), true);
+  return r.status == 200 ? ParseLobbyCreated(r.body, room_code) : std::nullopt;
+}
+
+bool MasterClient::DeleteLobby(const std::string& lobby_id) {
+  return Request(L"DELETE", "/api/v1/lobbies/" + lobby_id, "", true).status == 200;
+}
+
+bool MasterClient::SetLobbyQos(const std::string& lobby_id, const std::vector<uint8_t>& qos_data) {
+  return Request(L"PATCH", "/api/v1/lobbies/" + lobby_id, LobbyQosJson(qos_data), true).status == 200;
+}
+
+bool MasterClient::UpdateLobbySettings(const std::string& lobby_id, const std::vector<IdValue>& properties,
+                                       const std::vector<IdValue>& contexts) {
+  return Request(L"PATCH", "/api/v1/lobbies/" + lobby_id, LobbySettingsJson(properties, contexts), true).status == 200;
+}
+
+bool MasterClient::SetLobbyPlayers(const std::string& lobby_id, uint32_t players) {
+  return Request(L"PATCH", "/api/v1/lobbies/" + lobby_id, "{\"current_players\":" + std::to_string(players) + "}", true).status == 200;
+}
+
+bool MasterClient::SetLobbyInviteOnly(const std::string& lobby_id, bool invite_only) {
+  return Request(L"PATCH", "/api/v1/lobbies/" + lobby_id, invite_only ? R"({"invite_only":true})" : R"({"invite_only":false})", true)
+             .status == 200;
+}
+
+std::optional<std::pair<int, int>> MasterClient::Population(uint32_t title_id) {
+  char path[64];
+  std::snprintf(path, sizeof(path), "/api/v1/population?title_id=%08X", title_id);
+  Response r = Request(L"GET", std::string(path) + "&region=" + region_, "", false);
+  if (r.status != 200) return std::nullopt;
+  const auto j = nlohmann::json::parse(r.body, nullptr, false);
+  if (!j.is_object() || !j.contains("worldwide") || !j.contains("region") || !j["worldwide"].is_number_integer() ||
+      !j["region"].is_number_integer()) {
+    return std::nullopt;
+  }
+  return std::make_pair(j["worldwide"].get<int>(), j["region"].get<int>());
+}
+
+std::vector<LobbyInfo> MasterClient::SearchLobbies(uint32_t title_id) {
+  Response r = Request(L"GET", LobbySearchPath(title_id, region_), "", false);
+  return r.status == 200 ? ParseLobbyList(r.body) : std::vector<LobbyInfo>{};
+}
+
+std::string MasterClient::FriendsJson() {
+  Response r = Request(L"GET", "/api/v1/friends", "", true);
+  return r.status == 200 ? r.body : std::string();
+}
+
+std::optional<LobbyInfo> MasterClient::LookupRoomCode(const std::string& room_code) {
+  // with auth: a friends-only lobby answers only its host's friends
+  Response r = Request(L"GET", "/api/v1/lobbies/lookup/" + room_code, "", true);
+  return r.status == 200 ? ParseLobbyLookup(r.body) : std::nullopt;
+}
+
+void MasterClient::StartSignaling(std::function<void(const std::string&)> on_message) {
+  bool expected = false;
+  if (ws_started_.compare_exchange_strong(expected, true)) {
+    std::thread([this, fn = std::move(on_message)] { SignalingLoop(fn); }).detach();
+  }
+}
+
+bool MasterClient::Send(const std::string& text) {
+#if defined(_WIN32)
+  std::lock_guard<std::mutex> lock(ws_send_mutex_);
+  if (!ws_handle_) {
+    return false;
+  }
+  return WinHttpWebSocketSend(static_cast<HINTERNET>(ws_handle_), WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE,
+                              (void*)text.data(), DWORD(text.size())) == NO_ERROR;
+#else
+  (void)text;
+  return false;
+#endif
+}
+
+void MasterClient::SignalingLoop(std::function<void(const std::string&)> on_message) {
+#if defined(_WIN32)
+  for (;;) {
+    std::wstring host;
+    uint16_t port;
+    bool secure;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      host = host_;
+      port = port_;
+      secure = secure_;
+    }
+    const ClientIdentity id = GetClientIdentity();
+    // Which game: wait (up to 30 s) for the game module so the first connection already names it.
+    uint32_t title_id = 0;
+    {
+      std::function<uint32_t()> source;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        source = title_source_;
+      }
+      for (int i = 0; source && i < 30 && !(title_id = source()); ++i) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+      }
+    }
+    if (!host.empty() && Session() && !id.token.empty()) {
+      Handle conn(WinHttpConnect(Session(), host.c_str(), port, 0));
+      const std::string path = SignalingPath(id.uuid, id.token, title_id, region_);
+      Handle req(conn ? WinHttpOpenRequest(conn, L"GET", Widen(path).c_str(), nullptr, WINHTTP_NO_REFERER,
+                                           WINHTTP_DEFAULT_ACCEPT_TYPES, secure ? WINHTTP_FLAG_SECURE : 0)
+                      : nullptr);
+      if (req && WinHttpSetOption(req, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, nullptr, 0) &&
+          WinHttpSendRequest(req, WINHTTP_NO_ADDITIONAL_HEADERS, 0, nullptr, 0, 0, 0) &&
+          WinHttpReceiveResponse(req, nullptr)) {
+        HINTERNET ws = WinHttpWebSocketCompleteUpgrade(req, 0);
+        if (ws) {
+          {
+            std::lock_guard<std::mutex> lock(ws_send_mutex_);
+            ws_handle_ = ws;
+          }
+          ws_connected_ = true;
+          REXKRNL_INFO("cogbox_online: signaling connected");
+          std::string message;
+          std::vector<char> buf(16 * 1024);
+          for (;;) {
+            DWORD got = 0;
+            WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+            if (WinHttpWebSocketReceive(ws, buf.data(), DWORD(buf.size()), &got, &type) != NO_ERROR ||
+                type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE) {
+              break;
+            }
+            message.append(buf.data(), got);
+            if (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE) {
+              on_message(message);
+              message.clear();
+            } else if (type != WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE || message.size() > (1u << 20)) {
+              message.clear();  // binary or oversized: not ours
+            }
+          }
+          ws_connected_ = false;
+          {
+            std::lock_guard<std::mutex> lock(ws_send_mutex_);
+            ws_handle_ = nullptr;
+          }
+          WinHttpCloseHandle(ws);
+          REXKRNL_INFO("cogbox_online: signaling closed; reconnecting in 5 s");
+        }
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::seconds(5));
+  }
+#else
+  (void)on_message;
+#endif
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/master_protocol.cpp b/src/kernel/xam/net/master_protocol.cpp
new file mode 100644
index 0000000..f047f13
--- /dev/null
+++ b/src/kernel/xam/net/master_protocol.cpp
@@ -0,0 +1,303 @@
+// COGBox SDK patch 65: the master server's JSON.
+#include <rex/kernel/xam/net/master_protocol.h>
+
+#include <cstdio>
+#include <cstdlib>
+
+#include <nlohmann/json.hpp>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+using nlohmann::json;
+
+std::string Str(const json& j, const char* key) {
+  auto it = j.find(key);
+  return it != j.end() && it->is_string() ? it->get<std::string>() : std::string();
+}
+
+// XUIDs travel as decimal strings (JSON numbers lose 64-bit precision).
+uint64_t U64(const json& j, const char* key) {
+  const std::string s = Str(j, key);
+  return s.empty() ? 0 : std::strtoull(s.c_str(), nullptr, 10);
+}
+
+std::string Hex(const uint8_t* d, size_t n) {
+  static const char* digits = "0123456789abcdef";
+  std::string out;
+  out.reserve(n * 2);
+  for (size_t i = 0; i < n; ++i) {
+    out += digits[d[i] >> 4];
+    out += digits[d[i] & 15];
+  }
+  return out;
+}
+
+bool FromHex(const std::string& s, uint8_t* out, size_t n) {
+  if (s.size() != n * 2) {
+    return false;
+  }
+  auto nib = [](char c) -> int {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+  };
+  for (size_t i = 0; i < n; ++i) {
+    const int hi = nib(s[2 * i]), lo = nib(s[2 * i + 1]);
+    if (hi < 0 || lo < 0) {
+      return false;
+    }
+    out[i] = uint8_t(hi << 4 | lo);
+  }
+  return true;
+}
+
+json IdValues(const std::vector<IdValue>& v) {
+  json a = json::array();
+  for (const auto& e : v) {
+    a.push_back({{"id", e.id}, {"value", e.value}});
+  }
+  return a;
+}
+
+std::vector<IdValue> ParseIdValues(const json& j, const char* key) {
+  std::vector<IdValue> out;
+  auto it = j.find(key);
+  if (it == j.end() || !it->is_array()) {
+    return out;
+  }
+  for (const auto& e : *it) {
+    if (e.is_object() && e.contains("id") && e["id"].is_number_integer() && e.contains("value") &&
+        e["value"].is_number()) {
+      out.push_back({e["id"].get<uint32_t>(), e["value"].get<int64_t>()});
+    }
+  }
+  return out;
+}
+
+std::optional<LobbyInfo> ParseLobbyObject(const json& j) {
+  if (!j.is_object()) {
+    return std::nullopt;
+  }
+  LobbyInfo l;
+  l.lobby_id = Str(j, "lobby_id");
+  l.host_uuid = Str(j, "host_uuid");
+  l.host_xuid = U64(j, "host_xuid");
+  l.host_name = Str(j, "host_name");
+  l.title_id = uint32_t(std::strtoul(Str(j, "title_id").c_str(), nullptr, 16));
+  l.room_code = Str(j, "room_code");
+  if (l.lobby_id.empty() || l.host_uuid.empty() || !l.host_xuid ||
+      !FromHex(Str(j, "session_info"), l.session_info.data(), l.session_info.size())) {
+    return std::nullopt;
+  }
+  if (auto r = Str(j, "region"); !r.empty()) l.region = r;
+  if (j.contains("is_public") && j["is_public"].is_boolean()) l.is_public = j["is_public"].get<bool>();
+  if (j.contains("max_players") && j["max_players"].is_number_unsigned()) l.max_players = j["max_players"];
+  if (j.contains("current_players") && j["current_players"].is_number_unsigned()) {
+    l.current_players = j["current_players"];
+  }
+  l.properties = ParseIdValues(j, "properties");
+  l.contexts = ParseIdValues(j, "contexts");
+  const std::string qos = Str(j, "qos_data");
+  if (!qos.empty() && qos.size() % 2 == 0 && qos.size() <= 2048) {
+    l.qos_data.resize(qos.size() / 2);
+    if (!FromHex(qos, l.qos_data.data(), l.qos_data.size())) {
+      l.qos_data.clear();
+    }
+  }
+  return l;
+}
+
+const char* KindName(Candidate::Kind k) {
+  return k == Candidate::Srflx ? "srflx" : k == Candidate::Upnp ? "upnp" : "host";
+}
