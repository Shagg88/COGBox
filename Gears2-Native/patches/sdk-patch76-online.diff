+
+std::string CandidatesJson(const CandidateMessage& m) {
+  char token[17];
+  std::snprintf(token, sizeof(token), "%016llx", static_cast<unsigned long long>(m.session_token));
+  json list = json::array();
+  for (const auto& c : m.candidates) {
+    char ip[INET_ADDRSTRLEN] = {};
+    inet_ntop(AF_INET, &c.addr.sin_addr, ip, sizeof(ip));
+    list.push_back({{"ip", ip}, {"port", ntohs(c.addr.sin_port)}, {"kind", KindName(c.kind)}});
+  }
+  json out{{"type", "candidates"},
+           {"session_token", token},
+           {"port", m.port},
+           {"candidates", list}};
+  if (m.peer_uuid.empty()) {
+    out["target_xuid"] = std::to_string(m.peer_xuid);  // another guest of the match: the server knows who that is
+  } else {
+    out["target_uuid"] = m.peer_uuid;
+  }
+  if (m.launch_id) {
+    char launch[17];
+    std::snprintf(launch, sizeof(launch), "%016llx", static_cast<unsigned long long>(m.launch_id));
+    out["launch_id"] = launch;
+  }
+  return out.dump();
+}
+
+std::optional<CandidateMessage> ParseCandidates(const std::string& message) {
+  json j = json::parse(message, nullptr, false);
+  if (!j.is_object() || Str(j, "type") != "candidates" || !j.contains("candidates") || !j["candidates"].is_array() ||
+      !j.contains("port") || !j["port"].is_number_unsigned()) {
+    return std::nullopt;
+  }
+  CandidateMessage m;
+  m.peer_uuid = Str(j, "from_uuid");
+  m.peer_xuid = U64(j, "from_xuid");
+  m.session_token = std::strtoull(Str(j, "session_token").c_str(), nullptr, 16);
+  m.launch_id = std::strtoull(Str(j, "launch_id").c_str(), nullptr, 16);
+  m.port = j["port"].get<uint16_t>();
+  for (const auto& c : j["candidates"]) {
+    if (!c.is_object() || !c.contains("port") || !c["port"].is_number_unsigned()) {
+      continue;
+    }
+    sockaddr_in a{};
+    a.sin_family = AF_INET;
+    if (inet_pton(AF_INET, Str(c, "ip").c_str(), &a.sin_addr) != 1) {
+      continue;
+    }
+    a.sin_port = htons(c["port"].get<uint16_t>());
+    const std::string kind = Str(c, "kind");
+    m.candidates.push_back({a, kind == "srflx" ? Candidate::Srflx : kind == "upnp" ? Candidate::Upnp : Candidate::Host});
+  }
+  if (m.peer_uuid.empty() || !m.peer_xuid || m.candidates.empty()) {
+    return std::nullopt;
+  }
+  return m;
+}
+
+std::string UrlEncode(const std::string& s) {
+  static const char* hex = "0123456789ABCDEF";
+  std::string out;
+  for (unsigned char c : s) {
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+        c == '.' || c == '~') {
+      out += char(c);
+    } else {
+      out += '%';
+      out += hex[c >> 4];
+      out += hex[c & 15];
+    }
+  }
+  return out;
+}
+
+std::string NormalizeRegion(const std::string& region) {
+  for (const char* r : {"oceania", "us-e", "us-w", "europe"}) {
+    if (region == r) return region;
+  }
+  return "global";
+}
+
+std::string LobbySearchPath(uint32_t title_id, const std::string& region) {
+  char path[64];
+  std::snprintf(path, sizeof(path), "/api/v1/lobbies?title_id=%08X", title_id);
+  return region == "global" ? std::string(path) : std::string(path) + "&region=" + region;
+}
+
+std::string SignalingPath(const std::string& uuid, const std::string& token, uint32_t title_id, const std::string& region) {
+  std::string path = "/ws/signal?uuid=" + UrlEncode(uuid) + "&token=" + UrlEncode(token) + "&role=game";
+  if (title_id) {
+    char t[16];
+    std::snprintf(t, sizeof(t), "%08X", title_id);
+    path += "&title_id=";
+    path += t;
+  }
+  if (region != "global") {
+    path += "&region=" + region;
+  }
+  return path;
+}
