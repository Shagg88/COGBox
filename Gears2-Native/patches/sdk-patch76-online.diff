+// COGBox SDK patch 65: online XNADDRs and their virtual IPs.
+#include <rex/kernel/xam/net/xnaddr_online.h>
+
+#include <atomic>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+#include <rex/kernel/xam/net/sockaddr.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+std::mutex g_mutex;
+std::map<uint32_t, std::array<uint8_t, kXnAddrSize>> g_xnaddr_by_vip;
+std::function<void(uint32_t, uint64_t, uint64_t)> g_new_peer;
+std::atomic<uint64_t> g_local_token{0};
+
+void PutBe64(uint8_t* p, uint64_t v) {
+  for (int i = 0; i < 8; ++i) {
+    p[i] = uint8_t(v >> (56 - 8 * i));
+  }
+}
+
+uint64_t GetBe64(const uint8_t* p) {
+  uint64_t v = 0;
+  for (int i = 0; i < 8; ++i) {
+    v = v << 8 | p[i];
+  }
+  return v;
+}
+
+}  // namespace
+
+void WriteOnlineMarker(uint8_t* ab_online, uint64_t xuid, uint64_t token) {
+  std::memcpy(ab_online, "CGB1", 4);
+  PutBe64(ab_online + 4, xuid);
+  PutBe64(ab_online + 12, token);
+}
+
+bool ReadOnlineMarker(const uint8_t* ab_online, uint64_t* xuid, uint64_t* token) {
+  if (std::memcmp(ab_online, "CGB1", 4) != 0) {
+    return false;
+  }
+  *xuid = GetBe64(ab_online + 4);
+  *token = GetBe64(ab_online + 12);
+  return *xuid != 0;
+}
+
+void SetLocalSessionToken(uint64_t token) { g_local_token = token; }
+uint64_t LocalSessionToken() { return g_local_token; }
+
+uint32_t XnAddrToVip(const uint8_t* xnaddr) {
+  uint64_t xuid = 0, token = 0;
+  if (!ReadOnlineMarker(xnaddr + kXnAddrOnlineOffset, &xuid, &token)) {
+    return 0;
+  }
+  // A new token may be a relaunched host, which knows nothing about us: offer again and let its launch id decide.
+  bool restarted = false, token_changed = false;
+  const uint32_t vip = VirtualPeerManager::Get().AddPeer(xuid, token, &restarted, VirtualPeerManager::Clock::now(), &token_changed);
+  if (!vip) {
+    return 0;
+  }
+  std::function<void(uint32_t, uint64_t, uint64_t)> announce;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto [it, added] = g_xnaddr_by_vip.try_emplace(vip);
+    std::memcpy(it->second.data(), xnaddr, kXnAddrSize);
+    if (added || restarted || token_changed) {
+      announce = g_new_peer;
+    }
+  }
+  if (announce) {
+    announce(vip, xuid, token);
+  }
+  return vip;
+}
+
+void RegisterPeerXnAddr(uint32_t vip, uint64_t xuid, uint64_t token, uint32_t ina_network_order) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto [it, added] = g_xnaddr_by_vip.try_emplace(vip);
+  if (!added) {
+    return;
+  }
+  it->second.fill(0);
+  std::memcpy(it->second.data(), &ina_network_order, 4);
+  const uint32_t ip = ntohl(ina_network_order);
+  const uint8_t mac[6] = {0x02, 0x00, uint8_t(ip >> 24), uint8_t(ip >> 16), uint8_t(ip >> 8), uint8_t(ip)};
+  std::memcpy(it->second.data() + 10, mac, 6);
+  WriteOnlineMarker(it->second.data() + kXnAddrOnlineOffset, xuid, token);
+}
+
+bool VipToXnAddr(uint32_t vip, uint8_t* xnaddr_out) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto it = g_xnaddr_by_vip.find(vip);
+  if (it == g_xnaddr_by_vip.end()) {
+    return false;
+  }
+  std::memcpy(xnaddr_out, it->second.data(), kXnAddrSize);
+  return true;
+}
+
+uint32_t ConnectStatus(uint32_t vip) {
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!g_xnaddr_by_vip.count(vip)) {
+      return kXNetConnectLost;
+    }
+  }
+  switch (VirtualPeerManager::Get().State(vip)) {
+    case PeerState::Connected:
+      return kXNetConnectConnected;
+    case PeerState::Pending:
+      return kXNetConnectPending;
+    default:
+      return kXNetConnectLost;
+  }
+}
+
+void SetNewPeerCallback(std::function<void(uint32_t, uint64_t, uint64_t)> fn) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_new_peer = std::move(fn);
+}
+
+}  // namespace rex::kernel::xam::net
