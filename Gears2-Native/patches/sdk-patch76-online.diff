+}
+// The offset of a class's property (walking the class and its supers), or -1.
+int Ue3PropertyOffset(uint32_t gnames, uint32_t cls, const char* property) {
+  for (uint32_t c = cls, guard = 0; c && guard < 32; ++guard) {
+    uint32_t child = 0;
+    GuestRead32(c + kUe3Children(), &child);
+    for (uint32_t g2 = 0; child && g2 < 4096; ++g2) {
+      uint32_t n = 0;
+      if (GuestRead32(child + 44, &n) && Ue3Name(gnames, n) == property) {
+        uint32_t off = 0;
+        return GuestRead32(child + kUe3PropOffset(), &off) ? int(off) : -1;
+      }
+      if (!GuestRead32(child + kUe3Next(), &child)) break;
+    }
+    if (!GuestRead32(c + kUe3Super(), &c)) break;
+  }
+  return -1;
+}
+// UE3 object helpers by name (property offsets from the class chain).
+uint32_t Ue3ObjectProperty(uint32_t gnames, uint32_t obj, const char* property) {
+  uint32_t cls = 0, v = 0;
+  if (!obj || !GuestRead32(obj + 52, &cls)) return 0;
+  const int off = Ue3PropertyOffset(gnames, cls, property);
+  return off >= 0 && GuestRead32(obj + uint32_t(off), &v) ? v : 0;
+}
+std::string Ue3ObjectName(uint32_t gnames, uint32_t obj) {
+  uint32_t n = 0;
+  return obj && GuestRead32(obj + 44, &n) ? Ue3Name(gnames, n) : std::string();
+}
+// A UE3 game's GNames and GEngine variables: the cogbox_ue3_gnames / cogbox_ue3_gengine values when set, otherwise
+// found once in the game image (0x82000000-0x84000000): GNames is the TArray<FNameEntry*> whose names 0 and 1 are
+// "None" and "ByteProperty"; GObjObjects the next TArray<UObject*> after it; GEngine the variable holding the one
+// GameEngine instance (not its Default__ object).
+// Calls fn(address, value) for every readable aligned word of [lo, hi), skipping unreadable regions whole (one
+// VirtualQuery per region, not per word); fn returns true to stop.
+template <typename Fn>
+void Ue3ScanWords(uint32_t lo, uint32_t hi, Fn fn) {
+  for (uint32_t a = lo; a < hi;) {
+    const uint8_t* h = REX_KERNEL_MEMORY()->TranslateVirtual(a);
+    MEMORY_BASIC_INFORMATION mbi;
+    if (!VirtualQuery(h, &mbi, sizeof(mbi))) return;
+    const uint8_t* end = static_cast<const uint8_t*>(mbi.BaseAddress) + mbi.RegionSize;
+    const uint32_t span = uint32_t(std::min<uintptr_t>(uintptr_t(end - h), uintptr_t(hi - a)));
+    const bool readable = mbi.State == MEM_COMMIT && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) && mbi.Protect;
+    if (readable) {
+      for (uint32_t k = 0; k + 4 <= span; k += 4) {
+        if (fn(a + k, rex::memory::load_and_swap<uint32_t>(h + k))) return;
+      }
+    }
+    if (span == 0) return;
+    a += span & ~3u;
+    if ((span & ~3u) == 0) return;
+  }
+}
+
+std::atomic<uint32_t> g_ue3_objects_var{0};   // COGBox trace
+bool Ue3Globals(uint32_t* gnames_out, uint32_t* gengine_out) {
+  static std::mutex m;
+  static std::chrono::steady_clock::time_point searched{};  // the last search (again after 2 s while incomplete: hooks wait for it)
+  static uint32_t gnames = 0, gengine = 0;
+  static uint32_t engine_obj = 0;               // the GameEngine object found (0 with the cvars)
+  static std::vector<uint32_t> engine_vars;     // the variables that held it when found
+  std::lock_guard<std::mutex> lock(m);
+  if (engine_obj && gengine) {  // the variable that still holds the engine (a temporary held it once too)
+    uint32_t v = 0;
+    if (!GuestRead32(gengine, &v) || v != engine_obj) {
+      gengine = 0;
+      for (uint32_t a : engine_vars) {
+        if (GuestRead32(a, &v) && v == engine_obj) { gengine = a; break; }
+      }
+      if (!gengine) engine_obj = 0;  // search again below
+    }
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if ((!(gnames && gengine) || !g_ue3_objects) && (searched == std::chrono::steady_clock::time_point{} || now - searched > std::chrono::seconds(2))) {
+    searched = now;
+    try {
+      if (!REXCVAR_GET(cogbox_ue3_gnames).empty()) gnames = uint32_t(std::stoul(REXCVAR_GET(cogbox_ue3_gnames), nullptr, 16));
+      if (!REXCVAR_GET(cogbox_ue3_gengine).empty()) gengine = uint32_t(std::stoul(REXCVAR_GET(cogbox_ue3_gengine), nullptr, 16));
+    } catch (...) {
+      gnames = gengine = 0;
+    }
+    const auto t0 = std::chrono::steady_clock::now();
+    if (!gnames) {
+      Ue3ScanWords(0x82000000u, 0x84000000u, [&](uint32_t a, uint32_t data) {
+        uint32_t count = 0, max = 0;
+        if (data < 0x10000 || !GuestRead32(a + 4, &count) || !GuestRead32(a + 8, &max)) return false;
+        if (count < 1000 || count > 2000000 || max < count) return false;
+        if (Ue3Name(a, 0) == "None" && Ue3Name(a, 1) == "ByteProperty") gnames = a;
+        return gnames != 0;
+      });
+    }
+    uint32_t objects = 0, ocount = 0;
+    for (uint32_t a = gnames + 12; gnames && !g_ue3_objects && a < gnames + 0x400; a += 4) {  // also with the launcher's addresses
+      uint32_t data = 0, count = 0, max = 0, first = 0;
+      if (!GuestRead32(a, &data) || !GuestRead32(a + 4, &count) || !GuestRead32(a + 8, &max)) continue;
+      if (count < 1000 || count > 4000000 || max < count || !GuestRead32(data, &first) || !first) continue;
+      int named = 0;  // GObjObjects: most of its first entries are objects whose class has a name
+      for (uint32_t k = 0; k < 64; ++k) {
+        uint32_t o = 0, cls = 0;
+        if (GuestRead32(data + 4 * k, &o) && o && GuestRead32(o + 52, &cls) && !Ue3ObjectName(gnames, o).empty() &&
+            !Ue3ObjectName(gnames, cls).empty()) {
+          ++named;
+        }
+      }
+      if (named < 48) continue;
+      REXKRNL_INFO("cogbox_online: UE3 GObjObjects at {:08X} (GNames + {:X}), {} objects", a, a - gnames, count);
+      g_ue3_objects = data;
+      g_ue3_objects_var = a;   // COGBox trace: the list grows and moves; read it fresh
+      g_ue3_ocount = count;
+      objects = data;
+      ocount = count;
+      break;
+    }
+    // the field shift: the GameEngine class's SuperField is the Engine class
+    for (uint32_t i = 0; objects && !gengine && i < ocount; ++i) {
+      uint32_t o = 0, cls = 0;
+      if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+      if (Ue3ObjectName(gnames, o) != "GameEngine" || Ue3ObjectName(gnames, cls) != "Class") continue;
+      {
+        std::string fields;
+        for (uint32_t k = 56; k <= 100; k += 4) {
+          uint32_t v = 0;
+          GuestRead32(o + k, &v);
+          fields += fmt::format(" +{}={:08X}{}", k, v, v ? "(" + Ue3ObjectName(gnames, v) + ")" : "");
+        }
+        REXKRNL_INFO("cogbox_online: UE3 class GameEngine {:08X}:{}", o, fields);
+      }
+      for (uint32_t off : {64u, 60u, 72u}) {
+        uint32_t super = 0;
+        if (GuestRead32(o + off, &super) && Ue3ObjectName(gnames, super) == "Engine") {
+          g_ue3_super = off;
+          break;
+        }
+      }
+      break;
+    }
+    if (objects && !gengine) {  // the engine classes there are (another game may name its engine class otherwise)
+      std::string engines;
+      for (uint32_t i = 0; i < ocount && engines.size() < 600; ++i) {
+        uint32_t o = 0, cls = 0;
+        if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+        const std::string cn = Ue3ObjectName(gnames, cls), on = Ue3ObjectName(gnames, o);
+        if (cn == "Class" && on.find("Engine") != std::string::npos) engines += " " + on;
+      }
+      REXKRNL_INFO("cogbox_online: UE3 engine classes:{}", engines);
+    }
+    uint32_t engine = 0;
+    for (uint32_t i = 0; objects && !gengine && !engine && i < ocount; ++i) {
+      uint32_t o = 0, cls = 0;
+      if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+      if (Ue3ObjectName(gnames, cls).find("Engine") == std::string::npos) continue;  // cheap filter first
+      const std::string n = Ue3ObjectName(gnames, o);
+      if (n.rfind("Default__", 0) == 0) continue;
+      for (uint32_t c = cls, g = 0; c && g < 8; ++g) {
+        if (Ue3ObjectName(gnames, c) == "GameEngine") { engine = o; break; }
+        if (!GuestRead32(c + kUe3Super(), &c)) break;
+      }
+    }
+    if (engine && !gengine) {  // every variable holding it: only GEngine keeps holding it (checked at each use)
+      engine_obj = engine;
+      engine_vars.clear();
+      Ue3ScanWords(0x82000000u, 0x84000000u, [&](uint32_t a, uint32_t v) {
+        if (v == engine) engine_vars.push_back(a);
+        return engine_vars.size() >= 64;
+      });
+      if (!engine_vars.empty()) gengine = engine_vars.front();
+    }
+    REXKRNL_INFO("cogbox_online: UE3 globals GNames {:08X} GEngine {:08X} super +{} ({} ms)", gnames, gengine, g_ue3_super.load(),
+                 std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count());
+  }
+  *gnames_out = gnames;
+  *gengine_out = gengine;
+  return gnames != 0;
+}
+// The game's current GameInfo (GEngine.GamePlayers[0].Actor.WorldInfo.Game), or 0.
+uint32_t Ue3CurrentGameByScan(uint32_t gnames) {
+  const uint32_t objects = g_ue3_objects, ocount = g_ue3_ocount;
+  for (uint32_t i = 0; objects && i < ocount; ++i) {
+    uint32_t o = 0, cls = 0;
+    if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+    bool game = false;
+    for (uint32_t c = cls, g = 0; c && g < 10 && !game; ++g) {
+      game = Ue3ObjectName(gnames, c) == "GameInfo";
+      if (!GuestRead32(c + kUe3Super(), &c)) break;
+    }
+    if (game && Ue3ObjectName(gnames, o).rfind("Default__", 0) != 0) return o;
+  }
+  return 0;
+}
+uint32_t Ue3CurrentGameByEngine(uint32_t gnames, uint32_t gengine_var) {
+  uint32_t engine = 0, players = 0, player = 0;
+  if (!GuestRead32(gengine_var, &engine) || !engine) return 0;
+  uint32_t cls = 0;
+  if (!GuestRead32(engine + 52, &cls)) return 0;
+  const int gp = Ue3PropertyOffset(gnames, cls, "GamePlayers");
+  if (gp < 0 || !GuestRead32(engine + uint32_t(gp), &players) || !players || !GuestRead32(players, &player)) return 0;
+  const uint32_t pc = Ue3ObjectProperty(gnames, player, "Actor");
+  const uint32_t wi = Ue3ObjectProperty(gnames, pc, "WorldInfo");
+  return Ue3ObjectProperty(gnames, wi, "Game");
+}
+// The current game: through GEngine (Gears 3, Judgment), else by scan (Gears 2's property layout differs).
+uint32_t Ue3CurrentGame(uint32_t gnames, uint32_t gengine_var) {
+  const uint32_t game = gengine_var ? Ue3CurrentGameByEngine(gnames, gengine_var) : 0;
+  return game ? game : Ue3CurrentGameByScan(gnames);
+}
+// GameViewportClient.ProgressMessage[0..1] (the error / progress text the game shows): GEngine -> GameViewport ->
+// ProgressMessage, by property name. A few hundred reads; no object scan.
+std::string Ue3ProgressMessage() {
+  uint32_t gnames = 0, gengine_var = 0;
+  try {
+    gnames = uint32_t(std::stoul(REXCVAR_GET(cogbox_ue3_gnames), nullptr, 16));
+    gengine_var = uint32_t(std::stoul(REXCVAR_GET(cogbox_ue3_gengine), nullptr, 16));
+  } catch (...) {
+    return {};
+  }
+  uint32_t engine = 0, engine_cls = 0, viewport = 0, viewport_cls = 0;
+  if (!GuestRead32(gengine_var, &engine) || !engine || !GuestRead32(engine + 52, &engine_cls)) {
+    return "(no GEngine)";
+  }
+  const int vp_off = Ue3PropertyOffset(gnames, engine_cls, "GameViewport");
+  if (vp_off < 0 || !GuestRead32(engine + uint32_t(vp_off), &viewport) || !viewport ||
+      !GuestRead32(viewport + 52, &viewport_cls)) {
+    return fmt::format("(no GameViewport: offset {})", vp_off);
+  }
+  const int pm_off = Ue3PropertyOffset(gnames, viewport_cls, "ProgressMessage");
+  if (pm_off < 0) {
+    return "(no ProgressMessage property)";
+  }
+  const uint32_t a = viewport + uint32_t(pm_off);
+  return "\"" + Ue3String(a) + "\" / \"" + Ue3String(a + 12) + "\"";
+}
