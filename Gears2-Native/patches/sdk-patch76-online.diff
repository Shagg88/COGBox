+static void HostBanThread() {
+  using namespace rex::kernel::xam::net;
+  uint32_t profile = 0;
+  uint8_t* code = nullptr;
+  HostBanRecord record;
+  bool loaded = false, lifted_told = false;
+  int64_t last_notice = 0;
+  auto script_ok = [&] {
+    return code && GuestReadable(code, 3) && code[0] == 0x04 && code[2] == 0x92 && (code[1] == 0x9A || code[1] == 0x27);
+  };
+  for (;; std::this_thread::sleep_for(std::chrono::seconds(5))) {
+    const auto file = HostBanFile(REX_KERNEL_STATE()->title_id());
+    uint32_t gnames = 0, gengine = 0;
+    if (file.empty() || !Ue3Globals(&gnames, &gengine) || !g_ue3_objects) continue;
+    if (!loaded) {
+      LoadHostBan(file, &record);
+      loaded = true;
+    }
+    std::optional<int> penalty;
+    if (profile) penalty = HostPenaltyOf(profile);
+    if (!penalty || !script_ok()) {
+      uint32_t objects = g_ue3_objects, ocount = g_ue3_ocount;
+      if (g_ue3_objects_var) {
+        GuestRead32(g_ue3_objects_var, &objects);
+        GuestRead32(g_ue3_objects_var + 4, &ocount);
+      }
+      for (uint32_t i = 0; i < ocount; ++i) {
+        if ((i & 4095) == 4095) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        uint32_t o = 0, cls = 0;
+        if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+        const std::string cls_name = Ue3ObjectName(gnames, cls);
+        if (cls_name == "GearProfileSettings" && !penalty) {
+          if (Ue3ObjectName(gnames, o).rfind("Default__", 0) == 0) continue;
+          penalty = HostPenaltyOf(o);
+          if (penalty) profile = o;
+        } else if (cls_name == "Function" && !script_ok() && Ue3ObjectName(gnames, o) == "IsOkayToHost") {
+          uint32_t outer = 0, data = 0, count = 0;
+          if (!GuestRead32(o + 40, &outer) || Ue3ObjectName(gnames, outer) != "GearProfileSettings") continue;
+          code = Ue3Script(o, &data, &count);
+        }
+      }
+    }
+    if (!penalty || !script_ok()) continue;
+    const int64_t now = std::time(nullptr);
+    const HostBanRecord before = record;
+    const HostBanStatus status = UpdateHostBan(record, *penalty, now);
+    if (record.penalty != before.penalty || record.since != before.since) {
+      SaveHostBan(file, record);
+      REXKRNL_INFO("cogbox_online: host penalty {} since {}", record.penalty, record.since);
+    }
+    code[1] = status.lifted ? 0x27 : 0x9A;   // EX_True, or the game's own check
+    if (status.lifted && !lifted_told) REXKRNL_INFO("cogbox_online: hosting ban lifted after 30 minutes");
+    lifted_told = status.lifted;
+    if (status.banned && now - g_host_search_at.load() <= 15 && now - last_notice >= 300) {
+      last_notice = now;
+      SetHostBanNotice(status.minutes_left);
+      REXKRNL_INFO("cogbox_online: told the player hosting is locked for {} minutes", status.minutes_left);
+    }
+  }
