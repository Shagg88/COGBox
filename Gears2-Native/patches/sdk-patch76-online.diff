+bool XgiApp::WriteOnlineSearchResults(uint32_t max_results, uint32_t results_ptr, uint32_t results_size) {
+  auto* sessions = rex::kernel::xam::net::ActiveOnlineSessions();
+  if (!sessions || !results_ptr || results_size < rex::kernel::xam::net::kSearchHeaderSize ||
+      !memory_->LookupHeap(results_ptr) || !memory_->LookupHeap(results_ptr + results_size - 1)) {
+    return false;
+  }
+  const auto lobbies =
+      sessions->Search(kernel_state_->title_id(), rex::kernel::xam::net::GetAuthoritativeOnlineXuid());
+  const auto r = rex::kernel::xam::net::MarshalSearchResults(lobbies, max_results,
+                                                             memory_->TranslateVirtual(results_ptr), results_size,
+                                                             results_ptr);
+  REXKRNL_INFO("cogbox_online: search found {} lobby(ies), {} written{}", lobbies.size(), r.written,
+               r.ok ? "" : " (buffer too small)");
+  if (rex::kernel::xam::net::NetTraceOn()) {
+    for (const auto& l : lobbies) {
+      std::string text;
+      for (const auto& p : l.properties) text += fmt::format(" P{:08X}={}", p.id, p.value);
+      for (const auto& c : l.contexts) text += fmt::format(" C{:08X}={}", c.id, c.value);
+      REXKRNL_INFO("cogbox_net_trace:   lobby {} slots {}/{} qos {} byte(s):{}", l.room_code, l.current_players,
+                   l.max_players, l.qos_data.size(), text);
+    }
+  }
+  return r.ok;
+}
