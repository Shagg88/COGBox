diff --git a/tests/unit/net/invites_test.cpp b/tests/unit/net/invites_test.cpp
new file mode 100644
index 0000000..acf7e3c
--- /dev/null
+++ b/tests/unit/net/invites_test.cpp
@@ -0,0 +1,158 @@
+// COGBox SDK patch 65 (social step 4): the accepted invite a game reads with XInviteGetAcceptedInfo.
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+
+#include <rex/kernel/xam/net/invites.h>
+
+using namespace rex::kernel::xam::net;
+using namespace std::chrono_literals;
+
+namespace {
+PendingInvite Make(uint32_t title, uint8_t seed, std::chrono::steady_clock::time_point at) {
+  PendingInvite p{};
+  p.title_id = title;
+  p.inviter_xuid = 0x0009000000000ABCull;
+  p.session_info.fill(seed);
+  p.from_game_invite = true;
+  p.at = at;
+  return p;
+}
+uint64_t Be64(const uint8_t* b) {
+  uint64_t v = 0;
+  for (int i = 0; i < 8; ++i) v = v << 8 | b[i];
+  return v;
+}
+uint32_t Be32(const uint8_t* b) { return uint32_t(b[0]) << 24 | uint32_t(b[1]) << 16 | uint32_t(b[2]) << 8 | b[3]; }
+}  // namespace
+
+TEST_CASE("Invites: XINVITE_INFO layout", "[net][invites]") {
+  const auto t0 = std::chrono::steady_clock::time_point{} + 1000s;
+  const auto info = EncodeInviteInfo(Make(0x4D5308AB, 0x5A, t0), 0x0009000000000123ull);
+  REQUIRE(info.size() == 84);
+  CHECK(Be64(&info[0]) == 0x0009000000000123ull);   // invitee
+  CHECK(Be64(&info[8]) == 0x0009000000000ABCull);   // inviter
+  CHECK(Be32(&info[16]) == 0x4D5308ABu);            // title
+  for (size_t i = 20; i < 80; ++i) CHECK(info[i] == 0x5A);  // XSESSION_INFO
+  CHECK(Be32(&info[80]) == 1u);                     // fFromGameInvite
+}
+
+TEST_CASE("Invites: pending invite per title, newest wins, expires after 2 minutes", "[net][invites]") {
+  const auto t0 = std::chrono::steady_clock::time_point{} + 1000s;
+  Invites inv;
+  inv.Set(Make(0x4D5308AB, 1, t0));
+  inv.Set(Make(0x4D5308AB, 2, t0));
+  REQUIRE(inv.Find(0x4D5308AB, t0 + 1s).has_value());
+  CHECK(inv.Find(0x4D5308AB, t0 + 1s)->session_info[0] == 2);
+  CHECK_FALSE(inv.Find(0x4D53082D, t0 + 1s).has_value());
+  CHECK_FALSE(inv.Find(0x4D5308AB, t0 + 121s).has_value());
+}
+
+TEST_CASE("Invites: a join event from the server", "[net][invites]") {
+  auto e = ParseJoinEvent(R"({"type":"join","room_code":"COG-6GPY","inviter_xuid":"2533274790395904","from_game_invite":true})");
+  REQUIRE(e.has_value());
+  CHECK(e->room_code == "COG-6GPY");
+  CHECK(e->inviter_xuid == 2533274790395904ull);
+  CHECK(e->from_game_invite);
+  CHECK_FALSE(ParseJoinEvent(R"({"type":"join"})").has_value());
+  CHECK_FALSE(ParseJoinEvent(R"({"type":"candidates","room_code":"COG-6GPY"})").has_value());
+  CHECK_FALSE(ParseJoinEvent("not json").has_value());
+}
+
+TEST_CASE("Invites: accepting checks the game and announces it", "[net][invites]") {
+  LobbyInfo lobby;
+  lobby.title_id = 0x4D5308AB;
+  lobby.session_info.fill(7);
+  lobby.host_xuid = 0x0009000000000ABCull;
+  lobby.host_uuid = "host-uuid";
+  int broadcasts = 0;
+  uint32_t notified = 0;
+  InviteHooks hooks;
+  hooks.running_title = [] { return 0x4D53082Du; };  // Gears 2 running: a Gears 3 lobby is refused
+  hooks.broadcast = [&](uint32_t id) { ++broadcasts; notified = id; };
+  hooks.remember_host = [](uint64_t, const std::string&) {};
+  SetInviteHooksForTest(hooks);
+  Invites::Get().Clear();
+  CHECK_FALSE(AcceptInvite(lobby, "COG-TEST", false));
+  CHECK(broadcasts == 0);
+  CHECK_FALSE(Invites::Get().Find(0x4D5308AB, std::chrono::steady_clock::now()).has_value());
+
+  std::string remembered;
+  hooks.running_title = [] { return 0x4D5308ABu; };
+  hooks.remember_host = [&](uint64_t, const std::string& uuid) { remembered = uuid; };
+  SetInviteHooksForTest(hooks);
+  CHECK(AcceptInvite(lobby, "COG-TEST", true));
+  CHECK(broadcasts == 1);
+  CHECK(notified == kXnLiveInviteAccepted);
+  CHECK(remembered == "host-uuid");
+  auto got = Invites::Get().Find(0x4D5308AB, std::chrono::steady_clock::now());
+  REQUIRE(got.has_value());
+  CHECK(got->inviter_xuid == 0x0009000000000ABCull);
+  CHECK(got->from_game_invite);
+  SetInviteHooksForTest({});
+  Invites::Get().Clear();
+}
+
+TEST_CASE("Invites: an invite is announced until the game reads it", "[net][invites]") {
+  const auto t0 = std::chrono::steady_clock::time_point{} + 1000s;
+  Invites inv;
+  CHECK_FALSE(inv.NeedsAnnouncing(t0));
+  inv.Set(Make(0x4D5308AB, 1, t0));
+  CHECK(inv.NeedsAnnouncing(t0 + 10s));
+  inv.MarkRead();
+  CHECK_FALSE(inv.NeedsAnnouncing(t0 + 20s));
+  CHECK(inv.Find(0x4D5308AB, t0 + 20s).has_value());  // still readable after it was read
+  inv.Set(Make(0x4D5308AB, 2, t0 + 30s));              // a new invite is announced again
+  CHECK(inv.NeedsAnnouncing(t0 + 31s));
+  CHECK_FALSE(inv.NeedsAnnouncing(t0 + 30s + 121s));   // expired
+}
+
+TEST_CASE("Invites: XInviteGetAcceptedInfo's record comes from the parameter block (Gears 3 TU6 sub_82B1EED8)",
+          "[net][invites]") {
+  // The game's XDK code packs the call's parameters (sub_82B1ED48): 16-byte entries {u32 type (4 = pointer), pad,
+  // u64 value}, the count at +512; entry 0 points to the user index, entry 1 to the XINVITE_INFO.
+  std::array<uint8_t, 516> block{};
+  auto put32 = [&](size_t at, uint32_t v) { for (int i = 3; i >= 0; --i, v >>= 8) block[at + i] = uint8_t(v); };
+  put32(0, 4);
+  put32(12, 0x7018F0E4);   // entry 0: &user index (low word of the u64 at +8)
+  put32(16, 4);
+  put32(28, 0x441DC000);   // entry 1: the record
+  put32(512, 2);
+  CHECK(InviteInfoAddress(block.data(), block.size()) == 0x441DC000u);
+  put32(512, 1);           // only one parameter: not this call's layout
+  CHECK(InviteInfoAddress(block.data(), block.size()) == 0u);
+  put32(512, 2);
+  put32(16, 1);            // entry 1 is not a pointer
+  CHECK(InviteInfoAddress(block.data(), block.size()) == 0u);
+}
+
+TEST_CASE("Invites: the invited lobby is found by its session id (XSessionSearchByID)", "[net][invites]") {
+  LobbyInfo lobby;
+  lobby.title_id = 0x4D5308AB;
+  lobby.room_code = "COG-HBTB";
+  for (size_t i = 0; i < 60; ++i) lobby.session_info[i] = uint8_t(i + 1);
+  InviteHooks hooks;
+  hooks.running_title = [] { return 0x4D5308ABu; };
+  SetInviteHooksForTest(hooks);
+  Invites::Get().Clear();
+  REQUIRE(AcceptInvite(lobby, "COG-HBTB", false));
+  std::array<uint8_t, 8> kid{1, 2, 3, 4, 5, 6, 7, 8};
+  auto found = Invites::Get().LobbyForSessionId(kid, std::chrono::steady_clock::now());
+  REQUIRE(found.has_value());
+  CHECK(found->room_code == "COG-HBTB");
+  kid[0] = 9;
+  CHECK_FALSE(Invites::Get().LobbyForSessionId(kid, std::chrono::steady_clock::now()).has_value());
+  SetInviteHooksForTest({});
+  Invites::Get().Clear();
+}
+
+TEST_CASE("Invites: XSessionSearchByID carries the session id itself (Gears 3 trace, 20-byte request)", "[net][invites]") {
+  // Trace: 00000000 | 0760C4F99F90952B | 00000536 | 441DCB70 = user, XNKID, results size, results.
+  const uint8_t req[20] = {0, 0, 0, 0, 0x07, 0x60, 0xC4, 0xF9, 0x9F, 0x90, 0x95, 0x2B, 0, 0, 5, 0x36, 0x44, 0x1D, 0xCB, 0x70};
+  auto r = ParseSearchByIdRequest(req, 20);
+  REQUIRE(r.has_value());
+  CHECK(r->xnkid == std::array<uint8_t, 8>{0x07, 0x60, 0xC4, 0xF9, 0x9F, 0x90, 0x95, 0x2B});
+  CHECK(r->results_size == 0x536u);
+  CHECK(r->results_ptr == 0x441DCB70u);
+  CHECK_FALSE(ParseSearchByIdRequest(req, 32).has_value());  // another layout: not guessed at
+}
diff --git a/tests/unit/net/live_emulation_test.cpp b/tests/unit/net/live_emulation_test.cpp
new file mode 100644
index 0000000..30245a8
--- /dev/null
+++ b/tests/unit/net/live_emulation_test.cpp
@@ -0,0 +1,85 @@
+// COGBox SDK patch 65: LIVE emulation answers (signin state, online XUID, privileges) and the trace hex dump.
+#include <catch2/catch_test_macros.hpp>
+
+#include <filesystem>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/net/identity.h>
+#include <rex/kernel/xam/net/live_emulation.h>
+
+REXCVAR_DECLARE(bool, net_live_emulation);
+
+namespace fs = std::filesystem;
+using namespace rex::kernel::xam::net;
+
+namespace {
+struct EmulationScope {
+  bool old;
+  explicit EmulationScope(bool on) : old(REXCVAR_GET(net_live_emulation)) { REXCVAR_SET(net_live_emulation, on); }
+  ~EmulationScope() { REXCVAR_SET(net_live_emulation, old); }
+};
+// The emulation uses the XUID taken at start-up (when the saves are re-signed), never a claim made later.
+void SetIdentityXuid(uint64_t xuid) { SetEmulationXuid(xuid); }
+}  // namespace
+
+TEST_CASE("LIVE emulation off: every answer is the real one", "[net][live]") {
+  EmulationScope off(false);
+  SetIdentityXuid(0x0009000000000ABCull);
+  CHECK_FALSE(LiveEmulationOn());
+  CHECK(EmulatedSigninState(1) == 1);
+  CHECK(EmulatedOnlineXuid(0x1234) == 0x1234);
+  CHECK(EmulatedPrivilege(0) == 0);
+}
+
+TEST_CASE("LIVE emulation on: signed in to LIVE, the server XUID, privileges granted", "[net][live]") {
+  EmulationScope on(true);
+  SetIdentityXuid(0x0009000000000ABCull);
+  CHECK(LiveEmulationOn());
+  CHECK(EmulatedSigninState(1) == 2);
+  CHECK(EmulatedSigninState(0) == 0);  // nobody signed in stays nobody
+  CHECK(EmulatedOnlineXuid(0) == 0x0009000000000ABCull);
+  CHECK(EmulatedPrivilege(0) == 1);
+}
+
+TEST_CASE("LIVE emulation on without a claimed XUID stays off", "[net][live]") {
+  EmulationScope on(true);
+  SetIdentityXuid(0);
+  CHECK_FALSE(LiveEmulationOn());
+  CHECK(EmulatedSigninState(1) == 1);
+  CHECK(EmulatedOnlineXuid(0) == 0);
+  CHECK(EmulatedPrivilege(0) == 0);
+}
+
+TEST_CASE("LIVE emulation marks the profile LIVE-enabled in its sign-in info flags", "[net][live]") {
+  {
+    EmulationScope off(false);
+    SetIdentityXuid(0x0009000000000ABCull);
+    CHECK(EmulatedSigninInfoFlags(0) == 0);
+  }
+  EmulationScope on(true);
+  SetIdentityXuid(0x0009000000000ABCull);
+  CHECK(EmulatedSigninInfoFlags(0) == 0x1);  // XUSER_INFO_FLAG_LIVE_ENABLED
+  CHECK(EmulatedSigninInfoFlags(0x2) == 0x3);  // a guest flag stays
+}
+
+TEST_CASE("LIVE emulation ignores a claim made after start-up", "[net][live]") {
+  EmulationScope on(true);
+  SetEmulationXuid(0);
+  fs::path dir = fs::path(COGBOX_NET_TEST_DIR) / "live_emulation_late";
+  fs::create_directories(dir);
+  REQUIRE(LoadOrCreateIdentity(dir, "Cole"));
+  REQUIRE(ApplyClaim(dir, "", "0002", 0x0009000000000DEFull, "t"));
+  CHECK_FALSE(LiveEmulationOn());
+  CHECK(EmulatedOnlineXuid(0) == 0);
+}
+
+TEST_CASE("Trace hex dump: bytes as hex, cut at the limit", "[net][live]") {
+  const uint8_t two[] = {0x01, 0xAB};
+  CHECK(HexDump(two, 2, 512) == "01 AB");
+  CHECK(HexDump(nullptr, 0, 512) == "");
+  std::vector<uint8_t> big(600, 0xFF);
+  std::string d = HexDump(big.data(), big.size(), 512);
+  CHECK(d.size() == 512 * 3 - 1 + std::string(" ...(600 bytes)").size());
+  CHECK(d.substr(d.size() - 15) == " ...(600 bytes)");
+}
