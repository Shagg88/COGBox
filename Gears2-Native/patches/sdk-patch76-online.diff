+namespace {
+// around Gears 3 TU6's call (dumped): context, skip 0x004F, then the call ending in EX_EndFunctionParms; the next statement is a Let
+std::vector<uint8_t> MenuScript(const char* id) {
+  std::vector<uint8_t> v(30, 0x16);
+  const size_t start = v.size();
+  const uint8_t head[] = {0x19, 0x00, 0, 0, 0, 0, 0x41, 0x00, 0x00, 0x10, 0x00, 0x4F, 0, 0, 0, 0, 0, 0, 0, 0, 0};
+  v.insert(v.end(), head, head + sizeof(head));
+  const size_t call = v.size();
+  const uint8_t name[] = {0x1B, 0, 0, 0x7F, 0xD0, 0, 0, 0, 0, 0x38, 0x44, 0x1F};
+  v.insert(v.end(), name, name + sizeof(name));
+  for (const char* p = id; *p; ++p) v.push_back(uint8_t(*p));
+  v.push_back(0);
+  v.resize(call + 0x4F, 0x16);
+  v.push_back(0x0F);
+  v.resize(v.size() + 20, 0x16);
+  v.push_back(0x53);
+  (void)start;
+  return v;
+}
+}  // namespace
