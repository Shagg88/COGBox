+namespace rex::kernel::xam::net {
+
+void OnlineSessions::OnSetContext(uint32_t user_index, uint32_t id, uint32_t value) {
+  if (user_index != 0) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = contexts_.find(id);
+    if (it != contexts_.end() && it->second == value) {
+      return;
+    }
+    contexts_[id] = value;
+  }
+  OnModify();  // a search filters on these: the lobby must not go stale (no-op with nothing hosted)
+}
+
+void OnlineSessions::OnSetProperty(uint32_t user_index, uint32_t id, int64_t value) {
+  if (user_index != 0) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = properties_.find(id);
+    if (it != properties_.end() && it->second == value) {
+      return;
+    }
+    properties_[id] = value;
+  }
+  OnModify();
+}
+
+void OnlineSessions::OnCreate(uint32_t title_id, uint32_t flags, uint32_t public_slots, uint32_t private_slots,
+                              const std::array<uint8_t, 60>& session_info, uint64_t nonce, uint32_t handle) {
+  // Hosted sessions only. A party joinable by friends (join via presence friends-only, Gears 3 / Judgment "Joinable
+  // Friends") is listed for the host's friends: Join friend and invites put them in the party, as on a 360, and a
+  // private match or co-op started from it needs no lobby of its own (its friends come through the party). Public
+  // matchmaking with public slots is listed for everyone; any other hosted session (private match, co-op without such
+  // a party) for the host's friends only, with all its slots. A party with join via presence disabled is not listed.
+  REXKRNL_INFO("cogbox_online: session create flags {:08X} public slots {} private slots {} (xnkid {:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X})",
+               flags, public_slots, private_slots, session_info[0], session_info[1], session_info[2], session_info[3],
+               session_info[4], session_info[5], session_info[6], session_info[7]);
+  if (!(flags & kXSessionCreateHost)) {
+    return;
+  }
+  // a party: joinable by friends (Gears 3 / Judgment), or with join via presence disabled (Gears 2, whose friends
+  // came in through invites, which Join friend is to the game)
+  // or a matchmaking session without stats: Gears 3 / Judgment's "Joinable Public" party (0x2B). Every game's real
+  // match keeps stats (0x2D, 0x2F, 0x43D), so a party never reaches a match search.
+  const bool party = (flags & (kXSessionCreateJoinViaPresenceFriendsOnly | kXSessionCreateJoinViaPresenceDisabled)) != 0 ||
+                     ((flags & kXSessionCreateUsesMatchmaking) && !(flags & kXSessionCreateUsesStats));
+  if (handle) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    nonce_by_handle_[handle] = nonce;
+  }
+  if (!party && public_slots == 0 && private_slots > 0) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    private_match_ = nonce;
+  }
+  const bool is_public = !party && (flags & kXSessionCreateUsesMatchmaking) && public_slots > 0;
+  if (!is_public && !party) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (friends_party_) {
+      return;  // the party's lobby already brings friends in
+    }
+  }
+  const uint32_t slots = is_public ? public_slots : public_slots + private_slots;
+  if (slots == 0) {
+    return;
+  }
+  LobbyInfo l;
+  l.is_public = is_public;
+  l.title_id = title_id;
+  l.session_info = session_info;
+  l.max_players = slots;
+  l.current_players = 1;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (party) {
+      friends_party_ = nonce;
+    }
+    CurrentSettingsLocked(&l.properties, &l.contexts);
+    Hosted h;
+    std::copy_n(l.session_info.begin(), 8, h.xnkid.begin());
+    h.invite_only = party && !(flags & kXSessionCreateUsesStats) && (flags & kXSessionCreateJoinViaPresenceDisabled);
+    if (l.is_public && tcp_seen_ && !beacon_listening_) {   // friends-only lobbies are joined by invite / Join: no hold
+      h.held = l;
+      hosted_[nonce] = h;
+      newest_nonce_ = nonce;
+      REXKRNL_INFO("cogbox_online: lobby held until the game's join beacon (TCP {}) listens", kBeaconPort);
+      return;
+    }
+    hosted_[nonce] = h;
+    newest_nonce_ = nonce;
+  }
+  Publish(std::move(l), nonce);
+}
+
+void OnlineSessions::OnTcpListen(uint16_t port) {
+  std::vector<std::pair<uint64_t, LobbyInfo>> ready;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    tcp_seen_ = true;
+    if (port != kBeaconPort && port != kRankedBeaconPort) {
+      return;
+    }
+    beacon_listening_ = true;
+    for (auto& [nonce, h] : hosted_) {
+      if (h.held) {
+        LobbyInfo l = std::move(*h.held);
+        h.held.reset();
+        CurrentSettingsLocked(&l.properties, &l.contexts);  // the settings as they are now
+        h.settings_dirty = false;
+        ready.push_back({nonce, std::move(l)});
+      }
+    }
+  }
+  for (auto& [nonce, l] : ready) {
+    Publish(std::move(l), nonce);
+  }
+}
+
+void OnlineSessions::Publish(LobbyInfo l, uint64_t nonce) {
+  run_([this, l, nonce] {
+    std::string room;
+    auto id = backend_.CreateLobby(l, &room);
+    bool delete_now = false;
+    std::optional<std::vector<uint8_t>> qos;
+    bool settings = false, invite_only = false;
+    uint32_t players = 1;
+    std::vector<IdValue> props, ctxs;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      auto it = hosted_.find(nonce);
+      if (it == hosted_.end()) {
+        delete_now = id.has_value();  // deleted before the server answered
+      } else {
+        it->second.lobby_id = id;
+        it->second.room_code = room;
+        qos = std::move(it->second.qos);
+        it->second.qos.reset();
+        invite_only = it->second.invite_only;
+        players = uint32_t(it->second.members.size()) + 1;
+        settings = it->second.settings_dirty;
+        it->second.settings_dirty = false;
+        if (settings) {
+          CurrentSettingsLocked(&props, &ctxs);
+        }
+      }
+    }
+    if (id && qos) {
+      backend_.SetLobbyQos(*id, *qos);
+    }
+    if (id && settings) {
+      backend_.UpdateLobbySettings(*id, props, ctxs);
+    }
+    if (id && players > 1) {
+      backend_.SetLobbyPlayers(*id, players);
+    }
+    if (id && invite_only) {
+      backend_.SetLobbyInviteOnly(*id, true);
+    }
+    if (delete_now) {
+      backend_.DeleteLobby(*id);
+    }
+    if (id) {
+      REXKRNL_INFO("cogbox_online: hosting lobby {} (room code {})", *id, room);
+    } else {
+      REXKRNL_WARN("cogbox_online: the master server did not take the lobby");
+    }
+  });
+}
+
+bool OnlineSessions::HostingPrivateMatch() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return private_match_.has_value();
+}
+
+void OnlineSessions::OnDelete(uint64_t nonce, uint32_t handle) {
+  std::optional<std::string> id;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (handle) {
+      auto known = nonce_by_handle_.find(handle);
+      if (known != nonce_by_handle_.end()) {
+        if (!nonce) nonce = known->second;
+        nonce_by_handle_.erase(known);
+      }
+    }
+    if (!nonce) {
+      return;
+    }
+    if (friends_party_ && *friends_party_ == nonce) {
+      friends_party_.reset();
+    }
+    if (private_match_ && *private_match_ == nonce) {
+      private_match_.reset();
+    }
+    auto it = hosted_.find(nonce);
+    if (it == hosted_.end()) {
+      return;
+    }
+    id = it->second.lobby_id;
+    hosted_.erase(it);
+    if (newest_nonce_ == nonce) {
+      newest_nonce_ = 0;
+    }
+  }
+  if (id) {
+    run_([this, id] { backend_.DeleteLobby(*id); });
+  }
+}
+
+void OnlineSessions::OnSessionFlags(uint32_t handle, uint32_t flags) {
+  // Only a host's party without stats: Gears 2's normal party also has 0x200 (with stats), and the game sets 0x100 with
+  // it for a moment while a party starts, which is not the player's choice.
+  if (!(flags & kXSessionCreateHost) || (flags & kXSessionCreateUsesStats) ||
+      (flags & kXSessionCreateJoinInProgressDisabled)) {
+    return;
+  }
+  const bool invite_only = (flags & kXSessionCreateJoinViaPresenceDisabled) != 0;
+  std::optional<std::string> id;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto known = nonce_by_handle_.find(handle);
+    if (known == nonce_by_handle_.end()) {
+      return;
+    }
+    auto it = hosted_.find(known->second);
+    if (it == hosted_.end() || it->second.invite_only == invite_only) {
+      return;
+    }
+    it->second.invite_only = invite_only;
+    id = it->second.lobby_id;
+  }
+  if (id) {
+    run_([this, id, invite_only] { backend_.SetLobbyInviteOnly(*id, invite_only); });
+  }
+}
+
+void OnlineSessions::MembersChanged(uint32_t handle, const std::vector<uint64_t>& xuids, bool joined) {
+  std::optional<std::string> id;
+  uint32_t players = 0;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto known = nonce_by_handle_.find(handle);
+    if (known == nonce_by_handle_.end()) {
+      return;
+    }
+    auto it = hosted_.find(known->second);
+    if (it == hosted_.end()) {
+      return;
+    }
+    Hosted& h = it->second;
+    const size_t before = h.members.size();
+    for (uint64_t xuid : xuids) {
+      if (joined) h.members.insert(xuid); else h.members.erase(xuid);
+    }
+    if (h.members.size() == before) {
+      return;
+    }
+    id = h.lobby_id;
+    players = uint32_t(h.members.size()) + 1;
+  }
+  if (id) {
+    run_([this, id, players] { backend_.SetLobbyPlayers(*id, players); });
+  }
+}
+
+void OnlineSessions::OnMembersJoined(uint32_t handle, const std::vector<uint64_t>& xuids) { MembersChanged(handle, xuids, true); }
+void OnlineSessions::OnMembersLeft(uint32_t handle, const std::vector<uint64_t>& xuids) { MembersChanged(handle, xuids, false); }
+
+std::vector<LobbyInfo> OnlineSessions::Search(uint32_t title_id, uint64_t own_xuid) {
+  std::vector<LobbyInfo> out;
+  std::map<std::array<uint8_t, 8>, std::vector<uint8_t>> qos;
+  for (auto& l : backend_.SearchLobbies(title_id)) {
+    if (l.host_xuid == own_xuid) {
+      continue;
+    }
+    remember_(l.host_xuid, l.host_uuid);
+    std::array<uint8_t, 8> kid;
+    std::copy_n(l.session_info.begin(), 8, kid.begin());
+    qos[kid] = l.qos_data;
+    out.push_back(std::move(l));
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    searched_qos_ = std::move(qos);
+  }
+  return out;
+}
+
+void OnlineSessions::AddFound(const LobbyInfo& lobby) {
+  remember_(lobby.host_xuid, lobby.host_uuid);
+  std::array<uint8_t, 8> kid;
+  std::copy_n(lobby.session_info.begin(), 8, kid.begin());
+  std::lock_guard<std::mutex> lock(mutex_);
+  searched_qos_[kid] = lobby.qos_data;
+}
+
+void OnlineSessions::CurrentSettingsLocked(std::vector<IdValue>* properties, std::vector<IdValue>* contexts) const {
+  for (const auto& [id, v] : contexts_) contexts->push_back({id, int64_t(v)});
+  for (const auto& [id, v] : properties_) properties->push_back({id, v});
+}
+
+void OnlineSessions::OnModify() {
+  std::vector<std::string> ids;
+  std::vector<IdValue> props, ctxs;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& [nonce, h] : hosted_) {
+      if (h.lobby_id) {
+        ids.push_back(*h.lobby_id);
+      } else {
+        h.settings_dirty = true;  // sent with the server's answer
+      }
+    }
+    CurrentSettingsLocked(&props, &ctxs);
+  }
+  for (const auto& id : ids) {
+    run_([this, id, props, ctxs] { backend_.UpdateLobbySettings(id, props, ctxs); });
+  }
+}
+
+void OnlineSessions::SendQos(const std::string& lobby_id, std::vector<uint8_t> data) {
+  run_([this, lobby_id, data = std::move(data)] { backend_.SetLobbyQos(lobby_id, data); });
+}
+
+void OnlineSessions::OnQosListen(const std::array<uint8_t, 8>& xnkid, const std::vector<uint8_t>& data) {
+  std::optional<std::string> id;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& [nonce, h] : hosted_) {
+      if (h.xnkid != xnkid) {
+        continue;
+      }
+      if (!h.lobby_id) {
+        h.qos = data;  // goes out with the server's answer
+        return;
+      }
+      id = h.lobby_id;
+      break;
+    }
+  }
+  if (id) {
+    SendQos(*id, data);
+  }
+}
+
+std::optional<std::vector<uint8_t>> OnlineSessions::QosFor(const std::array<uint8_t, 8>& xnkid) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = searched_qos_.find(xnkid);
+  if (it == searched_qos_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+std::string OnlineSessions::RoomCode() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto it = hosted_.find(newest_nonce_);
+  return it == hosted_.end() ? std::string() : it->second.room_code;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/online_signaling.cpp b/src/kernel/xam/net/online_signaling.cpp
new file mode 100644
index 0000000..2a06a4c
--- /dev/null
+++ b/src/kernel/xam/net/online_signaling.cpp
@@ -0,0 +1,148 @@
+// COGBox SDK patch 65: who sends candidates to whom.
+#include <rex/kernel/xam/net/online_signaling.h>
+
+#include <rex/logging.h>
+
+#include <vector>
+
+
+namespace rex::kernel::xam::net {
+
+void OnlineSignaling::RememberHost(uint64_t xuid, const std::string& uuid) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  uuid_by_xuid_[xuid] = uuid;
+}
+
+size_t OnlineSignaling::SendOurs(const std::string& uuid, uint64_t xuid, uint64_t token) {
+  size_t sent = 0;
+  for (const auto& [port, candidates] : mgr_.AllLocalCandidates()) {
+    if (candidates.empty()) {
+      continue;
+    }
+    CandidateMessage m;
+    m.peer_uuid = uuid;
+    m.peer_xuid = xuid;
+    m.session_token = token;
+    m.launch_id = launch_id_;
+    m.port = port;
+    m.candidates = candidates;
+    send_(m);
+    ++sent;
+  }
+  return sent;
+}
+
+void OnlineSignaling::OnNewPeer(uint32_t, uint64_t xuid, uint64_t token) {
+  std::string uuid;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // no uuid: another guest of the match, which the server finds by XUID
+    auto it = uuid_by_xuid_.find(xuid);
+    auto offered = offered_token_.find(xuid);
+    if (offered_.count(xuid) && offered != offered_token_.end() && offered->second == token) {
+      return;  // already offered to this session of theirs
+    }
+    if (it != uuid_by_xuid_.end()) uuid = it->second;
+  }
+  if (SendOurs(uuid, xuid, token)) {
+    REXKRNL_INFO("cogbox_online: offered our candidates to {:016X}", xuid);
+    std::lock_guard<std::mutex> lock(mutex_);
+    offered_.insert(xuid);
+    offered_token_[xuid] = token;
+    pending_.erase(xuid);
+  } else {
+    REXKRNL_INFO("cogbox_online: offer to {:016X} waits for the game's socket", xuid);
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending_[xuid] = token;
+  }
+}
+
+void OnlineSignaling::RetryPendingOffers() {
+  std::map<uint64_t, uint64_t> pending;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending = pending_;
+  }
+  for (const auto& [xuid, token] : pending) {
+    OnNewPeer(0, xuid, token);
+  }
+}
+
+void OnlineSignaling::OfferPort(uint16_t port) {
+  struct To { std::string uuid; uint64_t xuid; uint64_t token; };
+  std::vector<To> to;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (const auto& [xuid, token] : offered_token_) {
+      auto it = uuid_by_xuid_.find(xuid);
+      to.push_back({it != uuid_by_xuid_.end() ? it->second : std::string(), xuid, token});
+    }
+  }
+  if (to.empty()) {
+    return;
+  }
+  const auto candidates = mgr_.LocalCandidates(port);
+  if (candidates.empty()) {
+    return;
+  }
+  for (const To& t : to) {
+    CandidateMessage m;
+    m.peer_uuid = t.uuid;
+    m.peer_xuid = t.xuid;
+    m.session_token = t.token;
+    m.launch_id = launch_id_;
+    m.port = port;
+    m.candidates = candidates;
+    send_(m);
+  }
+  REXKRNL_INFO("cogbox_online: offered game port {} to {} peer(s)", port, to.size());
+}
+
+void OnlineSignaling::OnCandidates(const CandidateMessage& in, VirtualPeerManager::Clock::time_point now) {
+  bool restarted = false;
+  const uint32_t vip = mgr_.AddPeer(in.peer_xuid, in.session_token, &restarted, now);
+  if (!vip) {
+    return;
+  }
+  // The peer's own word first; going by silence only for a peer whose build or server sends no launch id.
+  bool relaunched = false;
+  if (in.launch_id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto [it, first] = launch_by_xuid_.try_emplace(in.peer_xuid, in.launch_id);
+    relaunched = !first && it->second != in.launch_id;
+    it->second = in.launch_id;
+  }
+  if (relaunched) {
+    mgr_.ResetPeer(vip);
+  }
+  restarted = relaunched || mgr_.ResetIfSilent(vip, now) || restarted;
+  bool answer = false;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (restarted) {
+      offered_.erase(in.peer_xuid);
+      offered_token_.erase(in.peer_xuid);
+    }
+    uuid_by_xuid_[in.peer_xuid] = in.peer_uuid;
+    answer = !offered_.count(in.peer_xuid);  // a guest we never offered to: this was its offer
+  }
+  // The host never saw this guest's XNADDR; give the game one for XNetInAddrToXnAddr.
+  if (register_xnaddr_) {
+    register_xnaddr_(vip, in.peer_xuid, in.session_token, in.candidates.front().addr.sin_addr.s_addr);
+  }
+  mgr_.SetRemoteCandidates(vip, in.port, in.candidates, now);
+  REXKRNL_INFO("cogbox_online: candidates from {:016X} (game port {}){}", in.peer_xuid, in.port,
+               answer ? ", answering" : "");
+  if (answer) {
+    if (SendOurs(in.peer_uuid, in.peer_xuid, in.session_token)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      offered_.insert(in.peer_xuid);
+      offered_token_[in.peer_xuid] = in.session_token;
+    } else {
+      std::lock_guard<std::mutex> lock(mutex_);
+      pending_[in.peer_xuid] = in.session_token;
+    }
+  }
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/online_startup.cpp b/src/kernel/xam/net/online_startup.cpp
new file mode 100644
index 0000000..eeabb5f
--- /dev/null
+++ b/src/kernel/xam/net/online_startup.cpp
@@ -0,0 +1,210 @@
+// COGBox SDK patch 65: online play at start-up.
+#include <atomic>
+#include <cstdlib>
+#include <rex/kernel/xam/net/host_ban.h>
+#include <rex/kernel/xam/net/online_startup.h>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/net/identity.h>
+#include <rex/kernel/xam/net/invites.h>
+#include <rex/kernel/xam/net/live_emulation.h>
+#include <rex/kernel/xam/net/master_client.h>
+#include <rex/kernel/xam/net/online_sessions.h>
+#include <rex/kernel/xam/net/online_signaling.h>
+
+#include <random>
+#include <thread>
+#include <rex/kernel/xam/net/xnaddr_online.h>
+#include <rex/kernel/xam/net/socket_hooks.h>
+#include <rex/kernel/xam/net/stream_tunnel.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/user_module.h>
+#include <rex/logging.h>
+#include <rex/system/cogbox_save_sign.h>
+
+REXCVAR_DECLARE(bool, net_live_emulation);
+REXCVAR_DEFINE_STRING(net_join_lobby, "", "Network",
+                      "COGBox online play: join this lobby (room code COG-XXXX) once the game is at its menus - "
+                      "the game is told it accepted an invite to it.");
+REXCVAR_DEFINE_STRING(net_region, "", "Network",
+                      "COGBox online play: matchmaking region (oceania, us-e, us-w, europe). Empty = Any region.");
+REXCVAR_DEFINE_STRING(net_identity_dir, "", "Network",
+                      "COGBox online play: the profile folder holding identity.json, shared by all games of a profile. "
+                      "Empty = <user_data_root>\cogbox-online.");
+REXCVAR_DEFINE_STRING(net_master_server, "", "Network",
+                      "COGBox online play: master server as https://host[:port]. Empty = no online play.");
+
+REXCVAR_DECLARE(std::string, user_gamertag);  // xam_user.cpp: the launcher's player name
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+OnlineSignaling& Signaling() {
+  static OnlineSignaling* s = new OnlineSignaling(
+      VirtualPeerManager::Get(), [](const CandidateMessage& m) { MasterClient::Get().Send(CandidatesJson(m)); },
+      RegisterPeerXnAddr);
+  return *s;
+}
+
+// The running game's title id from any thread (the process-wide kernel state; 0 until the game module is loaded).
+uint32_t RunningTitle() {
+  rex::system::KernelState* ks = rex::system::kernel_state();
+  if (!ks || !ks->GetExecutableModule()) return 0u;
+  return ks->title_id();
+}
+
+// Join a lobby by room code (off the caller's thread: it waits for the server).
+void JoinByRoomCode(const std::string& room_code, bool from_game_invite) {
+  std::thread([room_code, from_game_invite] {
+    auto lobby = MasterClient::Get().LookupRoomCode(room_code);
+    if (!lobby) {
+      REXKRNL_WARN("cogbox_online: no lobby {} to join (closed?)", room_code);
+      return;
+    }
+    AcceptInvite(*lobby, room_code, from_game_invite);
+  }).detach();
+}
+
+// Set when the process exits: the background threads (invite re-announcing, Join, --net_join_lobby) stop touching
+// the kernel, which may already be gone.
+std::atomic<bool> g_exiting{false};
+
+// Claim, then signaling: candidates from others go to the punching, new peers the game resolves get our offer.
+void StartOnlineServices(const std::filesystem::path& dir) {
+  if (!NetOnline() || REXCVAR_GET(net_master_server).empty()) {
+    return;
+  }
+  std::atexit([] { g_exiting = true; });
+  auto& mc = MasterClient::Get();
+  if (!mc.Configure(REXCVAR_GET(net_master_server)) || !mc.Claim(dir, "")) {
+    return;
+  }
+  // The launcher's player name (--user_gamertag) is the account's name: a rename when they differ.
+  const std::string launcher_name = NormalizeGamertag(std::string(REXCVAR_GET(user_gamertag)));
+  if (!launcher_name.empty() && launcher_name != GetClientIdentity().display_name) {
+    mc.Rename(dir, launcher_name);
+  }
+  SetNewPeerCallback([](uint32_t vip, uint64_t xuid, uint64_t token) { Signaling().OnNewPeer(vip, xuid, token); });
+  SetSocketRegisteredCallback([](uint16_t port) {
+    Signaling().RetryPendingOffers();
+    Signaling().OfferPort(port);
+  });
+  VirtualPeerManager::Get().SetPublicAddressFn([](uint16_t port) { Signaling().OfferPort(port); });
+  StreamTunnel::Get().Start();  // its UDP socket joins the punching before any offer goes out
+  SetInviteHooks({RunningTitle,
+                  [](uint32_t id) {
+                    if (g_exiting) return;
+                    if (auto* ks = rex::system::kernel_state()) ks->BroadcastNotification(id, 0);
+                  },
+                  [](uint64_t xuid, const std::string& uuid) { RememberLobbyHost(xuid, uuid); }});
+  mc.StartSignaling([](const std::string& text) {
+    if (auto m = ParseCandidates(text)) {
+      Signaling().OnCandidates(*m, VirtualPeerManager::Clock::now());
+    } else if (auto j = ParseJoinEvent(text)) {
+      JoinByRoomCode(j->room_code, j->from_game_invite);
+    }
+  });
+  // --net_join_lobby: once the game runs and the signaling is up, plus 5 s for its menus to settle.
+  const std::string join = REXCVAR_GET(net_join_lobby);
+  if (!join.empty()) {
+    std::thread([join] {
+      for (int i = 0; i < 120 && !(RunningTitle() && MasterClient::Get().SignalingConnected()); ++i) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+      }
+      std::this_thread::sleep_for(std::chrono::seconds(5));
+      if (g_exiting) return;
+      REXKRNL_INFO("cogbox_online: --net_join_lobby {}", join);
+      JoinByRoomCode(join, false);
+    }).detach();
+  }
+}
+
+}  // namespace
+
+namespace {
+class MasterBackend : public SessionBackend {
+ public:
+  std::optional<std::string> CreateLobby(const LobbyInfo& l, std::string* room) override {
+    return MasterClient::Get().CreateLobby(l, room);
+  }
+  bool DeleteLobby(const std::string& id) override { return MasterClient::Get().DeleteLobby(id); }
+  std::vector<LobbyInfo> SearchLobbies(uint32_t title) override { return MasterClient::Get().SearchLobbies(title); }
+  bool SetLobbyQos(const std::string& id, const std::vector<uint8_t>& data) override {
+    return MasterClient::Get().SetLobbyQos(id, data);
+  }
+  bool SetLobbyPlayers(const std::string& id, uint32_t n) override { return MasterClient::Get().SetLobbyPlayers(id, n); }
+  bool SetLobbyInviteOnly(const std::string& id, bool on) override { return MasterClient::Get().SetLobbyInviteOnly(id, on); }
+  bool UpdateLobbySettings(const std::string& id, const std::vector<IdValue>& props,
+                           const std::vector<IdValue>& ctxs) override {
+    return MasterClient::Get().UpdateLobbySettings(id, props, ctxs);
+  }
+};
+}  // namespace
+
+OnlineSessions* ActiveOnlineSessions() {
+  if (!NetOnline() || !LiveEmulationOn() || !MasterClient::Get().Configured()) {
+    return nullptr;
+  }
+  static MasterBackend* backend = new MasterBackend();
+  static OnlineSessions* sessions = new OnlineSessions(
+      *backend, [](uint64_t xuid, const std::string& uuid) { RememberLobbyHost(xuid, uuid); },
+      [](std::function<void()> job) { std::thread(std::move(job)).detach(); });
+  return sessions;
+}
+
+uint64_t NewSessionToken() {
+  std::random_device rd;
+  uint64_t t = 0;
+  while (!t) t = (uint64_t(rd()) << 32) | rd();
+  return t;
+}
+
+void RememberLobbyHost(uint64_t host_xuid, const std::string& host_uuid) {
+  Signaling().RememberHost(host_xuid, host_uuid);
+}
+
+std::filesystem::path OnlineDataDir(const std::filesystem::path& user_data_root, const std::string& identity_dir) {
+  if (!identity_dir.empty()) {
+    return std::filesystem::path(identity_dir);
+  }
+  return user_data_root / "cogbox-online";
+}
+
+void OnlineStartup(const std::filesystem::path& user_data_root, uint64_t profile_xuid) {
+  if (user_data_root.empty()) {
+    return;
+  }
+  const auto dir = OnlineDataDir(user_data_root, std::string(REXCVAR_GET(net_identity_dir)));
+  SetHostBanFolder(dir);
+  {
+    std::random_device rd;
+    Signaling().SetLaunchId((uint64_t(rd()) << 32 | rd()) | 1);  // never 0, which means "no launch id"
+  }
+  std::error_code ec;
+  // Offline, an identity that already exists is only read (to sign the saves back); none is made.
+  if (NetOnline() || std::filesystem::exists(dir / "identity.json", ec)) {
+    const std::string launcher_name = NormalizeGamertag(std::string(REXCVAR_GET(user_gamertag)));
+    LoadOrCreateIdentity(dir, launcher_name.empty() ? "Player" : launcher_name);
+  }
+  // The emulation keeps the XUID the identity had before this run's claim (see SetEmulationXuid).
+  const uint64_t xuid = GetAuthoritativeOnlineXuid();
+  // Called on the signaling thread, which has no guest thread state: the process-wide kernel state, not
+  // REX_KERNEL_STATE() (that one is per guest thread and empty there).
+  MasterClient::Get().SetTitleIdSource(RunningTitle);
+  MasterClient::Get().SetRegion(std::string(REXCVAR_GET(net_region)));
+  StartOnlineServices(dir);
+  if (!xuid) {
+    return;
+  }
+  if (NetOnline() && REXCVAR_GET(net_live_emulation)) {
+    SetEmulationXuid(xuid);
+    REXKRNL_INFO("cogbox_online: LIVE emulation with online XUID {:016X}", xuid);
+    rex::system::CogConvertGears3SaveSigning(user_data_root, profile_xuid, 0, xuid, ".pre-online");
+  } else {
+    SetEmulationXuid(0);
+    rex::system::CogConvertGears3SaveSigning(user_data_root, profile_xuid, xuid, 0, ".pre-online");
+  }
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/qos.cpp b/src/kernel/xam/net/qos.cpp
new file mode 100644
index 0000000..5231ab9
--- /dev/null
+++ b/src/kernel/xam/net/qos.cpp
@@ -0,0 +1,62 @@
+// COGBox SDK patch 65: the XNetQosLookup answer.
+#include <rex/kernel/xam/net/qos.h>
+
+#include <cstring>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+constexpr uint32_t kHeader = 8;
+constexpr uint32_t kInfo = 24;
+constexpr uint16_t kRttMs = 30;                 // a direct path; the games only rank by it
+constexpr uint32_t kBitsPerSec = 10'000'000;
+
+void Put16(uint8_t* p, uint16_t v) {
+  p[0] = uint8_t(v >> 8);
+  p[1] = uint8_t(v);
+}
+void Put32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24);
+  p[1] = uint8_t(v >> 16);
+  p[2] = uint8_t(v >> 8);
+  p[3] = uint8_t(v);
+}
+
+}  // namespace
+
+std::vector<uint8_t> BuildXnQos(const std::vector<std::optional<std::vector<uint8_t>>>& targets, uint16_t probes,
+                                uint32_t guest_base) {
+  size_t data_total = 0;
+  for (const auto& t : targets) {
+    if (t) data_total += t->size();
+  }
+  std::vector<uint8_t> out(kHeader + kInfo * targets.size() + data_total, 0);
+  Put32(out.data() + 0, uint32_t(targets.size()));
+  Put32(out.data() + 4, 0);
+  uint32_t data_at = kHeader + kInfo * uint32_t(targets.size());
+  for (size_t i = 0; i < targets.size(); ++i) {
+    uint8_t* info = out.data() + kHeader + kInfo * i;
+    const auto& t = targets[i];
+    if (!t) {
+      info[0] = kXnQosComplete;
+      continue;
+    }
+    info[0] = uint8_t(kXnQosComplete | kXnQosTargetContacted | (t->empty() ? 0 : kXnQosDataReceived));
+    Put16(info + 2, probes);
+    Put16(info + 4, probes);
+    Put16(info + 6, uint16_t(t->size()));
+    if (!t->empty()) {
+      Put32(info + 8, guest_base + data_at);
+      std::memcpy(out.data() + data_at, t->data(), t->size());
+      data_at += uint32_t(t->size());
+    }
+    Put16(info + 12, kRttMs);
+    Put16(info + 14, kRttMs);
+    Put32(info + 16, kBitsPerSec);
+    Put32(info + 20, kBitsPerSec);
+  }
+  return out;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/session_marshal.cpp b/src/kernel/xam/net/session_marshal.cpp
new file mode 100644
index 0000000..d75c1f5
--- /dev/null
+++ b/src/kernel/xam/net/session_marshal.cpp
@@ -0,0 +1,141 @@
+// COGBox SDK patch 65: lobbies -> an XSessionSearch results buffer.
+#include <rex/kernel/xam/net/session_marshal.h>
+
+#include <algorithm>
+#include <cstring>
+#include <utility>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+void Put32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24);
+  p[1] = uint8_t(v >> 16);
+  p[2] = uint8_t(v >> 8);
+  p[3] = uint8_t(v);
+}
+
+void Put64(uint8_t* p, uint64_t v) {
+  Put32(p, uint32_t(v >> 32));
+  Put32(p + 4, uint32_t(v));
+}
+
+uint32_t PropertyType(uint32_t id) { return id >> 28; }
+
+constexpr uint32_t kHostNameProperty = 0x40008109;  // X_PROPERTY_GAMER_HOSTNAME
+constexpr size_t kMaxHostName = 15;                 // a gamertag
+// Xbox LIVE's search also added the host's TrueSkill: X_PROPERTY_GAMER_MU / _SIGMA (doubles). Gears 2 computes its
+// match quality from them; without a skill service every host gets LIVE's defaults for a new player.
+constexpr uint32_t kMuProperty = 0x30008105;
+constexpr uint32_t kSigmaProperty = 0x30008106;
+constexpr double kDefaultMu = 3.0;
+constexpr double kDefaultSigma = 1.0;
+constexpr uint32_t kSkillProperties = 2;
+
+void PutDouble(uint8_t* p, double d) {
+  uint64_t bits;
+  std::memcpy(&bits, &d, 8);
+  Put32(p, uint32_t(bits >> 32));
+  Put32(p + 4, uint32_t(bits));
+}
+
+std::string HostName(const LobbyInfo& l) { return l.host_name.substr(0, kMaxHostName); }
+uint32_t HostNameBytes(const LobbyInfo& l) {
+  return l.host_name.empty() ? 0 : uint32_t(2 * (HostName(l).size() + 1));
+}
+
+std::vector<IdValue> WritableProperties(const LobbyInfo& l) {
+  std::vector<IdValue> out;
+  for (const auto& p : l.properties) {
+    if (PropertyType(p.id) == 1 || PropertyType(p.id) == 2) {
+      out.push_back(p);
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+MarshalResult MarshalSearchResults(const std::vector<LobbyInfo>& lobbies, uint32_t max_results, uint8_t* buf,
+                                   uint32_t buf_len, uint32_t guest_base) {
+  MarshalResult r;
+  const size_t n = std::min<size_t>(lobbies.size(), max_results);
+  std::vector<std::vector<IdValue>> props(n);
+  uint64_t required = kSearchHeaderSize + uint64_t(kSearchResultSize) * n;
+  for (size_t i = 0; i < n; ++i) {
+    props[i] = WritableProperties(lobbies[i]);
+    const uint32_t name_bytes = HostNameBytes(lobbies[i]);
+    required += uint64_t(kUserPropertySize) * (props[i].size() + kSkillProperties + (name_bytes ? 1 : 0)) +
+                uint64_t(kUserContextSize) * lobbies[i].contexts.size() + name_bytes;
+  }
+  r.required = uint32_t(std::min<uint64_t>(required, UINT32_MAX));
+  if (!buf || required > buf_len) {
+    return r;
+  }
+  std::memset(buf, 0, size_t(required));
+  Put32(buf + 0, uint32_t(n));
+  Put32(buf + 4, n ? guest_base + kSearchHeaderSize : 0);
+  uint32_t tail = kSearchHeaderSize + kSearchResultSize * uint32_t(n);  // where the next array goes
+  for (size_t i = 0; i < n; ++i) {
+    const LobbyInfo& l = lobbies[i];
+    uint8_t* res = buf + kSearchHeaderSize + kSearchResultSize * i;
+    std::memcpy(res, l.session_info.data(), l.session_info.size());
+    const uint32_t filled = std::min(l.current_players, l.max_players);
+    Put32(res + 60, l.max_players - filled);  // open public
+    Put32(res + 64, 0);                       // open private
+    Put32(res + 68, filled);                  // filled public
+    Put32(res + 72, 0);                       // filled private
+    const uint32_t name_bytes = HostNameBytes(l);
+    const uint32_t prop_count = uint32_t(props[i].size()) + kSkillProperties + (name_bytes ? 1 : 0);
+    Put32(res + 76, prop_count);
+    Put32(res + 80, uint32_t(l.contexts.size()));
+    Put32(res + 84, prop_count ? guest_base + tail : 0);
+    uint8_t* name_prop = nullptr;
+    if (name_bytes) {
+      name_prop = buf + tail;
+      Put32(name_prop + 0, kHostNameProperty);
+      name_prop[8] = 4;  // XUSER_DATA_TYPE_UNICODE
+      Put32(name_prop + 16, name_bytes);
+      tail += kUserPropertySize;
+    }
+    for (const auto& p : props[i]) {
+      uint8_t* e = buf + tail;
+      Put32(e + 0, p.id);
+      e[8] = uint8_t(PropertyType(p.id));
+      if (PropertyType(p.id) == 1) {
+        Put32(e + 16, uint32_t(int32_t(p.value)));
+      } else {
+        Put64(e + 16, uint64_t(p.value));
+      }
+      tail += kUserPropertySize;
+    }
+    for (const auto& [id, value] : {std::pair<uint32_t, double>{kMuProperty, kDefaultMu}, {kSigmaProperty, kDefaultSigma}}) {
+      uint8_t* e = buf + tail;
+      Put32(e + 0, id);
+      e[8] = 3;  // XUSER_DATA_TYPE_DOUBLE
+      PutDouble(e + 16, value);
+      tail += kUserPropertySize;
+    }
+    Put32(res + 88, l.contexts.empty() ? 0 : guest_base + tail);
+    for (const auto& c : l.contexts) {
+      Put32(buf + tail, c.id);
+      Put32(buf + tail + 4, uint32_t(c.value));
+      tail += kUserContextSize;
+    }
+    if (name_prop) {
+      Put32(name_prop + 20, guest_base + tail);
+      for (char ch : HostName(l)) {
+        buf[tail++] = 0;
+        buf[tail++] = uint8_t(ch);
+      }
+      buf[tail++] = 0;
+      buf[tail++] = 0;
+    }
+  }
+  r.ok = true;
+  r.written = uint32_t(n);
+  return r;
+}
+
+}  // namespace rex::kernel::xam::net
