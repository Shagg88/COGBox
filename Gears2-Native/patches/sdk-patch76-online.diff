+namespace {
+// The XUIDs of an XSessionJoin / Leave request; none when the array is not mapped.
+std::vector<uint64_t> ReadXuids(rex::memory::Memory* memory, uint32_t ptr, uint32_t count) {
+  std::vector<uint64_t> out;
+  if (!ptr || count > 64 || !memory->LookupHeap(ptr) || !memory->LookupHeap(ptr + count * 8 - 1)) return out;
+  for (uint32_t i = 0; i < count; ++i) {
+    out.push_back(rex::memory::load_and_swap<uint64_t>(memory->TranslateVirtual(ptr + i * 8)));
+  }
+  return out;
+}
