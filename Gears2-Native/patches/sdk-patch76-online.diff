+// COGBox: Gears 3's hosting ban. The game alone hands out the penalty (GearProfileSettings.IsOkayToHost: quits +
+// standby demerits == 0) and the save has no time for it, so a player stayed locked out for good. This thread tells a
+// banned player when they search, and 30 minutes after the penalty makes IsOkayToHost answer true, in memory only (the
+// save is never written). It has its own thread: an object scan on the game thread froze the games.
+static std::atomic<int64_t> g_host_search_at{0};
+
+static std::optional<int> HostPenaltyOf(uint32_t profile) {
+  for (uint32_t off = 60; off < 600; off += 4) {
+    uint32_t data = 0, count = 0, max = 0;
+    if (!GuestRead32(profile + off, &data) || !GuestRead32(profile + off + 4, &count) ||
+        !GuestRead32(profile + off + 8, &max) || !data || count < 2 || count > 2048 || max < count) {
+      continue;
+    }
+    const size_t bytes = size_t(count) * 24;
+    const uint8_t* p = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(data);
+    if (!GuestReadable(p, bytes)) continue;
+    if (auto penalty = rex::kernel::xam::net::HostPenaltyFromSettings(p, bytes, count, REX_KERNEL_STATE()->title_id())) return penalty;
+  }
+  return std::nullopt;
+}
