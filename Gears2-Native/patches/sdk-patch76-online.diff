+namespace {
+void PutBe64(uint8_t* p, uint64_t v) {
+  for (int i = 7; i >= 0; --i, v >>= 8) p[i] = uint8_t(v);
+}
+void PutBe32(uint8_t* p, uint32_t v) {
+  for (int i = 3; i >= 0; --i, v >>= 8) p[i] = uint8_t(v);
+}
+}  // namespace
+
+std::array<uint8_t, 84> EncodeInviteInfo(const PendingInvite& invite, uint64_t invitee_xuid) {
+  std::array<uint8_t, 84> out{};
+  PutBe64(&out[0], invitee_xuid);
+  PutBe64(&out[8], invite.inviter_xuid);
+  PutBe32(&out[16], invite.title_id);
+  std::copy(invite.session_info.begin(), invite.session_info.end(), out.begin() + 20);
+  PutBe32(&out[80], invite.from_game_invite ? 1u : 0u);
+  return out;
+}
+
+Invites& Invites::Get() {
+  static Invites* i = new Invites();
+  return *i;
+}
+
+void Invites::Set(const PendingInvite& invite) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  invite_ = invite;
+  read_ = false;
+}
+
+bool Invites::NeedsAnnouncing(std::chrono::steady_clock::time_point now) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return invite_ && !read_ && now - invite_->at <= kLifetime;
+}
+
+bool Invites::IsCurrent(std::chrono::steady_clock::time_point set_at) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return invite_ && invite_->at == set_at;
+}
+
+std::optional<LobbyInfo> Invites::LobbyForSessionId(const std::array<uint8_t, 8>& xnkid,
+                                                    std::chrono::steady_clock::time_point now) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!invite_ || now - invite_->at > kLifetime ||
+      !std::equal(xnkid.begin(), xnkid.end(), invite_->session_info.begin())) {
+    return std::nullopt;
+  }
+  return invite_->lobby;
+}
+
+void Invites::MarkRead() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  read_ = true;
+}
+
+std::optional<PendingInvite> Invites::Find(uint32_t title_id, std::chrono::steady_clock::time_point now) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!invite_ || invite_->title_id != title_id || now - invite_->at > kLifetime) {
+    return std::nullopt;
+  }
+  return invite_;
+}
+
+void Invites::Clear() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  invite_.reset();
+}
+
+namespace {
+std::mutex g_hooks_mutex;
+InviteHooks g_hooks;
+}  // namespace
+
+uint32_t InviteInfoAddress(const uint8_t* param_block, size_t size) {
+  auto be32 = [&](size_t at) {
+    return uint32_t(param_block[at]) << 24 | uint32_t(param_block[at + 1]) << 16 | uint32_t(param_block[at + 2]) << 8 |
+           param_block[at + 3];
+  };
+  if (!param_block || size < 516 || be32(512) < 2 || be32(16) != 4 || be32(24) != 0) {
+    return 0;
+  }
+  const uint32_t ptr = be32(28);
+  return ptr >= 0x10000 ? ptr : 0;
+}
+
+std::optional<SearchByIdRequest> ParseSearchByIdRequest(const uint8_t* buf, uint32_t len) {
+  if (!buf || len != 20) {
+    return std::nullopt;
+  }
+  auto be32 = [&](size_t at) {
+    return uint32_t(buf[at]) << 24 | uint32_t(buf[at + 1]) << 16 | uint32_t(buf[at + 2]) << 8 | buf[at + 3];
+  };
+  SearchByIdRequest r;
+  std::copy(buf + 4, buf + 12, r.xnkid.begin());
+  r.results_size = be32(12);
+  r.results_ptr = be32(16);
+  return r;
+}
+
+std::optional<JoinEvent> ParseJoinEvent(const std::string& json) {
+  const auto j = nlohmann::json::parse(json, nullptr, false);
+  if (!j.is_object() || j.value("type", "") != "join" || !j.contains("room_code") || !j["room_code"].is_string() ||
+      j["room_code"].get<std::string>().empty()) {
+    return std::nullopt;
+  }
+  JoinEvent e;
+  e.room_code = j["room_code"].get<std::string>();
+  if (j.contains("inviter_xuid") && j["inviter_xuid"].is_string()) {
+    e.inviter_xuid = std::strtoull(j["inviter_xuid"].get<std::string>().c_str(), nullptr, 10);
+  }
+  e.from_game_invite = j.value("from_game_invite", false);
+  return e;
+}
+
+void SetInviteHooks(InviteHooks hooks) {
+  std::lock_guard<std::mutex> lock(g_hooks_mutex);
+  g_hooks = std::move(hooks);
+}
+
+void RememberInviteHost(const LobbyInfo& lobby) {
+  InviteHooks hooks;
+  {
+    std::lock_guard<std::mutex> lock(g_hooks_mutex);
+    hooks = g_hooks;
+  }
+  if (hooks.remember_host) hooks.remember_host(lobby.host_xuid, lobby.host_uuid);
+}
