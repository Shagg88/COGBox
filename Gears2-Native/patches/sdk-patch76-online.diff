+}
+
+TEST_CASE("Peers: a tunnel frame reaching a game socket is taken out", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  const uint8_t frame[22] = {'C', 'G', 'B', 'T', 1, 3};
+  CHECK(f.mgr.OnPacket(kSock, frame, sizeof(frame), kCandB, f.t0));
+}
+
+TEST_CASE("Peers: Paths lists a peer's selected paths by its port", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  CHECK(f.mgr.Paths(vip).empty());
+  auto ack = EncodePunch({PunchType::Ack, kToken, 0, kPeerPort});
+  f.mgr.OnPacket(kSock, ack.data(), ack.size(), kCandB, f.t0);
+  auto ack2 = EncodePunch({PunchType::Ack, kToken, 0, 5555});
+  const sockaddr_in tunnel = Addr(0xCB007107, 40001);
+  f.mgr.OnPacket(kSock, ack2.data(), ack2.size(), tunnel, f.t0);
+  auto paths = f.mgr.Paths(vip);
