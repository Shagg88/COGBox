diff --git a/src/kernel/xam/net/socket_hooks.cpp b/src/kernel/xam/net/socket_hooks.cpp
new file mode 100644
index 0000000..121c17e
--- /dev/null
+++ b/src/kernel/xam/net/socket_hooks.cpp
@@ -0,0 +1,315 @@
+// COGBox SDK patch 65: the socket hooks for online play.
+#include <set>
+#include <rex/kernel/xam/net/socket_hooks.h>
+
+#if defined(_WIN32)
+#include <iphlpapi.h>
+#endif
+
+#include <atomic>
+#include <map>
+#include <condition_variable>
+#include <mutex>
+#include <cstring>
+#include <string>
+#include <thread>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/net/live_emulation.h>
+#include <rex/kernel/xam/net/stream_tunnel.h>
+#include <rex/kernel/xam/net/upnp.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(net_online, false, "Network",
+                    "COGBox online play: peers as 10.254.x.y virtual IPs, NAT paths punched from the game's own "
+                    "sockets (no relay). Off = the network behaves exactly as without COGBox online play.");
+REXCVAR_DEFINE_STRING(net_stun_server, "", "Network",
+                      "COGBox online play: STUN server as host:port (default port 3478). Empty = no STUN probes.");
+
+#if !defined(_WIN32)
+#include <netdb.h>
+#include <sys/socket.h>
+using SOCKET = int;
+#endif
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+using Clock = VirtualPeerManager::Clock;
+
+void NativeSend(uint64_t handle, const uint8_t* data, size_t len, const sockaddr_in& to) {
+  ::sendto(static_cast<SOCKET>(handle), reinterpret_cast<const char*>(data), int(len), 0,
+           reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+}
+
+std::optional<sockaddr_in> ResolveStun(const std::string& spec) {
+  if (spec.empty()) {
+    return std::nullopt;
+  }
+  std::string host = spec;
+  std::string port = "3478";
+  if (auto colon = spec.rfind(':'); colon != std::string::npos) {
+    host = spec.substr(0, colon);
+    port = spec.substr(colon + 1);
+  }
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* res = nullptr;
+  if (getaddrinfo(host.c_str(), port.c_str(), &hints, &res) != 0 || !res) {
+    return std::nullopt;
+  }
+  sockaddr_in out;
+  std::memcpy(&out, res->ai_addr, sizeof(out));
+  freeaddrinfo(res);
+  return out;
+}
+
+// Ticks the manager every 100 ms on its own thread. Started on the first bound socket with net_online on.
+class Worker {
+ public:
+  static Worker& Get() {
+    static Worker* w = new Worker();  // never destroyed, like the manager
+    return *w;
+  }
+  void EnsureStarted() {
+    bool expected = false;
+    if (started_.compare_exchange_strong(expected, true)) {
+      std::thread([this] { Run(); }).detach();
+    }
+  }
+
+ private:
+  void Run() {
+    auto& mgr = VirtualPeerManager::Get();
+    if (auto stun = ResolveStun(REXCVAR_GET(net_stun_server))) {
+      mgr.SetStunServer(*stun);
+      REXKRNL_INFO("cogbox_online: STUN server {}", REXCVAR_GET(net_stun_server));
+    } else if (!REXCVAR_GET(net_stun_server).empty()) {
+      REXKRNL_WARN("cogbox_online: STUN server {} could not be resolved", REXCVAR_GET(net_stun_server));
+    }
+    for (;;) {
+      mgr.Tick(Clock::now());
+      std::this_thread::sleep_for(VirtualPeerManager::kProbeInterval);
+    }
+  }
+  std::atomic<bool> started_{false};
+};
+
+// IPv4 addresses of the adapters that are up, without loopback and link-local.
+std::vector<in_addr> LanAddresses() {
+  std::vector<in_addr> out;
+#if defined(_WIN32)
+  ULONG size = 16 * 1024;
+  std::vector<uint8_t> buf(size);
+  auto* list = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buf.data());
+  if (GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER,
+                           nullptr, list, &size) == ERROR_BUFFER_OVERFLOW) {
+    buf.resize(size);
+    list = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buf.data());
+    if (GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER,
+                             nullptr, list, &size) != NO_ERROR) {
+      return out;
+    }
+  }
+  for (auto* a = list; a; a = a->Next) {
+    if (a->OperStatus != IfOperStatusUp || a->IfType == IF_TYPE_SOFTWARE_LOOPBACK) {
+      continue;
+    }
+    for (auto* u = a->FirstUnicastAddress; u; u = u->Next) {
+      auto* sin = reinterpret_cast<sockaddr_in*>(u->Address.lpSockaddr);
+      const uint32_t ip = ntohl(sin->sin_addr.s_addr);
+      if ((ip >> 24) == 127 || (ip >> 16) == 0xA9FE) {  // loopback, 169.254/16
+        continue;
+      }
+      out.push_back(sin->sin_addr);
+    }
+  }
+#endif
+  return out;
+}
+
+}  // namespace
+
+namespace {
+std::mutex g_registered_mutex;
+std::function<void(uint16_t)> g_on_registered;
+}  // namespace
+
+void SetSocketRegisteredCallback(std::function<void(uint16_t)> fn) {
+  std::lock_guard<std::mutex> lock(g_registered_mutex);
+  g_on_registered = std::move(fn);
+}
+
+REXCVAR_DEFINE_INT32(net_bind_port_offset, 0, "Network",
+                     "COGBox online play, testing only: add this to every fixed UDP port the game binds (two copies of "
+                     "a game on one PC).");
+
+int BindPortOffset() {
+  return REXCVAR_GET(net_bind_port_offset);
+}
+
+namespace {
+std::mutex g_listen_mutex;
+std::set<uint16_t> g_listen_ports;
+}  // namespace
+
+void NoteGameListenPort(uint16_t local_port) {
+  std::lock_guard<std::mutex> lock(g_listen_mutex);
+  g_listen_ports.insert(local_port);
+}
+
+bool IsGameListenPort(uint16_t local_port) {
+  std::lock_guard<std::mutex> lock(g_listen_mutex);
+  return g_listen_ports.count(local_port) != 0;
+}
+
+bool NetOnline() {
+  return REXCVAR_GET(net_online);
+}
+
+void OnSocketBound(uint64_t native_handle) {
+  if (!NetOnline()) {
+    return;
+  }
+  sockaddr_in local{};
+  socklen_t len = sizeof(local);
+  if (getsockname(static_cast<SOCKET>(native_handle), reinterpret_cast<sockaddr*>(&local), &len) != 0) {
+    return;
+  }
+  const uint16_t port = ntohs(local.sin_port);
+  // A game socket is not read while the game loads a map (13 s in a traced Gears 3 join); Windows' default 64 KB
+  // receive buffer overflowed and the peer's packets were lost. Give it room for a load's worth of traffic.
+#if defined(_WIN32)
+  // Windows reports an ICMP "port unreachable" for an earlier send as WSAECONNRESET on the socket's next receive; a
+  // console never does, and a game takes the failed receive as a broken connection. Punches to a peer's closed socket
+  // (its lobby socket after the match opened another) caused exactly that. Off, as other emulators do.
+  {
+    BOOL report = FALSE;
+    DWORD bytes = 0;
+    WSAIoctl(static_cast<SOCKET>(native_handle), _WSAIOW(IOC_VENDOR, 12) /* SIO_UDP_CONNRESET */, &report,
+             sizeof(report), nullptr, 0, &bytes, nullptr, nullptr);
+  }
+#endif
+  int rcvbuf = 8 * 1024 * 1024;
+  setsockopt(static_cast<SOCKET>(native_handle), SOL_SOCKET, SO_RCVBUF, reinterpret_cast<const char*>(&rcvbuf),
+             sizeof(rcvbuf));
+  auto& mgr = VirtualPeerManager::Get();
+  mgr.SetSendFn(NativeSend);
+  mgr.RegisterSocket(native_handle, port);
+  for (const in_addr& ip : LanAddresses()) {
+    sockaddr_in a{};
+    a.sin_family = AF_INET;
+    a.sin_addr = ip;
+    a.sin_port = local.sin_port;
+    mgr.AddLocalCandidate(port, {a, Candidate::Host});
+  }
+  REXKRNL_INFO("cogbox_online: game socket on UDP port {} registered", port);
+  std::function<void(uint16_t)> on_registered;
+  {
+    std::lock_guard<std::mutex> lock(g_registered_mutex);
+    on_registered = g_on_registered;
+  }
+  if (on_registered) {
+    on_registered(port);
+  }
+  std::thread([port] {
+    UPnPResult r = TryUPnPPortMap(port);
+    if (!r.success) {
+      REXKRNL_INFO("cogbox_online: no UPnP mapping for port {} (normal behind CGNAT)", port);
+      return;
+    }
+    sockaddr_in a{};
+    a.sin_family = AF_INET;
+    inet_pton(AF_INET, r.external_ip.c_str(), &a.sin_addr);
+    a.sin_port = htons(r.external_port);
+    VirtualPeerManager::Get().AddLocalCandidate(port, {a, Candidate::Upnp});
+    REXKRNL_INFO("cogbox_online: UPnP mapped port {} as {}:{}", port, r.external_ip, r.external_port);
+  }).detach();
+  Worker::Get().EnsureStarted();
+}
+
+void OnSocketClosed(uint64_t native_handle) {
+  if (NetOnline()) {
+    VirtualPeerManager::Get().UnregisterSocket(native_handle);
+  }
+}
+
+bool OnPacketReceived(uint64_t native_handle, const uint8_t* data, size_t len, const sockaddr_in& from) {
+  return NetOnline() && VirtualPeerManager::Get().OnPacket(native_handle, data, len, from, Clock::now());
+}
+
+int RecvFromFiltered(uint64_t native_handle, uint8_t* buf, uint32_t buf_len, int flags, sockaddr_in* from,
+                     socklen_t* from_len) {
+  const auto s = static_cast<SOCKET>(native_handle);
+  const socklen_t len_in = from_len ? *from_len : 0;
+  int ret = recvfrom(s, reinterpret_cast<char*>(buf), int(buf_len), flags, reinterpret_cast<sockaddr*>(from), from_len);
+  while (ret >= 0 && from && OnPacketReceived(native_handle, buf, size_t(ret), *from)) {
+    if (flags & MSG_PEEK) {
+      recvfrom(s, reinterpret_cast<char*>(buf), int(buf_len), flags & ~MSG_PEEK, nullptr, nullptr);
+    }
+    if (from_len) {
+      *from_len = len_in;
+    }
+    ret = recvfrom(s, reinterpret_cast<char*>(buf), int(buf_len), flags, reinterpret_cast<sockaddr*>(from), from_len);
+  }
+  return ret;
+}
+
+SendDecision OnSendTo(uint64_t native_handle, uint32_t vip, uint16_t port, const uint8_t* data, size_t len) {
+  if (!NetOnline()) {
+    return {SendAction::PassThrough, {}};
+  }
+  return VirtualPeerManager::Get().OnSend(native_handle, vip, port, data, len, Clock::now());
+}
+
+std::optional<sockaddr_in> RedirectStreamConnect(uint32_t vip, uint16_t port) {
+  if (!NetOnline()) {
+    return std::nullopt;
+  }
+  return StreamTunnel::Get().RedirectConnect(vip, port);
+}
+
+void NoteUdp(const char* what, uint64_t native_handle, uint32_t ip, uint16_t port) {
+  if (!NetTraceOn() || !VirtualPeerManager::IsVirtualIp(ip)) {
+    return;
+  }
+  static std::mutex m;
+  struct Count {
+    uint64_t n = 0, logged = 0;
+    Clock::time_point last{};
+  };
+  static std::map<std::string, Count> counts;
+  sockaddr_in local{};
+  socklen_t len = sizeof(local);
+  getsockname(static_cast<SOCKET>(native_handle), reinterpret_cast<sockaddr*>(&local), &len);
+  const std::string key = std::string(what) + " :" + std::to_string(ntohs(local.sin_port)) + " " +
+                          (std::string(what) == "in" ? "<- " : "-> ") + "10.254." + std::to_string((ip >> 8) & 0xFF) +
+                          "." + std::to_string(ip & 0xFF) + ":" + std::to_string(port);
+  const auto now = Clock::now();
+  std::lock_guard<std::mutex> lock(m);
+  auto& c = counts[key];
+  ++c.n;
+  if (c.logged == 0 || now - c.last >= std::chrono::seconds(2)) {
+    REXKRNL_INFO("cogbox_net_trace: udp {} ({} packet(s), +{})", key, c.n, c.n - c.logged);
+    c.logged = c.n;
+    c.last = now;
+  }
+}
+
+bool HoldUnlabelled(const sockaddr_in& from) {
+  if (!NetOnline()) return false;
+  // With LIVE emulation everyone we play with is a known peer: a packet nobody can place never reaches the game's
+  // network code. (A known peer's socket not announced yet is held the same way; the game resends.)
+  return LiveEmulationOn() || VirtualPeerManager::Get().IsPeerAddress(from);
+}
+
+std::optional<std::pair<uint32_t, uint16_t>> RelabelFrom(const sockaddr_in& from, uint64_t native_handle) {
+  if (!NetOnline()) {
+    return std::nullopt;
+  }
+  return VirtualPeerManager::Get().Relabel(from, Clock::now(), native_handle);
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/stream_tunnel.cpp b/src/kernel/xam/net/stream_tunnel.cpp
new file mode 100644
index 0000000..cf65394
--- /dev/null
+++ b/src/kernel/xam/net/stream_tunnel.cpp
@@ -0,0 +1,228 @@
+// COGBox SDK patch 65: game TCP connections to an online peer over the punched UDP path (see stream_tunnel.h).
+#include <rex/kernel/xam/net/stream_tunnel.h>
+
+#include <chrono>
+#include <map>
+#include <thread>
+
+#include <rex/kernel/xam/net/live_emulation.h>
+#include <rex/kernel/xam/net/socket_hooks.h>
+#include <rex/kernel/xam/net/tunnel_core.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+#include <rex/logging.h>
+
+namespace rex::kernel::xam::net {
+
+StreamTunnel& StreamTunnel::Get() {
+  static StreamTunnel* t = new StreamTunnel();  // never destroyed: its thread runs until the process ends
+  return *t;
+}
+
+#if defined(_WIN32)
+
+namespace {
+
+sockaddr_in Loopback(uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  a.sin_port = htons(port);
+  return a;
+}
+
+void SetNonBlocking(SOCKET s, bool on) {
+  u_long v = on ? 1 : 0;
+  ioctlsocket(s, FIONBIO, &v);
+}
+
+bool SendAll(SOCKET s, const uint8_t* d, size_t n) {
+  while (n) {
+    const int sent = ::send(s, reinterpret_cast<const char*>(d), int(n), 0);
+    if (sent <= 0) return false;
+    d += sent;
+    n -= size_t(sent);
+  }
+  return true;
+}
+
+}  // namespace
+
+bool StreamTunnel::Start() {
+  bool expected = false;
+  if (!started_.compare_exchange_strong(expected, true)) {
+    return udp_ != ~0ull;
+  }
+  SOCKET s = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  sockaddr_in any{};
+  any.sin_family = AF_INET;
+  if (s == INVALID_SOCKET || ::bind(s, reinterpret_cast<sockaddr*>(&any), sizeof(any)) != 0) {
+    REXKRNL_WARN("cogbox_online: the stream tunnel's socket could not be made");
+    return false;
+  }
+  SetNonBlocking(s, true);
+  udp_ = uint64_t(s);
+  OnSocketBound(udp_);  // STUN, punching and candidates, like a game socket
+  std::thread([this] { Run(); }).detach();
+  return true;
+}
+
+std::optional<sockaddr_in> StreamTunnel::RedirectConnect(uint32_t vip, uint16_t port) {
+  if (udp_ == ~0ull) {
+    return std::nullopt;
+  }
+  SOCKET ls = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  sockaddr_in a = Loopback(0);
+  int len = sizeof(a);
+  if (ls == INVALID_SOCKET || ::bind(ls, reinterpret_cast<sockaddr*>(&a), sizeof(a)) != 0 || ::listen(ls, 1) != 0 ||
+      ::getsockname(ls, reinterpret_cast<sockaddr*>(&a), &len) != 0) {
+    if (ls != INVALID_SOCKET) closesocket(ls);
+    return std::nullopt;
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    new_listeners_.push_back({uint64_t(ls), vip, port});
+  }
+  REXKRNL_INFO("cogbox_online: TCP to 10.254.{}.{}:{} goes through the tunnel (local port {})", (vip >> 8) & 0xFF,
+               vip & 0xFF, port, ntohs(a.sin_port));
+  return a;
+}
+
+void StreamTunnel::Run() {
+  using Clock = TunnelCore::Clock;
+  auto& mgr = VirtualPeerManager::Get();
+  const SOCKET udp = SOCKET(udp_);
+  TunnelCore core;
+  std::vector<PendingListener> listeners;
+  std::map<uint32_t, SOCKET> bridges;        // tunnel handle -> local TCP socket
+  std::map<uint32_t, std::pair<uint16_t, Clock::time_point>> tunnel_port;  // peer VIP -> its tunnel socket's port and last frame
+  std::map<uint32_t, std::pair<size_t, size_t>> traffic;  // handle -> (bytes to the peer, bytes from the peer)
+
+  TunnelCore::Callbacks cb;
+  cb.send_frame = [&](uint32_t vip, const std::vector<uint8_t>& frame) {
+    auto known = tunnel_port.find(vip);
+    const auto port = known == tunnel_port.end()
+                          ? std::nullopt
+                          : VirtualPeerManager::FreshTunnelPort(known->second.first, known->second.second, Clock::now());
+    for (const auto& to : mgr.TunnelPaths(vip, port)) {
+      ::sendto(udp, reinterpret_cast<const char*>(frame.data()), int(frame.size()), 0,
+               reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+    }
+  };
+  cb.open_local = [&](uint32_t handle, uint16_t port) {
+    if (!IsGameListenPort(uint16_t(port + BindPortOffset()))) {
+      REXKRNL_WARN("cogbox_online: tunnel: refused port {} (not a port the game listens on)", port);
+      return false;
+    }
+    SOCKET s = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    sockaddr_in to = Loopback(uint16_t(port + BindPortOffset()));
+    if (s == INVALID_SOCKET || ::connect(s, reinterpret_cast<sockaddr*>(&to), sizeof(to)) != 0) {
+      if (s != INVALID_SOCKET) closesocket(s);
+      REXKRNL_WARN("cogbox_online: tunnel: nothing listens on local port {}", ntohs(to.sin_port));
+      return false;
+    }
+    bridges[handle] = s;
+    REXKRNL_INFO("cogbox_online: tunnel: a peer connected to local port {}", ntohs(to.sin_port));
+    return true;
+  };
+  cb.deliver = [&](uint32_t handle, const uint8_t* d, size_t n) {
+    auto it = bridges.find(handle);
+    traffic[handle].second += n;
+    if (NetTraceOn()) {
+      REXKRNL_INFO("cogbox_net_trace: tunnel {} <- {} byte(s) from the peer: {}", handle, n, HexDump(d, n, 96));
+    }
+    if (it != bridges.end()) SendAll(it->second, d, n);
+  };
+  cb.established = [&](uint32_t handle) { REXKRNL_INFO("cogbox_online: tunnel {} open", handle); };
+  cb.closed = [&](uint32_t handle) {
+    REXKRNL_INFO("cogbox_online: tunnel {} closed by the peer (sent {}, received {} bytes)", handle,
+                 traffic[handle].first, traffic[handle].second);
+    auto it = bridges.find(handle);
+    if (it != bridges.end()) {
+      closesocket(it->second);
+      bridges.erase(it);
+    }
+  };
+  core.SetCallbacks(std::move(cb));
+
+  std::vector<uint8_t> buf(65536);
+  for (;;) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      listeners.insert(listeners.end(), new_listeners_.begin(), new_listeners_.end());
+      new_listeners_.clear();
+    }
+    fd_set rd;
+    FD_ZERO(&rd);
+    FD_SET(udp, &rd);
+    for (const auto& l : listeners) FD_SET(SOCKET(l.socket), &rd);
+    for (const auto& [h, s] : bridges) FD_SET(s, &rd);
+    timeval tv{0, 20000};
+    ::select(0, &rd, nullptr, nullptr, &tv);
+    const auto now = Clock::now();
+
+    if (FD_ISSET(udp, &rd)) {
+      for (;;) {
+        sockaddr_in from{};
+        int fl = sizeof(from);
+        const int n = ::recvfrom(udp, reinterpret_cast<char*>(buf.data()), int(buf.size()), 0,
+                                 reinterpret_cast<sockaddr*>(&from), &fl);
+        if (n < 0) break;
+        if (IsTunnelFrame(buf.data(), size_t(n))) {
+          if (auto who = mgr.Relabel(from)) {
+            tunnel_port[who->first] = {who->second, now};
+            core.OnFrame(who->first, buf.data(), size_t(n), now);
+          }
+        } else {
+          mgr.OnPacket(udp_, buf.data(), size_t(n), from, now);  // STUN answers, punches
+        }
+      }
+    }
+    for (auto it = listeners.begin(); it != listeners.end();) {
+      if (!FD_ISSET(SOCKET(it->socket), &rd)) {
+        ++it;
+        continue;
+      }
+      SOCKET s = ::accept(SOCKET(it->socket), nullptr, nullptr);
+      closesocket(SOCKET(it->socket));
+      if (s != INVALID_SOCKET) {
+        bridges[core.Open(it->vip, it->port, now)] = s;
+      }
+      it = listeners.erase(it);
+    }
+    std::vector<uint32_t> ended;
+    for (const auto& [h, s] : bridges) {
+      if (!FD_ISSET(s, &rd)) continue;
+      const int n = ::recv(s, reinterpret_cast<char*>(buf.data()), int(buf.size()), 0);
+      if (n > 0) {
+        traffic[h].first += size_t(n);
+        if (NetTraceOn()) {
+          REXKRNL_INFO("cogbox_net_trace: tunnel {} -> {} byte(s) to the peer: {}", h, n, HexDump(buf.data(), size_t(n), 96));
+        }
+        core.Send(h, buf.data(), size_t(n), now);
+      } else {
+        ended.push_back(h);
+      }
+    }
+    for (uint32_t h : ended) {
+      REXKRNL_INFO("cogbox_online: tunnel {} closed by the game here (sent {}, received {} bytes)", h,
+                   traffic[h].first, traffic[h].second);
+      core.Close(h, now);
+      auto it = bridges.find(h);
+      if (it != bridges.end()) {
+        closesocket(it->second);
+        bridges.erase(it);
+      }
+    }
+    core.Tick(now);
+  }
+}
+
+#else
+
+bool StreamTunnel::Start() { return false; }
+std::optional<sockaddr_in> StreamTunnel::RedirectConnect(uint32_t, uint16_t) { return std::nullopt; }
+void StreamTunnel::Run() {}
+
+#endif
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/tunnel_core.cpp b/src/kernel/xam/net/tunnel_core.cpp
new file mode 100644
index 0000000..018cfdb
--- /dev/null
+++ b/src/kernel/xam/net/tunnel_core.cpp
@@ -0,0 +1,230 @@
+// COGBox SDK patch 65: reliable ordered streams in UDP frames (see tunnel_core.h).
+#include <rex/kernel/xam/net/tunnel_core.h>
+
+#include <algorithm>
+#include <cstring>
+#include <random>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+constexpr uint8_t kVersion = 1;
+
+void Put16(std::vector<uint8_t>& v, uint16_t x) {
+  v.push_back(uint8_t(x >> 8));
+  v.push_back(uint8_t(x));
+}
+void Put32(std::vector<uint8_t>& v, uint32_t x) {
+  for (int i = 3; i >= 0; --i) v.push_back(uint8_t(x >> (8 * i)));
+}
+uint16_t Get16(const uint8_t* p) { return uint16_t(p[0] << 8 | p[1]); }
+uint32_t Get32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+}  // namespace
+
+std::vector<uint8_t> EncodeTunnelFrame(const TunnelFrame& f) {
+  std::vector<uint8_t> v{'C', 'G', 'B', 'T', kVersion, uint8_t(f.type)};
+  v.reserve(kTunnelHeaderSize + f.payload.size());
+  Put32(v, f.conn);
+  Put32(v, f.seq);
+  Put32(v, f.ack);
+  Put16(v, f.port);
+  Put16(v, uint16_t(f.payload.size()));
+  v.insert(v.end(), f.payload.begin(), f.payload.end());
+  return v;
+}
+
+bool IsTunnelFrame(const uint8_t* d, size_t len) {
+  return d && len >= kTunnelHeaderSize && std::memcmp(d, "CGBT", 4) == 0;
+}
+
+std::optional<TunnelFrame> DecodeTunnelFrame(const uint8_t* d, size_t len) {
+  if (!IsTunnelFrame(d, len) || d[4] != kVersion || d[5] < 1 || d[5] > 6) {
+    return std::nullopt;
+  }
+  const uint16_t n = Get16(d + 20);
+  if (kTunnelHeaderSize + n != len || n > kTunnelMaxPayload) {
+    return std::nullopt;
+  }
+  TunnelFrame f{TunnelFrameType(d[5]), Get32(d + 6), Get32(d + 10), Get32(d + 14), Get16(d + 18),
+                std::vector<uint8_t>(d + kTunnelHeaderSize, d + len)};
+  return f;
+}
+
+void TunnelCore::Emit(const Conn& c, TunnelFrameType type, uint32_t seq, std::vector<uint8_t> payload) {
+  if (cb_.send_frame) {
+    cb_.send_frame(c.vip, EncodeTunnelFrame({type, c.id, seq, c.expected - 1, c.port, std::move(payload)}));
+  }
+}
+
+std::optional<uint32_t> TunnelCore::Find(uint32_t vip, uint32_t id) const {
+  auto it = by_id_.find({vip, id});
+  if (it == by_id_.end()) return std::nullopt;
+  return it->second;
+}
+
+void TunnelCore::Drop(uint32_t handle, bool notify) {
+  auto it = conns_.find(handle);
+  if (it == conns_.end()) return;
+  by_id_.erase({it->second.vip, it->second.id});
+  conns_.erase(it);
+  if (notify && cb_.closed) cb_.closed(handle);
+}
+
+uint32_t TunnelCore::Open(uint32_t vip, uint16_t port, Clock::time_point now) {
+  if (next_id_ == 0) {
+    next_id_ = std::random_device{}() | 1u;
+  }
+  const uint32_t handle = next_handle_++;
+  Conn c{vip, next_id_++, port, State::SynSent, now, now};
+  if (!c.id) c.id = next_id_++;
+  by_id_[{vip, c.id}] = handle;
+  Emit(c, TunnelFrameType::Syn, 0);
+  conns_.emplace(handle, std::move(c));
+  return handle;
+}
+
+void TunnelCore::Send(uint32_t handle, const uint8_t* data, size_t len, Clock::time_point now) {
+  auto it = conns_.find(handle);
+  if (it == conns_.end() || it->second.close_wanted) return;
+  it->second.to_send.insert(it->second.to_send.end(), data, data + len);
+  Pump(it->second, now);
+}
+
+void TunnelCore::Close(uint32_t handle, Clock::time_point now) {
+  auto it = conns_.find(handle);
+  if (it == conns_.end()) return;
+  if (it->second.state == State::SynSent) {
+    Emit(it->second, TunnelFrameType::Rst, 0);
+    Drop(handle, false);
+    return;
+  }
+  it->second.close_wanted = true;
+  Pump(it->second, now);
+}
+
+void TunnelCore::Pump(Conn& c, Clock::time_point now) {
+  if (c.state != State::Established) return;
+  while (c.unacked.size() < kWindow && !c.to_send.empty()) {
+    const size_t n = std::min(c.to_send.size(), kTunnelMaxPayload);
+    std::vector<uint8_t> chunk(c.to_send.begin(), c.to_send.begin() + n);
+    c.to_send.erase(c.to_send.begin(), c.to_send.begin() + n);
+    Segment s{c.next_seq++, TunnelFrameType::Data, std::move(chunk), now};
+    Emit(c, s.type, s.seq, s.payload);
+    c.unacked.push_back(std::move(s));
+  }
+  if (c.close_wanted && !c.fin_sent && c.to_send.empty() && c.unacked.size() < kWindow) {
+    Segment s{c.next_seq++, TunnelFrameType::Fin, {}, now};
+    Emit(c, s.type, s.seq);
+    c.unacked.push_back(std::move(s));
+    c.fin_sent = true;
+  }
+}
+
+void TunnelCore::OnFrame(uint32_t from_vip, const uint8_t* data, size_t len, Clock::time_point now) {
+  auto f = DecodeTunnelFrame(data, len);
+  if (!f) return;
+  auto handle = Find(from_vip, f->conn);
+
+  if (f->type == TunnelFrameType::Syn) {
+    if (handle) {  // our SynAck was lost
+      Emit(conns_.at(*handle), TunnelFrameType::SynAck, 0);
+      return;
+    }
+    const uint32_t h = next_handle_++;
+    Conn c{from_vip, f->conn, f->port, State::Established, now, now};
+    if (!cb_.open_local || !cb_.open_local(h, f->port)) {
+      Emit(c, TunnelFrameType::Rst, 0);
+      return;
+    }
+    by_id_[{from_vip, f->conn}] = h;
+    Emit(c, TunnelFrameType::SynAck, 0);
+    conns_.emplace(h, std::move(c));
+    return;
+  }
+  if (!handle) {
+    if (f->type != TunnelFrameType::Rst && f->type != TunnelFrameType::Ack) {
+      Conn ghost{from_vip, f->conn, f->port, State::Established, now, now};
+      Emit(ghost, TunnelFrameType::Rst, 0);
+    }
+    return;
+  }
+  Conn& c = conns_.at(*handle);
+  switch (f->type) {
+    case TunnelFrameType::Rst:
+      Drop(*handle, true);
+      return;
+    case TunnelFrameType::SynAck:
+      if (c.state == State::SynSent) {
+        c.state = State::Established;
+        if (cb_.established) cb_.established(*handle);
+        Pump(c, now);
+      }
+      return;
+    case TunnelFrameType::Ack:
+      break;
+    case TunnelFrameType::Data:
+    case TunnelFrameType::Fin: {
+      if (c.state == State::SynSent) {  // the SynAck was lost; data means it was accepted
+        c.state = State::Established;
+        if (cb_.established) cb_.established(*handle);
+      }
+      if (f->seq >= c.expected) {
+        c.early.emplace(f->seq, std::move(*f));
+      }
+      bool remote_closed = false;
+      for (auto it = c.early.find(c.expected); it != c.early.end(); it = c.early.find(c.expected)) {
+        if (it->second.type == TunnelFrameType::Fin) {
+          remote_closed = true;
+        } else if (cb_.deliver && !it->second.payload.empty()) {
+          cb_.deliver(*handle, it->second.payload.data(), it->second.payload.size());
+        }
+        c.early.erase(it);
+        ++c.expected;
+      }
+      Emit(c, TunnelFrameType::Ack, 0);
+      if (remote_closed) {
+        Drop(*handle, true);
+        return;
+      }
+      break;
+    }
+    default:
+      return;
+  }
+  // The other side's cumulative ack (Data / Fin / Ack all carry one).
+  const uint32_t acked = (f->type == TunnelFrameType::Ack) ? f->ack : f->ack;
+  while (!c.unacked.empty() && c.unacked.front().seq <= acked) {
+    c.unacked.pop_front();
+  }
+  if (c.fin_sent && c.unacked.empty()) {
+    Drop(*handle, false);  // our close went through
+    return;
+  }
+  Pump(c, now);
+}
+
+void TunnelCore::Tick(Clock::time_point now) {
+  std::vector<uint32_t> timed_out;
+  for (auto& [h, c] : conns_) {
+    if (c.state == State::SynSent) {
+      if (now - c.started >= kOpenTimeout) {
+        timed_out.push_back(h);
+      } else if (now - c.last_syn >= kSynRetry) {
+        c.last_syn = now;
+        Emit(c, TunnelFrameType::Syn, 0);
+      }
+      continue;
+    }
+    for (auto& s : c.unacked) {
+      if (now - s.sent >= kRetransmit) {
+        s.sent = now;
+        Emit(c, s.type, s.seq, s.payload);
+      }
+    }
+  }
+  for (uint32_t h : timed_out) {
+    Drop(h, true);
+  }
+}
+
+}  // namespace rex::kernel::xam::net
