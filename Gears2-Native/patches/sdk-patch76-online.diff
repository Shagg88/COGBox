+uint8_t* FindUe3Function(const char* name, uint32_t* count) {
+#if REX_PLATFORM_WIN32
+  uint32_t gnames = 0, gengine = 0;
+  if (!Ue3Globals(&gnames, &gengine) || !g_ue3_objects) return nullptr;
+  uint32_t objects = g_ue3_objects, ocount = g_ue3_ocount;
+  if (g_ue3_objects_var) {
+    GuestRead32(g_ue3_objects_var, &objects);
+    GuestRead32(g_ue3_objects_var + 4, &ocount);
+  }
+  for (uint32_t i = 0; i < ocount; ++i) {
+    if ((i & 4095) == 4095) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    uint32_t o = 0, cls = 0, data = 0;
+    if (!GuestRead32(objects + 4 * i, &o) || !o || !GuestRead32(o + 52, &cls)) continue;
+    if (Ue3ObjectName(gnames, o) != name || Ue3ObjectName(gnames, cls) != "Function") continue;
+    if (uint8_t* code = Ue3Script(o, &data, count)) return code;
+  }
+#endif
+  return nullptr;
+}
+}  // namespace net
+
+// COGBox: the main menu's "playing worldwide / in your region" numbers, from the master server every 30 s. Its own
+// thread, as the object scan must stay off the game thread.
+static void PopulationThread(uint32_t title) {
+  uint8_t* code = nullptr;
+  uint32_t count = 0;
+  auto ok = [&] { return code && GuestReadable(code, 2) && code[0] == 0x0F && code[1] == 0x48; };
+  for (;; std::this_thread::sleep_for(std::chrono::seconds(30))) {
+    uint32_t gnames = 0, gengine = 0;
+    if (!Ue3Globals(&gnames, &gengine) || !g_ue3_objects) continue;
+    if (!ok()) {
+      code = nullptr;
+      uint32_t objects = g_ue3_objects, ocount = g_ue3_ocount;
+      if (g_ue3_objects_var) {
+        GuestRead32(g_ue3_objects_var, &objects);
+        GuestRead32(g_ue3_objects_var + 4, &ocount);
+      }
+      bool menu_done = false;
+      for (uint32_t i = 0; i < ocount && (!code || !menu_done); ++i) {
+        if ((i & 4095) == 4095) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        uint32_t o = 0, data = 0, menu_count = 0;
+        if (!GuestRead32(objects + 4 * i, &o) || !o) continue;
+        const std::string name = Ue3ObjectName(gnames, o);
+        if (name == "GetPopulationInfoFromPlaylist") {
+          code = Ue3Script(o, &data, &count);
+        } else if (name == "UpdatePopulationNumbers") {
+          // one number per row: the Ranked lookup would add the same totals again
+          if (uint8_t* menu = Ue3Script(o, &data, &menu_count)) {
+            if (const auto jump = rex::kernel::xam::net::FindRankedPopulationCall(menu, menu_count)) {
+              menu[jump->at] = 0x06;
+              menu[jump->at + 1] = uint8_t(jump->target >> 8);
+              menu[jump->at + 2] = uint8_t(jump->target);
+            }
+            menu_done = true;
+          }
+        }
+      }
+      if (!ok()) continue;
+    }
+    if (const auto p = rex::kernel::xam::net::MasterClient::Get().Population(title)) {
+      if (rex::kernel::xam::net::SetPopulationScript(code, count, p->first, p->second)) {
+        REXKRNL_INFO("cogbox_online: {} playing worldwide, {} in this region", p->first, p->second);
+      }
+    }
+  }
+}
