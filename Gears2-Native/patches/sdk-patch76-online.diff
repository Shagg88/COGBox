diff --git a/tests/unit/net/host_ban_test.cpp b/tests/unit/net/host_ban_test.cpp
new file mode 100644
index 0000000..5311308
--- /dev/null
+++ b/tests/unit/net/host_ban_test.cpp
@@ -0,0 +1,121 @@
+// COGBox: the game's hosting ban is lifted 30 minutes after its penalty; the game alone decides who gets one.
+#include <catch2/catch_test_macros.hpp>
+
+#include <filesystem>
+#include <vector>
+
+#include <rex/kernel/xam/net/host_ban.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+void Put32(std::vector<uint8_t>& v, size_t at, uint32_t x) {
+  v[at] = uint8_t(x >> 24); v[at + 1] = uint8_t(x >> 16); v[at + 2] = uint8_t(x >> 8); v[at + 3] = uint8_t(x);
+}
+// entries of 24 bytes: owner, id at +4, type at +8, value at +12
+std::vector<uint8_t> Settings(std::vector<std::pair<uint32_t, uint32_t>> items) {
+  std::vector<uint8_t> v(items.size() * 24);
+  for (size_t i = 0; i < items.size(); ++i) {
+    Put32(v, i * 24 + 4, items[i].first);
+    v[i * 24 + 8] = 1;
+    Put32(v, i * 24 + 12, items[i].second);
+  }
+  return v;
+}
+}  // namespace
+
+TEST_CASE("HostBan: no penalty is no ban, and clears the record", "[net][hostban]") {
+  HostBanRecord r{2, 100};
+  const auto s = UpdateHostBan(r, 0, 500);
+  CHECK_FALSE(s.banned);
+  CHECK_FALSE(s.lifted);
+  CHECK(r.penalty == 0);
+}
+
+TEST_CASE("HostBan: a penalty first seen starts 30 minutes, rounded up", "[net][hostban]") {
+  HostBanRecord r;
+  auto s = UpdateHostBan(r, 1, 1000);
+  CHECK(s.banned);
+  CHECK(s.minutes_left == 30);
+  s = UpdateHostBan(r, 1, 1000 + 3 * 60 + 1);
+  CHECK(s.minutes_left == 27);
+  s = UpdateHostBan(r, 1, 1000 + 1799);
+  CHECK(s.banned);
+  CHECK(s.minutes_left == 1);
+}
+
+TEST_CASE("HostBan: lifted at 30 minutes, while the save keeps its count", "[net][hostban]") {
+  HostBanRecord r;
+  UpdateHostBan(r, 3, 1000);
+  const auto s = UpdateHostBan(r, 3, 1000 + 1800);
+  CHECK_FALSE(s.banned);
+  CHECK(s.lifted);
+}
+
+TEST_CASE("HostBan: another quit restarts the 30 minutes, a lower count does not", "[net][hostban]") {
+  HostBanRecord r;
+  UpdateHostBan(r, 1, 1000);
+  auto s = UpdateHostBan(r, 2, 1000 + 1800);
+  CHECK(s.banned);
+  CHECK(s.minutes_left == 30);
+  s = UpdateHostBan(r, 1, 1000 + 1800 + 600);
+  CHECK(s.minutes_left == 20);
+}
+
+TEST_CASE("HostBan: a clock moved backwards cannot make the wait longer", "[net][hostban]") {
+  HostBanRecord r{1, 5000};
+  const auto s = UpdateHostBan(r, 1, 1000);
+  CHECK(s.minutes_left == 30);
+  CHECK(r.since == 1000);
+}
+
+TEST_CASE("HostBan: quit count plus standby demerits come from the settings array", "[net][hostban]") {
+  const auto v = Settings({{0x10, 7}, {0x15E, 2}, {0x20, 9}, {0x15F, 1}});
+  CHECK(HostPenaltyFromSettings(v.data(), v.size(), 4) == 3);
+}
+
+TEST_CASE("HostBan: Gears 2 keeps its quits and demerits under its own ids", "[net][hostban]") {
+  constexpr uint32_t kGears2 = 0x4D53082D;
+  const auto g2 = Settings({{0x10, 7}, {0x165, 2}, {0x20, 9}, {0x166, 1}});
+  CHECK(HostPenaltyFromSettings(g2.data(), g2.size(), 4, kGears2) == 3);
+  CHECK_FALSE(HostPenaltyFromSettings(g2.data(), g2.size(), 4));  // not Gears 3's ids
+  const auto g3 = Settings({{0x15E, 2}, {0x15F, 1}});
+  CHECK_FALSE(HostPenaltyFromSettings(g3.data(), g3.size(), 2, kGears2));
+}
+
+TEST_CASE("HostBan: memory that is not the settings array gives no penalty", "[net][hostban]") {
+  const auto only_one = Settings({{0x10, 7}, {0x15F, 1}});
+  CHECK_FALSE(HostPenaltyFromSettings(only_one.data(), only_one.size(), 2));
+  const auto absurd = Settings({{0x15E, 0xFFFFFFFF}, {0x15F, 1}});
+  CHECK_FALSE(HostPenaltyFromSettings(absurd.data(), absurd.size(), 2));
+  CHECK_FALSE(HostPenaltyFromSettings(nullptr, 0, 0));
+}
+
+TEST_CASE("HostBan: the record survives a restart", "[net][hostban]") {
+  const auto dir = std::filesystem::temp_directory_path() / "cogbox_host_ban_test";
+  std::filesystem::create_directories(dir);
+  const auto file = dir / "host_ban.json";
+  std::error_code ec;
+  std::filesystem::remove(file, ec);
+  HostBanRecord r;
+  CHECK_FALSE(LoadHostBan(file, &r));
+  REQUIRE(SaveHostBan(file, HostBanRecord{2, 12345}));
+  REQUIRE(LoadHostBan(file, &r));
+  CHECK(r.penalty == 2);
+  CHECK(r.since == 12345);
+  std::filesystem::remove(file, ec);
+}
+
+TEST_CASE("HostBan: a notice is taken once", "[net][hostban]") {
+  SetHostBanNotice(27);
+  CHECK(TakeHostBanNotice() == 27);
+  CHECK(TakeHostBanNotice() == 0);
+}
+
+TEST_CASE("HostBan: each game keeps its own timer in the shared online folder", "[net][host_ban]") {
+  SetHostBanFolder("online");
+  CHECK(HostBanFile(0x4D5308AB).filename() == "host_ban.json");  // Gears 3's file stays where it was
+  CHECK(HostBanFile(0x4D530A26).filename() == "host_ban_4D530A26.json");
+  SetHostBanFolder({});
+  CHECK(HostBanFile(0x4D530A26).empty());
+}
