diff --git a/include/rex/kernel/xam/net/socket_hooks.h b/include/rex/kernel/xam/net/socket_hooks.h
new file mode 100644
index 0000000..708000d
--- /dev/null
+++ b/include/rex/kernel/xam/net/socket_hooks.h
@@ -0,0 +1,55 @@
+// COGBox SDK patch 65: what xsocket.cpp / xam_net.cpp call for online play. Every function is a no-op (or a
+// pass-through) unless --net_online is on.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <utility>
+
+#include <rex/kernel/xam/net/sockaddr.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+namespace rex::kernel::xam::net {
+
+bool NetOnline();
+int BindPortOffset();  // --net_bind_port_offset, for two copies of a game on one PC
+
+// A game UDP socket was bound: register it, list its LAN addresses, try UPnP, start the 100 ms worker.
+void OnSocketBound(uint64_t native_handle);
+void OnSocketClosed(uint64_t native_handle);
+// Called after a game socket registered (online signaling retries offers that waited for one).
+void SetSocketRegisteredCallback(std::function<void(uint16_t port)> fn);
+
+// true = a STUN / punch packet, consumed: the caller reads the next packet instead of returning this one.
+bool OnPacketReceived(uint64_t native_handle, const uint8_t* data, size_t len, const sockaddr_in& from);
+
+// recvfrom() on a game socket without COGBox's own packets: STUN answers and punch packets are handed to the manager
+// and the next packet is read instead. A non-blocking socket with nothing else waiting fails with WSAEWOULDBLOCK as
+// usual; with MSG_PEEK a consumed packet is still removed. With net_online off this is plain recvfrom().
+int RecvFromFiltered(uint64_t native_handle, uint8_t* buf, uint32_t buf_len, int flags, sockaddr_in* from,
+                     socklen_t* from_len);
+
+// vip / port in host order.
+SendDecision OnSendTo(uint64_t native_handle, uint32_t vip, uint16_t port, const uint8_t* data, size_t len);
+
+// The local endpoint a game TCP connect to an online peer's virtual IP goes to instead (the stream tunnel), or
+// nullopt when online play is off or the tunnel could not start.
+std::optional<sockaddr_in> RedirectStreamConnect(uint32_t vip, uint16_t port);
+
+// Trace (--cogbox_net_trace): counts game UDP packets to / from virtual IPs per local port and peer, logged every 2 s.
+// what: "out routed", "out queued", "out dropped", "in". ip/port host order.
+void NoteUdp(const char* what, uint64_t native_handle, uint32_t ip, uint16_t port);
+
+// A packet from a peer's selected path -> (VIP, peer game port), host order.
+std::optional<std::pair<uint32_t, uint16_t>> RelabelFrom(const sockaddr_in& from, uint64_t native_handle = 0);
+// A packet RelabelFrom could not place, from a known peer's address: held back (the game resends) until the peer's
+// candidates for that socket arrive, so the game never sees a peer under its raw address.
+bool HoldUnlabelled(const sockaddr_in& from);
+// A game socket listening on this local TCP port. The tunnel only opens these: a peer must never reach anything else
+// listening on this PC's loopback address.
+void NoteGameListenPort(uint16_t local_port);
+bool IsGameListenPort(uint16_t local_port);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/stream_tunnel.h b/include/rex/kernel/xam/net/stream_tunnel.h
new file mode 100644
index 0000000..9cfe5e0
--- /dev/null
+++ b/include/rex/kernel/xam/net/stream_tunnel.h
@@ -0,0 +1,39 @@
+// COGBox SDK patch 65: game TCP connections to an online peer (UE3's party beacon) over the punched UDP path.
+//
+// The tunnel has its own UDP socket, registered like a game socket (STUN, punching, candidates), and one thread.
+// Guest: a game connect to VIP:port is sent to a local listener on 127.0.0.1; the accepted connection opens a tunnel
+// stream to that port on the peer. Host: a stream opened from a peer connects to 127.0.0.1:port (+ the bind offset),
+// the game's own listening socket. Bytes are shuttled both ways; a close on either end closes the other.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+#include <rex/kernel/xam/net/sockaddr.h>
+
+namespace rex::kernel::xam::net {
+
+class StreamTunnel {
+ public:
+  static StreamTunnel& Get();
+  bool Start();  // once; false if the socket could not be made
+  std::optional<sockaddr_in> RedirectConnect(uint32_t vip, uint16_t port);
+
+ private:
+  struct PendingListener {
+    uint64_t socket;
+    uint32_t vip;
+    uint16_t port;
+  };
+  void Run();
+
+  std::atomic<bool> started_{false};
+  uint64_t udp_ = ~0ull;
+  std::mutex mutex_;
+  std::vector<PendingListener> new_listeners_;
+};
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/tunnel_core.h b/include/rex/kernel/xam/net/tunnel_core.h
new file mode 100644
index 0000000..4c4638d
--- /dev/null
+++ b/include/rex/kernel/xam/net/tunnel_core.h
@@ -0,0 +1,100 @@
+// COGBox SDK patch 65: game TCP connections to an online peer (UE3's party beacon), carried as reliable ordered streams
+// in UDP frames over the punched path. This is the transport-independent part: frames in, frames out, time passed
+// in. stream_tunnel.h connects it to real sockets.
+//
+// Frame (big endian): "CGBT", version 1, type, conn id (4), seq (4), ack (4), port (2), payload length (2), payload.
+// The opener sends Syn with the port it wants on the other side; the other side answers SynAck (or Rst when nothing
+// listens there). Data and Fin carry sequence numbers from 1, are acknowledged cumulatively and resent after 250 ms;
+// up to 32 frames are in flight. An open that gets no answer in 10 s fails.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <map>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace rex::kernel::xam::net {
+
+enum class TunnelFrameType : uint8_t { Syn = 1, SynAck = 2, Data = 3, Ack = 4, Fin = 5, Rst = 6 };
+
+struct TunnelFrame {
+  TunnelFrameType type;
+  uint32_t conn;
+  uint32_t seq;
+  uint32_t ack;
+  uint16_t port;
+  std::vector<uint8_t> payload;
+};
+
+constexpr size_t kTunnelHeaderSize = 22;
+constexpr size_t kTunnelMaxPayload = 1100;
+
+std::vector<uint8_t> EncodeTunnelFrame(const TunnelFrame& f);
+std::optional<TunnelFrame> DecodeTunnelFrame(const uint8_t* data, size_t len);
+bool IsTunnelFrame(const uint8_t* data, size_t len);
+
+class TunnelCore {
+ public:
+  using Clock = std::chrono::steady_clock;
+  static constexpr auto kRetransmit = std::chrono::milliseconds(250);
+  static constexpr auto kSynRetry = std::chrono::milliseconds(200);
+  static constexpr auto kOpenTimeout = std::chrono::seconds(10);
+  static constexpr size_t kWindow = 32;
+
+  struct Callbacks {
+    std::function<void(uint32_t vip, const std::vector<uint8_t>& frame)> send_frame;
+    // The other side opened a connection to `port` here: connect it locally; false refuses it.
+    std::function<bool(uint32_t handle, uint16_t port)> open_local;
+    std::function<void(uint32_t handle, const uint8_t* data, size_t len)> deliver;
+    std::function<void(uint32_t handle)> established;  // an Open() was accepted
+    std::function<void(uint32_t handle)> closed;       // refused, timed out, reset, or closed by the other side
+  };
+
+  void SetCallbacks(Callbacks cb) { cb_ = std::move(cb); }
+
+  // A connection to `port` on the peer at `vip`; returns its handle (events come through the callbacks).
+  uint32_t Open(uint32_t vip, uint16_t port, Clock::time_point now);
+  void Send(uint32_t handle, const uint8_t* data, size_t len, Clock::time_point now);
+  void Close(uint32_t handle, Clock::time_point now);  // after what was sent; no more callbacks for it
+  void OnFrame(uint32_t from_vip, const uint8_t* data, size_t len, Clock::time_point now);
+  void Tick(Clock::time_point now);
+
+ private:
+  enum class State { SynSent, Established };
+  struct Segment {
+    uint32_t seq;
+    TunnelFrameType type;  // Data or Fin
+    std::vector<uint8_t> payload;
+    Clock::time_point sent;
+  };
+  struct Conn {
+    uint32_t vip;
+    uint32_t id;
+    uint16_t port;
+    State state;
+    Clock::time_point started, last_syn;
+    uint32_t next_seq = 1;
+    std::deque<uint8_t> to_send;
+    std::deque<Segment> unacked;
+    bool close_wanted = false, fin_sent = false;
+    uint32_t expected = 1;  // next in-order seq from the other side
+    std::map<uint32_t, TunnelFrame> early;
+  };
+
+  void Emit(const Conn& c, TunnelFrameType type, uint32_t seq, std::vector<uint8_t> payload = {});
+  void Pump(Conn& c, Clock::time_point now);
+  void Drop(uint32_t handle, bool notify);
+  std::optional<uint32_t> Find(uint32_t vip, uint32_t id) const;
+
+  Callbacks cb_;
+  std::map<uint32_t, Conn> conns_;                           // by handle
+  std::map<std::pair<uint32_t, uint32_t>, uint32_t> by_id_;  // (vip, conn id) -> handle
+  uint32_t next_handle_ = 1;
+  uint32_t next_id_ = 0;
+};
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/ue3_script.h b/include/rex/kernel/xam/net/ue3_script.h
new file mode 100644
index 0000000..d1742e9
--- /dev/null
+++ b/include/rex/kernel/xam/net/ue3_script.h
@@ -0,0 +1,38 @@
+// COGBox SDK patch 65 (social step 4): UE3 script bytecode the private match fixes look for, found by what it does
+// (not by offsets of one game build), so Gears 3 and Judgment share it.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace rex::kernel::xam::net {
+
+struct ScriptJump {
+  uint32_t at = 0;      // the statement's first byte (a Jump to target is written there)
+  uint16_t target = 0;  // the next statement
+};
+
+// A statement calling a function with (false, false, false, ...): EX_VirtualFunction (1B), FName, three EX_False (28),
+// one more argument and EX_EndFunctionParms (16). GearPartyGame_Base.OnStartPartyComplete's SetPartyInviteFlags.
+std::optional<ScriptJump> FindFalseFalseFalseCall(const uint8_t* code, size_t n);
+
+// The EX_JumpIfNot (07) whose condition tests the "bIsFromInvite" option and whose branch ends in a return:
+// GearPreGameLobbyGame_Base.PreLogin's refusal of invited players. Its offset.
+std::optional<uint32_t> FindInviteOptionCheck(const uint8_t* code, size_t n);
+
+// OnlinePlaylistManager.GetPopulationInfoFromPlaylist, rewritten to answer these totals: the game's population file
+// came from an Xbox server that is gone. Its first statements set the two out values to 0; they become
+// "WorldwideTotal = w; RegionTotal = r; return". False (and nothing changed) when the script is not that function.
+// Can be called again to change the numbers.
+bool SetPopulationScript(uint8_t* code, size_t n, int32_t worldwide, int32_t region);
+
+// UIWidget_MainMenu.UpdatePopulationNumbers' statement that looks up a playlist's "RankedPlaylistID" population. The
+// menu adds it to the Social one, and our totals are not per playlist, so it is jumped over.
+std::optional<ScriptJump> FindRankedPopulationCall(const uint8_t* code, size_t n);
+
+// The bytecode of the script function called `name`, once the engine has loaded it; nullptr until then. Scans every
+// object, so call it from a worker thread. The bytes may be patched in place.
+uint8_t* FindUe3Function(const char* name, uint32_t* count);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/virtual_peer_manager.h b/include/rex/kernel/xam/net/virtual_peer_manager.h
new file mode 100644
index 0000000..a85179b
--- /dev/null
+++ b/include/rex/kernel/xam/net/virtual_peer_manager.h
@@ -0,0 +1,169 @@
+// COGBox SDK patch 65: online peers as virtual IPs (10.254.0.0/16, a per-PC table) and the NAT path to each.
+//
+// Every path is punched from the game's own UDP sockets: STUN probes tell each socket its public address, punch
+// packets (punch.h) open the path, and game packets then go straight between the two game sockets. Nothing is relayed.
+// This class does no I/O itself: sends go through the SendFn and time is passed in, so it is testable without sockets.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <rex/kernel/xam/net/sockaddr.h>
+#include <rex/kernel/xam/net/stun.h>
+
+namespace rex::kernel::xam::net {
+
+struct Candidate {
+  sockaddr_in addr;  // network order
+  enum Kind : uint8_t { Host, Srflx, Upnp } kind;
+};
+
+enum class PeerState { Pending, Connected, Lost };
+
+enum class SendAction {
+  PassThrough,  // not a virtual IP: send as the game asked
+  Routed,       // send to `to` instead
+  Queued,       // held until the path is open; tell the game it was sent
+  Dropped,      // a virtual IP with no peer, or a lost peer; tell the game it was sent
+};
+
+struct SendDecision {
+  SendAction action;
+  sockaddr_in to;
+};
+
+class VirtualPeerManager {
+ public:
+  using Clock = std::chrono::steady_clock;
+  using SendFn = std::function<void(uint64_t native_handle, const uint8_t* data, size_t len, const sockaddr_in& to)>;
+
+  static constexpr auto kProbeInterval = std::chrono::milliseconds(100);
+  static constexpr auto kPunchTimeout = std::chrono::seconds(10);
+  static constexpr auto kKeepaliveInterval = std::chrono::seconds(15);
+  static constexpr auto kPeerSilent = std::chrono::seconds(40);  // more than two keepalives missed
+  static constexpr auto kQueueMaxAge = std::chrono::seconds(5);
+  static constexpr size_t kQueueMaxPackets = 1024;
+
+  static VirtualPeerManager& Get();
+  static bool IsVirtualIp(uint32_t ip);  // host order
+
+  void SetSendFn(SendFn fn);
+  void SetStunServer(const sockaddr_in& server);
+  // Called (without the lock) when STUN finds a new public address for a game socket's port.
+  void SetPublicAddressFn(std::function<void(uint16_t port)> fn);
+
+  // The game's UDP sockets (each one is probed and punches).
+  void RegisterSocket(uint64_t native_handle, uint16_t local_port);
+  void UnregisterSocket(uint64_t native_handle);
+  void AddLocalCandidate(uint16_t local_port, const Candidate& c);
+  std::vector<Candidate> LocalCandidates(uint16_t local_port) const;
+  std::map<uint16_t, std::vector<Candidate>> AllLocalCandidates() const;  // per registered game socket's port
+
+  // Peers. AddPeer returns the peer's virtual IP (host order), the same one for the same XUID; 0 when the subnet is full.
+  // A known peer with a new session token and nothing heard for kPeerSilent restarted its game: its old addresses are
+  // dropped and *restarted is set, so it is connected to afresh.
+  uint32_t AddPeer(uint64_t peer_xuid, uint64_t session_token, bool* restarted = nullptr, Clock::time_point now = Clock::now(),
+                   bool* token_changed = nullptr);
+  // The same for a peer offering again with the same token (a guest back after restarting). True when it was reset.
+  bool ResetIfSilent(uint32_t vip, Clock::time_point now);
+  // The peer said it is a new launch of its game: everything known about its addresses is out of date.
+  void ResetPeer(uint32_t vip);
+  // Where tunnel frames for a peer go: its tunnel socket's path once learned, every path until then or when that port
+  // is gone (the peer restarted, with a new tunnel socket).
+  std::vector<sockaddr_in> TunnelPaths(uint32_t vip, std::optional<uint16_t> tunnel_port) const;
+  // A learned tunnel port counts only while its frames keep coming: a game restarted within seconds has a new one
+  // while the old path still looks fine.
+  static constexpr auto kTunnelPortFresh = std::chrono::seconds(3);
+  static std::optional<uint16_t> FreshTunnelPort(uint16_t port, Clock::time_point last_frame, Clock::time_point now);
+  // Starts (or restarts) punching toward the peer socket on peer_game_port.
+  void SetRemoteCandidates(uint32_t vip, uint16_t peer_game_port, std::vector<Candidate> candidates,
+                           Clock::time_point now);
+  std::optional<sockaddr_in> Route(uint32_t vip, uint16_t peer_game_port) const;
+  // -> (VIP, peer game port). A packet from a peer's announced candidate on a port with no path yet opens that path
+  // (the packet proves it) and sends what was queued for it.
+  // native_handle: the socket it arrived on (0: unknown); a packet from a peer proves that socket's route.
+  std::optional<std::pair<uint32_t, uint16_t>> Relabel(const sockaddr_in& from, Clock::time_point now = Clock::now(),
+                                                       uint64_t native_handle = 0);
+  std::vector<std::pair<uint16_t, sockaddr_in>> Paths(uint32_t vip) const;
+  // The address (any port) is one of a peer's announced candidates or paths: a packet from it that Relabel cannot
+  // place comes from a socket the peer has not announced yet and must not reach the game with its raw address.
+  bool IsPeerAddress(const sockaddr_in& from) const;  // selected paths, by peer port
+  PeerState State(uint32_t vip) const;
+
+  // The data path. OnPacket returns true when the packet was COGBox's own (STUN, punch) and must not reach the game.
+  bool OnPacket(uint64_t native_handle, const uint8_t* data, size_t len, const sockaddr_in& from, Clock::time_point now);
+  SendDecision OnSend(uint64_t native_handle, uint32_t vip, uint16_t port, const uint8_t* data, size_t len,
+                      Clock::time_point now);
+  // STUN probes, punch probes, timeouts and keepalives; call about every 100 ms.
+  void Tick(Clock::time_point now);
+
+ private:
+  struct Outgoing {
+    uint64_t handle;
+    std::vector<uint8_t> data;
+    sockaddr_in to;
+  };
+  struct SocketInfo {
+    uint16_t local_port = 0;
+    StunTxId txid{};
+    std::optional<Clock::time_point> last_stun;
+  };
+  struct PortPath {
+    std::vector<Candidate> candidates;
+    std::optional<sockaddr_in> selected;          // the first path that worked (any of our sockets)
+    // A NAT that filters by address and port only lets in what comes from the endpoint a mapping was made for, so a
+    // route belongs to (our socket, this peer port): by_socket is the path each of our sockets has proven.
+    std::map<uint64_t, sockaddr_in> by_socket;
+    std::map<uint64_t, Clock::time_point> punching;  // our sockets still punching this port, since when
+    std::optional<Clock::time_point> last_pair_probe;
+  };
+  struct Queued {
+    uint64_t handle;
+    uint16_t port;
+    std::vector<uint8_t> data;
+    Clock::time_point time;
+  };
+  struct Peer {
+    uint64_t xuid = 0;
+    uint64_t token = 0;
+    PeerState state = PeerState::Pending;
+    std::map<uint16_t, PortPath> ports;
+    std::optional<Clock::time_point> started;
+    std::optional<Clock::time_point> last_probe;
+    Clock::time_point last_keepalive{};
+    Clock::time_point last_heard{};
+    uint32_t seq = 0;
+    std::deque<Queued> queue;
+  };
+
+  static uint64_t EndpointKey(const sockaddr_in& a);
+  void Send(std::vector<Outgoing>& out);  // without the lock held
+  void PruneQueue(Peer& p, Clock::time_point now);
+  // Needs mutex_.
+  bool SilentLocked(const Peer& p, Clock::time_point now) const;
+  void ResetPeerLocked(uint32_t vip, Peer& p);
+  void FlushLocked(uint32_t vip, Peer& p, std::vector<Outgoing>& out);
+
+  mutable std::mutex mutex_;
+  SendFn send_fn_;
+  std::function<void(uint16_t)> public_address_fn_;
+  std::optional<sockaddr_in> stun_server_;
+  std::map<uint64_t, SocketInfo> sockets_;
+  std::map<uint16_t, std::vector<Candidate>> local_candidates_;
+  std::map<uint32_t, Peer> peers_;
+  std::map<uint64_t, uint32_t> xuid_to_vip_;
+  std::map<uint64_t, std::pair<uint32_t, uint16_t>> endpoint_to_peer_;
+  uint32_t next_host_ = 1;
+
+  // Whose punch this is (a virtual IP), 0 when not ours or nothing tells. Needs mutex_.
+  uint32_t PunchSenderLocked(const sockaddr_in& from, uint64_t token) const;
+};
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/xfriends.h b/include/rex/kernel/xam/net/xfriends.h
new file mode 100644
index 0000000..a59f24f
--- /dev/null
+++ b/include/rex/kernel/xam/net/xfriends.h
@@ -0,0 +1,54 @@
+// COGBox SDK patch 65 (social step 4): the games' Xbox LIVE friends list (XFriendsCreateEnumerator, XLIVEBASE
+// 0x00058020) from the master server's friends. Gears 3 checks it before accepting a friend into a "joinable by
+// friends" lobby (a private match refused a friend while the list was empty).
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam::net {
+
+// XONLINE_FRIEND.dwFriendState flags (360 SDK).
+constexpr uint32_t kFriendOnline = 0x00000001;
+constexpr uint32_t kFriendPlaying = 0x00000002;
+constexpr uint32_t kFriendJoinable = 0x00000010;
+
+struct FriendEntry {
+  uint64_t xuid = 0;
+  std::string name;   // the account name (the tag without #1234)
+  std::string state;  // offline | online | playing | joinable
+  uint32_t title_id = 0;
+  std::array<uint8_t, 8> session_id{};   // the XNKID of a joinable friend's session (all zero otherwise)
+  std::string room_code;                 // of that session
+};
+
+// GET /api/v1/friends' answer -> the accepted friends (requests are not friends to the games).
+std::vector<FriendEntry> ParseFriendsList(const std::string& json);
+// The game's own Join: the friends' joinable sessions, kept from the last friends read so a session lookup by id
+// (XSessionSearchByID) can name the room.
+void RememberFriendSessions(const std::vector<FriendEntry>& friends);
+std::string RoomCodeForFriendSession(const std::array<uint8_t, 8>& session_id);
+// The account uuids of the friends (GET /api/v1/friends' answer) whose big-endian XUID occurs in a game's request.
+std::vector<std::string> FriendUuidsInRequest(const std::string& json, const std::vector<uint8_t>& request);
+// The XUIDs a game invite is addressed to: a big-endian 64-bit count, then that many XUIDs (traced in Gears 3's
+// "Invite team to party"). Empty when the request does not look like that.
+std::vector<uint64_t> InviteTargetXuids(const std::vector<uint8_t>& request);
+
+// XONLINE_FRIEND (196 bytes, big-endian): xuid @0, szGamertag[16] @8, dwFriendState @24, sessionID @28,
+// dwTitleID @36, ftUserTime @40, xnkidInvite @48, gameinviteTime @56, cchRichPresence @64, wszRichPresence[64] @68.
+std::array<uint8_t, 196> EncodeXOnlineFriend(const FriendEntry& f);
+
+// The XDK's packed call arguments (Gears 3 TU6 sub_82B1ED48): 16-byte entries {u32 type (4 = pointer), pad,
+// u64 value}, the count at +512. The pointer in entry `index`, or 0.
+uint32_t ParamBlockPointer(const uint8_t* block, size_t size, uint32_t index);
+
+// XStorageBuildServerPath (XLIVEBASE 0x00058035): a path the title then uploads to / downloads from. Under emulation
+// there is no storage server; the path only has to be well-formed (Judgment ends a match on it).
+std::u16string StorageServerPath(uint32_t facility, const std::string& item);
+// UTF-16BE with its terminator, at most `max_chars` characters including the terminator.
+std::vector<uint8_t> EncodeWideBE(const std::u16string& s, size_t max_chars);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/kernel/xam/net/xnaddr_online.h b/include/rex/kernel/xam/net/xnaddr_online.h
new file mode 100644
index 0000000..7aa8063
--- /dev/null
+++ b/include/rex/kernel/xam/net/xnaddr_online.h
@@ -0,0 +1,40 @@
+// COGBox SDK patch 65: online XNADDRs. A player's XNADDR carries "CGB1" + online XUID + session token (big endian) in
+// abOnline; another PC turns that XNADDR into a virtual IP (virtual_peer_manager.h) and back.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+namespace rex::kernel::xam::net {
+
+// XNADDR: ina (4), inaOnline (4), wPortOnline (2), abEnet (6), abOnline (20).
+constexpr size_t kXnAddrSize = 36;
+constexpr size_t kXnAddrOnlineOffset = 16;
+
+// XNetGetConnectStatus answers.
+constexpr uint32_t kXNetConnectIdle = 0;
+constexpr uint32_t kXNetConnectPending = 1;
+constexpr uint32_t kXNetConnectConnected = 2;
+constexpr uint32_t kXNetConnectLost = 3;
+
+void WriteOnlineMarker(uint8_t* ab_online, uint64_t xuid, uint64_t token);
+bool ReadOnlineMarker(const uint8_t* ab_online, uint64_t* xuid, uint64_t* token);
+
+// This PC's session token, put in its own XNADDR (0 when it hosts nothing).
+void SetLocalSessionToken(uint64_t token);
+uint64_t LocalSessionToken();
+
+// A CGB1 XNADDR -> the peer's virtual IP (host order), adding the peer the first time; 0 for any other XNADDR.
+uint32_t XnAddrToVip(const uint8_t* xnaddr);
+bool VipToXnAddr(uint32_t vip, uint8_t* xnaddr_out);
+// A peer known only from signaling (a guest, seen by the host): a CGB1 XNADDR made up from its XUID, token and an IP
+// (network order), unless the game already gave us its real one.
+void RegisterPeerXnAddr(uint32_t vip, uint64_t xuid, uint64_t token, uint32_t ina_network_order);
+uint32_t ConnectStatus(uint32_t vip);
+
+// Called once per new online peer (the master-server client sends it our candidates).
+void SetNewPeerCallback(std::function<void(uint32_t vip, uint64_t xuid, uint64_t token)> fn);
+
+}  // namespace rex::kernel::xam::net
diff --git a/include/rex/system/cogbox_save_sign.h b/include/rex/system/cogbox_save_sign.h
new file mode 100644
index 0000000..2652407
--- /dev/null
+++ b/include/rex/system/cogbox_save_sign.h
@@ -0,0 +1,28 @@
+// COGBox: Gears 3 save signatures. Gears 3 signs PlayerStorage.dat and its profile settings (63E83FFF + 63E83FFE +
+// 63E83FFD) with SHA-1(online XUID, 8 bytes big endian + data) in the first 20 bytes. Patch 58 re-signs COGBox's old
+// saves from the offline XUID to 0; COGBox SDK patch 65 (online play) re-signs them between 0 and the online XUID.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <vector>
+
+namespace rex::system {
+
+enum class ResignResult { Resigned, AlreadyDone, NotRecognised, TooSmall, NoBackup, WriteFailed };
+
+std::array<uint8_t, 20> CogSaveSignature(uint64_t key, const uint8_t* body, size_t len);
+
+// files in order; the signature sits in the first 20 bytes of files[0] and covers the rest of their concatenation.
+// A file signed with from_key is re-signed with to_key (data untouched): files[0] is copied once to
+// <file><backup_suffix> (checked by size), the new file goes to <file>.cogbox-tmp and is renamed over the original.
+ResignResult CogResignSaveFiles(const std::vector<std::filesystem::path>& files, uint64_t from_key, uint64_t to_key,
+                                const char* backup_suffix);
+
+// Every Gears 3 save under user_data_root: the profile's PlayerStorage.dat and each profile-settings set. Never throws.
+void CogConvertGears3SaveSigning(const std::filesystem::path& user_data_root, uint64_t profile_xuid, uint64_t from_key,
+                                 uint64_t to_key, const char* backup_suffix);
+
+}  // namespace rex::system
