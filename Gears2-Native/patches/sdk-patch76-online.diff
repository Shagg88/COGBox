+// --- Routes per local socket (two-PC test, 2026-11-06): a NAT that filters by address and port lets in only what
+// comes from the exact endpoint a mapping was made for, so a route belongs to (our socket, the peer's port).
+namespace {
+constexpr uint64_t kSockB = 0x5678;
+constexpr uint16_t kLocalPortB = 53077;
+const sockaddr_in kCandC = Addr(0xCB007107, 41000);  // the peer port's mapping as seen from our second socket
+std::vector<uint8_t> PunchFrom(PunchType t, uint16_t src_port) {
+  auto p = EncodePunch({t, kToken, 1, src_port});
+  return {p.begin(), p.end()};
+}
