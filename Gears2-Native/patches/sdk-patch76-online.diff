diff --git a/include/rex/kernel/xam/net/host_ban.h b/include/rex/kernel/xam/net/host_ban.h
new file mode 100644
index 0000000..70fa7f4
--- /dev/null
+++ b/include/rex/kernel/xam/net/host_ban.h
@@ -0,0 +1,42 @@
+// COGBox: Gears 3 refuses to host while the profile has quits or standby demerits, and the save has no time for them.
+// The game alone hands out that penalty; COGBox tells the player and lifts it 30 minutes later. The timer lives in its
+// own file: the save is never written.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+
+namespace rex::kernel::xam::net {
+
+constexpr int64_t kHostBanSeconds = 30 * 60;
+
+struct HostBanRecord {
+  int penalty = 0;    // the count when the timer last started or was last seen
+  int64_t since = 0;  // unix seconds
+};
+
+struct HostBanStatus {
+  bool banned = false;
+  bool lifted = false;  // the game still has a penalty, but its 30 minutes are over
+  int minutes_left = 0;
+};
+
+HostBanStatus UpdateHostBan(HostBanRecord& record, int penalty, int64_t now);
+
+// Quit count (setting 0x15F) + standby demerits (0x15E) from a guest OnlineProfileSetting array, whose entry size is
+// found by looking; nullopt when these bytes are not that array.
+std::optional<int> HostPenaltyFromSettings(const uint8_t* data, size_t bytes, size_t count, uint32_t title = 0x4D5308AB);
+
+bool LoadHostBan(const std::filesystem::path& file, HostBanRecord* record);
+bool SaveHostBan(const std::filesystem::path& file, const HostBanRecord& record);
+
+void SetHostBanFolder(const std::filesystem::path& dir);  // the online profile's folder
+std::filesystem::path HostBanFile(uint32_t title);  // one timer per game: the folder is shared by all four                      // empty before SetHostBanFolder
+
+// The minutes to show the player, once; 0 when there is nothing new. Any thread.
+void SetHostBanNotice(int minutes);
+int TakeHostBanNotice();
+
+}  // namespace rex::kernel::xam::net
