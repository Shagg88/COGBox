+TEST_CASE("Peers: game packets are never consumed", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  const uint8_t pkt[] = {0x10, 0x20, 0x30, 0x40, 0x50};
+  CHECK_FALSE(f.mgr.OnPacket(kSock, pkt, sizeof(pkt), kCandB, f.t0));
+}
+
+TEST_CASE("Peers: a selected path gets a keepalive every 15 s", "[net][peers]") {
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandB, Candidate::Srflx}}, f.t0);
+  auto ack = EncodePunch({PunchType::Ack, kToken, 0, kPeerPort});
+  f.mgr.OnPacket(kSock, ack.data(), ack.size(), kCandB, f.t0);
+  f.sent.clear();
+  f.mgr.Tick(f.t0 + 14s);
+  f.mgr.Tick(f.t0 + 15s);
+  size_t keepalives = 0;
+  for (const auto& s : f.sent) {
+    auto p = DecodePunch(s.data.data(), s.data.size());
+    if (p && p->type == PunchType::Keepalive && Same(s.to, kCandB) && s.handle == kSock) ++keepalives;
