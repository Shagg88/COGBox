+
+TEST_CASE("Peers: a punch that comes from one of our own addresses is ignored (no connecting to ourselves)",
+          "[net][peers]") {
+  Fixture f;
+  const sockaddr_in own = Addr(0x645ADC2B, kLocalPort);  // 100.90.220.43, our own host candidate
+  f.mgr.RegisterSocket(kSock, kLocalPort);
