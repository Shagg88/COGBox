+}
+
+TEST_CASE("Peers: a game packet from a peer's announced candidate is labelled before that path is punched",
+          "[net][peers]") {
+  // A guest's new game socket sends to the host at once; the host has its candidates but no punch from it yet. The
+  // packet must still show as coming from the peer's VIP, or the game makes its connection under the real address
+  // and later (labelled) packets never reach it.
+  Fixture f;
+  f.mgr.RegisterSocket(kSock, kLocalPort);
+  uint32_t vip = f.mgr.AddPeer(42, kToken);
+  f.mgr.SetRemoteCandidates(vip, kPeerPort, {{kCandA, Candidate::Host}, {kCandB, Candidate::Srflx}}, f.t0);
+  auto label = f.mgr.Relabel(kCandB);
+  REQUIRE(label.has_value());
+  CHECK(label->first == vip);
+  CHECK(label->second == kPeerPort);
+}
