diff --git a/tests/unit/net/online_signaling_test.cpp b/tests/unit/net/online_signaling_test.cpp
new file mode 100644
index 0000000..eb7b119
--- /dev/null
+++ b/tests/unit/net/online_signaling_test.cpp
@@ -0,0 +1,241 @@
+// COGBox SDK patch 65: who sends candidates to whom. The guest offers when the game resolves the host's XNADDR; the
+// host answers an unknown guest once and starts punching toward it.
+#include <catch2/catch_test_macros.hpp>
+
+#include <vector>
+
+#include <rex/kernel/xam/net/online_signaling.h>
+#include <rex/kernel/xam/net/punch.h>
+#include <rex/kernel/xam/net/virtual_peer_manager.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+sockaddr_in Addr(uint32_t ip, uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(ip);
+  a.sin_port = htons(port);
+  return a;
+}
+struct Fixture {
+  VirtualPeerManager mgr;
+  std::vector<CandidateMessage> sent;
+  std::vector<uint32_t> xnaddrs;  // VIPs given a made-up XNADDR (kept here, not in the process-wide table)
+  OnlineSignaling sig{mgr, [this](const CandidateMessage& m) { sent.push_back(m); },
+                      [this](uint32_t vip, uint64_t, uint64_t, uint32_t) { xnaddrs.push_back(vip); }};
+  Fixture() {
+    mgr.RegisterSocket(0x10, 1001);
+    mgr.AddLocalCandidate(1001, {Addr(0xC0A80102, 1001), Candidate::Host});
+    mgr.AddLocalCandidate(1001, {Addr(0xCB007102, 50000), Candidate::Srflx});
+  }
+};
+}  // namespace
+
+TEST_CASE("Signaling: a guest offers its candidates to the host it knows from the lobby list", "[net][signaling]") {
+  Fixture f;
+  f.sig.RememberHost(0x0009000000000001ull, "host-uuid");
+  const uint32_t vip = f.mgr.AddPeer(0x0009000000000001ull, 0x51);
+  f.sig.OnNewPeer(vip, 0x0009000000000001ull, 0x51);
+  REQUIRE(f.sent.size() == 1);
+  CHECK(f.sent[0].peer_uuid == "host-uuid");
+  CHECK(f.sent[0].session_token == 0x51);
+  CHECK(f.sent[0].port == 1001);
+  CHECK(f.sent[0].candidates.size() == 2);
+}
+
+TEST_CASE("Signaling: a player known only by XUID (another guest of the match) is offered by XUID", "[net][signaling]") {
+  Fixture f;
+  const uint32_t vip = f.mgr.AddPeer(0x0009000000000002ull, 0x52);
+  f.sig.OnNewPeer(vip, 0x0009000000000002ull, 0x52);
+  REQUIRE(f.sent.size() == 1);
+  CHECK(f.sent[0].peer_uuid.empty());
+  CHECK(f.sent[0].peer_xuid == 0x0009000000000002ull);
+  f.sig.OnNewPeer(vip, 0x0009000000000002ull, 0x52);  // once
+  CHECK(f.sent.size() == 1);
+}
+
+TEST_CASE("Signaling: a later game port reaches a player known only by XUID", "[net][signaling]") {
+  Fixture f;
+  f.sig.OnNewPeer(1, 0x0009000000000002ull, 0x52);
+  REQUIRE(f.sent.size() == 1);
+  f.mgr.RegisterSocket(0x11, 1002);
+  f.mgr.AddLocalCandidate(1002, {Addr(0xC0A80102, 1002), Candidate::Host});
+  f.sig.OfferPort(1002);
+  REQUIRE(f.sent.size() == 2);
+  CHECK(f.sent[1].peer_xuid == 0x0009000000000002ull);
+  CHECK(f.sent[1].port == 1002);
+}
+
+TEST_CASE("Signaling: a host answers an unknown guest once and starts punching", "[net][signaling]") {
+  Fixture f;
+  CandidateMessage in;
+  in.peer_uuid = "guest-uuid";
+  in.peer_xuid = 0x0009000000000003ull;
+  in.session_token = 0x53;
+  in.port = 2002;
+  in.candidates = {{Addr(0xCB007103, 41000), Candidate::Srflx}};
+  f.sig.OnCandidates(in, VirtualPeerManager::Clock::now());
+  REQUIRE(f.sent.size() == 1);
+  CHECK(f.sent[0].peer_uuid == "guest-uuid");
+  CHECK(f.sent[0].session_token == 0x53);
+  CHECK(f.sent[0].port == 1001);
+  const uint32_t vip = f.mgr.AddPeer(0x0009000000000003ull, 0x53);
+  CHECK(f.mgr.State(vip) == PeerState::Pending);
+  REQUIRE(f.xnaddrs.size() == 1);
+  CHECK(f.xnaddrs[0] == vip);
+  // The same guest again (another of its sockets, or a repeat): candidates are taken, no second answer.
+  in.port = 2003;
+  f.sig.OnCandidates(in, VirtualPeerManager::Clock::now());
+  CHECK(f.sent.size() == 1);
+}
+
+TEST_CASE("Signaling: the host's answer to an offer is not answered back", "[net][signaling]") {
+  Fixture f;
+  f.sig.RememberHost(0x0009000000000004ull, "host-uuid");
+  const uint32_t vip = f.mgr.AddPeer(0x0009000000000004ull, 0x54);
+  f.sig.OnNewPeer(vip, 0x0009000000000004ull, 0x54);
+  REQUIRE(f.sent.size() == 1);
+  CandidateMessage reply;
+  reply.peer_uuid = "host-uuid";
+  reply.peer_xuid = 0x0009000000000004ull;
+  reply.session_token = 0x54;
+  reply.port = 1000;
+  reply.candidates = {{Addr(0xCB007104, 40000), Candidate::Srflx}};
+  f.sig.OnCandidates(reply, VirtualPeerManager::Clock::now());
+  CHECK(f.sent.size() == 1);
+  CHECK(f.mgr.State(vip) == PeerState::Pending);
+}
+
+TEST_CASE("Signaling: an offer waits until the guest has a game socket, then goes out once", "[net][signaling]") {
+  VirtualPeerManager mgr;  // no socket registered yet: the game resolved the host before binding
+  std::vector<CandidateMessage> sent;
+  OnlineSignaling sig{mgr, [&](const CandidateMessage& m) { sent.push_back(m); }, nullptr};
+  sig.RememberHost(0x0009000000000005ull, "host-uuid");
+  const uint32_t vip = mgr.AddPeer(0x0009000000000005ull, 0x55);
+  sig.OnNewPeer(vip, 0x0009000000000005ull, 0x55);
+  CHECK(sent.empty());
+  mgr.RegisterSocket(0x20, 57406);
+  mgr.AddLocalCandidate(57406, {Addr(0xC0A80102, 57406), Candidate::Host});
+  sig.RetryPendingOffers();
+  REQUIRE(sent.size() == 1);
+  CHECK(sent[0].peer_uuid == "host-uuid");
+  CHECK(sent[0].port == 57406);
+  sig.RetryPendingOffers();
+  CHECK(sent.size() == 1);
+}
+
+TEST_CASE("Signaling: a game socket opened after the offer is offered to every peer already offered to",
+          "[net][signaling]") {
+  Fixture f;  // UE3 opens its game-traffic socket only after the join: the peer must learn its path too
+  f.sig.RememberHost(0x0009000000000004ull, "host-uuid");
+  const uint32_t vip = f.mgr.AddPeer(0x0009000000000004ull, 0x54);
+  f.sig.OnNewPeer(vip, 0x0009000000000004ull, 0x54);
+  REQUIRE(f.sent.size() == 1);
+  f.mgr.RegisterSocket(0x11, 1101);
+  f.mgr.AddLocalCandidate(1101, {Addr(0xC0A80102, 1101), Candidate::Host});
+  f.sig.OfferPort(1101);
+  REQUIRE(f.sent.size() == 2);
+  CHECK(f.sent[1].peer_uuid == "host-uuid");
+  CHECK(f.sent[1].session_token == 0x54);
+  CHECK(f.sent[1].port == 1101);
+  CHECK(f.sent[1].candidates.size() == 1);
+}
+
+TEST_CASE("Signaling: a port is not offered when no peer has been offered to", "[net][signaling]") {
+  Fixture f;
+  f.sig.OfferPort(1001);
+  CHECK(f.sent.empty());
+}
+
+TEST_CASE("Signaling: a host back with a new session is offered to again", "[net][signaling]") {
+  Fixture f;
+  f.sig.RememberHost(0x71, "host-uuid");
+  f.sig.OnNewPeer(1, 0x71, 0x51);
+  f.sig.OnNewPeer(1, 0x71, 0x51);  // the same session: once
+  REQUIRE(f.sent.size() == 1);
+  f.sig.OnNewPeer(1, 0x71, 0x52);
+  REQUIRE(f.sent.size() == 2);
+  CHECK(f.sent[1].session_token == 0x52);
+}
+
+TEST_CASE("Signaling: a guest back after restarting its game is answered again", "[net][signaling]") {
+  Fixture f;
+  const auto t0 = VirtualPeerManager::Clock::time_point{} + std::chrono::seconds(1000);
+  CandidateMessage in;
+  in.peer_uuid = "guest-uuid";
+  in.peer_xuid = 0x72;
+  in.session_token = 0x53;
+  in.port = 2003;
+  in.candidates = {{Addr(0xCB007103, 41000), Candidate::Srflx}};
+  f.sig.OnCandidates(in, t0);
+  REQUIRE(f.sent.size() == 1);
+  // it connects
+  const uint32_t vip = f.mgr.AddPeer(0x72, 0x53, nullptr, t0);
+  f.mgr.Tick(t0);
+  auto ack = EncodePunch({PunchType::Ack, 0x53, 0, 2003});
+  f.mgr.OnPacket(0x10, ack.data(), ack.size(), in.candidates[0].addr, t0);
+  REQUIRE(f.mgr.State(vip) == PeerState::Connected);
+  // while it is still talking, another of its sockets is no new offer
+  f.sig.OnCandidates(in, t0 + std::chrono::seconds(5));
+  CHECK(f.sent.size() == 1);
+  // minutes later, silent: the same offer means its game restarted
+  f.sig.OnCandidates(in, t0 + std::chrono::seconds(180));
+  CHECK(f.sent.size() == 2);
+}
+
+namespace {
+CandidateMessage GuestOffer(uint64_t launch) {
+  CandidateMessage in;
+  in.peer_uuid = "guest-uuid";
+  in.peer_xuid = 0x73;
+  in.session_token = 0x53;
+  in.launch_id = launch;
+  in.port = 2003;
+  in.candidates = {{Addr(0xCB007103, 41000), Candidate::Srflx}};
+  return in;
+}
+void Connect(Fixture& f, const CandidateMessage& in, VirtualPeerManager::Clock::time_point t) {
+  const uint32_t vip = f.mgr.AddPeer(in.peer_xuid, in.session_token, nullptr, t);
+  f.mgr.Tick(t);
+  auto ack = EncodePunch({PunchType::Ack, in.session_token, 0, in.port});
+  f.mgr.OnPacket(0x10, ack.data(), ack.size(), in.candidates[0].addr, t);
+  REQUIRE(f.mgr.State(vip) == PeerState::Connected);
+}
+const auto kT0 = VirtualPeerManager::Clock::time_point{} + std::chrono::seconds(1000);
+}  // namespace
+
+TEST_CASE("Signaling: what we send carries this game's launch id", "[net][signaling]") {
+  Fixture f;
+  f.sig.SetLaunchId(0xABC);
+  f.sig.RememberHost(0x71, "host-uuid");
+  f.sig.OnNewPeer(1, 0x71, 0x51);
+  REQUIRE(f.sent.size() == 1);
+  CHECK(f.sent[0].launch_id == 0xABC);
+}
+
+TEST_CASE("Signaling: a new launch id resets a peer at once, however recently it was heard", "[net][signaling]") {
+  Fixture f;
+  f.sig.OnCandidates(GuestOffer(1), kT0);
+  REQUIRE(f.sent.size() == 1);
+  Connect(f, GuestOffer(1), kT0);
+  const uint32_t vip = f.mgr.AddPeer(0x73, 0x53, nullptr, kT0);
+  auto again = GuestOffer(2);
+  again.port = 1000;
+  f.sig.OnCandidates(again, kT0 + std::chrono::seconds(2));  // two seconds later
+  CHECK(f.mgr.State(vip) == PeerState::Pending);
+  CHECK_FALSE(f.mgr.Route(vip, 2003).has_value());
+  CHECK(f.sent.size() == 2);  // answered: it knows nothing about us
+}
+
+TEST_CASE("Signaling: the same launch id, or none, does not reset a talking peer", "[net][signaling]") {
+  for (uint64_t later : {1ull, 0ull}) {
+    Fixture f;
+    f.sig.OnCandidates(GuestOffer(1), kT0);
+    Connect(f, GuestOffer(1), kT0);
+    const uint32_t vip = f.mgr.AddPeer(0x73, 0x53, nullptr, kT0);
+    f.sig.OnCandidates(GuestOffer(later), kT0 + std::chrono::seconds(2));
+    CHECK(f.mgr.State(vip) == PeerState::Connected);
+    CHECK(f.sent.size() == 1);
+  }
+}
