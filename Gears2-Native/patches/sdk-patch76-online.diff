+// COGBox SDK patch 65, trace: who in the game asked for a session leave / delete / end. Walks the guest stack (each
+// frame's back chain at [r1], the caller's saved LR at [back chain - 8]) from the current LR.
+#if REX_PLATFORM_WIN32
+REXCVAR_DEFINE_STRING(cogbox_ue3_gnames, "", "Network",
+                      "COGBox online play: a UE3 game's GNames variable (hex), to find script objects by name: the "
+                      "Gears 3 private match fixes (joinable pregame lobby) and the traces (Gears 3 TU6: 8344D918).");
+REXCVAR_DEFINE_STRING(cogbox_ue3_gengine, "", "Network",
+                      "COGBox online play: a UE3 game's GEngine variable (hex), to reach the current game: the Gears 3 "
+                      "private match fixes (joinable pregame lobby) and the traces (Gears 3 TU6: 8343987C).");
+namespace {
+bool GuestReadable(const uint8_t* host, size_t n) {
+  // the last 16 readable regions, per thread (VirtualQuery is a system call; reads hop between a few regions, such as
+  // objects and their names)
+  struct Region { const uint8_t *lo = nullptr, *hi = nullptr; };
+  static thread_local Region cache[16];
+  static thread_local unsigned next = 0;
+  for (const Region& r : cache) {
+    if (host >= r.lo && host + n <= r.hi) return true;
+  }
+  MEMORY_BASIC_INFORMATION mbi;
+  if (!VirtualQuery(host, &mbi, sizeof(mbi))) return false;
+  if (mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) || mbi.Protect == 0) return false;
+  Region& r = cache[next++ % 16];
+  r.lo = static_cast<const uint8_t*>(mbi.BaseAddress);
+  r.hi = r.lo + mbi.RegionSize;
+  return host + n <= r.hi;
+}
+// UField / UStruct / UProperty field offsets after the object header (Next 60, SuperField 64, Children 68, Script
+// 76 / 80, UProperty::Offset 84 in Gears 3 and Judgment); Gears 2's engine has them 8 bytes later (its Script at 84,
+// Gears2-Recomp gow2_script_patches.cpp). Found with the globals (Ue3Globals).
+std::atomic<uint32_t> g_ue3_shift{0};
+inline uint32_t kUe3Next() { return 60 + g_ue3_shift; }
+std::atomic<uint32_t> g_ue3_super{64};    // UStruct::SuperField: 64 (Gears 3, Judgment), 60 (Gears 2)
+std::atomic<uint32_t> g_ue3_objects{0};   // GObjObjects data and count, for scans by name
+std::atomic<uint32_t> g_ue3_ocount{0};
+inline uint32_t kUe3Super() { return g_ue3_super; }
+inline uint32_t kUe3Children() { return 68 + g_ue3_shift; }
+inline uint32_t kUe3Script() { return 76 + g_ue3_shift; }
+inline uint32_t kUe3PropOffset() { return 84 + g_ue3_shift; }
+bool GuestRead32(uint32_t a, uint32_t* out) {
+  if (a < 0x10000 || a >= 0xC0000000u || (a >= 0x7FC00000u && a < 0x80000000u) || (a & 3)) return false;
+  const uint8_t* h = REX_KERNEL_MEMORY()->TranslateVirtual(a);
+  if (!GuestReadable(h, 4)) return false;
+  *out = rex::memory::load_and_swap<uint32_t>(h);
+  return true;
+}
+std::string Ue3Name(uint32_t gnames_var, uint32_t index) {
+  uint32_t data = 0, count = 0, entry = 0;
+  if (!GuestRead32(gnames_var, &data) || !GuestRead32(gnames_var + 4, &count) || index >= count) return {};
+  if (!GuestRead32(data + 4 * index, &entry) || !entry) return {};
+  const uint8_t* h = REX_KERNEL_MEMORY()->TranslateVirtual(entry + 8);
+  if (!GuestReadable(h, 64)) return {};
+  std::string n;
+  for (int i = 0; i < 64 && h[i]; ++i) {
+    if (h[i] < 32 || h[i] > 126) return {};
+    n += char(h[i]);
+  }
+  return n;
+}
+// The UTF-16BE FString {data, count, max} at `a`, as ASCII (others as '?').
+std::string Ue3String(uint32_t a) {
+  uint32_t data = 0, count = 0;
+  if (!GuestRead32(a, &data) || !GuestRead32(a + 4, &count) || !data || count == 0 || count > 512) return {};
+  const uint8_t* h = REX_KERNEL_MEMORY()->TranslateVirtual(data);
+  if (!GuestReadable(h, count * 2)) return {};
+  std::string out;
+  for (uint32_t i = 0; i + 1 < count; ++i) {
+    const uint16_t c = uint16_t(h[2 * i] << 8 | h[2 * i + 1]);
+    out += (c >= 32 && c < 127) ? char(c) : '?';
+  }
+  return out;
+}
+// Every UE3 FString {data, count, max} on the guest stack whose text reads as words (a parameter block of a script
+// event the native code called, such as SetProgressMessage's error text), innermost first.
+std::string Ue3StackStrings(uint32_t sp) {
+  std::string out;
+  std::set<std::string> seen;
+  for (uint32_t a = sp; a < sp + 0x8000; a += 4) {
+    uint32_t data = 0, count = 0, max = 0;
+    if (!GuestRead32(a, &data) || !GuestRead32(a + 4, &count) || !GuestRead32(a + 8, &max)) continue;
+    if (count < 3 || count > 300 || max < count || max > 4096 || (data & 1) || data < 0x10000) continue;
+    const std::string v = Ue3String(a);
+    if (v.size() + 1 != count) continue;
+    size_t letters = 0;
+    for (char c : v) letters += std::isalpha(static_cast<unsigned char>(c)) ? 1 : 0;
+    if (letters * 2 < v.size() || !seen.insert(v).second) continue;
+    out += (out.empty() ? "\"" : " | \"") + v + "\"";
+    if (seen.size() >= 40) break;
+  }
+  return out;
