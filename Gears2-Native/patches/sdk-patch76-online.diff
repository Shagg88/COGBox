+}  // namespace
+
+HostBanStatus UpdateHostBan(HostBanRecord& r, int penalty, int64_t now) {
+  if (penalty <= 0) {
+    r = {};
+    return {};
+  }
+  if (penalty > r.penalty || now < r.since) {
+    r.since = now;  // another quit, a first sighting, or a clock moved backwards
+  }
+  r.penalty = penalty;
+  const int64_t left = kHostBanSeconds - (now - r.since);
+  HostBanStatus s;
+  if (left <= 0) {
+    s.lifted = true;
+  } else {
+    s.banned = true;
+    s.minutes_left = int((left + 59) / 60);
+  }
+  return s;
+}
+
+std::optional<int> HostPenaltyFromSettings(const uint8_t* data, size_t bytes, size_t count, uint32_t title) {
+  if (!data || !count) return std::nullopt;
+  const uint32_t kQuitCount = title == kGears2 ? 0x166 : 0x15F;
+  const uint32_t kStandbyDemerits = title == kGears2 ? 0x165 : 0x15E;
+  for (size_t stride = 16; stride <= 32; stride += 4) {
+    if (count * stride > bytes) break;
+    for (size_t id_at = 0; id_at + 12 <= stride && id_at <= 8; id_at += 4) {
+      std::optional<uint32_t> quits, demerits;
+      for (size_t i = 0; i < count; ++i) {
+        const uint8_t* e = data + i * stride + id_at;
+        const uint32_t id = Be32(e);
+        if (id == kQuitCount) quits = Be32(e + 8);
+        if (id == kStandbyDemerits) demerits = Be32(e + 8);
+      }
+      if (quits && demerits && *quits <= kMostPenalty && *demerits <= kMostPenalty) {
+        return int(*quits + *demerits);
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+bool LoadHostBan(const std::filesystem::path& file, HostBanRecord* record) {
+  std::ifstream in(file);
+  if (!in) return false;
+  const auto j = nlohmann::json::parse(in, nullptr, false);
+  if (!j.is_object() || !j.contains("penalty") || !j.contains("since")) return false;
+  if (!j["penalty"].is_number_integer() || !j["since"].is_number_integer()) return false;
+  record->penalty = j["penalty"].get<int>();
+  record->since = j["since"].get<int64_t>();
+  return true;
+}
+
+bool SaveHostBan(const std::filesystem::path& file, const HostBanRecord& record) {
+  auto tmp = file;
+  tmp += ".tmp";
+  {
+    std::ofstream out(tmp, std::ios::trunc);
+    if (!out) return false;
+    out << nlohmann::json{{"penalty", record.penalty}, {"since", record.since}}.dump();
+    if (!out) return false;
+  }
+  std::error_code ec;
+  std::filesystem::rename(tmp, file, ec);
+  return !ec;
+}
+
+void SetHostBanFolder(const std::filesystem::path& dir) {
+  std::lock_guard<std::mutex> lock(g_folder_mutex);
+  g_folder = dir;
+}
+
+std::filesystem::path HostBanFile(uint32_t title) {
+  std::lock_guard<std::mutex> lock(g_folder_mutex);
+  if (g_folder.empty()) return {};
+  if (title == 0x4D5308AB) return g_folder / "host_ban.json";
+  char name[32];
+  std::snprintf(name, sizeof(name), "host_ban_%08X.json", title);
+  return g_folder / name;
+}
+
+void SetHostBanNotice(int minutes) { g_notice = minutes; }
+int TakeHostBanNotice() { return g_notice.exchange(0); }
+
+}  // namespace rex::kernel::xam::net
