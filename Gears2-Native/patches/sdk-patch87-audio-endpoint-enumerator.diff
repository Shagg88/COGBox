 // volume, for the log), restores a muted / zero slider unless --audio_restore_session_volume=false, and returns the
 // default device's id so a change of default device (SDL moves the stream to it) is noticed and checked again.
 // inspect=false only returns the id (the 5 s poll): a slider the player moves during play is never touched.
+// COGBox patch 87 (0.6.1, second review K2): the 5 s poll ran CoInitializeEx + CoCreateInstance(MMDeviceEnumerator) +
+// CoUninitialize on the audio submit path every time - several milliseconds, now and then far more. The calling
+// thread now keeps COM and one enumerator for its lifetime; a poll is one GetDefaultAudioEndpoint + GetId.
+struct EndpointEnumerator {
+  HRESULT co = E_FAIL;
+  IMMDeviceEnumerator* en = nullptr;
+  EndpointEnumerator() { co = CoInitializeEx(nullptr, COINIT_MULTITHREADED); }
+  IMMDeviceEnumerator* Get() {  // made at the first poll; a creation that failed is tried again at the next one
+    if (!en && FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator),
+                                       reinterpret_cast<void**>(&en))))
+      en = nullptr;
+    return en; }
+  ~EndpointEnumerator() {
+    if (en) en->Release();
+    if (SUCCEEDED(co)) CoUninitialize();
+  }
+  EndpointEnumerator(const EndpointEnumerator&) = delete;
+  EndpointEnumerator& operator=(const EndpointEnumerator&) = delete;
+};
