@@ -535,6 +542,20 @@ X_RESULT MnkInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
   if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_down)))
     ly -= INT16_MAX;
 
+  // Patch 60 (#125): walk key - hold, or toggle on each press.
+  {
+    static bool walk_was_down = false, walk_toggled = false;
+    const bool walk_down = !REXCVAR_GET(keybind_walk).empty() && IsBindPressed(key_down_, REXCVAR_GET(keybind_walk));
+    if (walk_down && !walk_was_down) walk_toggled = !walk_toggled;
+    walk_was_down = walk_down;
+    const bool walking = REXCVAR_GET(mnk_walk_toggle) ? walk_toggled : walk_down;
+    if (walking) {
+      const double k = REXCVAR_GET(mnk_walk_scale);
