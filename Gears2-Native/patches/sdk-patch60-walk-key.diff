+// COGBox SDK patch 60 (GitHub #125): a walk key. While it is held (or after a press with mnk_walk_toggle), the
+// keyboard's left stick is scaled to mnk_walk_scale, so the character walks instead of jogging.
+REXCVAR_DEFINE_STRING(keybind_walk, "", "Input/Keybinds/Controller", "Walk (left stick scaled down)");
+REXCVAR_DEFINE_BOOL(mnk_walk_toggle, false, "Input", "Walk key toggles walking instead of being held");
+REXCVAR_DEFINE_DOUBLE(mnk_walk_scale, 0.5, "Input", "Left stick deflection while walking (0.1 - 1)")
+    .range(0.1, 1.0);
+
 REXCVAR_DEFINE_BOOL(mnk_passthrough, false, "Input",
