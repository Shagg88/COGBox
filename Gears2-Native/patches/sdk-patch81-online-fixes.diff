+  CHECK(f.mgr.OnSend(kSockB, vip, kPeerPort, game, 1, f.t0).action == SendAction::Relay);
+  // once socket B proves its own route, it goes direct
+  f.mgr.OnPacket(kSockB, a.data(), a.size(), kCandC, f.t0 + 1s);
+  auto d = f.mgr.OnSend(kSockB, vip, kPeerPort, game, 1, f.t0 + 1s);
