+
+// COGBox 0.5.0: a stale non-socket close of a handle number that a socket now uses must not destroy the socket
+class FakeSocket : public XObject {
+ public:
+  static constexpr Type kObjectType = Type::Socket;
+  FakeSocket() : XObject(Type::Socket) {}
+};
+
+TEST_CASE("ObjectTable keeps a socket handle unless closesocket releases it", "[kernel][object_table][net]") {
+  InitTestLogging();
+  ObjectTable table;
+  auto* sock = new FakeSocket();
+  X_HANDLE handle = 0;
+  table.AddHandle(sock, &handle);
+
+  CHECK(table.ReleaseHandle(handle) == X_STATUS_INVALID_HANDLE);  // e.g. NtClose of a stale handle
+  CHECK(table.LookupObject<XObject>(handle).get() == sock);
+
+  ObjectTable::AllowSocketRelease(true);
+  CHECK(table.ReleaseHandle(handle) == X_STATUS_SUCCESS);  // closesocket
+  ObjectTable::AllowSocketRelease(false);
+  CHECK(table.LookupObject<XObject>(handle).get() == nullptr);
+  table.Reset();
+}
