diff --git a/tests/unit/net/punch_test.cpp b/tests/unit/net/punch_test.cpp
new file mode 100644
index 0000000..afeb6f7
--- /dev/null
+++ b/tests/unit/net/punch_test.cpp
@@ -0,0 +1,50 @@
+// COGBox SDK patch 63: CGBP punch packet codec tests.
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/kernel/xam/net/punch.h>
+
+using namespace rex::kernel::xam::net;
+
+TEST_CASE("Punch packets round trip for every type", "[net][punch]") {
+  for (PunchType t : {PunchType::Punch, PunchType::Ack, PunchType::Keepalive}) {
+    PunchPacket in{t, 0xDEADBEEFCAFEF00Dull, 0x01020304u, 7777};
+    auto bytes = EncodePunch(in);
+    REQUIRE(bytes.size() == kPunchPacketSize);
+    CHECK(bytes[0] == 'C');
+    CHECK(bytes[3] == 'P');
+    CHECK(bytes[4] == 1);  // version
+    auto out = DecodePunch(bytes.data(), bytes.size());
+    REQUIRE(out.has_value());
+    CHECK(out->type == t);
+    CHECK(out->token == in.token);
+    CHECK(out->seq == in.seq);
+    CHECK(out->src_port == 7777);
+  }
+}
+
+TEST_CASE("Punch packets are big endian", "[net][punch]") {
+  auto bytes = EncodePunch(PunchPacket{PunchType::Ack, 0x0102030405060708ull, 0x0A0B0C0Du, 0x1E61});
+  CHECK(bytes[5] == 2);
+  CHECK(bytes[6] == 0x01);
+  CHECK(bytes[13] == 0x08);
+  CHECK(bytes[14] == 0x0A);
+  CHECK(bytes[17] == 0x0D);
+  CHECK(bytes[18] == 0x1E);  // src_port, the sender's local game port
+  CHECK(bytes[19] == 0x61);
+  CHECK(kPunchPacketSize == 20);
+}
+
+TEST_CASE("Punch decode rejects bad magic, version, type and length", "[net][punch]") {
+  auto good = EncodePunch(PunchPacket{PunchType::Punch, 1, 1, 1000});
+  auto bad_magic = good;
+  bad_magic[0] = 'X';
+  CHECK_FALSE(DecodePunch(bad_magic.data(), bad_magic.size()).has_value());
+  auto bad_version = good;
+  bad_version[4] = 2;
+  CHECK_FALSE(DecodePunch(bad_version.data(), bad_version.size()).has_value());
+  auto bad_type = good;
+  bad_type[5] = 9;
+  CHECK_FALSE(DecodePunch(bad_type.data(), bad_type.size()).has_value());
+  CHECK_FALSE(DecodePunch(good.data(), 19).has_value());
+  CHECK_FALSE(DecodePunch(good.data(), 0).has_value());
+}
diff --git a/tests/unit/net/stun_test.cpp b/tests/unit/net/stun_test.cpp
new file mode 100644
index 0000000..ba6ffa4
--- /dev/null
+++ b/tests/unit/net/stun_test.cpp
@@ -0,0 +1,82 @@
+// COGBox SDK patch 63: STUN Binding Request / Response codec tests.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstring>
+#include <vector>
+
+#include <rex/kernel/xam/net/punch.h>
+#include <rex/kernel/xam/net/stun.h>
+
+using namespace rex::kernel::xam::net;
+
+namespace {
+// RFC 5769 section 2.2: sample IPv4 response, mapped address 192.0.2.1:32853.
+const std::vector<uint8_t> kRfc5769Response = {
+    0x01, 0x01, 0x00, 0x3c, 0x21, 0x12, 0xa4, 0x42, 0xb7, 0xe7, 0xa7, 0x01, 0xbc, 0x34, 0xd6, 0x86,
+    0xfa, 0x87, 0xdf, 0xae, 0x80, 0x22, 0x00, 0x0b, 0x74, 0x65, 0x73, 0x74, 0x20, 0x76, 0x65, 0x63,
+    0x74, 0x6f, 0x72, 0x20, 0x00, 0x20, 0x00, 0x08, 0x00, 0x01, 0xa1, 0x47, 0xe1, 0x12, 0xa6, 0x43,
+    0x00, 0x08, 0x00, 0x14, 0x2b, 0x91, 0xf5, 0x99, 0xfd, 0x9e, 0x90, 0xc3, 0x8c, 0x74, 0x89, 0xf9,
+    0x2a, 0xf9, 0xba, 0x53, 0xf0, 0x6b, 0xe7, 0xd7, 0x80, 0x28, 0x00, 0x04, 0xc0, 0x7d, 0x4c, 0x96};
+const StunTxId kRfcTxId = {0xb7, 0xe7, 0xa7, 0x01, 0xbc, 0x34, 0xd6, 0x86, 0xfa, 0x87, 0xdf, 0xae};
+
+uint32_t HostIp(const sockaddr_in& a) { return ntohl(a.sin_addr.s_addr); }
+uint16_t HostPort(const sockaddr_in& a) { return ntohs(a.sin_port); }
+}  // namespace
+
+TEST_CASE("STUN binding request is 20 bytes with type, cookie and txid", "[net][stun]") {
+  StunTxId txid{};
+  for (int i = 0; i < 12; ++i) txid[i] = uint8_t(0x10 + i);
+  auto req = BuildStunBindingRequest(txid);
+  REQUIRE(req.size() == 20);
+  CHECK(req[0] == 0x00);
+  CHECK(req[1] == 0x01);
+  CHECK(req[2] == 0x00);
+  CHECK(req[3] == 0x00);
+  CHECK(req[4] == 0x21);
+  CHECK(req[5] == 0x12);
+  CHECK(req[6] == 0xA4);
+  CHECK(req[7] == 0x42);
+  CHECK(std::memcmp(req.data() + 8, txid.data(), 12) == 0);
+  CHECK(IsStunPacket(req.data(), req.size()));
+}
+
+TEST_CASE("STUN parses the RFC 5769 XOR-MAPPED-ADDRESS sample", "[net][stun]") {
+  auto addr = ParseStunBindingResponse(kRfc5769Response.data(), kRfc5769Response.size(), kRfcTxId);
+  REQUIRE(addr.has_value());
+  CHECK(HostIp(*addr) == 0xC0000201);  // 192.0.2.1
+  CHECK(HostPort(*addr) == 32853);
+}
+
+TEST_CASE("STUN falls back to MAPPED-ADDRESS", "[net][stun]") {
+  StunTxId txid{};
+  std::vector<uint8_t> msg = {0x01, 0x01, 0x00, 0x0c, 0x21, 0x12, 0xa4, 0x42};
+  msg.insert(msg.end(), txid.begin(), txid.end());
+  const uint8_t attr[] = {0x00, 0x01, 0x00, 0x08, 0x00, 0x01, 0x1f, 0x90, 203, 0, 113, 7};
+  msg.insert(msg.end(), attr, attr + sizeof(attr));
+  auto addr = ParseStunBindingResponse(msg.data(), msg.size(), txid);
+  REQUIRE(addr.has_value());
+  CHECK(HostIp(*addr) == 0xCB007107);  // 203.0.113.7
+  CHECK(HostPort(*addr) == 8080);
+}
+
+TEST_CASE("STUN rejects a wrong transaction id", "[net][stun]") {
+  StunTxId other = kRfcTxId;
+  other[0] ^= 0xFF;
+  CHECK_FALSE(ParseStunBindingResponse(kRfc5769Response.data(), kRfc5769Response.size(), other).has_value());
+}
+
+TEST_CASE("STUN rejects a truncated attribute", "[net][stun]") {
+  // Header says 0x3c bytes of attributes, but the buffer ends inside XOR-MAPPED-ADDRESS.
+  CHECK_FALSE(ParseStunBindingResponse(kRfc5769Response.data(), 40, kRfcTxId).has_value());
+  // The header length itself overruns the buffer.
+  std::vector<uint8_t> bad = kRfc5769Response;
+  bad[3] = 0x7c;
+  CHECK_FALSE(ParseStunBindingResponse(bad.data(), bad.size(), kRfcTxId).has_value());
+}
+
+TEST_CASE("IsStunPacket is false for punch packets and short packets", "[net][stun]") {
+  auto punch = EncodePunch(PunchPacket{PunchType::Punch, 0x1122334455667788ull, 7, 1000});
+  CHECK_FALSE(IsStunPacket(punch.data(), punch.size()));
+  const uint8_t tiny[3] = {0, 1, 0};
+  CHECK_FALSE(IsStunPacket(tiny, sizeof(tiny)));
+}
diff --git a/tests/unit/net/upnp_test.cpp b/tests/unit/net/upnp_test.cpp
new file mode 100644
index 0000000..86c5385
--- /dev/null
+++ b/tests/unit/net/upnp_test.cpp
@@ -0,0 +1,19 @@
+// COGBox SDK patch 63: UPnP port mapping. Discovery is bound to the loopback interface so the test never reaches (or
+// changes) a real router: no IGD answers, and the call must give up quickly.
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+
+#include <rex/kernel/xam/net/upnp.h>
+
+using namespace rex::kernel::xam::net;
+
+TEST_CASE("UPnP: no gateway means a quick, clean failure", "[net][upnp]") {
+  auto start = std::chrono::steady_clock::now();
+  UPnPResult r = TryUPnPPortMap(7777, 60, "127.0.0.1");
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+  CHECK_FALSE(r.success);
+  CHECK(r.external_port == 0);
+  CHECK(r.external_ip.empty());
+  CHECK(ms <= 2000);
+}
