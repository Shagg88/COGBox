@@ -0,0 +1,28 @@
+// COGBox SDK patch 63: STUN (RFC 5389) Binding Request / Response, the only STUN COGBox needs. A game socket asks the
+// STUN server what public address and port its packets come from.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include <rex/kernel/xam/net/sockaddr.h>
+
+namespace rex::kernel::xam::net {
+
+using StunTxId = std::array<uint8_t, 12>;
+
+constexpr uint32_t kStunMagicCookie = 0x2112A442;
+
+std::vector<uint8_t> BuildStunBindingRequest(const StunTxId& txid);
+
+// A STUN message: at least the 20-byte header, top two bits 0, the magic cookie at [4..8).
+bool IsStunPacket(const uint8_t* data, size_t len);
+
+// The mapped address (XOR-MAPPED-ADDRESS, else MAPPED-ADDRESS) of a Binding success response for txid, in network
+// order. nullopt for anything else or anything malformed.
+std::optional<sockaddr_in> ParseStunBindingResponse(const uint8_t* data, size_t len, const StunTxId& txid);
+
+}  // namespace rex::kernel::xam::net
