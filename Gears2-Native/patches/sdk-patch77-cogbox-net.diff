diff --git a/include/rex/kernel/xam/net/punch.h b/include/rex/kernel/xam/net/punch.h
new file mode 100644
index 0000000..05ac119
--- /dev/null
+++ b/include/rex/kernel/xam/net/punch.h
@@ -0,0 +1,27 @@
+// COGBox SDK patch 63: the CGBP punch packet. Sent from the game's own socket to open (and keep open) the NAT path to a
+// peer; never passed to the game.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace rex::kernel::xam::net {
+
+enum class PunchType : uint8_t { Punch = 1, Ack = 2, Keepalive = 3 };
+
+struct PunchPacket {
+  PunchType type;
+  uint64_t token;  // the session token both peers got from the master server
+  uint32_t seq;
+  uint16_t src_port;  // the sender's local game port, so the receiver knows which of the peer's sockets this is
+};
+
+constexpr uint8_t kPunchVersion = 1;
+constexpr size_t kPunchPacketSize = 4 + 1 + 1 + 8 + 4 + 2;  // "CGBP", version, type, token, seq, src_port (big endian)
+
+std::array<uint8_t, kPunchPacketSize> EncodePunch(const PunchPacket& p);
+std::optional<PunchPacket> DecodePunch(const uint8_t* data, size_t len);
+
+}  // namespace rex::kernel::xam::net
