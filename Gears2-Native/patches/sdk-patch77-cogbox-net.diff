diff --git a/src/kernel/xam/net/punch.cpp b/src/kernel/xam/net/punch.cpp
new file mode 100644
index 0000000..91f4386
--- /dev/null
+++ b/src/kernel/xam/net/punch.cpp
@@ -0,0 +1,40 @@
+// COGBox SDK patch 63: the CGBP punch packet.
+#include <rex/kernel/xam/net/punch.h>
+
+namespace rex::kernel::xam::net {
+
+std::array<uint8_t, kPunchPacketSize> EncodePunch(const PunchPacket& p) {
+  std::array<uint8_t, kPunchPacketSize> b{};
+  b[0] = 'C';
+  b[1] = 'G';
+  b[2] = 'B';
+  b[3] = 'P';
+  b[4] = kPunchVersion;
+  b[5] = uint8_t(p.type);
+  for (int i = 0; i < 8; ++i) {
+    b[6 + i] = uint8_t(p.token >> (56 - 8 * i));
+  }
+  for (int i = 0; i < 4; ++i) {
+    b[14 + i] = uint8_t(p.seq >> (24 - 8 * i));
+  }
+  b[18] = uint8_t(p.src_port >> 8);
+  b[19] = uint8_t(p.src_port);
+  return b;
+}
+
+std::optional<PunchPacket> DecodePunch(const uint8_t* d, size_t len) {
+  if (!d || len != kPunchPacketSize || d[0] != 'C' || d[1] != 'G' || d[2] != 'B' || d[3] != 'P' ||
+      d[4] != kPunchVersion || d[5] < uint8_t(PunchType::Punch) || d[5] > uint8_t(PunchType::Keepalive)) {
+    return std::nullopt;
+  }
+  PunchPacket p{PunchType(d[5]), 0, 0, uint16_t(d[18] << 8 | d[19])};
+  for (int i = 0; i < 8; ++i) {
+    p.token = p.token << 8 | d[6 + i];
+  }
+  for (int i = 0; i < 4; ++i) {
+    p.seq = p.seq << 8 | d[14 + i];
+  }
+  return p;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/stun.cpp b/src/kernel/xam/net/stun.cpp
new file mode 100644
index 0000000..0609ff5
--- /dev/null
+++ b/src/kernel/xam/net/stun.cpp
@@ -0,0 +1,86 @@
+// COGBox SDK patch 63: STUN Binding Request / Response.
+#include <rex/kernel/xam/net/stun.h>
+
+#include <cstring>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+constexpr uint16_t kBindingRequest = 0x0001;
+constexpr uint16_t kBindingSuccess = 0x0101;
+constexpr uint16_t kAttrMappedAddress = 0x0001;
+constexpr uint16_t kAttrXorMappedAddress = 0x0020;
+constexpr size_t kHeaderSize = 20;
+
+uint16_t Be16(const uint8_t* p) { return uint16_t(p[0] << 8 | p[1]); }
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+
+// An IPv4 address attribute value: reserved (1), family (1), port (2), address (4). IPv6 is not used.
+std::optional<sockaddr_in> ReadAddress(const uint8_t* v, uint16_t len, bool xored) {
+  if (len < 8 || v[1] != 0x01) {
+    return std::nullopt;
+  }
+  uint16_t port = Be16(v + 2);
+  uint32_t ip = Be32(v + 4);
+  if (xored) {
+    port ^= uint16_t(kStunMagicCookie >> 16);
+    ip ^= kStunMagicCookie;
+  }
+  sockaddr_in out{};
+  out.sin_family = AF_INET;
+  out.sin_port = htons(port);
+  out.sin_addr.s_addr = htonl(ip);
+  return out;
+}
+
+}  // namespace
+
+std::vector<uint8_t> BuildStunBindingRequest(const StunTxId& txid) {
+  std::vector<uint8_t> msg(kHeaderSize, 0);
+  msg[0] = uint8_t(kBindingRequest >> 8);
+  msg[1] = uint8_t(kBindingRequest);
+  msg[4] = uint8_t(kStunMagicCookie >> 24);
+  msg[5] = uint8_t(kStunMagicCookie >> 16);
+  msg[6] = uint8_t(kStunMagicCookie >> 8);
+  msg[7] = uint8_t(kStunMagicCookie);
+  std::memcpy(msg.data() + 8, txid.data(), txid.size());
+  return msg;
+}
+
+bool IsStunPacket(const uint8_t* data, size_t len) {
+  return data && len >= kHeaderSize && (data[0] & 0xC0) == 0 && Be32(data + 4) == kStunMagicCookie;
+}
+
+std::optional<sockaddr_in> ParseStunBindingResponse(const uint8_t* data, size_t len, const StunTxId& txid) {
+  if (!IsStunPacket(data, len) || Be16(data) != kBindingSuccess ||
+      std::memcmp(data + 8, txid.data(), txid.size()) != 0) {
+    return std::nullopt;
+  }
+  const size_t body = Be16(data + 2);
+  if (kHeaderSize + body > len) {
+    return std::nullopt;
+  }
+  std::optional<sockaddr_in> mapped;
+  size_t pos = kHeaderSize;
+  const size_t end = kHeaderSize + body;
+  while (pos + 4 <= end) {
+    const uint16_t type = Be16(data + pos);
+    const uint16_t alen = Be16(data + pos + 2);
+    if (pos + 4 + alen > end) {
+      return std::nullopt;
+    }
+    const uint8_t* value = data + pos + 4;
+    if (type == kAttrXorMappedAddress) {
+      if (auto a = ReadAddress(value, alen, true)) {
+        return a;
+      }
+    } else if (type == kAttrMappedAddress && !mapped) {
+      mapped = ReadAddress(value, alen, false);
+    }
+    pos += 4 + ((alen + 3u) & ~3u);
+  }
+  return mapped;
+}
+
+}  // namespace rex::kernel::xam::net
diff --git a/src/kernel/xam/net/upnp.cpp b/src/kernel/xam/net/upnp.cpp
new file mode 100644
index 0000000..515f138
--- /dev/null
+++ b/src/kernel/xam/net/upnp.cpp
@@ -0,0 +1,108 @@
+// COGBox SDK patch 63: UPnP IGD port mapping through miniupnpc.
+#include <rex/kernel/xam/net/upnp.h>
+
+#if defined(_WIN32)
+#include <winsock2.h>
+#include <miniupnpc.h>
+#include <upnpcommands.h>
+#endif
+
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+namespace rex::kernel::xam::net {
+
+#if defined(_WIN32)
+namespace {
+
+constexpr const char* kIgdTypes[] = {"urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+                                     "urn:schemas-upnp-org:device:InternetGatewayDevice:2", nullptr};
+
+std::mutex g_mutex;
+std::string g_control_url;
+std::string g_service_type;
+
+void EnsureWinsock() {
+  static const bool started = [] {
+    WSADATA wsa;
+    return WSAStartup(MAKEWORD(2, 2), &wsa) == 0;
+  }();
+  (void)started;
+}
+
+}  // namespace
+
+UPnPResult TryUPnPPortMap(uint16_t local_port, uint16_t lease_duration_sec, const char* multicast_if) {
+  EnsureWinsock();
+  UPnPResult result;
+  int error = 0;
+  // searchalltypes = 1: every M-SEARCH goes out first and the 1 s wait happens once (with 0, miniupnpc waits after
+  // each type; it also raises any delay under 1000 ms to 1000).
+  UPNPDev* devices = upnpDiscoverDevices(kIgdTypes, 1000, multicast_if, nullptr, 0, 0, 2, &error, 1);
+  if (!devices) {
+    return result;
+  }
+  UPNPUrls urls{};
+  IGDdatas data{};
+  char lan[64] = {};
+  char wan[64] = {};
+  const int igd = UPNP_GetValidIGD(devices, &urls, &data, lan, sizeof(lan), wan, sizeof(wan));
+  freeUPNPDevlist(devices);
+  if (igd != UPNP_CONNECTED_IGD) {
+    if (igd != UPNP_NO_IGD) {
+      FreeUPNPUrls(&urls);
+    }
+    return result;
+  }
+  char port[8];
+  char lease[8];
+  std::snprintf(port, sizeof(port), "%u", unsigned(local_port));
+  std::snprintf(lease, sizeof(lease), "%u", unsigned(lease_duration_sec));
+  int r = UPNP_AddPortMapping(urls.controlURL, data.first.servicetype, port, port, lan, "COGBox online", "UDP",
+                              nullptr, lease);
+  if (r != UPNPCOMMAND_SUCCESS) {  // some gateways only take a permanent lease (error 725)
+    r = UPNP_AddPortMapping(urls.controlURL, data.first.servicetype, port, port, lan, "COGBox online", "UDP",
+                            nullptr, "0");
+  }
+  if (r == UPNPCOMMAND_SUCCESS) {
+    char external[40] = {};
+    if (UPNP_GetExternalIPAddress(urls.controlURL, data.first.servicetype, external) == UPNPCOMMAND_SUCCESS &&
+        external[0]) {
+      result.external_ip = external;
+    } else {
+      result.external_ip = wan;
+    }
+    result.success = !result.external_ip.empty();
+    result.external_port = result.success ? local_port : 0;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_control_url = urls.controlURL ? urls.controlURL : "";
+    g_service_type = data.first.servicetype;
+  }
+  FreeUPNPUrls(&urls);
+  return result;
+}
+
+void ReleaseUPnPPortMap(uint16_t local_port) {
+  std::string url, type;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    url = g_control_url;
+    type = g_service_type;
+  }
+  if (url.empty()) {
+    return;  // nothing was mapped
+  }
+  char port[8];
+  std::snprintf(port, sizeof(port), "%u", unsigned(local_port));
+  UPNP_DeletePortMapping(url.c_str(), type.c_str(), port, "UDP", nullptr);
+}
+
+#else
+
+UPnPResult TryUPnPPortMap(uint16_t, uint16_t, const char*) { return {}; }
+void ReleaseUPnPPortMap(uint16_t) {}
+
+#endif
+
+}  // namespace rex::kernel::xam::net
