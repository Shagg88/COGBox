+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::kernel::xam::net {
+
+struct UPnPResult {
+  bool success{false};
+  std::string external_ip;
+  uint16_t external_port{0};
+};
+
+// Maps UDP local_port -> the same external port on the gateway. Discovery waits at most 1 s; a missing or refusing
+// gateway returns success=false. multicast_if limits discovery to one local interface (tests pass "127.0.0.1").
+UPnPResult TryUPnPPortMap(uint16_t local_port, uint16_t lease_duration_sec = 3600, const char* multicast_if = nullptr);
+void ReleaseUPnPPortMap(uint16_t local_port);
+
+}  // namespace rex::kernel::xam::net
