+// COGBox SDK patch 98 (GitHub #245): see SendDs5TriggerEffect above. InputSystem calls this with its own mutex held, as
+// SetDeviceVibration (same lock order: InputSystem, then controllers_mutex_).
+X_RESULT SDLInputDriver::SetDeviceTriggerEffect(DeviceId id, const uint8_t* right11, const uint8_t* left11) {
+  if (!sdl_events_initialized_ || !SDL_Gamepad_initialized_) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  auto guard = DrainAndLock();
+  auto controller = FindController(id);
+  if (!controller) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  // The pad's real type, not a mapping's (DualSense and DualSense Edge are both PS5). A DualSense that Steam Input
+  // shows as an Xbox pad is not one here - Steam owns its triggers then.
+  if (SDL_GetRealGamepadType(controller->sdl) != SDL_GAMEPAD_TYPE_PS5) {
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  const char* name = SDL_GetGamepadName(controller->sdl);
+  if (!SendDs5TriggerEffect(controller->sdl, right11, left11)) {
+    static std::atomic<bool> warned{false};
+    if (!warned.exchange(true)) {
+      REXLOG_WARN("SDL: DualSense adaptive-trigger effect not sent to \"{}\": {}", name ? name : "?", SDL_GetError());
+    }
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  if (!controller->trigger_effect_sent) {
+    controller->trigger_effect_sent = true;
+    REXLOG_INFO("SDL: DualSense adaptive triggers on \"{}\" (device {}), first effect R {:02X} L {:02X}",
+                name ? name : "?", static_cast<uint64_t>(id), right11 ? right11[0] : 0,
+                left11 ? left11[0] : 0);
+  }
+  return X_ERROR_SUCCESS;
+}
