+bool InputSystem::AdaptiveTriggersEnabled() { return REXCVAR_GET(pad_adaptive_triggers); }
+
+// COGBox SDK patch 98 (GitHub #245). The game's call is cheap when nothing changed (no HID write): it may call every
+// few hundred ms, which is also how a reconnected pad (a new DeviceId) gets the effect back.
+X_RESULT InputSystem::SetTriggerEffect(uint32_t user_index, const uint8_t* right11, const uint8_t* left11) {
+  if (!REXCVAR_GET(pad_adaptive_triggers)) {
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  if (user_index >= kMaxGuestUsers) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  std::lock_guard<std::recursive_mutex> lock(mutex_);
+  if (!assignment_ || !g_trigger_driver) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  TriggerEffect& e = trigger_effects_[user_index];
+  bool changed = !e.set;
+  e.set = true;
+  if (right11 && std::memcmp(e.right.data(), right11, e.right.size()) != 0) {
+    std::memcpy(e.right.data(), right11, e.right.size());
+    changed = true;
+  }
+  if (left11 && std::memcmp(e.left.data(), left11, e.left.size()) != 0) {
+    std::memcpy(e.left.data(), left11, e.left.size());
+    changed = true;
+  }
+  RefreshDevices();
+  return ApplyTriggerEffectLocked(user_index, changed) ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+size_t InputSystem::ApplyTriggerEffectLocked(uint32_t user_index, bool force) {
+  TriggerEffect& e = trigger_effects_[user_index];
+  if (!e.set || !g_trigger_driver || !assignment_) {
+    return 0;
+  }
+  const bool off = ui_input_blockers_.load() > 0;
+  if (off != e.applied_off) {
+    force = true;    // UI opened or closed: every pad gets "off" / the effect back
+  } else if (off) {
+    force = false;   // a new effect while the UI is open waits for it to close (the pads already hold "off")
+  }
+  std::vector<DeviceId> ids;
+  assignment_->DevicesForUser(user_index, ids);
+  std::vector<DeviceId> holding;
+  for (DeviceId id : ids) {
+    // Only the SDL driver's own devices: never the keyboard / mouse, NOP or a game's script pad.
+    if (DriverForDevice(id) != g_trigger_driver) {
+      continue;
+    }
+    if (!force && std::find(e.sent_to.begin(), e.sent_to.end(), id) != e.sent_to.end()) {
+      holding.push_back(id);
+      continue;
+    }
+    // Not a PS5 pad: X_ERROR_FUNCTION_FAILED without a write; asked again on the next call (cheap, no I/O).
+    if (g_trigger_driver->SetDeviceTriggerEffect(id, off ? kTriggerOff.data() : e.right.data(),
+                                                 off ? kTriggerOff.data() : e.left.data()) == X_ERROR_SUCCESS) {
+      holding.push_back(id);
+    }
+  }
+  e.sent_to = std::move(holding);
+  e.applied_off = off;
+  return e.sent_to.size();
+}
+
+void InputSystem::ReapplyTriggerEffects() {
+  if (!REXCVAR_GET(pad_adaptive_triggers)) {
+    return;
+  }
+  std::lock_guard<std::recursive_mutex> lock(mutex_);
+  for (uint32_t user_index = 0; user_index < kMaxGuestUsers; user_index++) {
+    if (trigger_effects_[user_index].set) {
+      ApplyTriggerEffectLocked(user_index, false);   // forced by itself when "off" changed
+    }
+  }
+}
