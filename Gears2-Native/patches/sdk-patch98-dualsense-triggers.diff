+// COGBox SDK patch 98 (GitHub #245): DualSense adaptive triggers. SDL_SendGamepadEffect on a PS5 pad takes the body of
+// the DS5 output report; SDL's HIDAPI PS5 driver adds the report id (USB 0x02; Bluetooth 0x31 + its 0x02 tag and the
+// CRC) and queues it on its rumble thread, so the call does not wait for the pad. Body layout = SDL 3.4's own
+// test/testcontroller.c (DS5EffectsState_t, CyclePS5TriggerEffect):
+//   [0] enable bits 1: 0x04 = right trigger effect is valid, 0x08 = left (0x01 / 0x02 rumble - not set here, so the
+//       motors, lights and audio keep whatever SDL last sent)
+//   [1] enable bits 2, [2..9] rumble / audio / mic (left 0)
+//   [10..20] right trigger effect (11 bytes: mode, parameters)
+//   [21..31] left trigger effect
+//   [32..46] LEDs etc. (left 0, not enabled)
+// The pad keeps a trigger effect until it is sent another (or loses power), so the effect is sent only when it changes.
+constexpr int kDs5EffectsSize = 47;
+bool SendDs5TriggerEffect(SDL_Gamepad* gamepad, const uint8_t* right11, const uint8_t* left11) {
+  uint8_t report[kDs5EffectsSize] = {};
+  if (right11) {
+    report[0] |= 0x04;
+    std::memcpy(&report[10], right11, 11);
+  }
+  if (left11) {
+    report[0] |= 0x08;
+    std::memcpy(&report[21], left11, 11);
+  }
+  return !report[0] || SDL_SendGamepadEffect(gamepad, report, kDs5EffectsSize);
+}
