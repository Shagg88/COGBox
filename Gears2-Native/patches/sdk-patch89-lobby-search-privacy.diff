+
+TEST_CASE("Sessions: patch 89 - the session block sent to the server has no LAN address", "[net][sessions]") {
+  Fixture f;
+  std::array<uint8_t, 60> info{};
+  for (size_t i = 0; i < 8; ++i) info[i] = uint8_t(0xA0 + i);                 // XNKID
+  const uint8_t ip[4] = {192, 168, 1, 20};
+  std::copy(ip, ip + 4, info.begin() + 8);                                     // XNADDR.ina
+  const uint8_t mac[6] = {0x02, 0x00, 192, 168, 1, 20};
+  std::copy(mac, mac + 6, info.begin() + 18);                                  // XNADDR.abEnet (made from the IP)
+  WriteOnlineMarker(info.data() + 8 + kXnAddrOnlineOffset, 0x0009000011223344ull, 0x55);  // XNADDR.abOnline
+  for (size_t i = 44; i < 60; ++i) info[i] = uint8_t(i);                       // XNKEY
+  f.sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, info, 0xD1);
+  REQUIRE(f.backend.created.size() == 1);
+  const auto& sent = f.backend.created[0].session_info;
+  for (size_t i = 8; i < 12; ++i) CHECK(sent[i] == 0);                         // no IP
+  CHECK(sent[18] == 0x02);
+  CHECK(sent[19] == 0x00);
+  CHECK(!(sent[20] == 192 && sent[21] == 168 && sent[22] == 1 && sent[23] == 20));   // no IP in the MAC either
+  CHECK(sent[20] == 0x11);   // made from the XUID instead: still one per player
+  CHECK(sent[23] == 0x44);
+  CHECK(std::equal(info.begin(), info.begin() + 8, sent.begin()));             // XNKID kept
+  CHECK(std::equal(info.begin() + 24, info.end(), sent.begin() + 24));        // online marker and key kept
+}
