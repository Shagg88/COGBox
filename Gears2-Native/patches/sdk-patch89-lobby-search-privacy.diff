+namespace {
+// COGBox SDK patch 89: the session block a lobby is registered with leaves this PC (anyone who searches can read it),
+// so its XNADDR goes without the LAN address: ina is zeroed and the MAC made from that IP (02:00:a.b.c.d) is made from
+// the XUID in the online marker instead (still one per player). Online peers never use either: they reach the host
+// through the marker and its virtual IP. The game's own XNADDR is untouched, so System Link / LAN keep the real IP.
+std::array<uint8_t, 60> WithoutLanAddress(std::array<uint8_t, 60> info) {
+  constexpr size_t kXnAddr = 8, kIna = kXnAddr + 0, kEnet = kXnAddr + 10;
+  std::fill_n(info.begin() + kIna, 4, uint8_t(0));
+  uint64_t xuid = 0, token = 0;
+  ReadOnlineMarker(info.data() + kXnAddr + kXnAddrOnlineOffset, &xuid, &token);
+  info[kEnet + 0] = 0x02;
+  info[kEnet + 1] = 0x00;
+  for (int i = 0; i < 4; ++i) info[kEnet + 2 + i] = uint8_t(xuid >> (8 * (3 - i)));
+  return info;
+}
