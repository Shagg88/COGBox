@@ -27,6 +27,12 @@ namespace rex::filesystem {
 // Gears2-Native SDK patch 32 (vfs.h).
 static std::atomic<FileOpenObserver> g_file_open_observer{nullptr};
 void SetFileOpenObserver(FileOpenObserver observer) { g_file_open_observer.store(observer); }
+// COGBox SDK patch 52 (vfs.h).
+static std::atomic<FileOpenFailedObserver> g_file_open_failed_observer{nullptr};
+void SetFileOpenFailedObserver(FileOpenFailedObserver observer) { g_file_open_failed_observer.store(observer); }
+static void NotifyFileOpenFailed(std::string_view path) {
+  if (const FileOpenFailedObserver observer = g_file_open_failed_observer.load(std::memory_order_relaxed)) observer(path);
+}
 
