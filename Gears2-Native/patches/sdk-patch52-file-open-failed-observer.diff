 using FileOpenObserver = void (*)(std::string_view guest_path, const std::filesystem::path* host_path);
 void SetFileOpenObserver(FileOpenObserver observer);
+// COGBox SDK patch 52 (GitHub #54): an optional observer told about every file open that fails because the file (or its
+// folder) does not exist: the guest path the title asked for, on the opening thread. Judgment's end-of-chapter loading
+// screen only looks up a LoadingMovie*.txt that is not there, so this is the one sign that screen gives. One observer;
+// null = none (the default). Keep it cheap. REX_FILESYSTEM_FILE_OPEN_FAILED_OBSERVER tells code it exists.
+#define REX_FILESYSTEM_FILE_OPEN_FAILED_OBSERVER 1
+using FileOpenFailedObserver = void (*)(std::string_view guest_path);
+void SetFileOpenFailedObserver(FileOpenFailedObserver observer);
 
