+namespace {
+// COGBox SDK patch 121: search hints for BaseHeap::AllocRange, kept OUTSIDE
+// BaseHeap so the class layout (and every game exe built against it) stays
+// as it is. Every page below `low` and every page above `high` is in use, so
+// a scan may start there and still pick exactly the page the full scan would.
+// Pages only become free in Release / Reset / Restore / Initialize, which
+// widen the hints again. Read and written under the heap's own mutex
+// (Initialize / Reset / Restore run before or outside guest allocation).
+struct AllocHints {
+  const void* heap = nullptr;
+  uint32_t low = 0;
+  uint32_t high = UINT32_MAX;
+};
+constexpr size_t kMaxAllocHints = 32;
+AllocHints g_alloc_hints[kMaxAllocHints];
+std::atomic<size_t> g_alloc_hint_count{0};
+std::mutex g_alloc_hint_add_mutex;
+AllocHints* FindAllocHints(const void* heap) {
+  size_t n = g_alloc_hint_count.load(std::memory_order_acquire);
+  for (size_t i = 0; i < n; ++i) {
+    if (g_alloc_hints[i].heap == heap) {
+      return &g_alloc_hints[i];
+    }
+  }
+  return nullptr;
+}
+// Full range again (or a new entry); nullptr when the table is full - then
+// that heap just keeps the full scan.
+void ResetAllocHints(const void* heap, size_t page_count) {
+  AllocHints* h = FindAllocHints(heap);
+  if (!h) {
+    std::lock_guard<std::mutex> lock(g_alloc_hint_add_mutex);
+    h = FindAllocHints(heap);
+    if (!h) {
+      size_t n = g_alloc_hint_count.load(std::memory_order_relaxed);
+      if (n >= kMaxAllocHints) {
+        return;
+      }
+      g_alloc_hints[n].heap = heap;
+      h = &g_alloc_hints[n];
+      g_alloc_hint_count.store(n + 1, std::memory_order_release);
+    }
+  }
+  h->low = 0;
+  h->high = page_count ? uint32_t(page_count - 1) : UINT32_MAX;
+}
+}  // namespace
