+PingView CurrentPing() {   // patch 93
+  PingView v;
+  OnlineSessions* s = ActiveOnlineSessions();
+  if (!s) return v;
+  auto& peers = VirtualPeerManager::Get();
+  const auto now = VirtualPeerManager::Clock::now();
+  if (auto host = s->JoinedHostXuid()) {   // a session someone else hosts that the game joined
+    v.kind = PingView::ToHost;
+    if (auto ms = peers.PingMs(*host, now)) v.ms = *ms;
+    return v;
+  }
+  // players the game put in our sessions come before an old join target (someone we once joined may now join us)
+  const std::vector<uint64_t> members = s->Hosting() ? s->HostedMembers() : std::vector<uint64_t>{};
+  if (!members.empty()) {
+    v.kind = PingView::Hosting;
+    for (uint64_t xuid : members) {
+      if (auto ms = peers.PingMs(xuid, now)) {
+        ++v.players;
+        v.ms = std::max(v.ms, *ms);
+      }
+    }
+    return v;
+  }
+  // a party / co-op join creates no session here: the host whose lobby the game looked up, while its game packets
+  // arrive (a failed join stops them at once). Forgotten 30 s after the lookup once its packets have stopped.
+  if (auto target = s->TargetHostXuid()) {
+    if (peers.RecentGameTraffic(*target, now)) {
+      v.kind = PingView::ToHost;
+      if (auto ms = peers.PingMs(*target, now)) v.ms = *ms;
+      return v;
+    }
+    if (std::chrono::steady_clock::now() - s->TargetHostSince() > std::chrono::seconds(30)) s->ForgetTargetHost();
+  }
+  if (s->Hosting()) v.kind = PingView::Hosting;   // on our own: "(hosting)"
+  return v;
+}
