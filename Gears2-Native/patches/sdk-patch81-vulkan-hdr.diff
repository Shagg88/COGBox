+++ b/src/ui/shaders/immediate_hdr.ps.hlsl
@@ -1,8 +1,15 @@
 // COGBox's host overlays are authored in SDR sRGB. The HDR10 swapchain expects
 // PQ/BT.2020; writing SDR white (1.0) directly would mean 10,000 nits.
-Texture2D<float4> uiTexture : register(t0);
-SamplerState uiSampler : register(s0);
-float4 main(float2 uv : TEXCOORD0, float4 vertexColor : COLOR0) : SV_Target0 {
+#ifdef __spirv__
+#define UI_BIND [[vk::combinedImageSampler]][[vk::binding(0, 0)]]
+#define UI_LOCATION(n) [[vk::location(n)]]
+#else
+#define UI_BIND
+#define UI_LOCATION(n)
+#endif
+UI_BIND Texture2D<float4> uiTexture : register(t0);
+UI_BIND SamplerState uiSampler : register(s0);
+float4 main(UI_LOCATION(0) float2 uv : TEXCOORD0, UI_LOCATION(1) float4 vertexColor : COLOR0) : SV_Target0 {
   float4 color = saturate(uiTexture.SampleLevel(uiSampler, uv, 0.0) * vertexColor);
   color = float4(isfinite(color.r) ? color.r : 0.0,
                  isfinite(color.g) ? color.g : 0.0,
