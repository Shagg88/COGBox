@@ -1305,6 +1306,22 @@
       // Just pick any format.
       image_format = surface_formats.front();
     }
+  }
+
+  // The guest image is already BT.2020 / PQ. Negotiate its matching surface
+  // rather than displaying those codes through an SDR colour space.
+  if (REXCVAR_GET(present_hdr)) {
+    const auto hdr = std::find_if(surface_formats.begin(), surface_formats.end(), [](const auto& format) {
+      return format.colorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT &&
+             (format.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32 ||
+              format.format == VK_FORMAT_A2R10G10B10_UNORM_PACK32);
+    });
+    if (hdr == surface_formats.end()) {
+      REXLOG_ERROR("VulkanPresenter: HDR10 requested but no 10-bit ST2084 surface format is available; enable Windows/compositor HDR or disable HDR in COGBox");
+      return VK_NULL_HANDLE;
+    }
+    image_format = *hdr;
+    REXLOG_INFO("VulkanPresenter: HDR10 ST2084 colour space selected (format {})", int(image_format.format));
   }
 
   // Get presentation modes.
