+SystemLinkNet DetectSystemLinkNet() {
+  SystemLinkNet net;
+  // The cvar text is never echoed into the log: a player may type their own addresses there.
+  const std::string peers = REXCVAR_GET(net_peer_ip);
+  size_t start = 0;
+  while (start < peers.size()) {
+    size_t end = peers.find_first_of(", ;", start);
+    if (end == std::string::npos) {
+      end = peers.size();
+    }
+    const std::string token = peers.substr(start, end - start);
+    uint32_t peer = 0;
+    if (token.empty()) {
+    } else if (ParseIpv4(token, &peer) && peer != 0 && peer != INADDR_BROADCAST) {
+      net.peers.push_back(peer);
+      REXKRNL_INFO("System link: peer {}", LogIp(peer));
+    } else {
+      REXKRNL_WARN("System link: an entry of net_peer_ip is not an IPv4 address; skipped");
+    }
+    start = end + 1;
+  }
+
+  const std::string wanted_text = REXCVAR_GET(net_interface_ip);
+  uint32_t wanted = 0;
+  const bool has_wanted = !wanted_text.empty() && ParseIpv4(wanted_text, &wanted);
+  if (!wanted_text.empty() && !has_wanted) {
+    REXKRNL_WARN("System link: net_interface_ip is not an IPv4 address; choosing automatically");
+  }
+
+  // Automatic choice: the adapter on the same subnet as the first net_peer_ip (a VPN user names a peer anyway, since
+  // Radmin drops broadcasts), else the one with the default gateway (the LAN), else a Radmin / ZeroTier / Hamachi
+  // adapter. A VPN that is installed but unused no longer wins over the real LAN.
+  const std::vector<NetAdapter> adapters = ListAdapters();
+  const NetAdapter* best = nullptr;
+  int best_score = -1;
+  for (const auto& a : adapters) {
+    int score = 0;
+    if (has_wanted) {
+      score = a.ip == wanted ? 100 : -1;
+    } else if (!net.peers.empty() && a.prefix && SameSubnet(a.ip, net.peers.front(), a.prefix)) {
+      score = 80;
+    } else {
+      score = a.gateway ? 20 : a.vpn ? 10 : 0;
+    }
+    REXKRNL_INFO("System link: adapter {}/{}{}{}", LogIp(a.ip), a.prefix, a.vpn ? " (VPN)" : "",
+                 a.gateway ? " (gateway)" : "");
+    if (score > best_score) {
+      best_score = score;
+      best = &a;
+    }
+  }
+  if (best && best_score >= 0) {
+    net.ip = best->ip;
+    net.broadcast = best->prefix == 0 || best->prefix >= 31 ? INADDR_BROADCAST
+                                                            : best->ip | ((1u << (32 - best->prefix)) - 1);
+    REXKRNL_INFO("System link: using {}/{}, broadcast {} (chosen once; restart the game after changing networks)",
+                 LogIp(net.ip), best->prefix, LogIp(net.broadcast));
+  } else {
+    REXKRNL_WARN("System link: {}; using 127.0.0.1 (this PC only)",
+                 has_wanted ? "no active adapter has net_interface_ip" : "no active network adapter");
+  }
+  return net;
+}
+
+// Chosen on the first network call, not at start-up.
+const SystemLinkNet& GetSystemLinkNet() {
+  static const SystemLinkNet net = DetectSystemLinkNet();
+  return net;
+}
+
+// The MAC in an XNADDR only has to tell consoles apart (RakNet builds its IDs from it, see XNetGetTitleXnAddr), so it
+// is made from the IP: locally administered 02:00:a:b:c:d.
+void FillXnAddr(XNADDR* addr, uint32_t ip) {
+  std::memset(reinterpret_cast<uint8_t*>(addr), 0, sizeof(XNADDR));
+  addr->ina.s_addr = htonl(ip);
+  const uint8_t mac[6] = {0x02, 0x00, uint8_t(ip >> 24), uint8_t(ip >> 16), uint8_t(ip >> 8), uint8_t(ip)};
+  std::memcpy(addr->abEnet, mac, 6);
+}
+
+// A system link XNKID has 0 in its high nibble.
+void RandomXnKid(uint8_t* xnkid) {
+  std::random_device rnd;
+  for (int i = 0; i < 8; ++i) {
+    xnkid[i] = uint8_t(rnd());
+  }
+  xnkid[0] &= 0x0F;
+}
+
+// A broadcast (255.255.255.255) goes to the broadcast address of the chosen adapter, or the OS sends it on the
+// default adapter only and a VPN never sees it, and a copy goes straight to each net_peer_ip. The game stops searching
+// when a send fails, so success from any copy counts.
+int SendToSystemLink(XSocket* socket, uint8_t* buf, uint32_t buf_len, uint32_t flags, N_XSOCKADDR_IN* to,
+                     uint32_t to_len) {
+  if (!REXCVAR_GET(net_system_link) || uint32_t(to->sin_addr) != INADDR_BROADCAST) {
+    return socket->SendTo(buf, buf_len, flags, to, to_len);
+  }
+  const SystemLinkNet& net = GetSystemLinkNet();
+  N_XSOCKADDR_IN target = *to;
+  target.sin_addr = net.broadcast;
+  int ret = socket->SendTo(buf, buf_len, flags, &target, to_len);
+  for (uint32_t peer : net.peers) {
+    target.sin_addr = peer;
+    const int peer_ret = socket->SendTo(buf, buf_len, flags, &target, to_len);
+    if (ret < 0 && peer_ret >= 0) {
+      ret = peer_ret;
+    }
+  }
+  return ret;
+}
+
+}  // namespace
+
+bool XNetSystemLinkEnabled() {
+  return REXCVAR_GET(net_system_link);
+}
+
+void XNetFillHostSessionInfo(uint8_t* session_info, uint8_t* nonce) {
+  if (!XNetSystemLinkEnabled()) {
+    return;
+  }
+  // XSESSION_INFO { XNKID sessionID (8); XNADDR hostAddress (36); XNKEY keyExchangeKey (16); } = 60 bytes.
+  uint8_t xnkid[8];
+  RandomXnKid(xnkid);
+  std::memcpy(session_info, xnkid, 8);
+  XNADDR host;
+  FillXnAddr(&host, GetSystemLinkNet().ip);
+  std::memcpy(session_info + 8, &host, sizeof(host));
+  // The same fixed key XNetCreateKey hands out (Netplay LAN mode), so the 16 bytes are never left as stale guest data.
+  for (uint8_t i = 0; i < 16; ++i) {
+    session_info[8 + sizeof(XNADDR) + i] = i;
+  }
+  if (nonce) {
+    std::random_device rnd;
+    for (int i = 0; i < 8; ++i) {
+      nonce[i] = uint8_t(rnd());
+    }
+  }
+  REXKRNL_INFO("System link: hosting session {:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X} at {}", xnkid[0],
+               xnkid[1], xnkid[2], xnkid[3], xnkid[4], xnkid[5], xnkid[6], xnkid[7],
+               LogIp(GetSystemLinkNet().ip));
+}
