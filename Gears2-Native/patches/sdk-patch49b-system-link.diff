 XNetStartupParams xnet_startup_params = {};
 
+// COGBox SDK patch 49: system link. Before this patch the XNADDR was always 127.0.0.1, the link status said "cable
+// unplugged" (the game shows "No Network Connection"), and keys and connections were stubs, so no game could be found
+// or joined. Now one adapter is chosen once (net_interface_ip, or automatically), the XNADDR carries its IP, a
+// broadcast goes out on that adapter's subnet (and to each net_peer_ip), and XNetXnAddrToInAddr gives the IP back.
+namespace {
+
+static_assert(sizeof(XNADDR) == 36, "XNADDR is 36 bytes");
+
+// IPs here are host-order numbers (a.b.c.d = a << 24 | b << 16 | c << 8 | d).
+struct SystemLinkNet {
+  uint32_t ip = INADDR_LOOPBACK;
+  uint32_t broadcast = INADDR_BROADCAST;
+  std::vector<uint32_t> peers;
+};
+
+struct NetAdapter {
+  uint32_t ip;
+  uint32_t prefix;
+  bool vpn;
+  bool gateway;
+};
+
+std::string IpText(uint32_t ip) {
+  return std::to_string(ip >> 24) + "." + std::to_string((ip >> 16) & 0xFF) + "." +
+         std::to_string((ip >> 8) & 0xFF) + "." + std::to_string(ip & 0xFF);
+}
+
+// For the log only (logs get attached to public GitHub issues): private and link-local addresses are shown in full, as
+// they are what a player needs to compare between PCs; any other address (a public IP, or a VPN range such as Radmin's
+// 26.x or Hamachi's 25.x, which identify the player) only shows its first and last number.
+std::string LogIp(uint32_t ip) {
+  const bool local = (ip >> 24) == 10 || (ip >> 20) == 0xAC1 || (ip >> 16) == 0xC0A8 || (ip >> 16) == 0xA9FE ||
+                     (ip >> 22) == (0x64400000u >> 22) || (ip >> 24) == 127 || ip == INADDR_BROADCAST;
+  return local ? IpText(ip) : std::to_string(ip >> 24) + ".x.x." + std::to_string(ip & 0xFF);
+}
+
+bool SameSubnet(uint32_t a, uint32_t b, uint32_t prefix) {
+  const uint32_t mask = prefix == 0 ? 0 : prefix >= 32 ? ~0u : ~((1u << (32 - prefix)) - 1);
+  return (a & mask) == (b & mask);
+}
+
+bool ParseIpv4(const std::string& text, uint32_t* ip) {
+  in_addr a = {};
+  if (inet_pton(AF_INET, text.c_str(), &a) != 1) {
+    return false;
+  }
+  *ip = ntohl(a.s_addr);
+  return true;
+}
+
+#if REX_PLATFORM_WIN32
+bool IsVpnName(const wchar_t* text) {
+  if (!text) {
+    return false;
+  }
+  std::wstring name(text);
+  for (auto& c : name) {
+    c = wchar_t(std::towlower(c));
+  }
+  for (const wchar_t* vpn : {L"radmin", L"zerotier", L"hamachi"}) {
+    if (name.find(vpn) != std::wstring::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::vector<NetAdapter> ListAdapters() {
+  std::vector<NetAdapter> adapters;
+  ULONG size = 32 * 1024;
+  std::vector<uint8_t> buffer;
+  ULONG rc = ERROR_BUFFER_OVERFLOW;
+  for (int tries = 0; tries < 4 && rc == ERROR_BUFFER_OVERFLOW; ++tries) {
+    buffer.resize(size);
+    rc = GetAdaptersAddresses(AF_INET,
+                              GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_SKIP_MULTICAST,
+                              nullptr, reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buffer.data()), &size);
+  }
+  if (rc != NO_ERROR) {
+    REXKRNL_WARN("System link: GetAdaptersAddresses failed ({})", rc);
+    return adapters;
+  }
+  for (auto* a = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buffer.data()); a; a = a->Next) {
+    if (a->OperStatus != IfOperStatusUp || a->IfType == IF_TYPE_SOFTWARE_LOOPBACK) {
+      continue;
+    }
+    // Some security software adds an adapter with a 0.0.0.0 gateway; that is no way out.
+    bool gateway = false;
+    for (auto* g = a->FirstGatewayAddress; g; g = g->Next) {
+      auto* sin = reinterpret_cast<sockaddr_in*>(g->Address.lpSockaddr);
+      if (sin->sin_family == AF_INET && sin->sin_addr.s_addr != 0) {
+        gateway = true;
+      }
+    }
+    const bool vpn = IsVpnName(a->FriendlyName) || IsVpnName(a->Description);
+    for (auto* u = a->FirstUnicastAddress; u; u = u->Next) {
+      auto* sin = reinterpret_cast<sockaddr_in*>(u->Address.lpSockaddr);
+      const uint32_t ip = ntohl(sin->sin_addr.s_addr);
+      if (sin->sin_family != AF_INET || (ip >> 16) == 0xA9FE) {  // 169.254.x.x: no DHCP answer, not a network
+        continue;
+      }
+      adapters.push_back({ip, u->OnLinkPrefixLength, vpn, gateway});
+    }
+  }
+  return adapters;
+}
+#else
+std::vector<NetAdapter> ListAdapters() {
+  std::vector<NetAdapter> adapters;
+  ifaddrs* list = nullptr;
+  if (getifaddrs(&list) != 0) {
+    REXKRNL_WARN("System link: getifaddrs failed");
+    return adapters;
+  }
+  for (ifaddrs* i = list; i; i = i->ifa_next) {
+    if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET || !(i->ifa_flags & IFF_UP) ||
+        (i->ifa_flags & IFF_LOOPBACK)) {
+      continue;
+    }
+    const std::string name = i->ifa_name ? i->ifa_name : "";
+    const uint32_t ip = ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr.s_addr);
+    if ((ip >> 16) == 0xA9FE) {
+      continue;
+    }
+    uint32_t mask = i->ifa_netmask ? ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_netmask)->sin_addr.s_addr) : 0;
+    uint32_t prefix = 0;
+    for (; mask & 0x80000000u; mask <<= 1) {
+      ++prefix;
+    }
+    // ZeroTier names its adapters zt*, Hamachi ham0. There is no gateway list here, so every adapter counts as one.
+    // (COGBox runs under Wine / Proton on Linux and takes the Windows path above; this is for a native build.)
+    const bool vpn = name.rfind("zt", 0) == 0 || name.rfind("ham", 0) == 0;
+    adapters.push_back({ip, prefix, vpn, true});
+  }
+  freeifaddrs(list);
+  return adapters;
+}
+#endif
