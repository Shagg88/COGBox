+// The modifier bit a bare modifier key name stands for ("Shift", "Ctrl"...), or 0.
+uint8_t BareModifierBit(std::string_view token) {
+  if (token == "Shift" || token == "LShift" || token == "RShift") return kModShift;
+  if (token == "Ctrl" || token == "Control" || token == "LControl" || token == "RControl") return kModCtrl;
+  if (token == "Alt" || token == "LMenu" || token == "RMenu" || token == "Menu") return kModAlt;
+  return 0;
+}
+
+// Modifiers some bind uses as a key of its own (e.g. keybind_left_shoulder=Shift).
+// Those are left out of the exact modifier match, so holding them neither
+// silences the other binds (W while Shift is held) nor is needed by them.
+uint8_t g_bare_mod_mask = 0;
+
 bool TokenPressed(const bool (&key_down)[256], std::string_view token, uint8_t live_mods) {
+  if (BareModifierBit(token)) {   // a bare modifier is a key: pressed whatever else is held
+    rex::ui::VirtualKey mvk = rex::ui::ParseVirtualKey(token);
+    if (mvk == rex::ui::VirtualKey::kNone) {
+      const uint8_t bit = BareModifierBit(token);
+      mvk = bit == kModShift ? rex::ui::VirtualKey::kShift
+            : bit == kModCtrl ? rex::ui::VirtualKey::kControl : rex::ui::VirtualKey::kMenu;
+    }
+    const uint16_t midx = static_cast<uint16_t>(mvk);
+    return midx < 256 && key_down[midx];
+  }
   uint8_t want = TakeModifiers(token);
