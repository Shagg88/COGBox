+        std::error_code fec;
+        if (std::filesystem::exists(f, fec) && !fec) files.push_back(f);
+      }
+    }
+    // Review r79 R6: players 2-4's own settings (patch 71: <setting>.p2 - .p4 beside player 1's) are copied too.
+    for (const char* title : {"4D5308AB", "4D530A26"}) {
+      const auto prof = root / title / "profile";
+      std::error_code pec;
+      if (!std::filesystem::is_directory(prof, pec)) continue;
+      for (auto it = std::filesystem::directory_iterator(prof, pec); !pec && it != std::filesystem::directory_iterator();
+           it.increment(pec)) {
+        std::error_code dec;
+        if (!it->is_directory(dec) || dec) continue;
+        for (const char* n : {"63E83FFF", "63E83FFE", "63E83FFD"}) {
+          for (const char* p : {".p2", ".p3", ".p4"}) {
+            auto f = it->path() / n;
+            f += p;
+            std::error_code fec;
+            if (std::filesystem::is_regular_file(f, fec) && !fec) files.push_back(f);
+          }
+        }
+      }
+    }
+    if (files.empty()) {
+      return SnapshotResult::NotNeeded;
+    }
+    const auto backups = root / kSnapshotDir;
+    std::filesystem::path dir, tmp_dir;
+    for (uint32_t seq = NextSnapshotSeq(backups), tries = 0; seq <= kSnapshotSeqMax && tries < 100; ++seq, ++tries) {
+      const auto c = backups / fmt::format("{:06}-{}-{}-to-{}", seq, CogStamp(), from, now);
+      auto t = c;
+      t += kTmpSuffix;
+      std::error_code xec, tec;
+      if (!std::filesystem::exists(c, xec) && !xec && !std::filesystem::exists(t, tec) && !tec) {
+        dir = c;
+        tmp_dir = t;
+        break;
+      }
+    }
+    // Written into <name>.cogbox-tmp and renamed once whole: a failed copy leaves no half folder behind.
+    bool ok = !dir.empty();
+    for (const auto& f : files) {
+      if (!ok) break;
+      const auto rel = f.lexically_relative(root);
+      if (rel.empty() || *rel.begin() == "..") continue;
+      const auto dest = tmp_dir / rel;
+      std::error_code cec;
+      std::filesystem::create_directories(dest.parent_path(), cec);
+      std::vector<uint8_t> bytes, check;
+      ok = !cec && CogReadFile(f, &bytes) && CogWriteAll(dest, bytes) && CogReadFile(dest, &check) && check == bytes;
+    }
+    if (ok) ok = RenameWithRetry(tmp_dir, dir);
+    if (!ok) {
+      std::error_code rec;
+      if (!tmp_dir.empty()) std::filesystem::remove_all(tmp_dir, rec);
+      // A failed copy changes nothing else: every re-sign still keeps its own copy (.pre-* / .cogbox-adopted-*).
+      REXLOG_WARN("cogbox_save_convert: save signing key {} -> {}: copying the saves to {} failed; tried again next "
+                  "start", from, now, rex::path_to_utf8(backups));
+      return SnapshotResult::Failed;
+    }
+    REXLOG_INFO("cogbox_save_convert: save signing key {} -> {}: {} save file(s) copied to {} first", from, now,
+                files.size(), rex::path_to_utf8(dir));
+    PruneSnapshots(backups, dir);
+    return SnapshotResult::Copied;
+  } catch (...) {
+    REXLOG_INFO("cogbox_save_convert: save copy before a key change stopped; saves left as they were");
+    return SnapshotResult::Failed;
+  }
+}
+
+void CogPrepareGears3Saves(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t run_key,
+                           uint64_t other_key, bool adopt_foreign, std::optional<uint64_t> extra_key) {
+  if (root.empty() || !profile_xuid) {
+    return;
+  }
+  // The keys recent runs signed with, newest first (read before this run's is noted, at the end).
+  const std::vector<uint64_t> history = CogSaveKeyHistory(root);
+  const SnapshotResult snap = CogSnapshotSavesOnKeyChange(root, profile_xuid, run_key);
+  // Verified passes first: a save signed with a key COGBox can name is converted from it (its first copy kept).
+  CogConvertGears3SaveSigning(root, profile_xuid, other_key, run_key, ".pre-online", false);
+  for (uint64_t k : history) {
+    if (k != run_key && k != other_key) {
+      CogConvertGears3SaveSigning(root, profile_xuid, k, run_key, ".pre-lastkey", false);
+    }
+  }
+  if (extra_key && *extra_key != run_key) {
+    CogConvertGears3SaveSigning(root, profile_xuid, *extra_key, run_key, ".pre-adoptkey", false);
+  }
+  // Then, only for what is left, the unverified re-sign of whole, plausible saves.
+  if (adopt_foreign) {
+    CogAdoptGears3Saves(root, profile_xuid, run_key);
+  }
+  CogReportGears3SaveSigning(root, profile_xuid, run_key, other_key);
+  // Review r79 R5: this run's key is noted only now, after every pass, and only when the copy was made or none was
+  // needed - a failed copy (or a crash before here) leaves the old key noted, so the copy is tried again and that key
+  // is still converted from with a check next start.
+  if (snap == SnapshotResult::Copied || snap == SnapshotResult::NotNeeded) {
+    if (!CogNoteSaveKey(root, run_key)) {
+      REXLOG_WARN("cogbox_save_convert: couldn't note the save signing key in {}",
+                  rex::path_to_utf8(root / "cogbox-save-key"));
+    }
+  }
+}
+
 }  // namespace rex::system
