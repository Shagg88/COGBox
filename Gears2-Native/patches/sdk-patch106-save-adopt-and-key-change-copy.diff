+TEST_CASE("Save copy: a save that can't be read fails the copy, leaves no folder and no key (r78 F2 / F5)", "[net][save]") {
+  G3Root g("snapshot_unreadable");
+  WriteProfileSet(g.prof, 0);
+  MakeUnreadable(g.ps);
+  CHECK_FALSE(CogSnapshotSavesOnKeyChange(g.root, kProfile, kXuid));
+  CHECK_FALSE(fs::exists(g.root / "cogbox-save-key"));
+  CHECK(WithPrefix(g.root / "_cogbox-save-backups", "").empty());   // nothing half made
+  // readable again: the next start makes the copy and notes the key
+  std::error_code ec;
+  fs::remove_all(g.ps, ec);
+  WriteFile(g.ps, MakeSave(0));
+  CHECK(CogSnapshotSavesOnKeyChange(g.root, kProfile, kXuid));
+  CHECK(CogLastSaveKey(g.root) == kXuid);
+}
