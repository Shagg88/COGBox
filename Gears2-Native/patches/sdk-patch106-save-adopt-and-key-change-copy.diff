+bool CogWriteAtomic(const std::filesystem::path& p, const std::vector<uint8_t>& v) {
+  auto tmp = p;
+  tmp += ".cogbox-tmp";
+  std::error_code ec;
+  if (!CogWriteAll(tmp, v)) {
+    std::filesystem::remove(tmp, ec);
+    return false;
+  }
+  std::filesystem::rename(tmp, p, ec);
+  if (ec) {
+    std::filesystem::remove(tmp, ec);
+    return false;
+  }
+  return true;
+}
