+TEST_CASE("Save copy: every save is copied once before a run with another key", "[net][save]") {
+  G3Root g("snapshot_root");
+  WriteFile(g.ps, MakeSave(0x1234));
+  WriteFile(g.prof / "63E83FFF", MakeSave(0x1234));
+  const fs::path backups = g.root / "_cogbox-save-backups";
+  CHECK(CogSnapshotSavesOnKeyChange(g.root, kProfile, 0));   // no key noted yet: a first copy
+  auto dirs = WithPrefix(backups, "");
+  REQUIRE(dirs.size() == 1);
+  CHECK(ReadFile(dirs[0] / g.ps.lexically_relative(g.root)) == MakeSave(0x1234));
+  CHECK(ReadFile(dirs[0] / (g.prof / "63E83FFF").lexically_relative(g.root)) == MakeSave(0x1234));
+  CHECK_FALSE(CogSnapshotSavesOnKeyChange(g.root, kProfile, 0));   // same key: nothing new
+  CHECK(WithPrefix(backups, "").size() == 1);
+  CHECK(CogSnapshotSavesOnKeyChange(g.root, kProfile, kXuid));
+  CHECK(WithPrefix(backups, "").size() == 2);
+  CHECK(ReadFile(g.root / "cogbox-save-key") == Bytes("0009000012345678"));
+}
