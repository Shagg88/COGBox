+// COGBox SDK patch 106 (GitHub #329, review r78): a whole, plausible Gears 3 save signed with a key COGBox can't name is
+// re-signed (a copy kept) instead of being reset by the game; known keys (the last run's, --cogbox_save_adopt_key) are
+// converted with a check first; every save is copied before a run that signs with another key.
+namespace {
+constexpr uint64_t kProfile = 0xB13EBABEBABEBABEull;
+constexpr uint64_t kOldAccount = 0x0009000000000ABCull;   // the online account before a new one was made
+
+// A file name as UTF-8 bytes in a std::string, whatever the name and whether or not char8_t is on (the SDK builds with
+// -fno-char8_t): u8string() never throws, unlike string() on Windows.
+std::string Name(const fs::path& p) {
+  const auto u = p.filename().u8string();
+  return std::string(u.begin(), u.end());
+}
+std::vector<fs::path> WithPrefix(const fs::path& dir, const std::string& prefix) {
+  std::vector<fs::path> out;
+  std::error_code ec;
+  for (auto it = fs::directory_iterator(dir, ec); !ec && it != fs::directory_iterator(); it.increment(ec)) {
+    if (Name(it->path()).rfind(prefix, 0) == 0) out.push_back(it->path());
+  }
+  return out;
+}
+// A signed file of the given size whose body isn't all zero.
+std::vector<uint8_t> Signed(uint64_t key, size_t size, uint8_t seed = 5) {
+  std::vector<uint8_t> body(size - 20);
+  for (size_t i = 0; i < body.size(); ++i) body[i] = uint8_t(i * 13 + seed);
+  const auto sig = CogSaveSignature(key, body.data(), body.size());
+  std::vector<uint8_t> file(sig.begin(), sig.end());
+  file.insert(file.end(), body.begin(), body.end());
+  return file;
+}
+// A profile set FFF + FFE + FFD signed together with key (FFF carries the signature over all three).
+void WriteProfileSet(const fs::path& dir, uint64_t key, size_t fff = 300, size_t ffe = 200, size_t ffd = 100,
+                     uint8_t fill = 0) {
+  fs::create_directories(dir);
+  std::vector<uint8_t> a(fff), b(ffe, uint8_t(fill ? fill : 0x22)), c(ffd, uint8_t(fill ? fill : 0x33));
+  for (size_t i = 20; i < a.size(); ++i) a[i] = fill ? fill : uint8_t(i * 3 + 1);
+  std::vector<uint8_t> body(a.begin() + 20, a.end());
+  body.insert(body.end(), b.begin(), b.end());
+  body.insert(body.end(), c.begin(), c.end());
+  const auto sig = CogSaveSignature(key, body.data(), body.size());
+  std::copy(sig.begin(), sig.end(), a.begin());
+  WriteFile(dir / "63E83FFF", a);
+  WriteFile(dir / "63E83FFE", b);
+  WriteFile(dir / "63E83FFD", c);
+}
+bool SetSignedFor(const fs::path& dir, uint64_t key) {
+  std::vector<uint8_t> all = ReadFile(dir / "63E83FFF");
+  for (const char* n : {"63E83FFE", "63E83FFD"}) {
+    const auto v = ReadFile(dir / n);
+    all.insert(all.end(), v.begin(), v.end());
+  }
+  const auto sig = CogSaveSignature(key, all.data() + 20, all.size() - 20);
+  return std::equal(sig.begin(), sig.end(), all.begin());
+}
+bool FileSignedFor(const fs::path& f, uint64_t key) {
+  const auto v = ReadFile(f);
+  const auto sig = CogSaveSignature(key, v.data() + 20, v.size() - 20);
+  return v.size() > 20 && std::equal(sig.begin(), sig.end(), v.begin());
+}
+// A Gears 3 user folder: <root>/B13E.../4D5308AB/.../PlayerStorage.dat and <root>/4D5308AB/profile/User/63E83FF*.
+struct G3Root {
+  fs::path root, ps, prof;
+  explicit G3Root(const char* name) {
+    root = SwapDir(name);
+    ps = root / "B13EBABEBABEBABE" / "4D5308AB" / "00000001" / "PlayerStorage.dat" / "PlayerStorage.dat";
+    prof = root / "4D5308AB" / "profile" / "User";
+    fs::create_directories(ps.parent_path());
+    fs::create_directories(prof);
+  }
+};
+// A path that exists but can't be read as a file (a folder of that name): fopen or fread fails on every platform.
+void MakeUnreadable(const fs::path& p) {
+  std::error_code ec;
+  fs::remove(p, ec);
+  fs::create_directories(p / "x");
+}
+}  // namespace
