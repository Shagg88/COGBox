+TEST_CASE("Save copy: only the newest 20 copies are kept", "[net][save]") {
+  G3Root g("snapshot_prune");
+  WriteFile(g.ps, MakeSave(0));
+  const fs::path backups = g.root / "_cogbox-save-backups";
+  fs::create_directories(backups / "19990101-000000-old.cogbox-tmp");   // a half-made one from a crash
+  for (int k = 0; k < 25; ++k) {
+    char n[64];
+    std::snprintf(n, sizeof(n), "2000%04d-000000-x-to-y", k);
+    fs::create_directories(backups / n);
+  }
+  REQUIRE(CogSnapshotSavesOnKeyChange(g.root, kProfile, kXuid));
+  const auto left = WithPrefix(backups, "");
+  CHECK(left.size() == 20);
+  CHECK_FALSE(fs::exists(backups / "20000000-000000-x-to-y"));       // the oldest went
+  CHECK_FALSE(fs::exists(backups / "19990101-000000-old.cogbox-tmp"));
+}
