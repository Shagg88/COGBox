+// Patch 106 (review r78 F5, r79 R1 / R2): the key-change copies live in <root>/_cogbox-save-backups, named
+//   <nnnnnn>-<yyyymmdd>-<hhmmss>-<old key>-to-<new key>     (old key: 16 hex digits, "first" or "unknown")
+// and built as that name + ".cogbox-tmp". nnnnnn is a sequence number one above the highest there, so the order never
+// depends on the clock (a clock set wrong, a dead CMOS battery). COGBox only ever removes folders named exactly like
+// that - never a link, a junction or another folder a player made there (a "0 my good save" or "keep.cogbox-tmp" is
+// left alone) - and names are matched on the native path text, never converted (no name can make it throw).
+constexpr size_t kSnapshotsKept = 20;
+constexpr uint32_t kSnapshotSeqMax = 999999;
+constexpr uintmax_t kSnapshotFileMax = 1 << 20, kSnapshotFilesMax = 4096;
+const char* const kSnapshotDir = "_cogbox-save-backups";
+const char* const kTmpSuffix = ".cogbox-tmp";
+struct SnapshotName {
+  bool ok = false, tmp = false, first = false;
+  uint32_t seq = 0;
+};
+SnapshotName ParseSnapshotName(const std::filesystem::path::string_type& n) {
+  using C = std::filesystem::path::value_type;
+  SnapshotName r;
+  auto lit = [&](size_t at, const char* s) {
+    const size_t len = std::strlen(s);
+    if (at + len > n.size()) return false;
+    for (size_t k = 0; k < len; ++k) {
+      if (n[at + k] != C(s[k])) return false;
+    }
+    return true;
+  };
+  auto digits = [&](size_t at, size_t len) {
+    if (at + len > n.size()) return false;
+    for (size_t k = 0; k < len; ++k) {
+      if (n[at + k] < C('0') || n[at + k] > C('9')) return false;
+    }
+    return true;
+  };
+  auto hex = [&](size_t at, size_t len) {
+    if (at + len > n.size()) return false;
+    for (size_t k = 0; k < len; ++k) {
+      const C c = n[at + k];
+      if (!((c >= C('0') && c <= C('9')) || (c >= C('A') && c <= C('F')))) return false;
+    }
+    return true;
+  };
+  size_t len = n.size();
+  const size_t tlen = std::strlen(kTmpSuffix);
+  if (len > tlen && lit(len - tlen, kTmpSuffix)) {
+    r.tmp = true;
+    len -= tlen;
+  }
+  if (!(digits(0, 6) && lit(6, "-") && digits(7, 8) && lit(15, "-") && digits(16, 6) && lit(22, "-"))) return r;
+  size_t at = 23;
+  if (len == 23 + 5 + 4 + 16 && lit(at, "first")) {
+    r.first = true;
+    at += 5;
+  } else if (len == 23 + 7 + 4 + 16 && lit(at, "unknown")) {
+    at += 7;
+  } else if (len == 23 + 16 + 4 + 16 && hex(at, 16)) {
+    at += 16;
+  } else {
+    return r;
+  }
+  if (!(lit(at, "-to-") && hex(at + 4, 16))) return r;
+  for (size_t k = 0; k < 6; ++k) r.seq = r.seq * 10 + uint32_t(n[k] - C('0'));
+  r.ok = true;
+  return r;
+}
+struct Snapshot {
+  std::filesystem::path path;
+  SnapshotName name;
+};
+// COGBox's own snapshot folders (and half-made ones) directly in dir; anything else, and any link, is not listed.
+std::vector<Snapshot> ListSnapshots(const std::filesystem::path& dir) {
+  std::vector<Snapshot> out;
+  std::error_code ec;
+  for (auto it = std::filesystem::directory_iterator(dir, ec); !ec && it != std::filesystem::directory_iterator();
+       it.increment(ec)) {
+    std::error_code sec;
+    const auto st = it->symlink_status(sec);   // not is_directory(): that follows links and junctions
+    if (sec || !std::filesystem::is_directory(st)) continue;
+    const SnapshotName n = ParseSnapshotName(it->path().filename().native());
+    if (n.ok) out.push_back({it->path(), n});
+  }
+  std::sort(out.begin(), out.end(), [](const Snapshot& a, const Snapshot& b) {
+    return a.name.seq != b.name.seq ? a.name.seq < b.name.seq : a.path < b.path;
+  });
+  return out;
