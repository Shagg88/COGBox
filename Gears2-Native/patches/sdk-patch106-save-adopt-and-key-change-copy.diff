+  CHECK(ReadFile(made[0] / g.ps.lexically_relative(g.root)) == save);
+  CHECK(WithPrefix(backups, "").size() == 20);
+  CHECK(fs::exists(backups / SnapName(1, "20991231", "first")));
+  CHECK_FALSE(fs::exists(backups / SnapName(2, "20991231")));   // redundant with the new copy
+}
