+// A Gears 3 file whose first 20 bytes are its signature (they change with the key, not with the save).
+bool SignedSaveFile(const std::filesystem::path& rel) {
+  bool gears3 = false;
+  for (const auto& part : rel) gears3 = gears3 || part == "4D5308AB";
+  const auto f = rel.filename();
+  return gears3 && (f == "PlayerStorage.dat" || f == "63E83FFF" || f == "63E83FFF.p2" || f == "63E83FFF.p3" ||
+                    f == "63E83FFF.p4");
