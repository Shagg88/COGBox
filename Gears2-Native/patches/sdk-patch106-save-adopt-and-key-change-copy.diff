+// Called after just_made was renamed into place. Removes:
+// - half-made ".cogbox-tmp" snapshots older than just_made (a newer one may be another instance's, in progress);
+// - while more than kSnapshotsKept snapshots are there, oldest first, a snapshot whose every file is also, with the
+//   same data, in one newer snapshot - so a copy is only ever removed when another holds the same save. Never the
+//   oldest snapshot, a "-first-" one or just_made. Snapshots that each hold a different save are all kept.
+void PruneSnapshots(const std::filesystem::path& dir, const std::filesystem::path& just_made) {
+  try {
+    const uint32_t just_seq = ParseSnapshotName(just_made.filename().native()).seq;
+    std::vector<Snapshot> done;
+    for (auto& s : ListSnapshots(dir)) {
+      if (s.name.tmp) {
+        if (s.name.seq < just_seq) {
+          std::error_code rec;
+          std::filesystem::remove_all(s.path, rec);
+        }
+      } else {
+        done.push_back(std::move(s));
+      }
+    }
+    size_t count = done.size();
+    if (count <= kSnapshotsKept) return;
+    std::vector<std::optional<std::optional<SnapshotContent>>> content(done.size());
+    auto get = [&](size_t k) -> const std::optional<SnapshotContent>& {
+      if (!content[k]) content[k] = ReadSnapshotContent(done[k].path);
+      return *content[k];
+    };
+    std::vector<bool> gone(done.size(), false);
+    for (size_t i = 1; i + 1 < done.size() && count > kSnapshotsKept; ++i) {
+      if (done[i].name.first || done[i].path == just_made) continue;
+      const auto& older = get(i);
+      if (!older) continue;
+      for (size_t j = i + 1; j < done.size(); ++j) {
+        if (gone[j]) continue;
+        const auto& newer = get(j);
+        if (!newer || !Covers(*newer, *older)) continue;
+        std::error_code rec;
+        std::filesystem::remove_all(done[i].path, rec);
+        if (!rec) {
+          gone[i] = true;
+          --count;
+        }
+        break;
+      }
+    }
+  } catch (...) {
+    // pruning is housekeeping only: whatever stopped it, the snapshot just made stands
+  }
+}
+uint32_t NextSnapshotSeq(const std::filesystem::path& dir) {
+  uint32_t top = 0;
+  for (const auto& s : ListSnapshots(dir)) top = std::max(top, s.name.seq);
+  return top + 1;
+}
+// Review r79 R5: a folder just written can be held for a moment by an antivirus scan (Windows Defender), which fails the
+// rename; tried four times over about a second.
+bool RenameWithRetry(const std::filesystem::path& from, const std::filesystem::path& to) {
+  for (int attempt = 0;; ++attempt) {
+    std::error_code ec;
+    std::filesystem::rename(from, to, ec);
+    if (!ec) return true;
+    if (attempt == 3) return false;
+    std::this_thread::sleep_for(std::chrono::milliseconds(50 << (2 * attempt)));   // 50, 200, 800 ms
+  }
+}
