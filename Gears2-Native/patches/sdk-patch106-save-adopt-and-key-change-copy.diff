+  const auto dirs = WithPrefix(root / "_cogbox-save-backups", "");
+  REQUIRE(dirs.size() == 1);
+  CHECK(ReadFile(dirs[0] / ps.lexically_relative(root)) == Bytes("judgment storage"));
+  CHECK(ReadFile(dirs[0] / hdr.lexically_relative(root)) == Bytes("judgment header"));
+  CHECK(ReadFile(dirs[0] / fff.lexically_relative(root)) == Bytes("judgment profile"));
