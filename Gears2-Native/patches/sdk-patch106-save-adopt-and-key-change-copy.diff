+std::optional<uint64_t> CogLastSaveKey(const std::filesystem::path& root) {
+  const std::string t = CogReadMode(root / "cogbox-save-key");
+  if (t.size() != 16) return std::nullopt;
+  uint64_t v = 0;
+  for (char c : t) {
+    int d = c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+    if (d < 0) return std::nullopt;
+    v = (v << 4) | uint64_t(d);
+  }
+  return v;
+}
+
+bool CogSnapshotSavesOnKeyChange(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t run_key) {
+  if (root.empty() || !profile_xuid) {
+    return false;
+  }
+  try {
+    std::error_code ec;
+    const bool gears3 = std::filesystem::is_directory(root / "4D5308AB", ec);
+    const bool judgment = std::filesystem::is_directory(root / "4D530A26", ec);
+    if (!gears3 && !judgment) {
+      return false;  // another game's user folder
+    }
+    const auto marker = root / "cogbox-save-key";
+    const std::string was = CogReadMode(marker), now = fmt::format("{:016X}", run_key);
+    if (was == now) {
+      return false;
+    }
+    std::vector<std::filesystem::path> files;
+    if (gears3) {
+      for (const auto& set : Gears3SaveSets(root, profile_xuid, false)) files.insert(files.end(), set.begin(), set.end());
+    }
+    if (judgment) {
+      for (const auto& f : JudgmentSaveFiles(root, profile_xuid)) {
+        std::error_code fec;
+        if (std::filesystem::exists(f, fec) && !fec) files.push_back(f);
+      }
+    }
+    const std::string from = was.empty() ? std::string("(none noted)") : was;
+    if (!files.empty()) {
+      // Written into <name>.cogbox-tmp and renamed once whole: a failed copy leaves no half folder behind.
+      const auto backups = root / kSnapshotDir;
+      const auto dir = CogFreshName(backups / CogStamp(), "-" + (was.empty() ? std::string("first") : was) + "-to-" + now);
+      bool ok = !dir.empty();
+      auto tmp_dir = dir;
+      tmp_dir += ".cogbox-tmp";
+      for (const auto& f : files) {
+        if (!ok) break;
+        const auto rel = f.lexically_relative(root);
+        if (rel.empty() || *rel.begin() == "..") continue;
+        const auto dest = tmp_dir / rel;
+        std::error_code cec;
+        std::filesystem::create_directories(dest.parent_path(), cec);
+        std::vector<uint8_t> bytes, check;
+        ok = !cec && CogReadFile(f, &bytes) && CogWriteAll(dest, bytes) && CogReadFile(dest, &check) && check == bytes;
+      }
+      if (ok) {
+        std::error_code rec;
+        std::filesystem::rename(tmp_dir, dir, rec);
+        ok = !rec;
+      }
+      if (!ok) {
+        std::error_code rec;
+        if (!dir.empty()) std::filesystem::remove_all(tmp_dir, rec);
+        // A failed copy changes nothing else: every re-sign still keeps its own copy (.pre-* / .cogbox-adopted-*).
+        REXLOG_WARN("cogbox_save_convert: save signing key {} -> {}: copying the saves to {} failed; tried again next "
+                    "start", from, now, rex::path_to_utf8(backups));
+        return false;
+      }
+      REXLOG_INFO("cogbox_save_convert: save signing key {} -> {}: {} save file(s) copied to {} first", from, now,
+                  files.size(), rex::path_to_utf8(dir));
+      PruneSnapshots(backups);
+    }
+    const std::vector<uint8_t> m(now.begin(), now.end());
+    if (!CogWriteAtomic(marker, m)) {
+      REXLOG_WARN("cogbox_save_convert: couldn't note the save signing key in {}", rex::path_to_utf8(marker));
+      return false;
+    }
+    return true;
+  } catch (...) {
+    REXLOG_INFO("cogbox_save_convert: save copy before a key change stopped; saves left as they were");
+    return false;
+  }
+}
+
+void CogPrepareGears3Saves(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t run_key,
+                           uint64_t other_key, bool adopt_foreign, std::optional<uint64_t> extra_key) {
+  if (root.empty() || !profile_xuid) {
+    return;
+  }
+  // The key the last run signed with, read before the copy below notes this run's.
+  const std::optional<uint64_t> last = CogLastSaveKey(root);
+  CogSnapshotSavesOnKeyChange(root, profile_xuid, run_key);
+  // Verified passes first: a save signed with a key COGBox can name is converted from it (its first copy kept).
+  CogConvertGears3SaveSigning(root, profile_xuid, other_key, run_key, ".pre-online", false);
+  if (last && *last != run_key && *last != other_key) {
+    CogConvertGears3SaveSigning(root, profile_xuid, *last, run_key, ".pre-lastkey", false);
+  }
+  if (extra_key && *extra_key != run_key) {
+    CogConvertGears3SaveSigning(root, profile_xuid, *extra_key, run_key, ".pre-adoptkey", false);
+  }
+  // Then, only for what is left, the unverified re-sign of whole, plausible saves.
+  if (adopt_foreign) {
+    CogAdoptGears3Saves(root, profile_xuid, run_key);
+  }
+  CogReportGears3SaveSigning(root, profile_xuid, run_key, other_key);
+}
