+namespace {
+// A snapshot folder as COGBox names it: <seq>-<date>-<time>-<old key>-to-<new key>.
+std::string SnapName(int seq, const char* date, const char* from = "0000000000000000",
+                     const char* to = "0009000012345678") {
+  char n[96];
+  std::snprintf(n, sizeof(n), "%06d-%s-120000-%s-to-%s", seq, date, from, to);
+  return n;
+}
+// A snapshot of the G3Root's PlayerStorage.dat holding save (any signature).
+void MakeSnapshot(const G3Root& g, const std::string& name, const std::vector<uint8_t>& save) {
+  const fs::path f = g.root / "_cogbox-save-backups" / name / g.ps.lexically_relative(g.root);
+  fs::create_directories(f.parent_path());
+  WriteFile(f, save);
+}
+std::vector<uint8_t> Resigned(std::vector<uint8_t> v, uint64_t key) {
+  const auto sig = CogSaveSignature(key, v.data() + 20, v.size() - 20);
+  std::copy(sig.begin(), sig.end(), v.begin());
+  return v;
+}
+}  // namespace
