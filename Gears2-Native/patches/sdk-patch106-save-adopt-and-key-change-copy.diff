+namespace {
+// Patch 106 (review r78 F4): the bodies (everything after the signature) of the sets adopted so far, one hex digest a
+// line in <root>/cogbox-save-adopted, newest last, at most 64. A body adopted once and found again with a key that isn't
+// this run's means the game signed it with a key COGBox doesn't predict: it is not adopted again (no loop of copies).
+constexpr size_t kAdoptNotesMax = 64;
+std::string BodyDigest(const std::vector<uint8_t>& all) {
+  const auto d = CogSign(0, all.data() + 20, all.size() - 20);
+  std::string h;
+  for (uint8_t b : d) h += fmt::format("{:02x}", b);
+  return h;
+}
+std::vector<std::string> ReadLines(const std::filesystem::path& p) {
+  std::vector<std::string> out;
+  std::string cur;
+  for (uint8_t c : CogReadAll(p)) {
+    if (c == '\n' || c == '\r') {
+      if (!cur.empty()) out.push_back(cur);
+      cur.clear();
+    } else {
+      cur += char(c);
+    }
+  }
+  if (!cur.empty()) out.push_back(cur);
+  return out;
+}
+bool WriteLines(const std::filesystem::path& p, const std::vector<std::string>& lines) {
+  std::string t;
+  for (const auto& l : lines) t += l + "\n";
+  return CogWriteAtomic(p, std::vector<uint8_t>(t.begin(), t.end()));
+}
+}  // namespace
