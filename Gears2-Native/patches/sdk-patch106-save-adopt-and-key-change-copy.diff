+std::vector<uint64_t> CogSaveKeyHistory(const std::filesystem::path& root) {
+  std::vector<uint64_t> keys;
+  for (std::string t : ReadLines(root / "cogbox-save-key")) {
+    while (!t.empty() && t.back() == ' ') t.pop_back();
+    if (!IsHexText(t, 16)) continue;   // review r79 R4: only a well-formed key is ever used, never the text itself
+    const uint64_t v = std::strtoull(t.c_str(), nullptr, 16);
+    if (std::find(keys.begin(), keys.end(), v) == keys.end() && keys.size() < kKeyHistoryMax) keys.push_back(v);
+  }
+  return keys;
+}
