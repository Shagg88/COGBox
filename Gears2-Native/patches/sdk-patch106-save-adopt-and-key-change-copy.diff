+void CogAdoptGears3Saves(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t run_key) {
+  if (root.empty() || !profile_xuid) {
+    return;
+  }
+  try {
+    const auto notes_path = root / "cogbox-save-adopted";
+    auto notes = ReadLines(notes_path);
+    for (const auto& files : Gears3SaveSets(root, profile_xuid, false)) {
+      const auto name = rex::path_to_utf8(files[0]);
+      std::vector<uint8_t> all;
+      std::vector<size_t> sizes;
+      if (!CogReadSet(files, &all, &sizes)) {
+        REXLOG_WARN("cogbox_save_convert: {} - a file of this save couldn't be read now; not re-signed (tried again "
+                    "next start)", name);
+        continue;
+      }
+      if (all.size() < 21 || sizes[0] < 20) continue;
+      const auto sig = CogSign(run_key, all.data() + 20, all.size() - 20);
+      if (std::memcmp(sig.data(), all.data(), 20) == 0) continue;   // signed for this run
+      const std::string digest = BodyDigest(all);
+      if (std::find(notes.begin(), notes.end(), digest) != notes.end()) {
