+  const fs::path hdr = root / "B13EBABEBABEBABE" / "4D530A26" / "Headers" / "00000001" / "PlayerStorage.dat.header";
+  const fs::path fff = root / "4D530A26" / "profile" / "User" / "63E83FFF";
