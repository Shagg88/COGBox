+namespace {
+// Patch 106 (review r78 F1 / F3): only a whole save of the shapes Gears 3 writes is ever re-signed without a known key.
+// PlayerStorage.dat alone: COGBox / player logs show Gears 3 TU6 writing 6232-6520 bytes; 4 KB - 64 KB leaves room for
+// more progress and refuses a cut-off or empty file. A profile set: 63E83FFF + 63E83FFE + 63E83FFD, all three (the
+// signature sits in FFF and covers the other two), each at most 1000 bytes (the XDK's limit for a title setting).
+// Nothing may be all zero.
+constexpr size_t kPlayerStorageMin = 4 * 1024, kPlayerStorageMax = 64 * 1024, kSettingMax = 1000;
+bool AllZero(const uint8_t* p, size_t n) {
+  for (size_t i = 0; i < n; ++i) {
+    if (p[i]) return false;
+  }
+  return true;
+}
+const char* AdoptRefusal(const std::vector<std::filesystem::path>& files, const std::vector<uint8_t>& all,
+                         const std::vector<size_t>& sizes) {
+  if (files.size() == 1 && files[0].filename() == "PlayerStorage.dat") {
+    if (sizes[0] < kPlayerStorageMin || sizes[0] > kPlayerStorageMax) return "PlayerStorage.dat size out of range";
+    if (AllZero(all.data() + 20, all.size() - 20)) return "all zero";
+    return nullptr;
+  }
+  if (files.size() != 3 || files[0].filename() != "63E83FFF" || files[1].filename() != "63E83FFE" ||
+      files[2].filename() != "63E83FFD") {
+    return "not a whole profile set (63E83FFF, 63E83FFE and 63E83FFD)";
+  }
+  size_t at = 0;
+  for (size_t k = 0; k < 3; ++k) {
+    if (sizes[k] > kSettingMax) return "a profile setting over 1000 bytes";
+    const size_t skip = k == 0 ? 20 : 0;
+    if (sizes[k] <= skip || AllZero(all.data() + at + skip, sizes[k] - skip)) return "a profile setting empty or all zero";
+    at += sizes[k];
+  }
+  return nullptr;
+}
+}  // namespace
+
+ResignResult CogAdoptSaveFiles(const std::vector<std::filesystem::path>& files, uint64_t to_key) {
+  if (files.empty()) {
+    return ResignResult::Refused;
+  }
+  std::vector<uint8_t> all;
+  std::vector<size_t> sizes;
+  if (!CogReadSet(files, &all, &sizes)) {
+    return ResignResult::ReadFailed;
+  }
+  if (all.size() < 21 || sizes[0] < 20) {
+    return ResignResult::TooSmall;
+  }
+  const auto to_sig = CogSign(to_key, all.data() + 20, all.size() - 20);
+  if (std::memcmp(to_sig.data(), all.data(), 20) == 0) {
+    return ResignResult::AlreadyDone;
+  }
+  if (AdoptRefusal(files, all, sizes)) {
+    return ResignResult::Refused;
+  }
+  // Every file read again just before writing: a set that changed or became unreadable meanwhile is left alone.
+  std::vector<uint8_t> again;
+  std::vector<size_t> again_sizes;
+  if (!CogReadSet(files, &again, &again_sizes) || again != all) {
+    return ResignResult::ReadFailed;
+  }
+  std::vector<uint8_t> first(all.begin(), all.begin() + std::ptrdiff_t(sizes[0]));
+  // The file as it was, under a name of its own that nothing ever replaces (every adoption keeps its copy).
+  const auto backup = CogFreshName(files[0], ".cogbox-adopted-" + CogStamp());
+  if (backup.empty() || !CogWriteAtomic(backup, first)) {
+    return ResignResult::NoBackup;
+  }
+  std::vector<uint8_t> check;
+  if (!CogReadFile(backup, &check) || check != first) {
+    return ResignResult::NoBackup;
+  }
+  std::memcpy(first.data(), to_sig.data(), 20);
+  std::error_code ec;
+  auto tmp = files[0];
+  tmp += ".cogbox-tmp";
+  bool ok = CogWriteAll(tmp, first) && std::filesystem::file_size(tmp, ec) == first.size() && !ec;
+  if (ok) {
+    std::filesystem::rename(tmp, files[0], ec);
+    ok = !ec;
+  }
+  if (!ok) {
+    std::filesystem::remove(tmp, ec);
+    return ResignResult::WriteFailed;
+  }
+  return ResignResult::Resigned;
+}
