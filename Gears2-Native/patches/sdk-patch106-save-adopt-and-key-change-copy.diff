+namespace {
+constexpr size_t kSnapshotsKept = 20;
+const char* const kSnapshotDir = "_cogbox-save-backups";
+// Patch 106 (review r78 F5): the newest kSnapshotsKept snapshot folders are kept (their names start with the date, so
+// name order is age order); older ones and any half-made ".cogbox-tmp" folder are removed.
+void PruneSnapshots(const std::filesystem::path& dir) {
+  std::error_code ec;
+  std::vector<std::filesystem::path> done;
+  for (auto it = std::filesystem::directory_iterator(dir, ec); !ec && it != std::filesystem::directory_iterator();
+       it.increment(ec)) {
+    std::error_code dec;
+    if (!it->is_directory(dec) || dec) continue;
+    const std::string n = it->path().filename().string();
+    if (n.size() > 11 && n.compare(n.size() - 11, 11, ".cogbox-tmp") == 0) {
+      std::error_code rec;
+      std::filesystem::remove_all(it->path(), rec);
+    } else {
+      done.push_back(it->path());
+    }
+  }
+  if (done.size() <= kSnapshotsKept) return;
+  std::sort(done.begin(), done.end());
+  for (size_t k = 0; k + kSnapshotsKept < done.size(); ++k) {
+    std::error_code rec;
+    std::filesystem::remove_all(done[k], rec);
+  }
+}
