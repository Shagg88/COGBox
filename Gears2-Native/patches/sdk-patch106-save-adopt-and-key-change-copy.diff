+void CogSnapshotSavesOnKeyChange(const std::filesystem::path& root, uint64_t profile_xuid, uint64_t run_key) {
+  if (root.empty() || !profile_xuid) {
+    return;
+  }
+  try {
+    std::error_code ec;
+    const bool gears3 = std::filesystem::is_directory(root / "4D5308AB", ec);
+    const bool judgment = std::filesystem::is_directory(root / "4D530A26", ec);
+    if (!gears3 && !judgment) {
+      return;  // another game's user folder
+    }
+    const auto marker = root / "cogbox-save-key";
+    const std::string was = CogReadMode(marker), now = fmt::format("{:016X}", run_key);
+    if (was == now) {
+      return;
+    }
+    std::vector<std::filesystem::path> files;
+    if (gears3) {
+      for (const auto& set : Gears3SaveSets(root, profile_xuid, false)) files.insert(files.end(), set.begin(), set.end());
+    }
+    if (judgment) {
+      for (const auto& f : JudgmentSaveFiles(root, profile_xuid)) {
+        std::error_code fec;
+        if (std::filesystem::is_regular_file(f, fec) && !fec) files.push_back(f);
+      }
+    }
+    bool ok = true;
+    if (!files.empty()) {
+      const auto dir = CogFreshName(root / "_cogbox-save-backups" / CogStamp(),
+                                    "-" + (was.empty() ? std::string("first") : was) + "-to-" + now);
+      ok = !dir.empty();
+      for (const auto& f : files) {
+        if (!ok) break;
+        const auto rel = f.lexically_relative(root);
+        if (rel.empty() || *rel.begin() == "..") continue;
+        const auto dest = dir / rel;
+        std::error_code cec;
+        std::filesystem::create_directories(dest.parent_path(), cec);
+        const auto bytes = CogReadAll(f);
+        ok = !cec && CogWriteAll(dest, bytes) && CogReadAll(dest) == bytes;
+      }
+      if (ok) {
+        REXLOG_INFO("cogbox_save_convert: save signing key {} -> {}: {} save file(s) copied to {} first",
+                    was.empty() ? "(none noted)" : was, now, files.size(), rex::path_to_utf8(dir));
+      } else {
+        REXLOG_WARN("cogbox_save_convert: save signing key {} -> {}: copying the saves to {} failed; tried again next "
+                    "start", was.empty() ? "(none noted)" : was, now, rex::path_to_utf8(dir));
+      }
+    }
+    if (ok) {
+      const std::vector<uint8_t> m(now.begin(), now.end());
+      CogWriteAll(marker, m);
+    }
+  } catch (...) {
+    REXLOG_INFO("cogbox_save_convert: save copy before a key change stopped; saves left as they were");
+  }
+}
+
 }  // namespace rex::system
diff --git a/tests/unit/net/save_resign_test.cpp b/tests/unit/net/save_resign_test.cpp
index 1e2c3e4..a3b1c99 100644
--- a/tests/unit/net/save_resign_test.cpp
+++ b/tests/unit/net/save_resign_test.cpp
@@ -2,6 +2,7 @@
 // re-signed between XUID 0 and the online XUID. Files live in COGBOX_NET_TEST_DIR (build tree, never AppData).
 #include <catch2/catch_test_macros.hpp>
 
+#include <algorithm>
 #include <cstring>
 #include <filesystem>
 #include <fstream>
@@ -180,3 +181,95 @@ TEST_CASE("Judgment settings: a copy already set aside is kept, never overwritte
   CHECK(ReadFile(fs::path(f) += ".cogbox-offline") == Bytes("now"));
   CHECK(ReadFile(fs::path(f) += ".cogbox-offline.old-1") == Bytes("older offline"));
 }
+
+// COGBox SDK patch 106 (GitHub #329): a save signed with a key COGBox can't name is re-signed (a copy kept), never left
+// for Gears 3 to reset; and every save is copied before a run that signs with another key.
+namespace {
+std::vector<fs::path> WithPrefix(const fs::path& dir, const std::string& prefix) {
+  std::vector<fs::path> out;
+  for (auto& e : fs::directory_iterator(dir)) {
+    if (e.path().filename().string().rfind(prefix, 0) == 0) out.push_back(e.path());
+  }
+  return out;
+}
+}  // namespace
+
+TEST_CASE("Save adopt: a save signed for an earlier online account is re-signed and its old file kept", "[net][save]") {
+  const auto foreign = MakeSave(0x0009000000000ABCull);   // the account before a new one was made
+  auto f = FreshFile("adopt_foreign", foreign);
+  CHECK(CogAdoptSaveFiles({f}, kXuid) == ResignResult::Resigned);
+  const auto now = ReadFile(f);
+  CHECK(now == MakeSave(kXuid));
+  CHECK(std::equal(now.begin() + 20, now.end(), foreign.begin() + 20));   // the data itself never changes
+  const auto kept = WithPrefix(f.parent_path(), "PlayerStorage.dat.cogbox-adopted-");
+  REQUIRE(kept.size() == 1);
+  CHECK(ReadFile(kept[0]) == foreign);
+  CHECK_FALSE(fs::exists(fs::path(f) += ".cogbox-tmp"));
+  // signed for this run now: nothing more is done or kept
+  CHECK(CogAdoptSaveFiles({f}, kXuid) == ResignResult::AlreadyDone);
+  CHECK(WithPrefix(f.parent_path(), "PlayerStorage.dat.cogbox-adopted-").size() == 1);
+}
+
+TEST_CASE("Save adopt: each adoption keeps its own copy, none replaced", "[net][save]") {
+  auto f = FreshFile("adopt_twice", MakeSave(0x1111));
+  REQUIRE(CogAdoptSaveFiles({f}, kXuid) == ResignResult::Resigned);
+  REQUIRE(CogAdoptSaveFiles({f}, 0) == ResignResult::Resigned);   // same second: "-2" name
+  CHECK(ReadFile(f) == MakeSave(0));
+  CHECK(WithPrefix(f.parent_path(), "PlayerStorage.dat.cogbox-adopted-").size() == 2);
+}
+
+TEST_CASE("Save adopt: a profile set is signed over all its files and only the first one changes", "[net][save]") {
+  const fs::path d = fs::path(COGBOX_NET_TEST_DIR) / "adopt_set";
+  std::error_code ec;
+  fs::remove_all(d, ec);
+  fs::create_directories(d);
+  std::vector<uint8_t> a(120, 0x11), b(64, 0x22);
+  std::vector<uint8_t> body(a.begin() + 20, a.end());
+  body.insert(body.end(), b.begin(), b.end());
+  const auto sig = CogSaveSignature(0x2222, body.data(), body.size());
+  std::copy(sig.begin(), sig.end(), a.begin());
+  WriteFile(d / "63E83FFF", a);
+  WriteFile(d / "63E83FFE", b);
+  REQUIRE(CogAdoptSaveFiles({d / "63E83FFF", d / "63E83FFE"}, kXuid) == ResignResult::Resigned);
+  const auto now = ReadFile(d / "63E83FFF");
+  const auto want = CogSaveSignature(kXuid, body.data(), body.size());
+  CHECK(std::equal(want.begin(), want.end(), now.begin()));
+  CHECK(ReadFile(d / "63E83FFE") == b);
+}
+
+TEST_CASE("Save adopt: a file too small to hold a signature is left alone", "[net][save]") {
+  auto f = FreshFile("adopt_small", std::vector<uint8_t>(10, 0));
+  CHECK(CogAdoptSaveFiles({f}, kXuid) == ResignResult::TooSmall);
+  CHECK(WithPrefix(f.parent_path(), "PlayerStorage.dat.cogbox-adopted-").empty());
+}
+
+TEST_CASE("Save copy: every save is copied once before a run with another key", "[net][save]") {
+  const fs::path root = SwapDir("snapshot_root");
+  constexpr uint64_t kProfile = 0xB13EBABEBABEBABEull;
+  const fs::path ps = root / "B13EBABEBABEBABE" / "4D5308AB" / "00000001" / "PlayerStorage.dat" / "PlayerStorage.dat";
+  const fs::path prof = root / "4D5308AB" / "profile" / "User" / "63E83FFF";
+  fs::create_directories(ps.parent_path());
+  fs::create_directories(prof.parent_path());
+  WriteFile(ps, MakeSave(0x1234));
+  WriteFile(prof, MakeSave(0x1234));
+  const fs::path backups = root / "_cogbox-save-backups";
+  CogSnapshotSavesOnKeyChange(root, kProfile, 0);          // no key noted yet: a first copy
+  REQUIRE(fs::is_directory(backups));
+  auto dirs = WithPrefix(backups, "");
+  REQUIRE(dirs.size() == 1);
+  CHECK(ReadFile(dirs[0] / ps.lexically_relative(root)) == MakeSave(0x1234));
+  CHECK(ReadFile(dirs[0] / prof.lexically_relative(root)) == MakeSave(0x1234));
+  CogSnapshotSavesOnKeyChange(root, kProfile, 0);          // same key: nothing new
+  CHECK(WithPrefix(backups, "").size() == 1);
+  CogSnapshotSavesOnKeyChange(root, kProfile, kXuid);      // online with an account: a second copy
+  CHECK(WithPrefix(backups, "").size() == 2);
+  CHECK(ReadFile(root / "cogbox-save-key") == Bytes("0009000012345678"));
+}
