+bool CogNoteSaveKey(const std::filesystem::path& root, uint64_t run_key) {
+  const auto keys = CogSaveKeyHistory(root);
+  if (!keys.empty() && keys[0] == run_key) return true;
+  std::vector<std::string> lines = {fmt::format("{:016X}", run_key)};
+  for (uint64_t k : keys) {
+    if (k != run_key && lines.size() < kKeyHistoryMax) lines.push_back(fmt::format("{:016X}", k));
+  }
+  return WriteLines(root / "cogbox-save-key", lines);
