+TEST_CASE("Save copy: only redundant copies are pruned, down to 20, oldest first (r79 R2)", "[net][save]") {
+  G3Root g("snapshot_prune");
+  const auto save = Signed(0, 6238);
+  WriteFile(g.ps, save);
+  const fs::path backups = g.root / "_cogbox-save-backups";
+  fs::create_directories(backups / (SnapName(3, "20250101") + ".cogbox-tmp"));   // a half-made one from a crash
+  // 25 copies of the same save, signed for one key or the other (an online / offline toggle each)
+  for (int k = 1; k <= 25; ++k) MakeSnapshot(g, SnapName(k, "20250101"), Resigned(save, k % 2 ? 0 : kXuid));
+  REQUIRE(CogSnapshotSavesOnKeyChange(g.root, kProfile, 0x1234) == SnapshotResult::Copied);
+  CHECK(WithPrefix(backups, "").size() == 20);
+  CHECK(fs::exists(backups / SnapName(1, "20250101")));       // the oldest is always kept
+  CHECK_FALSE(fs::exists(backups / SnapName(2, "20250101")));  // then the oldest redundant ones went
+  CHECK_FALSE(fs::exists(backups / SnapName(7, "20250101")));
+  CHECK(fs::exists(backups / SnapName(8, "20250101")));
+  CHECK(WithPrefix(backups, "000026-").size() == 1);           // the one just made
+  CHECK_FALSE(fs::exists(backups / (SnapName(3, "20250101") + ".cogbox-tmp")));
+}
