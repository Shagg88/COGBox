+// Patch 106: every file of a set, concatenated; false if any of them can't be read.
+bool CogReadSet(const std::vector<std::filesystem::path>& files, std::vector<uint8_t>* all, std::vector<size_t>* sizes) {
+  all->clear();
+  sizes->clear();
+  for (const auto& f : files) {
+    std::vector<uint8_t> v;
+    if (!CogReadFile(f, &v)) return false;
