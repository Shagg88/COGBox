+TEST_CASE("Save copy: folders COGBox didn't make are never pruned (r79 R1 repro)", "[net][save]") {
+  G3Root g("snapshot_foreign");
+  const auto save = Signed(0, 6238);
+  WriteFile(g.ps, save);
+  const fs::path backups = g.root / "_cogbox-save-backups";
+  for (int k = 1; k <= 25; ++k) MakeSnapshot(g, SnapName(k, "20250101"), save);
+  const std::vector<fs::path> players = {
+      backups / "0 my good save before 0.6.3", backups / "1-RAAM done", backups / "My manual backup",
+      backups / "keep.cogbox-tmp", backups / (SnapName(2, "20250101") + " copy"),
+      backups / "000002-20250101-120000-0000000000000000-to-0009000012345678.cogbox-tmp.bak",
+      backups / "000002-20250101-120000-0000000000000000-to-0009000012345678x",
+      backups / "000002-20250101-120000-0000000000000abc-to-0009000012345678",   // lower-case hex: not ours
+      backups / "2-20250101-120000-first-to-0009000012345678",
+#if defined(_WIN32)
+      backups / fs::path(L"000002 Sicherung \u00fc \u65e5\u672c")};   // not in any one ANSI code page
+#else
+      backups / fs::path("000002 Sicherung \xc3\xbc \xe6\x97\xa5\xe6\x9c\xac")};
+#endif
+  for (const auto& p : players) {
+    fs::create_directories(p);
+    WriteFile(p / "PlayerStorage.dat", save);
+  }
+  // a link named like a snapshot, to a folder outside: neither the link nor what it points at is touched
+  const fs::path outside = g.root / "outside";
+  fs::create_directories(outside);
+  WriteFile(outside / "PlayerStorage.dat", save);
+  const fs::path link = backups / SnapName(4, "20250101", "first");
+  const fs::path tmp_link = backups / (SnapName(5, "20250101", "first") + ".cogbox-tmp");
+  std::error_code lec;
+  fs::create_directory_symlink(outside, link, lec);
+  if (!lec) fs::create_directory_symlink(outside, tmp_link, lec);
+  REQUIRE(CogSnapshotSavesOnKeyChange(g.root, kProfile, 0x1234) == SnapshotResult::Copied);
+  for (const auto& p : players) {
+    CHECK(ReadFile(p / "PlayerStorage.dat") == save);
+  }
+  CHECK(ReadFile(outside / "PlayerStorage.dat") == save);
+  if (!lec) {
+    CHECK(fs::is_symlink(link));
+    CHECK(fs::is_symlink(tmp_link));
+  }
+  // and pruning still worked on COGBox's own folders: 20 of them left beside the players' folders and links
+  size_t own = 0;
+  for (auto& e : fs::directory_iterator(backups)) {
+    if (!fs::is_symlink(e.symlink_status()) && std::find(players.begin(), players.end(), e.path()) == players.end()) {
+      ++own;
+    }
+  }
+  CHECK(own == 20);
+}
