+TEST_CASE("Save prepare: the last run's key is converted with a check (r78 F3)", "[net][save]") {
+  G3Root g("prepare_last_key");
+  // the saves of the last run, signed for the old account, and that run's key noted
+  WriteFile(g.ps, Signed(kOldAccount, 6238));
+  WriteProfileSet(g.prof, kOldAccount);
+  WriteFile(g.root / "cogbox-save-key", Bytes("0009000000000ABC"));
+  REQUIRE(CogLastSaveKey(g.root) == kOldAccount);
+  // a new online account: verified, so even with the unverified re-sign off it converts
+  CogPrepareGears3Saves(g.root, kProfile, kXuid, 0, false, std::nullopt);
+  CHECK(FileSignedFor(g.ps, kXuid));
+  CHECK(SetSignedFor(g.prof, kXuid));
+  CHECK(fs::exists(fs::path(g.ps) += ".pre-lastkey"));
+  CHECK(WithPrefix(g.ps.parent_path(), "PlayerStorage.dat.cogbox-adopted-").empty());
+  CHECK(CogLastSaveKey(g.root) == kXuid);
+}
