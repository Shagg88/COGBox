+// Every file of a snapshot by its path inside it: a digest of its size and bytes (past the signature for a signed
+// Gears 3 file, so a copy of the same save signed for another key counts as the same). nullopt when a file can't be
+// read or the folder is unexpectedly large: such a snapshot is never taken as redundant.
+using SnapshotContent = std::map<std::filesystem::path, std::array<uint8_t, 20>>;
+std::optional<SnapshotContent> ReadSnapshotContent(const std::filesystem::path& dir) {
+  SnapshotContent out;
+  std::error_code ec;
+  for (auto it = std::filesystem::recursive_directory_iterator(dir, std::filesystem::directory_options::none, ec);
+       !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    std::error_code sec;
+    const auto st = it->symlink_status(sec);
+    if (sec) return std::nullopt;
+    if (std::filesystem::is_directory(st)) continue;
+    if (!std::filesystem::is_regular_file(st)) return std::nullopt;   // a link or anything odd: keep the snapshot
+    std::error_code zec;
+    if (out.size() >= kSnapshotFilesMax || std::filesystem::file_size(it->path(), zec) > kSnapshotFileMax || zec) {
+      return std::nullopt;
+    }
+    std::vector<uint8_t> v;
+    if (!CogReadFile(it->path(), &v)) return std::nullopt;
+    const auto rel = it->path().lexically_relative(dir);
+    const size_t skip = SignedSaveFile(rel) && v.size() >= 20 ? 20 : 0;
+    out[rel] = CogSign(uint64_t(v.size()), v.data() + skip, v.size() - skip);
+  }
+  if (ec) return std::nullopt;
+  return out;
+}
+bool Covers(const SnapshotContent& newer, const SnapshotContent& older) {
+  for (const auto& [rel, d] : older) {
+    const auto it = newer.find(rel);
+    if (it == newer.end() || it->second != d) return false;
+  }
+  return true;
