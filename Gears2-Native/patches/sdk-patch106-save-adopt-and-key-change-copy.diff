+std::optional<uint64_t> CogLastSaveKey(const std::filesystem::path& user_data_root);
+// When run_key differs from the last run's (none noted counts as a change), every Gears 3 / Judgment save file in place
+// (PlayerStorage.dat, Judgment's header, the profile settings 63E83FFF/E/D) is copied to
+// <user_data_root>/_cogbox-save-backups/<stamp>-<old key>-to-<new key>/ under the same relative path (built in a
+// .cogbox-tmp folder and renamed when whole; the newest 20 kept), then run_key is noted (atomically). A file that can't
+// be read fails the copy: no folder is left and the key is not noted, so it is tried again next start. A user folder of
+// another game (no Gears 3 / Judgment folder) is left alone. True when a copy was made and the key noted. Never throws.
+bool CogSnapshotSavesOnKeyChange(const std::filesystem::path& user_data_root, uint64_t profile_xuid, uint64_t run_key);
+// Everything done to the Gears 3 saves at start-up, in order: the copy above; the verified conversions from other_key,
+// from the last run's key and from extra_key (--cogbox_save_adopt_key) to run_key; only then, if adopt_foreign, the
+// unverified adoption; and the per-set verdict (CogReportGears3SaveSigning). other_key == run_key: no conversion from it.
+void CogPrepareGears3Saves(const std::filesystem::path& user_data_root, uint64_t profile_xuid, uint64_t run_key,
+                           uint64_t other_key, bool adopt_foreign, std::optional<uint64_t> extra_key);
