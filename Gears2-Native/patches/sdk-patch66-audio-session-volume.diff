+namespace {
+#ifdef _WIN32
+// COGBox patch 66 (GitHub #203: sound on the monitor's speakers, silence on the desktop speakers, while the log shows
+// the speakers opened normally). Windows keeps a volume-mixer slider and mute for each program on each output device,
+// by the program's path, and keeps it across reboots and reinstalls to the same folder - so a gow3.exe muted (or
+// slid to 0) on one device stays silent there and plays on every other device. SDL's stream is this process's
+// default audio session on the default device; this reads that session's slider and mute (and the device's own
+// volume, for the log), restores a muted / zero slider unless --audio_restore_session_volume=false, and returns the
+// default device's id so a change of default device (SDL moves the stream to it) is noticed and checked again.
+// inspect=false only returns the id (the 5 s poll): a slider the player moves during play is never touched.
+std::wstring CheckDefaultEndpointSession(bool inspect) {
+  std::wstring id_out;
+  const HRESULT co = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  IMMDeviceEnumerator* en = nullptr;
+  IMMDevice* dev = nullptr;
+  if (SUCCEEDED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator),
+                                 reinterpret_cast<void**>(&en))) &&
+      SUCCEEDED(en->GetDefaultAudioEndpoint(eRender, eConsole, &dev))) {
+    LPWSTR id = nullptr;
+    if (SUCCEEDED(dev->GetId(&id)) && id) {
+      id_out = id;
+      CoTaskMemFree(id);
+    }
+  }
+  if (dev && inspect) {
+    float dev_vol = -1.0f;
+    BOOL dev_mute = FALSE;
+    IAudioEndpointVolume* ev = nullptr;
+    if (SUCCEEDED(dev->Activate(__uuidof(IAudioEndpointVolume), CLSCTX_ALL, nullptr, reinterpret_cast<void**>(&ev)))) {
+      ev->GetMasterVolumeLevelScalar(&dev_vol);
+      ev->GetMute(&dev_mute);
+      ev->Release();
+    }
+    float app_vol = -1.0f;
+    BOOL app_mute = FALSE;
+    bool restored = false;
+    IAudioSessionManager* sm = nullptr;
+    ISimpleAudioVolume* sv = nullptr;
+    if (SUCCEEDED(dev->Activate(__uuidof(IAudioSessionManager), CLSCTX_ALL, nullptr, reinterpret_cast<void**>(&sm))) &&
+        SUCCEEDED(sm->GetSimpleAudioVolume(nullptr, FALSE, &sv))) {
+      sv->GetMasterVolume(&app_vol);
+      sv->GetMute(&app_mute);
+      if ((app_mute || (app_vol >= 0.0f && app_vol < 0.01f)) && REXCVAR_GET(audio_restore_session_volume)) {
+        restored = (!app_mute || SUCCEEDED(sv->SetMute(FALSE, nullptr))) &&
+                   (app_vol >= 0.01f || SUCCEEDED(sv->SetMasterVolume(1.0f, nullptr)));
+      }
+      sv->Release();
+    }
+    if (sm) sm->Release();
+    const bool silent = app_mute || (app_vol >= 0.0f && app_vol < 0.01f);
+    if (silent) {
+      REXAPU_WARN("audio: this game's own Windows volume-mixer slider on the output device is {} ({}%){}", app_mute ? "MUTED" : "at 0",
+                  static_cast<int>(app_vol * 100.0f + 0.5f),
+                  restored ? " - restored (unmuted, or 0 set to 100%; --audio_restore_session_volume=false keeps it)"
+                           : (REXCVAR_GET(audio_restore_session_volume) ? " - restoring it failed" : " - left as it is"));
+    }
+    {
+      REXAPU_INFO("audio: Windows default output: device volume {}%{}, this game's mixer slider {}%{}",
+                  static_cast<int>(dev_vol * 100.0f + 0.5f), dev_mute ? " (device MUTED)" : "",
+                  static_cast<int>(app_vol * 100.0f + 0.5f), app_mute ? " (muted)" : "");
+    }
+  }
+  if (dev) dev->Release();
+  if (en) en->Release();
+  if (SUCCEEDED(co)) CoUninitialize();
+  return id_out;
+}
+#endif
