diff --git a/resources/templates/codegen/pch_h.inja b/resources/templates/codegen/pch_h.inja
--- a/resources/templates/codegen/pch_h.inja
+++ b/resources/templates/codegen/pch_h.inja
@@ -144,6 +144,17 @@
 #define REX_STORE_U32(x, y) (*(volatile u32*)(base + (u32)(x) + REX_PHYS_HOST_OFFSET(x)) = __builtin_bswap32(y))
 #define REX_STORE_U64(x, y) (*(volatile u64*)(base + (u32)(x) + REX_PHYS_HOST_OFFSET(x)) = __builtin_bswap64(y))
 
+// Gears2-Native SDK patch 28: accesses based on the stack pointer (r1) - stack frames, register saves - never reach
+// the 0xE0000000+ physical views, so they skip the REX_PHYS_HOST_OFFSET compare (about a third of all loads/stores).
+#define REX_SLOAD_U8(x) (*(volatile u8*)(base + (u32)(x)))
+#define REX_SLOAD_U16(x) __builtin_bswap16(*(volatile u16*)(base + (u32)(x)))
+#define REX_SLOAD_U32(x) __builtin_bswap32(*(volatile u32*)(base + (u32)(x)))
+#define REX_SLOAD_U64(x) __builtin_bswap64(*(volatile u64*)(base + (u32)(x)))
+#define REX_SSTORE_U8(x, y)  (*(volatile u8*)(base + (u32)(x)) = (y))
+#define REX_SSTORE_U16(x, y) (*(volatile u16*)(base + (u32)(x)) = __builtin_bswap16(y))
+#define REX_SSTORE_U32(x, y) (*(volatile u32*)(base + (u32)(x)) = __builtin_bswap32(y))
+#define REX_SSTORE_U64(x, y) (*(volatile u64*)(base + (u32)(x)) = __builtin_bswap64(y))
+
 #define REX_MEMORY_SIZE 0x100000000ull
 
 //=============================================================================
diff --git a/src/codegen/builders/context.cpp b/src/codegen/builders/context.cpp
--- a/src/codegen/builders/context.cpp
+++ b/src/codegen/builders/context.cpp
@@ -499,6 +499,10 @@
       snprintf(mm_macro, sizeof(mm_macro), "REX_MM_LOAD_%s", load_macro + 9);
       macro = mm_macro;
     }
+  } else if (insn.operands[2] == 1 && strncmp(load_macro, "REX_LOAD_", 9) == 0) {
+    // Gears2-Native SDK patch 28: stack-pointer based - no physical-view offset check.
+    snprintf(mm_macro, sizeof(mm_macro), "REX_SLOAD_%s", load_macro + 9);
+    macro = mm_macro;
   }
 
   print("\t{}.{} = {}(", r(insn.operands[0]), dest_type, macro);
@@ -539,6 +543,10 @@
       snprintf(mm_macro, sizeof(mm_macro), "REX_MM_STORE_%s", store_macro + 10);
       macro = mm_macro;
     }
+  } else if (insn.operands[2] == 1 && strncmp(store_macro, "REX_STORE_", 10) == 0) {
+    // Gears2-Native SDK patch 28: stack-pointer based - no physical-view offset check.
+    snprintf(mm_macro, sizeof(mm_macro), "REX_SSTORE_%s", store_macro + 10);
+    macro = mm_macro;
   }
 
   print("\t{}(", macro);
diff --git a/src/codegen/builders/helpers.h b/src/codegen/builders/helpers.h
