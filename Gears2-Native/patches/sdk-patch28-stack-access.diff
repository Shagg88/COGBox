   // EA = displacement + rA
   ctx.println("\t{} = {} + {}.u32;", ctx.ea(), static_cast<int32_t>(ctx.insn.operands[1]),
               ctx.r(ctx.insn.operands[2]));
-  // rD = MEM[EA]
-  ctx.println("\t{}.u64 = {}({});", ctx.r(ctx.insn.operands[0]), load_macro, ctx.ea());
+  // rD = MEM[EA] (Gears2-Native SDK patch 28: r1-based -> no physical-view offset check)
+  if (ctx.insn.operands[2] == 1 && std::string_view(load_macro).starts_with("REX_LOAD_"))
+    ctx.println("\t{}.u64 = REX_SLOAD_{}({});", ctx.r(ctx.insn.operands[0]), load_macro + 9, ctx.ea());
+  else
+    ctx.println("\t{}.u64 = {}({});", ctx.r(ctx.insn.operands[0]), load_macro, ctx.ea());
   // rA = EA (update)
   ctx.println("\t{}.u32 = {};", ctx.r(ctx.insn.operands[2]), ctx.ea());
 }
@@ -221,8 +225,11 @@
   // EA = displacement + rA
   ctx.println("\t{} = {} + {}.u32;", ctx.ea(), static_cast<int32_t>(ctx.insn.operands[1]),
               ctx.r(ctx.insn.operands[2]));
-  // MEM[EA] = rS
-  ctx.println("\t{}({}, {}.{});", store_macro, ctx.ea(), ctx.r(ctx.insn.operands[0]), field);
+  // MEM[EA] = rS (Gears2-Native SDK patch 28: r1-based, e.g. stwu r1 - no physical-view offset check)
+  if (ctx.insn.operands[2] == 1 && std::string_view(store_macro).starts_with("REX_STORE_"))
+    ctx.println("\tREX_SSTORE_{}({}, {}.{});", store_macro + 10, ctx.ea(), ctx.r(ctx.insn.operands[0]), field);
+  else
+    ctx.println("\t{}({}, {}.{});", store_macro, ctx.ea(), ctx.r(ctx.insn.operands[0]), field);
   // rA = EA (update)
   ctx.println("\t{}.u32 = {};", ctx.r(ctx.insn.operands[2]), ctx.ea());
 }
