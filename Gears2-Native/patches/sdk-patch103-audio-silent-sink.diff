+void SDLAudioDriver::SilentSinkLoop(bool allow_retry) {
+  using clock = std::chrono::steady_clock;
+  // One frame is channel_samples_ samples at frame_frequency_: 256 / 48000 s = 5.33 ms.
+  const auto period = std::chrono::nanoseconds(1000000000LL * channel_samples_ / frame_frequency_);
+  auto next = clock::now() + period;
+  auto next_retry = clock::now() + std::chrono::seconds(5);
+  while (!silent_stop_) {
+    auto now = clock::now();
+    if (now < next) {
+      std::this_thread::sleep_for(std::min<clock::duration>(next - now, std::chrono::milliseconds(20)));
+      continue;
+    }
+    if (now - next > std::chrono::milliseconds(250)) next = now;  // a stall: do not replay it
+    uint32_t consumed = 0;
+    {
+      // What SDLCallback does with a queued frame, minus the mixing: the buffer goes back to frames_unused_ and the
+      // game's semaphore is released once for it. No queued frame = silence for that slot, nothing released.
+      std::unique_lock<std::mutex> guard(frames_mutex_);
+      for (; next <= now; next += period) {
+        if (frames_queued_.empty()) continue;
+        frames_unused_.push(frames_queued_.front());
+        frames_queued_.pop();
+        ++consumed;
