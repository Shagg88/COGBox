 #include <cstdlib>
 #include <cstring>
@@ -69,6 +70,12 @@ REXCVAR_DEFINE_BOOL(mnk_walk_toggle, false, "Input", "Walk key toggles walking i
 REXCVAR_DEFINE_DOUBLE(mnk_walk_scale, 0.5, "Input", "Left stick deflection while walking (0.1 - 1)")
     .range(0.1, 1.0);
 
+// COGBox SDK patch 99 (GitHub #305): a tap shorter than one game frame is kept until the game has read it.
+REXCVAR_DEFINE_INT32(mnk_tap_latch_ms, 250, "Input",
+                     "Keep a key / mouse button press until the game has read it, for up to this many ms "
+                     "(0 = off: a tap between two game reads is lost)")
+    .range(0, 1000);
+
 REXCVAR_DEFINE_BOOL(mnk_passthrough, false, "Input",
                     "Surface raw keystrokes to the title instead of emulating a pad, for "
                     "titles that read a USB keyboard. Enables the device on its own");
@@ -331,6 +338,21 @@ std::array<PadBind, 24> PadBinds() {
   }};
 }
 
+// Patch 99: bind table entries 0-15 (buttons and triggers) are latched; the stick directions are not.
+constexpr uint32_t kLatchedBinds = 0xFFFF;
+constexpr uint16_t kLatchButton[16] = {
+    X_INPUT_GAMEPAD_A,          X_INPUT_GAMEPAD_B,           X_INPUT_GAMEPAD_X,         X_INPUT_GAMEPAD_Y,
+    X_INPUT_GAMEPAD_LEFT_SHOULDER, X_INPUT_GAMEPAD_RIGHT_SHOULDER, 0 /* LT */,          0 /* RT */,
+    X_INPUT_GAMEPAD_LEFT_THUMB, X_INPUT_GAMEPAD_RIGHT_THUMB, X_INPUT_GAMEPAD_BACK,      X_INPUT_GAMEPAD_START,
+    X_INPUT_GAMEPAD_DPAD_UP,    X_INPUT_GAMEPAD_DPAD_DOWN,   X_INPUT_GAMEPAD_DPAD_LEFT, X_INPUT_GAMEPAD_DPAD_RIGHT};
+constexpr uint32_t kLatchLt = 1u << 6, kLatchRt = 1u << 7;
+
+uint64_t NowMs() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+
 }  // namespace
 
 void SetMouseLookActive(bool active) {
@@ -534,6 +556,22 @@ X_RESULT MnkInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
   uint8_t lt = IsBindPressed(key_down_, REXCVAR_GET(keybind_left_trigger)) ? 0xFF : 0;
   uint8_t rt = IsBindPressed(key_down_, REXCVAR_GET(keybind_right_trigger)) ? 0xFF : 0;
 
+  // Patch 99 (#305): taps that went down and up since the game's last read are reported down once.
+  if (const int32_t latch_ms = REXCVAR_GET(mnk_tap_latch_ms); latch_ms > 0) {
+    uint32_t live = 0;
+    for (uint32_t i = 0; i < 16; ++i)
+      if (kLatchButton[i] & buttons) live |= 1u << i;
+    if (lt) live |= kLatchLt;
+    if (rt) live |= kLatchRt;
+    const uint32_t out = tap_latch_.Read(live, InGuestPoll(), NowMs(), static_cast<uint32_t>(latch_ms));
+    buttons = 0;
+    for (uint32_t i = 0; i < 16; ++i)
+      if (out >> i & 1u) buttons |= kLatchButton[i];
+    if (IsBindPressed(key_down_, REXCVAR_GET(keybind_guide))) buttons |= X_INPUT_GAMEPAD_GUIDE;  // not latched
+    lt = (out & kLatchLt) ? 0xFF : 0;
+    rt = (out & kLatchRt) ? 0xFF : 0;
+  }
+
   int32_t lx = 0;
   int32_t ly = 0;
   if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_left)))
@@ -679,6 +717,10 @@ void MnkInputDriver::RefreshBoundKeystrokesLocked() {
   // The whole table is diffed rather than the key that moved: binds carry
   // modifiers, so Shift alone can flip several of them at once.
   const uint32_t changed = pressed ^ bound_pressed_;
+  // Patch 99 (#305): a bind that went down is kept for the game's next read, even if it goes up first.
+  if (REXCVAR_GET(mnk_tap_latch_ms) > 0) {
+    tap_latch_.Rise(changed & pressed & kLatchedBinds, NowMs());
+  }
   bound_pressed_ = pressed;
   if (!changed) {
     return;
@@ -909,6 +951,7 @@ void MnkInputDriver::OnLostFocus(rex::ui::UISetupEvent&) {
     std::memset(key_down_, 0, sizeof(key_down_));
     // Releases landing on another window never arrive here as key-ups.
     RefreshBoundKeystrokesLocked();
+    tap_latch_.Clear();  // patch 99: no press from before the switch reaches the game afterwards
     mouse_dx_ = 0.0f;
     mouse_dy_ = 0.0f;
   }
