diff --git a/tests/unit/input/tap_latch_test.cpp b/tests/unit/input/tap_latch_test.cpp
new file mode 100644
index 0000000..9eeee05
--- /dev/null
+++ b/tests/unit/input/tap_latch_test.cpp
@@ -0,0 +1,83 @@
+// COGBox SDK patch 99 (GitHub #305): short taps reach the game's next read, once.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <initializer_list>
+
+#include <rex/input/tap_latch.h>
+
+using rex::input::TapLatch;
+
+namespace {
+constexpr uint32_t kB = 1u << 1;
+constexpr uint32_t kExpire = 250;
+}  // namespace
+
+TEST_CASE("A tap between two game reads is reported down once", "[input]") {
+  TapLatch l;
+  CHECK(l.Read(0, true, 0, kExpire) == 0);
+  l.Rise(kB, 10);                                // down at 10 ms, up at 20 ms: no read in between
+  CHECK(l.Read(0, false, 25, kExpire) == kB);    // a host read sees it but does not use it up
+  CHECK(l.Read(0, true, 33, kExpire) == kB);     // the game's read gets it
+  CHECK(l.Read(0, true, 66, kExpire) == 0);      // and the release next frame
+  CHECK(l.Read(0, true, 99, kExpire) == 0);      // never a second time
+}
+
+TEST_CASE("A held key is one press; no extra press on release", "[input]") {
+  TapLatch l;
+  l.Rise(kB, 0);
+  CHECK(l.Read(kB, true, 33, kExpire) == kB);
+  CHECK(l.Read(kB, true, 66, kExpire) == kB);
+  CHECK(l.Read(0, true, 99, kExpire) == 0);
+}
+
+TEST_CASE("Released and pressed again between two reads gives up, then down", "[input]") {
+  TapLatch l;
+  l.Rise(kB, 0);
+  CHECK(l.Read(kB, true, 33, kExpire) == kB);
+  l.Rise(kB, 50);                                 // let go at 40, down again at 50, still held
+  CHECK(l.Read(kB, true, 66, kExpire) == 0);      // one 'up' read
+  CHECK(l.Read(kB, true, 99, kExpire) == kB);     // the second press
+  CHECK(l.Read(0, true, 133, kExpire) == 0);
+}
+
+TEST_CASE("Rising edges seen by the game never outnumber real presses", "[input]") {
+  for (uint64_t period : {40, 60, 100}) {         // a 10 ms tap every 40 / 60 / 100 ms
+    TapLatch l;
+    int real = 0, seen = 0;
+    uint32_t prev = 0;
+    for (uint64_t t = 0; t < 10000; ++t) {
+      if (t % period == 5) { l.Rise(kB, t); ++real; }
+      if (t % 33 == 0) {                          // the game reads every 33 ms
+        const uint32_t out = l.Read(0, true, t, kExpire);
+        if ((out & kB) && !(prev & kB)) ++seen;
+        prev = out;
+      }
+    }
+    CHECK(seen <= real);
+    if (period >= 66) CHECK(seen >= real - 1);    // at most one press per two reads can be shown
+  }
+}
+
+TEST_CASE("A press the game never reads is dropped after the latch time", "[input]") {
+  TapLatch l;
+  l.Rise(kB, 0);
+  CHECK(l.Read(0, true, 300, kExpire) == 0);
+}
+
+TEST_CASE("Clear drops pending presses (focus lost)", "[input]") {
+  TapLatch l;
+  l.Rise(kB, 0);
+  l.Clear();
+  CHECK(l.Read(0, true, 33, kExpire) == 0);
+}
+
+TEST_CASE("A host read is not held back by what the game last saw (review r14)", "[input]") {
+  TapLatch l;
+  l.Rise(kB, 0);
+  CHECK(l.Read(kB, true, 33, kExpire) == kB);    // the game saw it held
+  l.Rise(kB, 50);                                // released and tapped again while the game's reads are blocked
+  CHECK(l.Read(0, false, 60, kExpire) == kB);    // the host (COGBox menu) sees the tap
+  CHECK(l.Read(0, true, 66, kExpire) == 0);      // the game still gets its 'up' first
+  CHECK(l.Read(0, true, 99, kExpire) == kB);
+}
