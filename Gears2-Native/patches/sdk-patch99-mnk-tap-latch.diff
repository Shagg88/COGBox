From: Shagg <shagg.dev88@gmail.com>
Subject: [PATCH] patch99 (GitHub #305): short key / mouse taps kept until the game's own read (mnk_tap_latch_ms), with review r14 fixes

diff --git a/include/rex/input/input_driver.h b/include/rex/input/input_driver.h
index 52116f1..02aaeb9 100644
--- a/include/rex/input/input_driver.h
+++ b/include/rex/input/input_driver.h
@@ -27,6 +27,20 @@ namespace rex::input {
 
 class InputSystem;
 
+// COGBox SDK patch 99 (GitHub #305): true while InputSystem::GetState reads the drivers for the game (XInputGetState).
+// COGBox's own readers go through GetStateForUI and see false. Set per thread by GuestPollScope.
+bool InGuestPoll();
+class GuestPollScope {
+ public:
+  GuestPollScope();
+  ~GuestPollScope();
+  GuestPollScope(const GuestPollScope&) = delete;
+  GuestPollScope& operator=(const GuestPollScope&) = delete;
+
+ private:
+  bool prev_;
+};
+
