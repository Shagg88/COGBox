diff --git a/include/rex/input/tap_latch.h b/include/rex/input/tap_latch.h
new file mode 100644
index 0000000..4def5b7
--- /dev/null
+++ b/include/rex/input/tap_latch.h
@@ -0,0 +1,45 @@
+// COGBox SDK patch 99 (GitHub #305): a key or mouse tap shorter than one game read still reaches the game.
+// The game reads the pad once per frame (about every 33 ms at 30 fps); a tap that goes down and up between two
+// reads used to be lost. Each pad bind that goes down is kept "pending" until the game's own read (InGuestPoll) has
+// reported it down once. Host reads (COGBox's menu, the prompt monitor) see it but never use it up.
+#pragma once
+
+#include <cstdint>
+
+namespace rex::input {
+
+struct TapLatch {
+  uint32_t pending = 0;      // binds that went down since the game last read them down
+  uint32_t reported = 0;     // what the game was given at its last read
+  uint64_t since_ms[32] = {};
+
+  // Binds that went from up to down (key / mouse handlers, under the driver's lock).
+  void Rise(uint32_t rose, uint64_t now_ms) {
+    for (uint32_t i = 0; i < 32; ++i)
+      if ((rose & ~pending) >> i & 1u) since_ms[i] = now_ms;
+    pending |= rose;
+  }
+
+  // The binds to report for one read. live = held right now. guest = the game's own read: it uses up what it is
+  // shown. A press the game has not read within expire_ms (loading, a paused poll) is dropped.
+  uint32_t Read(uint32_t live, bool guest, uint64_t now_ms, uint32_t expire_ms) {
+    for (uint32_t i = 0; i < 32; ++i)
+      if ((pending >> i & 1u) && now_ms - since_ms[i] > expire_ms) pending &= ~(1u << i);
+    uint32_t out = live | pending;
+    // Pressed again after a read that showed it down (released in between): one read "up" first, so the game sees
+    // a second press instead of one long one. The new press stays pending for the next read.
+    // Only for the game's reads: 'reported' is what the game was last shown, which says nothing about a host reader
+    // (review r14: the COGBox menu, open while the game's reads are blocked, would miss a tap of a key the game last saw
+    // held, and RemoveUIInputBlocker would not mask it). Host reads get live | pending.
+    if (guest) out &= ~(reported & pending);
+    if (guest) {
+      pending &= ~out;
+      reported = out;
+    }
+    return out;
+  }
+
+  void Clear() { pending = reported = 0; }
+};
+
+}  // namespace rex::input
diff --git a/src/input/input_system.cpp b/src/input/input_system.cpp
index 9f7bde8..c38160b 100644
--- a/src/input/input_system.cpp
+++ b/src/input/input_system.cpp
@@ -68,6 +68,20 @@ REXCVAR_DEFINE_STRING(pad_remap, "", "Input",
                       "Controller button layout, e.g. 'a=b,b=a' or 'sticks=swap' (empty = the game's own), COGBox patch 55");
 namespace rex::input {
 
+namespace {
+thread_local bool t_guest_poll = false;  // patch 99: see GuestPollScope
+}  // namespace
+
+bool InGuestPoll() {
+  return t_guest_poll;
+}
+GuestPollScope::GuestPollScope() : prev_(t_guest_poll) {
+  t_guest_poll = true;
+}
+GuestPollScope::~GuestPollScope() {
+  t_guest_poll = prev_;
+}
+
 namespace {
 
 // ---- Patch 55: radial dead zone and button layout (see the cvars above) ----
@@ -415,7 +429,13 @@ X_RESULT InputSystem::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
     return X_ERROR_SUCCESS;
   }
 
-  X_RESULT result = GetStateForUI(user_index, out_state);
+  X_RESULT result;
+  if (out_state) {
+    GuestPollScope guest_poll;  // patch 99: this read is the game's, so it uses up short taps (mnk driver)
+    result = GetStateForUI(user_index, out_state);
+  } else {
+    result = GetStateForUI(user_index, out_state);   // a connection check reads nothing: no tap is used up
+  }
   if (result == X_ERROR_SUCCESS && out_state) {
     out_state->gamepad.buttons = ButtonsForGame(static_cast<uint16_t>(out_state->gamepad.buttons), REXCVAR_GET(guide_button));
   }
