diff -ru a/src/kernel/xboxkrnl/xboxkrnl_audio_xma.cpp b/src/kernel/xboxkrnl/xboxkrnl_audio_xma.cpp
--- a/src/kernel/xboxkrnl/xboxkrnl_audio_xma.cpp	2026-11-11 16:56:35.031347251 -0800
+++ b/src/kernel/xboxkrnl/xboxkrnl_audio_xma.cpp	2026-11-11 16:56:35.148940455 -0800
@@ -161,6 +161,10 @@
     return X_E_FALSE;
   }
 
+  // COGBox patch 80 (Edge 56e9596): the decoder's state is cleared FIRST - the Clear also resets the read offset, which
+  // comes from the init struct (cleared after the store, every sound started at offset 0)
+  StoreXmaContextIndexedRegister(REX_KERNEL_STATE(), 0x1A80, context_ptr.guest_address());
+
   std::memset(context_ptr, 0, sizeof(XMA_CONTEXT_DATA));
 
   XMA_CONTEXT_DATA context(context_ptr);
@@ -175,7 +179,7 @@
 
   // context.work_buffer = context_init->work_buffer;  // ?
   context.subframe_decode_count = context_init->subframe_decode_count;
-  context.is_stereo = context_init->channel_count >= 1;
+  context.is_stereo = context_init->channel_count & 1;   // patch 80: the channel count is 0-based, only bit 0
   context.sample_rate = context_init->sample_rate;
 
   context.loop_start = context_init->loop_data.loop_start;
@@ -186,8 +190,6 @@
 
   context.Store(context_ptr);
 
-  StoreXmaContextIndexedRegister(REX_KERNEL_STATE(), 0x1A80, context_ptr.guest_address());
-
   return 0;
 }
 
@@ -338,17 +340,12 @@
   return result;
 }
 
+// COGBox patch 80 (Edge 9906014): waits until the decoder isn't working on the context. Was a loop that always ended at
+// once (work_buffer_ptr is never set), so a game could reuse a context the decoder was still reading.
 u32 XMABlockWhileInUse_entry(mapped_void context_ptr) {
-  do {
-    XMA_CONTEXT_DATA context(context_ptr);
-    if (!context.input_buffer_0_valid && !context.input_buffer_1_valid) {
-      break;
-    }
-    if (!context.work_buffer_ptr) {
-      break;
-    }
-    rex::thread::Sleep(std::chrono::milliseconds(1));
-  } while (true);
+  static_cast<audio::AudioSystem*>(REX_KERNEL_STATE()->emulator()->audio_system())
+      ->xma_decoder()
+      ->BlockOnContext(context_ptr.guest_address(), false);
   return 0;
 }
 
