diff --git a/src/codegen/builders/logical.cpp b/src/codegen/builders/logical.cpp
index a58f51d0..58dee363 100644
--- a/src/codegen/builders/logical.cpp
+++ b/src/codegen/builders/logical.cpp
@@ -351,6 +351,10 @@ bool build_srad(BuilderContext& ctx) {
   ctx.println("\t{}.ca = ({}.s64 < 0) & ((({}.s64 >> {}.u64) << {}.u64) != {}.s64);", ctx.xer(),
               ctx.r(ctx.insn.operands[1]), ctx.r(ctx.insn.operands[1]), ctx.temp(), ctx.temp(),
               ctx.r(ctx.insn.operands[1]));
+  // COGBox patch 109 (rexglue 02a002f): a shift of 64 or more shifts out every bit - CA is the sign bit (computed
+  // before rD is written, as rD may be rS).
+  ctx.println("\tif ({}.u8 & 0x40) {}.ca = {}.s64 < 0;", ctx.r(ctx.insn.operands[2]), ctx.xer(),
+              ctx.r(ctx.insn.operands[1]));
   ctx.println("\t{}.s64 = {}.s64 >> {}.u64;", ctx.r(ctx.insn.operands[0]),
               ctx.r(ctx.insn.operands[1]), ctx.temp());
   emitRecordFormCompare(ctx);
@@ -378,6 +382,9 @@ bool build_sraw(BuilderContext& ctx) {
   ctx.println("\t{}.ca = ({}.s32 < 0) & ((({}.s32 >> {}.u32) << {}.u32) != {}.s32);", ctx.xer(),
               ctx.r(ctx.insn.operands[1]), ctx.r(ctx.insn.operands[1]), ctx.temp(), ctx.temp(),
               ctx.r(ctx.insn.operands[1]));
+  // COGBox patch 109 (rexglue 02a002f): a shift of 32 or more - CA is the sign bit.
+  ctx.println("\tif ({}.u8 & 0x20) {}.ca = {}.s32 < 0;", ctx.r(ctx.insn.operands[2]), ctx.xer(),
+              ctx.r(ctx.insn.operands[1]));
   ctx.println("\t{}.s64 = {}.s32 >> {}.u32;", ctx.r(ctx.insn.operands[0]),
               ctx.r(ctx.insn.operands[1]), ctx.temp());
   emitRecordFormCompare(ctx);
