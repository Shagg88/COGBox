diff --git a/include/rex/frame_hooks.h b/include/rex/frame_hooks.h
new file mode 100644
index 0000000..07e6ac2
--- /dev/null
+++ b/include/rex/frame_hooks.h
@@ -0,0 +1,25 @@
+// Gears2-Native SDK patch 35: frame-timing hooks for latency tools (NVIDIA Reflex, AMD Anti-Lag 2). The game layer sets
+// them once at start-up; every one is optional (null = nothing happens) and is called on the thread named below.
+#pragma once
+
+#include <atomic>
+
+namespace rex {
+
+using FrameHook = void (*)();
+
+struct FrameHooks {
+  std::atomic<FrameHook> guest_swap{nullptr};     // guest thread, end of VdSwap: one game frame handed to the GPU
+  std::atomic<FrameHook> input_read{nullptr};     // guest thread, XamInputGetState for a game pad
+  std::atomic<FrameHook> present_begin{nullptr};  // presenter thread, just before IDXGISwapChain::Present
+  std::atomic<FrameHook> present_end{nullptr};    // presenter thread, just after it
+};
+
+// One shared set, defined in the SDK runtime (xboxkrnl_video.cpp).
+FrameHooks& GetFrameHooks();
+
+inline void CallFrameHook(const std::atomic<FrameHook>& hook) {
+  if (FrameHook fn = hook.load(std::memory_order_acquire)) fn();
+}
+
+}  // namespace rex
