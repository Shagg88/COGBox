+void OnlineSessions::OnStarted(uint32_t handle, uint64_t nonce, bool started) {
+  std::optional<std::string> id;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!nonce && handle) {
+      auto known = nonce_by_handle_.find(handle);
+      if (known != nonce_by_handle_.end()) nonce = known->second;
+    }
+    auto it = hosted_.find(nonce);
+    if (!nonce || it == hosted_.end() || it->second.in_progress == started) {
+      return;
+    }
+    it->second.in_progress = started;
+    id = it->second.lobby_id;   // none yet: Publish sends it once the server answers
+  }
+  if (id) {
+    run_([this, nonce] { SendInProgress(nonce); });
+  }
+}
+
+void OnlineSessions::SendInProgress(uint64_t nonce) {
+  std::lock_guard<std::mutex> sending(send_mutex_);
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    std::string id;
+    bool want = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      auto it = hosted_.find(nonce);
+      if (it == hosted_.end() || !it->second.lobby_id || it->second.in_progress_sent == it->second.in_progress) {
+        return;   // gone, not on the server yet (Publish sends it), or the server already has this state
+      }
+      id = *it->second.lobby_id;
+      want = it->second.in_progress;
+    }
+    if (backend_.SetLobbyInProgress(id, want)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      auto it = hosted_.find(nonce);
+      if (it != hosted_.end()) it->second.in_progress_sent = want;
+      attempt = -1;   // sent: go round once more in case the state changed meanwhile
+      continue;
+    }
+    if (attempt < 2) std::this_thread::sleep_for(retry_delay_);
+  }
+  REXKRNL_WARN("cogbox_online: the server did not take the match's started / ended state");
+}
+
 void OnlineSessions::OnMembersJoined(uint32_t handle, const std::vector<uint64_t>& xuids) { MembersChanged(handle, xuids, true); }
 void OnlineSessions::OnMembersLeft(uint32_t handle, const std::vector<uint64_t>& xuids) { MembersChanged(handle, xuids, false); }
 
