+void OnlineSessions::OnStarted(uint32_t handle, uint64_t nonce, bool started) {
+  std::optional<std::string> id;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!nonce && handle) {
+      auto known = nonce_by_handle_.find(handle);
+      if (known != nonce_by_handle_.end()) nonce = known->second;
+    }
+    auto it = hosted_.find(nonce);
+    if (!nonce || it == hosted_.end() || it->second.in_progress == started) {
+      return;
+    }
+    it->second.in_progress = started;
+    id = it->second.lobby_id;   // none yet: Publish sends it once the server answers
+  }
+  if (id) {
+    run_([this, id, started] { backend_.SetLobbyInProgress(*id, started); });
+  }
+}
