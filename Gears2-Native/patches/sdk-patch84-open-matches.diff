+
+TEST_CASE("Sessions: open matches - XSessionStart / XSessionEnd of a hosted public match mark it in progress",
+          "[net][sessions]") {
+  Fixture f;
+  f.sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x31), 0xC1, 0x100);
+  f.sessions.OnStarted(0x100, 0, true);
+  f.sessions.OnStarted(0x100, 0, true);   // the same state again: nothing more is sent
+  f.sessions.OnStarted(0x100, 0, false);
+  f.sessions.OnStarted(0x999, 0, true);   // not a session we host
+  REQUIRE(f.backend.in_progress.size() == 2);
+  CHECK(f.backend.in_progress[0] == std::make_pair(std::string("lobby-1"), true));
+  CHECK(f.backend.in_progress[1] == std::make_pair(std::string("lobby-1"), false));
+}
+
+TEST_CASE("Sessions: open matches - a match started before the server answered is marked once it does",
+          "[net][sessions]") {
+  FakeBackend backend;
+  std::vector<std::function<void()>> jobs;
+  OnlineSessions sessions{backend, [](uint64_t, const std::string&) {}, [&](std::function<void()> j) { jobs.push_back(j); }};
+  sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x32), 0xC2, 0x200);
+  sessions.OnStarted(0x200, 0, true);   // no lobby id yet: remembered
+  for (size_t i = 0; i < jobs.size(); ++i) jobs[i]();
+  REQUIRE(backend.in_progress.size() == 1);
+  CHECK(backend.in_progress[0].second);
+}
+
+TEST_CASE("Sessions: open matches - a failed in-progress update is retried", "[net][sessions]") {
+  Fixture f;
+  f.sessions.SetRetryDelayForTest(std::chrono::milliseconds(0));
+  f.sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x33), 0xC3, 0x300);
+  f.backend.fail_in_progress = 2;   // the first two PATCHes fail
+  f.sessions.OnStarted(0x300, 0, true);
+  REQUIRE(f.backend.in_progress.size() == 3);
+  CHECK(f.backend.in_progress.back() == std::make_pair(std::string("lobby-1"), true));
+}
+
+TEST_CASE("Sessions: open matches - start and end sent from queued jobs in any order end on the latest state",
+          "[net][sessions]") {
+  FakeBackend backend;
+  std::vector<std::function<void()>> jobs;
+  OnlineSessions sessions{backend, [](uint64_t, const std::string&) {}, [&](std::function<void()> j) { jobs.push_back(j); }};
+  sessions.OnCreate(kTitle, kHostMatchmaking, 10, 0, Info(0x34), 0xC4, 0x400);
+  jobs[0]();   // the lobby is created
+  jobs.clear();
+  sessions.OnStarted(0x400, 0, true);
+  jobs[0]();   // the server shows it started
+  jobs.clear();
+  sessions.OnStarted(0x400, 0, false);
+  sessions.OnStarted(0x400, 0, true);
+  sessions.OnStarted(0x400, 0, false);
+  REQUIRE(jobs.size() == 3);
+  jobs[2]();   // the last end's job runs first, then the older ones: each sends the state as it is now
+  jobs[0]();
+  jobs[1]();
+  REQUIRE(backend.in_progress.size() == 2);
+  CHECK(backend.in_progress.back().second == false);
+}
