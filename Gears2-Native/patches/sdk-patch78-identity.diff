new file mode 100644
index 0000000..88a1ea0
--- /dev/null
+++ b/include/rex/kernel/xam/net/identity.h
@@ -0,0 +1,31 @@
+// COGBox SDK patch 78: the player's online identity (identity.json). The uuid is made here; the discriminator, the
+// online XUID and the signaling token come from the master server's claim. The local profile's XUID is never touched.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+namespace rex::kernel::xam::net {
+
+struct ClientIdentity {
+  std::string uuid;
+  std::string display_name;
+  std::string discriminator;     // "8373", empty until claimed
+  uint64_t authoritative_xuid{0};  // 0 until claimed
+  std::string token;             // signaling token, empty until claimed
+
+  std::string FullTag() const { return discriminator.empty() ? display_name : display_name + "#" + discriminator; }
+};
+
+ClientIdentity GetClientIdentity();
+uint64_t GetAuthoritativeOnlineXuid();
+
+// Loads profile_dir/identity.json, or makes a new identity (uuid v4, fallback_gamertag or "Player") and saves it.
+bool LoadOrCreateIdentity(const std::filesystem::path& profile_dir, const std::string& fallback_gamertag);
+bool SaveIdentity(const std::filesystem::path& profile_dir);
+// Stores the master server's claim answer and saves.
+bool ApplyClaim(const std::filesystem::path& profile_dir, const std::string& discriminator, uint64_t xuid,
+                const std::string& token);
+
+}  // namespace rex::kernel::xam::net
