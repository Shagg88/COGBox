diff --git a/tests/unit/net/identity_test.cpp b/tests/unit/net/identity_test.cpp
new file mode 100644
index 0000000..badf159
--- /dev/null
+++ b/tests/unit/net/identity_test.cpp
@@ -0,0 +1,73 @@
+// COGBox SDK patch 78: client identity tests. Files go to COGBOX_NET_TEST_DIR in the build tree (never AppData).
+#include <catch2/catch_test_macros.hpp>
+
+#include <filesystem>
+#include <fstream>
+#include <regex>
+#include <string>
+
+#include <rex/kernel/xam/net/identity.h>
+
+namespace fs = std::filesystem;
+using namespace rex::kernel::xam::net;
+
+namespace {
+fs::path FreshDir(const char* name) {
+  fs::path dir = fs::path(COGBOX_NET_TEST_DIR) / name;
+  fs::remove_all(dir);
+  fs::create_directories(dir);
+  return dir;
+}
+}  // namespace
+
+TEST_CASE("Identity: a new identity has a uuid v4, the gamertag and no claim yet", "[net][identity]") {
+  auto dir = FreshDir("identity_new");
+  REQUIRE(LoadOrCreateIdentity(dir, "Marcus"));
+  ClientIdentity id = GetClientIdentity();
+  CHECK(std::regex_match(id.uuid, std::regex("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")));
+  CHECK(id.display_name == "Marcus");
+  CHECK(id.discriminator.empty());
+  CHECK(id.authoritative_xuid == 0);
+  CHECK(id.token.empty());
+  CHECK(id.FullTag() == "Marcus");
+  CHECK(GetAuthoritativeOnlineXuid() == 0);
+  CHECK(fs::exists(dir / "identity.json"));
+}
+
+TEST_CASE("Identity: loading again keeps the uuid", "[net][identity]") {
+  auto dir = FreshDir("identity_reload");
+  REQUIRE(LoadOrCreateIdentity(dir, "Marcus"));
+  const std::string uuid = GetClientIdentity().uuid;
+  REQUIRE(LoadOrCreateIdentity(dir, "SomeoneElse"));
+  CHECK(GetClientIdentity().uuid == uuid);
+  CHECK(GetClientIdentity().display_name == "Marcus");
+}
+
+TEST_CASE("Identity: a claim is kept and saved", "[net][identity]") {
+  auto dir = FreshDir("identity_claim");
+  REQUIRE(LoadOrCreateIdentity(dir, "Dom"));
+  REQUIRE(ApplyClaim(dir, "0042", 0x0009123400005678ull, "secret-token"));
+  CHECK(GetAuthoritativeOnlineXuid() == 0x0009123400005678ull);
+  CHECK(GetClientIdentity().FullTag() == "Dom#0042");
+  REQUIRE(LoadOrCreateIdentity(dir, "Dom"));
+  ClientIdentity id = GetClientIdentity();
+  CHECK(id.discriminator == "0042");
+  CHECK(id.authoritative_xuid == 0x0009123400005678ull);
+  CHECK(id.token == "secret-token");
+}
+
+TEST_CASE("Identity: a corrupt file is replaced by a new identity", "[net][identity]") {
+  auto dir = FreshDir("identity_corrupt");
+  { std::ofstream(dir / "identity.json") << "{ not valid json ..."; }
+  REQUIRE(LoadOrCreateIdentity(dir, "Baird"));
+  ClientIdentity id = GetClientIdentity();
+  CHECK_FALSE(id.uuid.empty());
+  CHECK(id.display_name == "Baird");
+  CHECK(id.authoritative_xuid == 0);
+}
+
+TEST_CASE("Identity: an empty gamertag becomes Player", "[net][identity]") {
+  auto dir = FreshDir("identity_empty_name");
+  REQUIRE(LoadOrCreateIdentity(dir, ""));
+  CHECK(GetClientIdentity().display_name == "Player");
+}
