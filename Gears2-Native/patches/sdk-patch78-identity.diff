diff --git a/src/kernel/xam/net/identity.cpp b/src/kernel/xam/net/identity.cpp
new file mode 100644
index 0000000..b95ad21
--- /dev/null
+++ b/src/kernel/xam/net/identity.cpp
@@ -0,0 +1,130 @@
+// COGBox SDK patch 78: the player's online identity (identity.json).
+#include <rex/kernel/xam/net/identity.h>
+
+#if defined(_WIN32)
+#include <windows.h>
+#include <bcrypt.h>
+#endif
+
+#include <cstdio>
+#include <fstream>
+#include <mutex>
+#include <random>
+
+#include <nlohmann/json.hpp>
+
+namespace rex::kernel::xam::net {
+
+namespace {
+
+std::mutex g_mutex;
+ClientIdentity g_identity;
+
+void RandomBytes(uint8_t* out, size_t len) {
+#if defined(_WIN32)
+  if (BCRYPT_SUCCESS(BCryptGenRandom(nullptr, out, ULONG(len), BCRYPT_USE_SYSTEM_PREFERRED_RNG))) {
+    return;
+  }
+#endif
+  std::random_device rd;
+  for (size_t i = 0; i < len; ++i) {
+    out[i] = uint8_t(rd());
+  }
+}
+
+std::string NewUuidV4() {
+  uint8_t b[16];
+  RandomBytes(b, sizeof(b));
+  b[6] = uint8_t((b[6] & 0x0F) | 0x40);
+  b[8] = uint8_t((b[8] & 0x3F) | 0x80);
+  char s[37];
+  std::snprintf(s, sizeof(s), "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x", b[0], b[1], b[2],
+                b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+  return s;
+}
+
+std::string StringField(const nlohmann::json& j, const char* key) {
+  auto it = j.find(key);
+  return it != j.end() && it->is_string() ? it->get<std::string>() : std::string();
+}
+
+// Must be called with g_mutex held.
+bool SaveLocked(const std::filesystem::path& dir) {
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  nlohmann::json j = {{"uuid", g_identity.uuid},
+                      {"display_name", g_identity.display_name},
+                      {"discriminator", g_identity.discriminator},
+                      {"xuid", std::to_string(g_identity.authoritative_xuid)},
+                      {"token", g_identity.token}};
+  const auto tmp = dir / "identity.json.tmp";
+  {
+    std::ofstream out(tmp, std::ios::trunc);
+    if (!out) {
+      return false;
+    }
+    out << j.dump(2) << '\n';
+    if (!out.good()) {
+      return false;
+    }
+  }
+  std::filesystem::rename(tmp, dir / "identity.json", ec);
+  return !ec;
+}
+
+}  // namespace
+
+ClientIdentity GetClientIdentity() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  return g_identity;
+}
+
+uint64_t GetAuthoritativeOnlineXuid() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  return g_identity.authoritative_xuid;
+}
+
+bool SaveIdentity(const std::filesystem::path& profile_dir) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  return SaveLocked(profile_dir);
+}
+
+bool LoadOrCreateIdentity(const std::filesystem::path& profile_dir, const std::string& fallback_gamertag) {
+  ClientIdentity id;
+  {
+    std::ifstream in(profile_dir / "identity.json");
+    if (in) {
+      nlohmann::json j = nlohmann::json::parse(in, nullptr, false);
+      if (j.is_object()) {
+        id.uuid = StringField(j, "uuid");
+        id.display_name = StringField(j, "display_name");
+        id.discriminator = StringField(j, "discriminator");
+        id.token = StringField(j, "token");
+        const std::string xuid = StringField(j, "xuid");
+        id.authoritative_xuid = xuid.empty() ? 0 : std::strtoull(xuid.c_str(), nullptr, 10);
+      }
+    }
+  }
+  const bool complete = !id.uuid.empty() && !id.display_name.empty();
+  if (id.uuid.empty()) {
+    id = ClientIdentity{};  // unreadable or corrupt: a claim without its uuid is worthless
+    id.uuid = NewUuidV4();
+  }
+  if (id.display_name.empty()) {
+    id.display_name = fallback_gamertag.empty() ? "Player" : fallback_gamertag;
+  }
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_identity = id;
+  return complete || SaveLocked(profile_dir);
+}
+
+bool ApplyClaim(const std::filesystem::path& profile_dir, const std::string& discriminator, uint64_t xuid,
+                const std::string& token) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_identity.discriminator = discriminator;
+  g_identity.authoritative_xuid = xuid;
+  g_identity.token = token;
+  return SaveLocked(profile_dir);
+}
+
+}  // namespace rex::kernel::xam::net
