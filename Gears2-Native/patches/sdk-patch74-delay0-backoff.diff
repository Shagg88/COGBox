+// COGBox patch 74 (0.5.1, gameplay diagnostics 10 Nov: Gears 1's main thread spent ~half of its 90% of a core in
+// KeDelayExecutionThread(0) -> SwitchToThread): a thread that keeps asking for a zero delay is polling. After
+// --kernel_delay0_spin_limit zero delays in a row (each within 2 ms of the last) it really sleeps for
+// --kernel_delay0_backoff_ms instead of yielding; a longer gap (not counting our own sleep) resets the count. 0 = off.
+// Milliseconds because Windows Sleep has 1 ms steps (review: a sub-ms sleep became Sleep(0), another yield).
+REXCVAR_DEFINE_INT32(kernel_delay0_spin_limit, 0, "Kernel",
+                     "Patch 74: zero delays in a row before a polling thread sleeps instead of yielding (0 = off, the old behaviour)");
+REXCVAR_DEFINE_INT32(kernel_delay0_backoff_ms, 1, "Kernel",
+                     "Patch 74: how long a polling thread sleeps, in milliseconds (1-5), once kernel_delay0_spin_limit is reached");
 
