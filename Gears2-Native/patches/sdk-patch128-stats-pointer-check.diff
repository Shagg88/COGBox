+// ---- Gears2-Native SDK patch 128 (COGBox ticket-0017, Myth): a stats write / flush with a pointer that is not mapped (Gears 3 and Judgment
+// passed views 0x00000001 when a Horde match was left -> read of guest 0x1 = crash) is skipped and logged once, never read.
+namespace stats_guard {
+inline bool Mapped(rex::memory::Memory* mem, uint32_t ptr, uint32_t len) {
+  return ptr >= 0x10000 && len && uint64_t(ptr) + len <= 0x100000000ull && mem->LookupHeap(ptr) && mem->LookupHeap(ptr + len - 1);
+}
+inline void Skipped(const char* what, uint32_t ptr, uint32_t count) {
+  static std::atomic<int> said{0};
+  if (said.fetch_add(1) < 8) REXKRNL_WARN("xam_stats_store: {} pointer {:08X} (count {}) is not mapped - skipped (patch 128)", what, ptr, count);
+}
