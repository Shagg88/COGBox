+// ---- Gears2-Native SDK patch 128 (COGBox ticket-0017, #447 #451 #453 #454): every stats pointer the title hands over is
+// checked before it is read - inside one heap, every page of the range committed and readable (QueryRangeAccess) - and a bad
+// one is skipped and logged, never read. All four games passed views 0x00000001 with XSessionFlushStats when a match /
+// co-op session / level ended (read of guest 0x1 = crash in stats_store::Write). XSessionFlushStats(hSession, pOverlapped)
+// carries no views at all (Xbox SDK), so the flush message is no longer read as views (review 24 Nov: a readable garbage
+// pointer would otherwise write garbage stats into the store).
+namespace stats_guard {
+inline bool Mapped(rex::memory::Memory* mem, uint32_t ptr, uint32_t len) {
+  if (ptr < 0x10000 || !len || uint64_t(ptr) + len > 0x100000000ull) return false;
+  rex::memory::BaseHeap* heap = mem->LookupHeap(ptr);
+  if (!heap || heap != mem->LookupHeap(ptr + len - 1)) return false;
+  return heap->QueryRangeAccess(ptr, ptr + len - 1) != rex::memory::PageAccess::kNoAccess;
+}
+inline void Skipped(const char* what, uint32_t ptr, uint32_t count) {
+  static std::atomic<int> said{0};
+  if (said.fetch_add(1) < 8) REXKRNL_WARN("xam_stats_store: {} pointer {:08X} (count {}) is not readable game memory (or too many) - skipped (patch 128)", what, ptr, count);
+}
