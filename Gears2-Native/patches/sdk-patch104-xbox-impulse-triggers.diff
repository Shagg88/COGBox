+// COGBox SDK patch 104 (GitHub #245): see SetDeviceTriggerRumble in the header. Same lock order as SetDeviceVibration.
+// SDL keeps the trigger motors apart from the two big ones (its own end times; the WGI / GameInput / Xbox HIDAPI backends
+// send all four in one command and remember the other pair), so the game's own rumble keeps going under a pulse.
+X_RESULT SDLInputDriver::SetDeviceTriggerRumble(DeviceId id, uint16_t left, uint16_t right, uint32_t duration_ms) {
+  if (!sdl_events_initialized_ || !SDL_Gamepad_initialized_) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  auto guard = DrainAndLock();
+  auto controller = FindController(id);
+  if (!controller) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  if (!SDL_GetBooleanProperty(SDL_GetGamepadProperties(controller->sdl), SDL_PROP_GAMEPAD_CAP_TRIGGER_RUMBLE_BOOLEAN,
+                              false)) {
+    return X_ERROR_FUNCTION_FAILED;   // no trigger motors SDL can reach (logged once when the pad was added)
+  }
+  if (!has_focus_.load()) {
+    left = 0;
+    right = 0;
+    duration_ms = 0;
+  }
+  const char* name = SDL_GetGamepadName(controller->sdl);
+  if (!SDL_RumbleGamepadTriggers(controller->sdl, left, right, duration_ms)) {
+    // e.g. the raw input driver before the pad is matched to its WGI gamepad ("Controller isn't correlated yet") -
+    // the next pulse tries again
+    if (!controller->trigger_rumble_failed_logged) {
+      controller->trigger_rumble_failed_logged = true;
+      REXLOG_WARN("SDL: impulse trigger pulse not sent to \"{}\" (device {}): {} (logged once per pad)",
+                  name ? name : "?", static_cast<uint64_t>(id), SDL_GetError());
+    }
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  if ((left || right) && !controller->trigger_rumble_active_logged) {
+    controller->trigger_rumble_active_logged = true;
+    REXLOG_INFO("SDL: impulse triggers active on \"{}\" (device {}), first pulse L {} R {} for {} ms",
+                name ? name : "?", static_cast<uint64_t>(id), left, right, duration_ms);
+  }
+  return X_ERROR_SUCCESS;
+}
