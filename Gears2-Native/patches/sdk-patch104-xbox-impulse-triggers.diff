+bool InputSystem::TriggerRumbleEnabled() { return REXCVAR_GET(pad_trigger_rumble); }
+
+// COGBox SDK patch 104 (GitHub #245): Xbox impulse triggers. The game calls this per event (a shot) or, for a continuous
+// action (the chainsaw), again every few frames with a short duration, so a pulse always ends by itself - even if the
+// game stops calling. SDL times the pulse (SDL_UpdateJoysticks, pumped every 1 ms while a pad is open) and writes
+// nothing when the same strengths are sent again (it only moves the end time).
+X_RESULT InputSystem::SetTriggerRumble(uint32_t user_index, uint16_t left, uint16_t right, uint32_t duration_ms) {
+  if (!REXCVAR_GET(pad_trigger_rumble)) {
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  if (user_index >= kMaxGuestUsers) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  std::lock_guard<std::recursive_mutex> lock(mutex_);
+  if (!assignment_ || !g_trigger_driver) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  // COGBox's Vibration setting off, or COGBox's in-game menu / a system dialog open: the motors stay still.
+  if (!REXCVAR_GET(vibration) || ui_input_blockers_.load() > 0) {
+    left = 0;
+    right = 0;
+  }
+  const bool stop = left == 0 && right == 0;
+  if (stop && !trigger_rumble_running_[user_index]) {
+    return X_ERROR_SUCCESS;   // nothing running: no write
+  }
+  // SDL takes 0 as "until told otherwise" - never asked for here: 1 ms to 1 s, a longer action is sent again.
+  duration_ms = stop ? 0 : std::clamp<uint32_t>(duration_ms, 1, 1000);
+  RefreshDevices();
+  std::vector<DeviceId> ids;
+  assignment_->DevicesForUser(user_index, ids);
+  bool any = false;
+  for (DeviceId id : ids) {
+    // Only the SDL driver's own devices: never the keyboard / mouse, NOP or a game's script pad. A pad without trigger
+    // motors answers X_ERROR_FUNCTION_FAILED without a write.
+    if (DriverForDevice(id) != g_trigger_driver) {
+      continue;
+    }
+    if (g_trigger_driver->SetDeviceTriggerRumble(id, left, right, duration_ms) == X_ERROR_SUCCESS) {
+      any = true;
+    }
+  }
+  trigger_rumble_running_[user_index] = !stop && any;
+  return any ? X_ERROR_SUCCESS : X_ERROR_FUNCTION_FAILED;
+}
+
+void InputSystem::StopTriggerRumble() {
+  if (!REXCVAR_GET(pad_trigger_rumble)) {
+    return;
+  }
+  std::lock_guard<std::recursive_mutex> lock(mutex_);
+  for (uint32_t user_index = 0; user_index < kMaxGuestUsers; user_index++) {
+    if (trigger_rumble_running_[user_index]) {
+      // (with a blocker held or vibration off, SetTriggerRumble turns any strength into a stop)
+      SetTriggerRumble(user_index, 0, 0, 0);
+    }
+  }
+}
