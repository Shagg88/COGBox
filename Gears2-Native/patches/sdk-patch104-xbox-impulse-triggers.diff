+void SDLInputDriver::RetryRumbleLocked(ControllerState& controller) {
+  if (!controller.rumble_retry) {
+    return;
+  }
+  if (SDL_RumbleGamepad(controller.sdl, controller.rumble_low, controller.rumble_high, kRumbleDurationMs)) {
