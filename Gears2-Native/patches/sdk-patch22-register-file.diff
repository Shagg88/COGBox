--- a/include/rex/graphics/draw_observer.h
+++ b/include/rex/graphics/draw_observer.h
@@ -93,6 +93,9 @@ struct GpuServices {
   std::function<bool()> running;       // false once the GPU worker is shutting down (leave any wait loop)
   std::function<void()> make_coherent; // what WAIT_REG_MEM on COHER_STATUS_HOST does
   std::function<bool()> vsync;         // --vsync (WAIT_REG_MEM sleeps when on, yields when off)
+  // Gears2-Native SDK patch 22 (5B phase 3): the register file itself, so an external processor that runs draws
