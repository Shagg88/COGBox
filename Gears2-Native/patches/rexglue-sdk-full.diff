+  slot.frame = frame_readback_counter_++;
+  slot.pending = true;
+  ++frame_readback_next_;
+}
+
+void D3D12CommandProcessor::DeliverFrameReadbacks() {
+  DrawObserver* observer = GetDrawObserver();
+  // Deliver in frame order.
+  for (;;) {
+    FrameReadbackSlot* oldest = nullptr;
+    for (FrameReadbackSlot& slot : frame_readback_) {
+      if (slot.pending && slot.submission <= GetCompletedSubmission() &&
+          (!oldest || slot.frame < oldest->frame)) {
+        oldest = &slot;
+      }
+    }
+    if (!oldest) {
+      return;
+    }
+    if (observer && oldest->mapped) {
+      observer->OnFrameImage(oldest->mapped + oldest->footprint.Offset, oldest->width, oldest->height,
+                             oldest->footprint.Footprint.RowPitch, oldest->frame);
+    }
+    oldest->pending = false;
+  }
+}
