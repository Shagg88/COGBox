diff --git a/include/rex/frame_hooks.h b/include/rex/frame_hooks.h
new file mode 100644
index 0000000..2f1bedf
--- /dev/null
+++ b/include/rex/frame_hooks.h
@@ -0,0 +1,39 @@
+// Gears2-Native SDK patch 35: frame-timing hooks for latency tools (NVIDIA Reflex, AMD Anti-Lag 2). The game layer sets
+// them once at start-up; every one is optional (null = nothing happens) and is called on the thread named below.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex {
+
+using FrameHook = void (*)();
+
+struct FrameHooks {
+  std::atomic<FrameHook> guest_swap{nullptr};     // guest thread, end of VdSwap: one game frame handed to the GPU
+  std::atomic<FrameHook> input_read{nullptr};     // guest thread, XamInputGetState for a game pad
+  std::atomic<FrameHook> present_begin{nullptr};  // presenter thread, just before IDXGISwapChain::Present
+  std::atomic<FrameHook> present_end{nullptr};    // presenter thread, just after it
+  // SDK patch 36 (frame generation): when set, the D3D12 presenter makes its swap chain through create_swap_chain
+  // (the same DXGI_SWAP_CHAIN_DESC1, IDXGIFactory2, direct ID3D12CommandQueue and HWND; it returns an IDXGISwapChain1
+  // with one reference for the presenter, or false to have the swap chain made the usual way). swap_chain_change is
+  // called with that swap chain just before the presenter resizes its buffers (destroying = false) or lets go of it
+  // (destroying = true: the hook releases what it made around it before the presenter drops the last reference).
+  std::atomic<bool (*)(void* dxgi_factory2, void* d3d12_queue, void* hwnd, const void* desc1, void** swap_chain1)>
+      create_swap_chain{nullptr};
+  std::atomic<void (*)(void* swap_chain, bool destroying)> swap_chain_change{nullptr};
+  // Presenter thread, after a paint's commands were submitted and before Present: the guest output image the paint
+  // showed (ID3D12Resource*, null = none) and the direct ID3D12CommandQueue. Return false to skip this Present (frame
+  // generation presents once per new game image; a repaint of the same image must not count as a frame).
+  // rect: where the guest output was painted in the back buffer (x, y, width, height; all 0 = not painted).
+  std::atomic<bool (*)(void* guest_output_resource, void* d3d12_queue, const int32_t* rect)> before_present{nullptr};
+};
+
+// One shared set, defined in the SDK runtime (xboxkrnl_video.cpp).
+FrameHooks& GetFrameHooks();
+
+inline void CallFrameHook(const std::atomic<FrameHook>& hook) {
+  if (FrameHook fn = hook.load(std::memory_order_acquire)) fn();
+}
+
+}  // namespace rex
