 #include <cstddef>
 #include <cstdint>
 
@@ -27,7 +28,49 @@ namespace rex::graphics {
 class ShaderInterpreter {
  public:
   ShaderInterpreter(const RegisterFile& register_file, const memory::Memory& memory)
-      : register_file_(register_file), memory_(memory) {}
+      : register_file_(register_file), memory_(&memory) {}
+  // Gears2-Native SDK patch 8 (test oracle, notes/41): an interpreter over a plain block of guest physical memory, for
+  // tools that have no guest memory system. Vertex fetch reads physical_membase + address.
+  ShaderInterpreter(const RegisterFile& register_file, const uint8_t* physical_membase)
+      : register_file_(register_file), physical_membase_override_(physical_membase) {}
+
+  // Gears2-Native SDK patch 8: optional texture fetch. Without a sink the interpreter behaves as before (texture fetch
+  // results read as zeros). With one, tfetch* asks the sink for the 4 filtered components (the sink gets the raw,
+  // unswizzled source register and the instruction, and does the addressing itself), setTex* ops change nothing, and
+  // the other texture queries still read as zeros.
+  class TextureFetchSink {
+   public:
+    virtual ~TextureFetchSink() = default;
+    virtual void FetchTexture(const ucode::TextureFetchInstruction& instr, const float* source_register,
+                              float* result) = 0;
+  };
+  TextureFetchSink* GetTextureFetchSink() const { return texture_fetch_sink_; }
+  void SetTextureFetchSink(TextureFetchSink* sink) { texture_fetch_sink_ = sink; }
