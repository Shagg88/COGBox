diff --git a/include/rex/graphics/draw_observer.h b/include/rex/graphics/draw_observer.h
new file mode 100644
index 0000000..965efef
--- /dev/null
+++ b/include/rex/graphics/draw_observer.h
@@ -0,0 +1,109 @@
+/**
+ * Gears2-Native SDK patch 2 (notes/32): an optional observer of the guest GPU command stream.
+ * The command processor (in the GPU plugin) calls it on its worker thread just before every draw reaches the backend -
+ * including EDRAM copies/resolves, which arrive as draws with edram_mode == kCopy - and just before every swap.
+ * The registry lives in rexruntime so the app and the runtime-loaded plugin share it. One observer per process; set it
+ * before the guest starts and leave it until shutdown. When none is set, the cost is one atomic load per draw.
+ */
+#pragma once
+
+#include <functional>
+
+#include <cstdint>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics {
+
+class RegisterFile;
+class Shader;
+
+struct ObservedIndexBuffer {
+  xenos::IndexFormat format;
+  xenos::Endian endianness;
+  uint32_t count;
+  uint32_t guest_base;
+  uint64_t length;
+};
+
+// Gears2-Native SDK patch 15 (Stage 4, notes/46): one PM4 EVENT_WRITE_ZPD, i.e. one occlusion-query report write.
+enum class ZpdAnswer : uint8_t {
+  kNone,         // nothing written (query_occlusion_fake_sample_count < 0)
+  kBegin,        // a begin report (the D3D12 host path leaves it as it is, unless occlusion_query_no_fake)
+  kHost,         // end: the real host sample count
+  kFake,         // end: query_occlusion_fake_sample_count (host queries off, or the host path fell back)
+  kNoRealCount,  // end, occlusion_query_no_fake: no real count could be had; 1 was written
+};
+struct ObservedZpd {
+  uint32_t report_address;  // RB_SAMPLE_COUNT_ADDR (guest physical)
+  bool is_end;              // the report held D3D's pending marker (0xFFFFFEED in ZPass or ZFail) when the packet ran
+  ZpdAnswer answer;
+  uint64_t samples;         // what was written into ZPass_A / Total_A for an end (after resolution scaling), else 0
+  uint32_t host_segments;   // host queries summed for this end (> 1 when submissions split it; occlusion_query_no_fake)
+};
+
+class DrawObserver {
+ public:
+  virtual ~DrawObserver() = default;
+  // `regs` holds the complete state for this draw (ALU/fetch constants, render state). `index_buffer` is null for
+  // auto-indexed draws. Called on the GPU worker thread.
+  virtual void OnDraw(const RegisterFile& regs, xenos::PrimitiveType primitive, uint32_t index_count,
+                      const ObservedIndexBuffer* index_buffer, bool major_mode_explicit) = 0;
+  // Gears2-Native (Stage 1): the active shaders for the draw that follows (OnDraw comes right after), so observers can
+  // see which fetch constants the draw actually uses (Shader::vertex_bindings / texture_bindings; empty until the
+  // shader has been analysed, which happens at its first draw). Called on the GPU worker thread.
+  virtual void OnDrawShaders(const Shader* vertex_shader, const Shader* pixel_shader) {}
+  // Gears2-Native SDK patch 20 (Stage 5B): a primary ring range is about to be executed: dwords [read_index,
+  // write_index) of the ring at ring_physical (ring_dwords long, wrapping). An observer with its own PM4 processor
+  // parses the same range (before the SDK runs it). Called on the GPU worker thread.
+  virtual void OnPrimaryRange(uint32_t ring_physical, uint32_t ring_dwords, uint32_t read_index,
+                              uint32_t write_index) {}
+  // Before the swap is handed to the presenter. Called on the GPU worker thread.
+  virtual void OnSwap(const RegisterFile& regs, uint32_t frontbuffer_ptr, uint32_t width, uint32_t height) = 0;
+  // Optional per-swap readback of the final frame (SDK patch 3, D3D12 backend): the presenter's guest-output image
+  // after the game's gamma ramp (and FXAA if enabled), before window scaling and overlays. R10G10B10A2_UNORM pixels,
+  // `row_pitch` bytes per row. Delivered on the GPU thread 1-2 swaps after the frame (no stall); copy what you need and
+  // return quickly. `frame` counts swaps since the readback started.
+  // Gears2-Native SDK patch 15: every EVENT_WRITE_ZPD, in stream order with OnDraw, after the report has been written
+  // (read its final lanes from guest memory). Called on the GPU worker thread.
+  virtual void OnZpd(const RegisterFile& regs, const ObservedZpd& zpd) {}
+  virtual bool WantsFrameImages() const { return false; }
+  virtual void OnFrameImage(const uint8_t* rgb10a2, uint32_t width, uint32_t height, uint32_t row_pitch,
+                            uint64_t frame) {}
+};
+
+// Gears2-Native SDK patch 18 (takeover T1): an observer wrote guest memory itself (our renderer's front buffer) from
+// inside an observer callback, on the GPU worker thread. This tells the GPU emulation the physical range changed
+// (SharedMemory::MemoryInvalidationCallback, exact range): its shared memory and texture cache reload it from guest
+// memory at the next use - e.g. the swap that follows OnSwap. No-op until a command processor registers the handler.
+void NotifyGuestRangeWrittenByObserver(uint32_t physical_address, uint32_t length);
+using GuestRangeWrittenHandler = void (*)(void* context, uint32_t physical_address, uint32_t length);
+void SetGuestRangeWrittenHandler(GuestRangeWrittenHandler handler, void* context);
+
+// Gears2-Native SDK patch 21 (Stage 5B phase 2): with --gpu_external_pm4 the SDK does not parse the primary ring
+// itself; the draw observer's own PM4 processor does (OnPrimaryRange), using these services for what still lives in
+// the SDK: the register file with its side effects (gamma LUT, scratch write-back, coherency), and single packets it
+// hands back for the SDK to run as usual - draws (observer + IssueDraw), shader loads (the SDK's Shader objects),
+// ZPD (query reports), XE_SWAP (present) and INTERRUPT (the title's callback). Valid on the GPU worker thread only.
+struct GpuServices {
+  std::function<void(uint32_t index, uint32_t value)> write_register;
+  std::function<uint32_t(uint32_t index)> read_register;
+  std::function<void(const uint32_t* big_endian_dwords, uint32_t dword_count)> execute_packet;  // one packet
+  std::function<uint32_t()> counter;   // the vblank/swap counter EVENT_WRITE_SHD writes (bit 31 of the initiator)
+  std::function<bool()> running;       // false once the GPU worker is shutting down (leave any wait loop)
+  std::function<void()> make_coherent; // what WAIT_REG_MEM on COHER_STATUS_HOST does
+  std::function<bool()> vsync;         // --vsync (WAIT_REG_MEM sleeps when on, yields when off)
+  // Gears2-Native SDK patch 22 (5B phase 3): the register file itself, so an external processor that runs draws
+  // and shader loads itself can hand the observers the same RegisterFile the SDK would.
+  std::function<const RegisterFile*()> register_file;
+  // Gears2-Native SDK patch 23 (5C-2): an external processor that runs XE_SWAP itself (and presents its own image)
+  // calls this once per swap for the SDK's own swap bookkeeping: the profiler frame flip and the swap counter.
+  std::function<void()> swap_done;
+};
+GpuServices* GetGpuServices();
+void SetGpuServices(GpuServices* services);
+
+void SetDrawObserver(DrawObserver* observer);
+DrawObserver* GetDrawObserver();
+
+}  // namespace rex::graphics
