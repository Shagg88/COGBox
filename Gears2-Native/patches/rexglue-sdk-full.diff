+bool CommandProcessor::PlayTrace(const uint8_t* trace_data, size_t trace_size) {
+  const uint8_t* p = trace_data;
+  const uint8_t* end = trace_data + trace_size;
+  const PacketStartCommand* pending_packet = nullptr;
+  auto need = [&](size_t n) { return size_t(end - p) >= n; };
+  while (p < end) {
+    if (!need(4)) return false;
+    auto type = static_cast<TraceCommandType>(*reinterpret_cast<const uint32_t*>(p));
+    switch (type) {
+      case TraceCommandType::kPrimaryBufferStart:
+      case TraceCommandType::kIndirectBufferStart: {
+        if (!need(sizeof(PrimaryBufferStartCommand))) return false;
+        auto cmd = reinterpret_cast<const PrimaryBufferStartCommand*>(p);
+        p += sizeof(*cmd) + size_t(cmd->count) * 4;
+        break;
+      }
+      case TraceCommandType::kPrimaryBufferEnd:
+      case TraceCommandType::kIndirectBufferEnd:
+        p += sizeof(PrimaryBufferEndCommand);
+        break;
+      case TraceCommandType::kPacketStart: {
+        if (!need(sizeof(PacketStartCommand))) return false;
+        auto cmd = reinterpret_cast<const PacketStartCommand*>(p);
+        p += sizeof(*cmd);
+        if (!need(size_t(cmd->count) * 4)) return false;
+        std::memcpy(memory_->TranslatePhysical(cmd->base_ptr), p, size_t(cmd->count) * 4);
+        p += size_t(cmd->count) * 4;
+        pending_packet = cmd;
+        break;
+      }
+      case TraceCommandType::kPacketEnd: {
+        p += sizeof(PacketEndCommand);
+        if (pending_packet) {
+          ExecutePacket(pending_packet->base_ptr, pending_packet->count);
+          pending_packet = nullptr;
+        }
+        break;
+      }
+      case TraceCommandType::kMemoryRead: {
+        if (!need(sizeof(MemoryCommand))) return false;
+        auto cmd = reinterpret_cast<const MemoryCommand*>(p);
+        p += sizeof(*cmd);
+        if (cmd->encoding_format != MemoryEncodingFormat::kNone || !need(cmd->encoded_length)) {
+          return false;
+        }
+        std::memcpy(memory_->TranslatePhysical(cmd->base_ptr), p, cmd->decoded_length);
+        p += cmd->encoded_length;
+        TracePlaybackWroteMemory(cmd->base_ptr, cmd->decoded_length);
+        break;
+      }
+      case TraceCommandType::kMemoryWrite: {
+        if (!need(sizeof(MemoryCommand))) return false;
+        auto cmd = reinterpret_cast<const MemoryCommand*>(p);
+        // The command processor repeats the same write when the packet executes.
+        p += sizeof(*cmd) + cmd->encoded_length;
+        break;
+      }
+      case TraceCommandType::kEdramSnapshot: {
+        if (!need(sizeof(EdramSnapshotCommand))) return false;
+        auto cmd = reinterpret_cast<const EdramSnapshotCommand*>(p);
+        p += sizeof(*cmd);
+        if (cmd->encoding_format != MemoryEncodingFormat::kNone || !need(cmd->encoded_length)) {
+          return false;
+        }
+        RestoreEdramSnapshot(p);
+        p += cmd->encoded_length;
+        break;
+      }
+      case TraceCommandType::kEvent:
+        p += sizeof(EventCommand);
+        break;
+      case TraceCommandType::kRegisters: {
+        if (!need(sizeof(RegistersCommand))) return false;
+        auto cmd = reinterpret_cast<const RegistersCommand*>(p);
+        p += sizeof(*cmd);
+        if (cmd->encoding_format != MemoryEncodingFormat::kNone || !need(cmd->encoded_length)) {
+          return false;
+        }
+        std::vector<uint32_t> values(cmd->register_count);
+        std::memcpy(values.data(), p, sizeof(uint32_t) * cmd->register_count);
+        p += cmd->encoded_length;
+        RestoreRegisters(cmd->first_register, values.data(), cmd->register_count,
+                         cmd->execute_callbacks);
+        break;
+      }
+      case TraceCommandType::kGammaRamp: {
+        if (!need(sizeof(GammaRampCommand))) return false;
+        auto cmd = reinterpret_cast<const GammaRampCommand*>(p);
+        p += sizeof(*cmd);
+        if (cmd->encoding_format != MemoryEncodingFormat::kNone || !need(cmd->encoded_length)) {
+          return false;
+        }
+        std::vector<uint32_t> ramps(256 + 3 * 128);
+        std::memcpy(ramps.data(), p, sizeof(uint32_t) * ramps.size());
+        p += cmd->encoded_length;
+        RestoreGammaRamp(reinterpret_cast<const reg::DC_LUT_30_COLOR*>(ramps.data()),
+                         reinterpret_cast<const reg::DC_LUT_PWL_DATA*>(ramps.data() + 256),
+                         cmd->rw_component);
+        break;
+      }
+      default:
+        return false;
+    }
+  }
+  return true;
+}
+
 }  // namespace rex::graphics
