 Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // Gears2-Native SDK patch 34: wait until the presentation queue has room (at most d3d12_max_frame_latency frames), so a
+  // frame is not painted - and the game's newest picture not held back - behind frames still waiting to be shown.
+  if (paint_context_.frame_latency_waitable) {
+    WaitForSingleObjectEx(paint_context_.frame_latency_waitable, 100, TRUE);
+  }
   // Begin the command list with the command allocator not currently potentially
   // used on the GPU.
   UINT64 current_paint_submission = paint_context_.paint_submission_tracker.GetCurrentSubmission();
