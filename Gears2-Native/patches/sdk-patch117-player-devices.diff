+TEST_CASE("DeviceKey names kbm, pads by guid and path, and nothing for NOP", "[input]") {
+  CHECK(DeviceKey(Kbm(1)) == "kbm");
+  CHECK(DeviceKey(Nop(2)).empty());
+  CHECK(DeviceKey(SdlPad(3, 0, "G", "p1")) == "sdl:G|p1");
+  // No path: two identical pads still get distinct keys.
+  CHECK(DeviceKey(SdlPad(4, 0, "G", "")) != DeviceKey(SdlPad(5, 1, "G", "")));
+}
