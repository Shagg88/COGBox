+/// Stable identity of a device across runs: "kbm" for the keyboard/mouse
+/// synthetic device, "sdl:<guid>|<path>" for a pad (path falls back to the
+/// per-run instance id when the driver has none, so identical pads stay
+/// distinct), "" for the NOP stand-in.
+std::string DeviceKey(const DeviceInfo& device);
+
+/// Splits a `player_devices` cvar value: `;`-separated keys in player order,
+/// "auto" or empty meaning Auto (returned as "").
+std::vector<std::string> ParsePlayerDevices(const std::string& text);
+
+/// Player N gets the device named by keys_by_player[N] (empty = Auto). Players
+/// whose device is absent, and Auto players, take unchosen devices lowest
+/// player first, pads in ordinal order before keyboard/mouse. The NOP stand-in
+/// feeds user 0 only when user 0 has nothing else. Players = number of keys.
+class ExplicitAssignment final : public DeviceAssignment {
+ public:
+  explicit ExplicitAssignment(std::vector<std::string> keys_by_player);
+  void OnDevicesChanged(const std::vector<DeviceInfo>& devices) override;
+  void DevicesForUser(uint32_t user_index, std::vector<DeviceId>& out) const override;
+
+ private:
+  std::vector<std::string> keys_;
+  std::vector<std::vector<DeviceId>> users_;
+  std::string last_log_;
+};
+
 /// Every device feeds guest user 0. Users 1 and up report not connected. For
