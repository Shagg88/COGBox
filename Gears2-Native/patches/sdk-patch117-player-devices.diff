 }
 
+std::string DeviceKey(const DeviceInfo& device) {
+  if (device.synthetic) {
+    return device.nop ? std::string() : std::string("kbm");
+  }
+  // Drivers without a path (or SDL builds that cannot report one) fall back to
+  // the instance id, unique per run, so two identical pads never share a key.
+  const std::string suffix =
+      device.path.empty() ? "#" + std::to_string(static_cast<uint64_t>(device.id)) : device.path;
+  return "sdl:" + device.guid + "|" + suffix;
+}
+
+std::vector<std::string> ParsePlayerDevices(const std::string& text) {
+  std::vector<std::string> keys;
+  if (text.empty()) {
+    return keys;
+  }
+  size_t start = 0;
+  while (true) {
+    size_t end = text.find(';', start);
+    std::string key = text.substr(start, end == std::string::npos ? end : end - start);
+    const auto b = key.find_first_not_of(" \t");
+    const auto e = key.find_last_not_of(" \t");
+    key = b == std::string::npos ? std::string() : key.substr(b, e - b + 1);
+    std::string lower = key;  // match "auto" any case; keys keep theirs (guids are case-sensitive)
+    std::transform(lower.begin(), lower.end(), lower.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    if (lower == "auto") {
+      key.clear();
+    }
+    keys.push_back(std::move(key));
+    if (end == std::string::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return keys;
+}
+
+ExplicitAssignment::ExplicitAssignment(std::vector<std::string> keys_by_player)
+    : keys_(std::move(keys_by_player)) {
+  if (keys_.size() > kMaxGuestUsers) {
+    keys_.resize(kMaxGuestUsers);
+  }
+  // Keyboard and mouse always drive player 1; a "kbm" key from an older setting is just Auto.
+  for (auto& key : keys_) {
+    if (key == "kbm") {
+      key.clear();
+    }
+  }
+  users_.resize(keys_.size());
+}
+
+void ExplicitAssignment::OnDevicesChanged(const std::vector<DeviceInfo>& devices) {
+  for (auto& user : users_) {
+    user.clear();
+  }
+  std::vector<bool> used(devices.size(), false);
+  std::vector<bool> has(users_.size(), false);
+
+  // Pass 1: mapped keys claim their device.
+  for (size_t p = 0; p < keys_.size(); p++) {
+    if (keys_[p].empty()) {
+      continue;
+    }
+    for (size_t d = 0; d < devices.size(); d++) {
+      if (!used[d] && DeviceKey(devices[d]) == keys_[p]) {
+        users_[p].push_back(devices[d].id);
+        used[d] = true;
+        has[p] = true;
+        break;
+      }
+    }
+  }
+
+  // Unchosen pads by ordinal. A device some player names stays reserved for it
+  // even while that player is unmatched. Keyboard/mouse is never pooled: it
+  // always drives user 0 (below).
+  std::vector<size_t> pool;
+  for (size_t d = 0; d < devices.size(); d++) {
+    const std::string key = DeviceKey(devices[d]);
+    if (key.empty() || devices[d].synthetic || used[d] || std::find(keys_.begin(), keys_.end(), key) != keys_.end()) {
+      continue;
+    }
+    pool.push_back(d);
+  }
+  std::stable_sort(pool.begin(), pool.end(),
+                   [&](size_t a, size_t b) { return devices[a].ordinal < devices[b].ordinal; });
+
+  // Pass 2: mapped-but-absent players first, then Auto, lowest player first.
+  size_t next = 0;
+  for (int pass = 0; pass < 2; pass++) {
+    for (size_t p = 0; p < keys_.size() && next < pool.size(); p++) {
+      if (has[p] || keys_[p].empty() != (pass == 1)) {
+        continue;
+      }
+      users_[p].push_back(devices[pool[next++]].id);
+      has[p] = true;
+    }
+  }
+
+  // The keyboard and mouse always belong to player 1, whatever else it has.
+  if (!users_.empty()) {
+    for (const auto& device : devices) {
+      if (device.synthetic && !device.nop) {
+        users_[0].push_back(device.id);
+      }
+    }
+  }
+
+  // The NOP stand-in keeps the guest from pausing when user 0 has no device.
+  if (!users_.empty() && users_[0].empty()) {
+    for (const auto& device : devices) {
+      if (device.nop) {
+        users_[0].push_back(device.id);
+        break;
+      }
+    }
+  }
+
+  std::string log;
+  for (size_t p = 0; p < users_.size(); p++) {
+    std::string key = "-";
+    for (const auto& device : devices) {
+      if (!users_[p].empty() && device.id == users_[p][0]) {
+        key = DeviceKey(device).empty() ? "nop" : DeviceKey(device);
+        break;
+      }
+    }
+    log += (p ? " P" : "P") + std::to_string(p + 1) + "=" + key;
+  }
+  if (log != last_log_) {
+    last_log_ = log;
+    REXLOG_INFO("player_devices: {}", log);
+  }
+}
+
+void ExplicitAssignment::DevicesForUser(uint32_t user_index, std::vector<DeviceId>& out) const {
+  out.clear();
+  if (user_index >= users_.size()) {
+    return;
+  }
+  out = users_[user_index];
+}
+
 void SharedAssignment::OnDevicesChanged(const std::vector<DeviceInfo>& devices) {
   user0_.clear();
   user0_.reserve(devices.size());
