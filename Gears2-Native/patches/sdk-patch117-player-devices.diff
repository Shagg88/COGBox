+namespace {
+
+DeviceInfo SdlPad(uint64_t id, uint32_t ordinal, const char* guid, const char* path) {
+  DeviceInfo info = Pad(id, ordinal);
+  info.guid = guid;
+  info.path = path;
+  return info;
+}
+
+DeviceInfo Kbm(uint64_t id) {
+  DeviceInfo info;
+  info.id = static_cast<DeviceId>(id);
+  info.name = "Keyboard and Mouse";
+  info.synthetic = true;
+  return info;
+}
+
+DeviceInfo Nop(uint64_t id) {
+  DeviceInfo info;
+  info.id = static_cast<DeviceId>(id);
+  info.name = "None";
+  info.synthetic = true;
+  info.nop = true;
+  return info;
+}
+
+using Ids = std::vector<DeviceId>;
+Ids Of(std::initializer_list<uint64_t> ids) {
+  Ids out;
+  for (auto id : ids) out.push_back(static_cast<DeviceId>(id));
+  return out;
+}
+
+}  // namespace
