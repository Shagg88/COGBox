+// SDK patch 70 (COGBox 0.4.9, 4:3 screens): the console's "widescreen" setting. Gears 2 / 3 / Judgment read
+// XGetVideoMode and, when it says not widescreen and the mode is at most 720 lines, make a 4:3 back buffer
+// (width = 720 x width / height, so 960x720 for a 960x720 mode) as on a 4:3 TV. The old answer (width x 3 >=
+// height x 4) called every 4:3 mode widescreen. Default true = unchanged.
+REXCVAR_DEFINE_BOOL(video_mode_widescreen, true, "Display",
+                    "Guest video mode is widescreen (16:9 TV setting); false = a 4:3 TV (use with a 4:3 video_mode_width / height)");
+
 namespace {
 // Display gamma type: 0 - linear, 1 - sRGB (CRT), 2 - BT.709 (HDTV), 3 - power
 constexpr uint32_t kDisplayGammaType = 2;
