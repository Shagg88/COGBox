+// Patch 56 (Edge c7a43fa): the requesting thread of an overlapped, kept here instead of in its InternalContext.
+namespace {
+std::mutex g_overlapped_thread_mutex;
+std::unordered_map<uint32_t, X_HANDLE> g_overlapped_thread;
+void NoteOverlappedThread(void* ptr, uint32_t overlapped_ptr, X_HANDLE thread) {
+  if (REXCVAR_GET(cogbox_xam_edge_semantics)) {
+    std::lock_guard<std::mutex> l(g_overlapped_thread_mutex);
+    g_overlapped_thread[overlapped_ptr] = thread;
+  } else {
+    XOverlappedSetContext(ptr, thread);
+  }
+}
+X_HANDLE TakeOverlappedThread(void* ptr, uint32_t overlapped_ptr) {
+  {
+    std::lock_guard<std::mutex> l(g_overlapped_thread_mutex);
+    auto it = g_overlapped_thread.find(overlapped_ptr);
+    if (it != g_overlapped_thread.end()) {
+      X_HANDLE h = it->second;
+      g_overlapped_thread.erase(it);
+      return h;
+    }
+  }
+  // Edge c7a43fa: the completion routine runs on the requester's thread - the current one when nothing was noted
+  return REXCVAR_GET(cogbox_xam_edge_semantics) ? XThread::GetCurrentThreadHandle() : XOverlappedGetContext(ptr);
+}
