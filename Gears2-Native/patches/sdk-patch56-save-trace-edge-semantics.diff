+X_RESULT ContentManager::CreatePackage(uint64_t xuid, const XCONTENT_AGGREGATE_DATA& data) {  // patch 56
+  auto package_path = ResolvePackagePath(xuid, data);
+  if (std::filesystem::exists(package_path)) {
+    return X_ERROR_ALREADY_EXISTS;
+  }
+  if (!std::filesystem::create_directories(package_path)) {
+    return X_ERROR_ACCESS_DENIED;
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT ContentManager::TruncateContent(uint64_t xuid, const XCONTENT_AGGREGATE_DATA& data) {  // patch 56
+  if (IsContentOpen(data)) {
+    return X_RESULT_FROM_WIN32(0x00000020L);  // ERROR_SHARING_VIOLATION
+  }
+  auto package_path = ResolvePackagePath(xuid, data);
+  std::error_code ec;
+  if (!std::filesystem::is_directory(package_path, ec)) {  // a container file becomes an empty directory
+    if (!std::filesystem::remove(package_path, ec) || !std::filesystem::create_directory(package_path, ec)) {
+      return X_ERROR_ACCESS_DENIED;
+    }
+    return X_ERROR_SUCCESS;
+  }
+  std::vector<std::filesystem::path> entries;
+  for (const auto& entry : std::filesystem::directory_iterator(package_path, ec)) {
+    if (entry.path().filename() != kThumbnailFileName) entries.push_back(entry.path());
+  }
+  if (ec) {
+    return X_ERROR_ACCESS_DENIED;
+  }
+  for (const auto& entry : entries) {
+    if (std::filesystem::remove_all(entry, ec) == static_cast<std::uintmax_t>(-1)) {
+      return X_ERROR_ACCESS_DENIED;
+    }
+  }
+  return X_ERROR_SUCCESS;
+}
