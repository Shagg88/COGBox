diff --git a/include/rex/system/save_trace.h b/include/rex/system/save_trace.h
new file mode 100644
index 0000000..ee9875f
--- /dev/null
+++ b/include/rex/system/save_trace.h
@@ -0,0 +1,35 @@
+/**
+ * COGBox SDK patch 56 (GitHub #55 #68 #79 #80 #120, Gears 3 checkpoint deaths): a trace of the save path and a switch
+ * for content / overlapped semantics as Xenia Edge changed them in October 2026.
+ *  --cogbox_save_trace (default off): one info line per content call (create / open / close / device state), per
+ *    file open / read / write on a save path (SG*, savedrive, *.sav, GearsCheckpoint, PlayerStorage), per overlapped
+ *    completion (event set, APC queued, InternalContext before), and per failed root lookup with the mounted roots.
+ *  --cogbox_xam_edge_semantics (default off): (1) the requesting thread is kept beside the overlapped, not written
+ *    into its InternalContext; (2) with a completion routine only the APC is queued, the event is not set; (3) a
+ *    create on a root still in use makes the package and fails with ERROR_DUP_NAME (an open: ALREADY_EXISTS);
+ *    (4) TRUNCATE_EXISTING empties the package but for its thumbnail and opens it (SHARING_VIOLATION while open); (5) XamContentClose completes with ERROR_FUNCTION_FAILED + the
+ *    error as an HRESULT (or success), length 0; GetDeviceState's unknown device as an HRESULT.
+ * Ported from Edge's diffs (c7a43fa ad0d187 0028503 4ee7c0f 52f802d 451f915 af53787, dumped by job 1039; patch 56b
+ * corrected the first port, which was written from the titles alone).
+ */
+#pragma once
+
+#include <rex/cvar.h>
+
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <string_view>
+
+REXCVAR_DECLARE(bool, cogbox_save_trace);
+REXCVAR_DECLARE(bool, cogbox_xam_edge_semantics);
+
+namespace rex::system {
+inline bool SaveTracePath(std::string_view p) {
+  std::string l(p);
+  std::transform(l.begin(), l.end(), l.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  for (const char* k : {"sg0", "sg1", "sg2", "savedrive", ".sav", "checkpoint", "playerstorage", "content"})
+    if (l.find(k) != std::string::npos) return true;
+  return false;
+}
+}  // namespace rex::system
