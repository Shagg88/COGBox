+// COGBox patch 90 (0.6.1; GitHub #271, GitLab 5): the number of disc blocks that failed verification. As a plain stub
+// it left r3 as it came in (the caller's first argument), so the game read an arbitrary count. Gears 3 polls it twice
+// a second on its menu and again as a level starts; in #271's log the call at the level start is followed 144 ms later
+// by XamShowDirtyDiscErrorUI and the game stopping, with every game file read without an error. There is no disc, so
+// nothing ever fails: 0. No log line (it was a STUB warning every 0.5 s).
+extern "C" REX_FUNC(__imp__XamMediaVerificationFailedBlocks) {
+  (void)base;
+  ctx.r3.u64 = 0;
+}
+static rex::ppc::detail::PPCFuncRegistrar _ppc_reg___imp__XamMediaVerificationFailedBlocks(
+    "__imp__XamMediaVerificationFailedBlocks", &__imp__XamMediaVerificationFailedBlocks);
