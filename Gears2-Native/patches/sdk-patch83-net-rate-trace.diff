+// COGBox SDK patch 83 (trace flag only): game UDP bytes per peer per second, to see whether the game's byte-rate caps
+// (MaxInternetClientRate / ConfiguredInternetSpeed, 7000 B/s on Xbox) are what limits it. One line per peer and
+// direction each second with traffic, and a running summary every 30 s: average, peak, and how many seconds came
+// within 10% of the 7000 B/s cap.
+void NoteUdpBytes(bool out, uint32_t ip, size_t bytes) {
+  if (!NetTraceOn() || !VirtualPeerManager::IsVirtualIp(ip)) {
+    return;
+  }
+  struct Rate {
+    Clock::time_point sec_start{}, start{}, last_summary{};
+    uint64_t sec_bytes = 0, sec_packets = 0;
+    uint64_t total_bytes = 0, seconds = 0, peak = 0, near_cap = 0;
+  };
+  static std::mutex m;
+  static std::map<uint64_t, Rate> rates;
+  const auto now = Clock::now();
+  std::lock_guard<std::mutex> lock(m);
+  auto& r = rates[(uint64_t(out) << 32) | ip];
+  const std::string who = std::string(out ? "out -> " : "in <- ") + "10.254." + std::to_string((ip >> 8) & 0xFF) +
+                          "." + std::to_string(ip & 0xFF);
+  if (r.start == Clock::time_point{}) {
+    r.start = r.sec_start = r.last_summary = now;
+  }
+  if (now - r.sec_start >= std::chrono::seconds(1)) {
+    REXKRNL_INFO("cogbox_net_rate: {} {} B/s {} pkt/s", who, r.sec_bytes, r.sec_packets);
+    ++r.seconds;
+    r.total_bytes += r.sec_bytes;
+    r.peak = std::max(r.peak, r.sec_bytes);
+    if (r.sec_bytes >= 6300) ++r.near_cap;
+    r.sec_bytes = r.sec_packets = 0;
+    r.sec_start = now;
+    if (now - r.last_summary >= std::chrono::seconds(30)) {
+      REXKRNL_INFO("cogbox_net_rate: summary {}: {} s with traffic, avg {} B/s, peak {} B/s, {} s at >= 6300 B/s",
+                   who, r.seconds, r.seconds ? r.total_bytes / r.seconds : 0, r.peak, r.near_cap);
+      r.last_summary = now;
+    }
+  }
+  r.sec_bytes += bytes + 28;  // + IP/UDP headers, as the engine counts them
+  ++r.sec_packets;
+}
