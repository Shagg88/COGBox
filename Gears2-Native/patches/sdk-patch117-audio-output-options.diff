+// Patch 117: a device chosen by name that is unplugged during play. SDL never moves its stream (as it does the default
+// device's): the stream runs on silently and the device drops out of SDL's list, so the list is checked in patch 66's
+// 5 s slot. Gone: the stream and SDL's audio are closed and opened again on the default device for the rest of this
+// run (patch 66's following of the Windows default comes back with it); if that fails, the silent sink takes over.
+// On the game thread, in SubmitFrame; the SDL callback stops with the stream, and frames wait in frames_queued_.
+void SDLAudioDriver::CheckNamedDevice() {
+  int count = 0;
+  SDL_AudioDeviceID* ids = SDL_GetAudioPlaybackDevices(&count);
+  bool listed = false;
+  for (int i = 0; ids && i < count; ++i) listed = listed || ids[i] == named_id_;
+  SDL_free(ids);
+  if (listed) return;
+  REXAPU_WARN("audio: the output device chosen with --audio_output_device is gone - using the system default device");
+  CloseSdlOutput();  // sdl_stream_ to nullptr and destroyed, then SDL's audio quit (initialised for that stream)
+  skip_named_device_ = true;
+  if (TryOpenSdl(false)) {
+#ifdef _WIN32
+    default_endpoint_id_ = CheckDefaultEndpointSession(true);
+#endif
+    return;
+  }
+  if (silent_thread_.joinable()) silent_thread_.join();  // a sink that handed over to SDL earlier has returned
+  StartSilentSink(true);
+}
