@@ -0,0 +1,124 @@
+// COGBox SDK patch 117 (GitHub #425): the output stage's extra mixes for --audio_channels (mono, 7.1), the
+// --audio_night_mode compressor and --audio_output_device's name match. Pure functions on the interleaved float frames
+// SDLAudioDriver::SDLCallback hands SDL (and on device names), kept here so tests/unit/audio can check them without a
+// sound device.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cctype>
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace rex::audio {
+
+// --audio_channels=1: the stereo fold (conversion.h) made centred mono - the same signal on both channels, so a mono
+// speaker or one ear of a headset gets everything. Half of each side, so the sum never clips: a sound in the middle
+// keeps its level, one panned hard to one side comes out 6 dB quieter.
+inline void FoldStereoToMono(float* lr, size_t frames) {
+  for (size_t i = 0; i < frames; ++i) {
+    const float m = 0.5f * (lr[i * 2] + lr[i * 2 + 1]);
+    lr[i * 2] = m;
+    lr[i * 2 + 1] = m;
+  }
+}
+
+// --audio_channels=8: the games mix 5.1 (FL FR FC LFE BL BR, the XAudio order, also SDL's). A 7.1 device (SDL order
+// FL FR FC LFE BL BR SL SR) gets the front, centre and LFE as they are and each surround channel on both its back and
+// side speaker at -3 dB, so the surround sound comes from all around the listener at the level it had on one speaker.
+// In place: `buf` holds `frames` 5.1 frames and has room for as many 7.1 frames. Worked from the last frame back, as the
+// output grows (a frame's 7.1 slot never overlaps an earlier frame's 5.1 one).
+inline void Expand51To71(float* buf, size_t frames) {
+  constexpr float k = 0.70710678f;
+  for (size_t i = frames; i-- > 0;) {
+    const float* s = buf + i * 6;
+    const float fl = s[0], fr = s[1], fc = s[2], lfe = s[3], bl = s[4], br = s[5];
+    float* d = buf + i * 8;
+    d[0] = fl;
+    d[1] = fr;
+    d[2] = fc;
+    d[3] = lfe;
+    d[4] = bl * k;
+    d[5] = br * k;
+    d[6] = bl * k;
+    d[7] = br * k;
+  }
+}
+
+// --audio_night_mode: a gentle compressor on the final mix, so quiet dialogue stays clear at a low volume while
+// explosions and gunfire no longer jump out. One peak follower for all channels (so the picture never moves to one
+// side), 4:1 above -30 dBFS, 5 ms attack, 200 ms release, +9 dB of makeup gain, then a limiter that never lets a
+// sample past -1 dBFS (instant attack, 50 ms release). A full-scale peak comes out near -13.5 dBFS and speech at
+// -36 dBFS at -27 dBFS: about 36 dB of range becomes 13.5. Not used at all while the switch is off (the mix is
+// untouched).
+class NightMode {
+ public:
+  static constexpr float kThresholdDb = -30.0f;
+  static constexpr float kRatio = 4.0f;
+  static constexpr float kAttackMs = 5.0f;
+  static constexpr float kReleaseMs = 200.0f;
+  static constexpr float kMakeupDb = 9.0f;
+  static constexpr float kCeiling = 0.89125094f;  // -1 dBFS
+  static constexpr float kLimiterReleaseMs = 50.0f;
+
+  void Reset() {
+    env_ = 0.0f;
+    limit_ = 1.0f;
+  }
+
+  // `data`: `frames` interleaved frames of `channels` floats, changed in place.
+  void Process(float* data, size_t frames, size_t channels, float sample_rate) {
+    if (sample_rate != rate_) SetRate(sample_rate);
+    const float threshold = DbToGain(kThresholdDb);
+    const float makeup = DbToGain(kMakeupDb);
+    const float exponent = 1.0f / kRatio - 1.0f;
+    for (size_t i = 0; i < frames; ++i) {
+      float* f = data + i * channels;
+      float peak = 0.0f;
+      for (size_t c = 0; c < channels; ++c) peak = std::max(peak, std::fabs(f[c]));
+      env_ = peak + (peak > env_ ? attack_ : release_) * (env_ - peak);
+      if (env_ < 1e-9f) env_ = 0.0f;  // no denormals while the game is silent
+      const float comp = env_ > threshold ? std::pow(env_ / threshold, exponent) : 1.0f;
+      const float gain = comp * makeup;
+      limit_ = 1.0f + limiter_release_ * (limit_ - 1.0f);
+      if (peak * gain * limit_ > kCeiling) limit_ = kCeiling / (peak * gain);
+      const float g = gain * limit_;
+      for (size_t c = 0; c < channels; ++c) f[c] = std::clamp(f[c] * g, -kCeiling, kCeiling);
+    }
+  }
+
+  static float DbToGain(float db) { return std::pow(10.0f, db / 20.0f); }
+
+ private:
+  void SetRate(float sample_rate) {
+    rate_ = sample_rate;
+    auto coeff = [sample_rate](float ms) { return std::exp(-1000.0f / (ms * sample_rate)); };
+    attack_ = coeff(kAttackMs);
+    release_ = coeff(kReleaseMs);
+    limiter_release_ = coeff(kLimiterReleaseMs);
+  }
+
+  float rate_ = 0.0f;
+  float attack_ = 0.0f, release_ = 0.0f, limiter_release_ = 0.0f;
+  float env_ = 0.0f;    // the peak follower (linear)
+  float limit_ = 1.0f;  // the limiter's gain
+};
+
+// --audio_output_device: which of `names` (the playback devices SDL lists) the saved name means - the same name, else
+// the first that contains it, any case. -1: none (an empty name never matches).
+inline int MatchDeviceName(const std::string& want, const std::vector<std::string>& names) {
+  if (want.empty()) return -1;
+  auto lower = [](std::string t) {
+    for (char& c : t) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return t;
+  };
+  for (size_t i = 0; i < names.size(); ++i)
+    if (names[i] == want) return static_cast<int>(i);
+  const std::string want_low = lower(want);
+  for (size_t i = 0; i < names.size(); ++i)
+    if (lower(names[i]).find(want_low) != std::string::npos) return static_cast<int>(i);
+  return -1;
+}
+
+}  // namespace rex::audio
