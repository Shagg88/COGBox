+SDL_AudioDeviceID SDLAudioDriver::ChosenPlaybackDevice() {
+  const std::string want = REXCVAR_GET(audio_output_device);
+  if (want.empty()) return 0;
+  auto lower = [](std::string t) {
+    for (char& c : t) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return t;
+  };
+  const std::string want_low = lower(want);
+  int count = 0;
+  SDL_AudioDeviceID* ids = SDL_GetAudioPlaybackDevices(&count);
+  SDL_AudioDeviceID exact = 0, part = 0;
+  std::string names;
+  for (int i = 0; ids && i < count; ++i) {
+    const char* name = SDL_GetAudioDeviceName(ids[i]);
+    if (!name) continue;
+    names += (names.empty() ? "'" : ", '") + std::string(name) + "'";
+    if (!exact && want == name) exact = ids[i];
+    if (!part && lower(name).find(want_low) != std::string::npos) part = ids[i];
+  }
+  SDL_free(ids);
+  const SDL_AudioDeviceID id = exact ? exact : part;
+  static std::atomic<bool> logged{false};
+  if (!id && !logged.exchange(true))
+    REXAPU_WARN("audio: --audio_output_device '{}' not found - using the system default device (devices: {})", want,
+                names.empty() ? "none" : names);
+  return id;
+}
