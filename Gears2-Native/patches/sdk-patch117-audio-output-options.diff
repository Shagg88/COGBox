new file mode 100644
index 0000000..10e3825
--- /dev/null
+++ b/tests/unit/audio/output_mix_test.cpp
@@ -0,0 +1,117 @@
+// COGBox SDK patch 117 (GitHub #425): the speaker setup's mono and 7.1 mixes and the night mode compressor.
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include <rex/audio/output_mix.h>
+
+using rex::audio::Expand51To71;
+using rex::audio::FoldStereoToMono;
+using rex::audio::NightMode;
+
+namespace {
+constexpr float kRate = 48000.0f;
+
+bool Near(float a, float b, float tol = 1e-5f) { return std::fabs(a - b) <= tol; }
+
+float Peak(const std::vector<float>& v) {
+  float p = 0.0f;
+  for (float x : v) p = std::max(p, std::fabs(x));
+  return p;
+}
+
+// `frames` stereo frames of a 1 kHz sine at `level` (linear peak) on both channels
+std::vector<float> Sine(size_t frames, float level) {
+  std::vector<float> v(frames * 2);
+  for (size_t i = 0; i < frames; ++i) {
+    const float s = level * std::sin(2.0f * 3.14159265f * 1000.0f * static_cast<float>(i) / kRate);
+    v[i * 2] = s;
+    v[i * 2 + 1] = s;
+  }
+  return v;
+}
+
+// the night mode's output for a steady sine, after it has settled (1 s in), in 256-frame blocks as the callback
+std::vector<float> Settled(NightMode& n, float level) {
+  const size_t frames = 256 * 188;
+  std::vector<float> v = Sine(frames, level);
+  for (size_t at = 0; at < frames; at += 256) n.Process(v.data() + at * 2, 256, 2, kRate);
+  return std::vector<float>(v.end() - 9600, v.end());  // the last 100 ms
+}
+}  // namespace
+
+TEST_CASE("Mono puts half of each side on both channels", "[audio]") {
+  std::vector<float> v = {1.0f, 0.0f, 0.5f, 0.5f, -0.25f, 0.75f};
+  FoldStereoToMono(v.data(), 3);
+  CHECK(Near(v[0], 0.5f));
+  CHECK(Near(v[1], 0.5f));
+  CHECK(Near(v[2], 0.5f));
+  CHECK(Near(v[3], 0.5f));
+  CHECK(Near(v[4], 0.25f));
+  CHECK(Near(v[5], 0.25f));
+}
+
+TEST_CASE("7.1 keeps the front, centre and LFE and spreads each surround over back and side", "[audio]") {
+  const size_t frames = 5;
+  std::vector<float> v(frames * 8, 99.0f);
+  for (size_t i = 0; i < frames; ++i)
+    for (size_t c = 0; c < 6; ++c) v[i * 6 + c] = static_cast<float>(i * 10 + c + 1) / 100.0f;
+  Expand51To71(v.data(), frames);
+  const float k = 0.70710678f;
+  for (size_t i = 0; i < frames; ++i) {
+    const float* d = v.data() + i * 8;
+    auto in = [i](size_t c) { return static_cast<float>(i * 10 + c + 1) / 100.0f; };
+    CHECK(Near(d[0], in(0)));
+    CHECK(Near(d[1], in(1)));
+    CHECK(Near(d[2], in(2)));
+    CHECK(Near(d[3], in(3)));
+    CHECK(Near(d[4], in(4) * k));
+    CHECK(Near(d[5], in(5) * k));
+    CHECK(Near(d[6], in(4) * k));
+    CHECK(Near(d[7], in(5) * k));
+    // the surround power is kept: two speakers at -3 dB
+    CHECK(Near(d[4] * d[4] + d[6] * d[6], in(4) * in(4)));
+  }
+}
+
+TEST_CASE("Night mode lifts quiet sound and lowers loud sound", "[audio]") {
+  NightMode quiet, loud;
+  const float quiet_in = NightMode::DbToGain(-36.0f), loud_in = NightMode::DbToGain(-1.0f);
+  const float quiet_out = Peak(Settled(quiet, quiet_in));
+  const float loud_out = Peak(Settled(loud, loud_in));
+  // below the threshold: the makeup gain only (+12 dB), within the peak follower's ripple
+  CHECK(std::fabs(20.0f * std::log10(quiet_out / quiet_in) - NightMode::kMakeupDb) < 0.5f);
+  // above it: 4:1 - from -1 dBFS, 23 dB over, 17.25 dB less, +12 dB makeup = about -6.25 dBFS
+  CHECK(std::fabs(20.0f * std::log10(loud_out) - (-6.25f)) < 1.0f);
+  // 35 dB apart going in, about 18 coming out
+  const float range = 20.0f * std::log10(loud_out / quiet_out);
+  CHECK(range > 15.0f);
+  CHECK(range < 21.0f);
+}
+
+TEST_CASE("Night mode never goes past -1 dBFS, even on a sudden full-scale hit", "[audio]") {
+  NightMode n;
+  std::vector<float> v = Sine(4800, NightMode::DbToGain(-40.0f));  // quiet: the gain is at its highest
+  n.Process(v.data(), 4800, 2, kRate);
+  std::vector<float> hit(512 * 2);
+  for (size_t i = 0; i < hit.size(); ++i) hit[i] = (i / 2) % 2 ? -1.0f : 1.0f;
+  n.Process(hit.data(), 512, 2, kRate);
+  CHECK(Peak(hit) <= NightMode::kCeiling + 1e-6f);
+  CHECK(Peak(hit) > 0.5f);  // limited, not silenced
+}
+
+TEST_CASE("Night mode treats all channels alike and Reset starts it afresh", "[audio]") {
+  NightMode a, b;
+  std::vector<float> one = {0.9f, 0.1f, 0.9f, 0.1f};
+  std::vector<float> two = {0.9f, 0.1f, 0.9f, 0.1f};
+  a.Process(one.data(), 2, 2, kRate);
+  b.Process(two.data(), 2, 2, kRate);
+  CHECK(one == two);
+  CHECK(Near(one[0] / one[1], 9.0f, 1e-3f));  // one gain for both channels: the balance stays
+  a.Reset();
+  std::vector<float> again = {0.9f, 0.1f, 0.9f, 0.1f};
+  a.Process(again.data(), 2, 2, kRate);
+  CHECK(again == two);
+}
