+// COGBox SDK patch 38 (0.2.0, mouse look): with keyboard and mouse on, the game's look binding loses its dead zone and
+// gets a higher speed, so the mouse (folded into the right stick) is neither swallowed nor capped. A controller used
+// alongside gets that change undone here, before the devices are merged: its right stick is scaled by pad_look_scale
+// after a per-axis dead zone of pad_look_deadzone (the game's own, now off in its binding). The mouse is untouched.
+REXCVAR_DEFINE_DOUBLE(pad_look_scale, 1.0, "Input",
+                      "Right-stick scale for controllers only (not the keyboard-and-mouse device), COGBox patch 38")
+    .range(0.0, 1.0);
+REXCVAR_DEFINE_DOUBLE(pad_look_deadzone, 0.0, "Input",
+                      "Per-axis right-stick dead zone for controllers only, as a fraction, COGBox patch 38")
+    .range(0.0, 0.9);
