+  // Output buffers are in raw PCM samples, 256 bytes per block. The output buffer is a ring buffer: we write from the
+  // write offset to the read offset.
+  memory::RingBuffer output_rb(output_buffer, output_capacity);
+  output_rb.set_read_offset(output_read_offset);
+  output_rb.set_write_offset(output_write_offset);
+  remaining_subframe_blocks_in_output_buffer_ =
+      static_cast<int32_t>(output_rb.write_count()) / kOutputBytesPerBlock;
+
+  return output_rb;
+}
