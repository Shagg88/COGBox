+  const uint8_t effective_sdc =
+      static_cast<uint8_t>(std::max(static_cast<uint32_t>(1), data->subframe_decode_count));
+  // A pass writes whole subframes, two blocks each in stereo.
+  const int8_t subframes_to_write =
+      std::min(static_cast<int8_t>(current_frame_remaining_subframes_),
+               static_cast<int8_t>(effective_sdc << data->is_stereo));
