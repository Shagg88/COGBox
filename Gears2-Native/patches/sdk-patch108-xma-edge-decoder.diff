+  // The frame at loop_end is cut after loop_subframe_end, then decoding jumps to loop_start. Starting past
+  // loop_subframe_end plays it to its end and decoding goes on from there, even into padding.
+  const bool at_loop_end = data->loop_count > 0 && data->input_buffer_read_offset == data->loop_end;
+  const bool is_loop_end_frame = IsLoopEndFrame(data);
