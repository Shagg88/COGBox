+// COGBox SDK patch 115: a test of the Linux / Proton case on Windows - the listed ports are refused at bind as a host
+// refuses ports below 1024 to an ordinary program ("1000" or "1000,3074"; empty = off).
+REXCVAR_DEFINE_STRING(net_test_refuse_ports, "", "Network",
+                      "Tests only: refuse binds to these ports (comma-separated) as Linux refuses ports below 1024");
+bool TestRefusesPort(uint16_t port) {
+  const std::string& list = REXCVAR_GET(net_test_refuse_ports);
+  if (list.empty() || port == 0) return false;
+  size_t at = 0;
+  while (at <= list.size()) {
+    size_t e = list.find(',', at);
+    if (e == std::string::npos) e = list.size();
+    std::string item = list.substr(at, e - at);
+    const size_t b = item.find_first_not_of(" \t"), z = item.find_last_not_of(" \t");
+    item = b == std::string::npos ? std::string() : item.substr(b, z - b + 1);
+    if (!item.empty() && item.size() <= 5 && item.find_first_not_of("0123456789") == std::string::npos &&
+        std::strtoul(item.c_str(), nullptr, 10) == port)
+      return true;
+    at = e + 1;
+  }
+  return false;
+}
