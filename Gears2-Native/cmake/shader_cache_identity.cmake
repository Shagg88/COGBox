function(cogbox_shader_cache_identity target root)
  set(identity "")
  foreach(source ucode.cpp dxbc_gen.cpp hlsl.cpp include/xenos/ucode.h include/xenos/dxbc_gen.h include/xenos/hlsl.h)
    set(path "${root}/${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(SHA256 "${path}" digest)
    string(APPEND identity "${digest}")
  endforeach()
  string(SHA256 combined "${identity}")
  target_compile_definitions(${target} PRIVATE COGBOX_SHADER_TRANSLATOR_ID="${combined}")
endfunction()
