# gn_add_spirv_opt(<layer 0 target> <third_party folder>): SPIRV-Tools' optimiser for the Vulkan shader path (0.6.1),
# built as static libraries from the rexglue SDK's own vendored source (third_party/rexglue-sdk/thirdparty/spirv-tools,
# Apache-2.0) with this project's compiler. Defines GN_SPIRV_OPT for the target. Without that source, or without
# Python (SPIRV-Tools generates its tables with it), the build goes on as before and Vulkan shaders stay as converted.
function(gn_add_spirv_opt tgt third_party)
  set(_st "${third_party}/rexglue-sdk/thirdparty/spirv-tools")
  set(_sh "${third_party}/rexglue-sdk/thirdparty/spirv-headers")
  if(NOT EXISTS "${_st}/source/opt/optimizer.cpp" OR NOT EXISTS "${_sh}/include/spirv/unified1/spirv.h")
    message(STATUS "SPIR-V optimiser: NOT built (no ${_st} or ${_sh})")
    return()
  endif()
  find_package(Python3 COMPONENTS Interpreter QUIET)
  if(NOT Python3_FOUND)
    message(STATUS "SPIR-V optimiser: NOT built (no Python 3 for SPIRV-Tools' generated tables)")
    return()
  endif()
  if(NOT TARGET SPIRV-Tools-opt)
    set(SPIRV_SKIP_TESTS ON CACHE BOOL "" FORCE)
    set(SPIRV_SKIP_EXECUTABLES ON CACHE BOOL "" FORCE)
    set(SPIRV_WERROR OFF CACHE BOOL "" FORCE)
    set(SKIP_SPIRV_TOOLS_INSTALL ON CACHE BOOL "" FORCE)
    set(SPIRV_TOOLS_BUILD_STATIC ON CACHE BOOL "" FORCE)
    set(SPIRV-Headers_SOURCE_DIR "${_sh}" CACHE PATH "" FORCE)
    add_subdirectory("${_st}" "${CMAKE_BINARY_DIR}/gn-spirv-tools" EXCLUDE_FROM_ALL)
  endif()
  target_link_libraries(${tgt} PRIVATE SPIRV-Tools-opt)
  target_compile_definitions(${tgt} PRIVATE GN_SPIRV_OPT=1)
  message(STATUS "SPIR-V optimiser: built from ${_st}")
endfunction()
