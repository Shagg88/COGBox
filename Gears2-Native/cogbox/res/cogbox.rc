#include <winver.h>
#include "version_rc.h"
1 ICON "../art/cogbox.ico"
1 VERSIONINFO
FILEVERSION VERSION_RC
PRODUCTVERSION VERSION_RC
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "CogBox - launcher for the Gears of War native PC ports (unofficial fan project)"
      VALUE "ProductName", "CogBox"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
1 24 "cogbox.manifest"
