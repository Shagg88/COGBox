         if (!logged_[i]) { logged_[i] = true; REXLOG_INFO("gow2_input_script{}: t={:.1f}{} press 0x{:04X} for {:.1f}", id_ == kScriptPad2 ? "2" : "", t, frames_ ? " frames" : "s", s.buttons, s.hold); }
       }
     }
