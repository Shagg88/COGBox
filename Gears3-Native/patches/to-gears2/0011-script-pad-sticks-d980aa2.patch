+    auto clamp16 = [](int32_t v) { return int16_t(std::clamp(v, -32767, 32767)); };
+    const int16_t slx = clamp16(lx), sly = clamp16(ly), srx = clamp16(rx), sry = clamp16(ry);
+    if (buttons != last_ || lt != last_lt_ || rt != last_rt_ || slx != last_lx_ || sly != last_ly_ || srx != last_rx_ ||
+        sry != last_ry_) {
+      ++packet_; last_ = buttons; last_lt_ = lt; last_rt_ = rt;
+      last_lx_ = slx; last_ly_ = sly; last_rx_ = srx; last_ry_ = sry;
+    }
     if (out) {
       std::memset(out, 0, sizeof(*out));
       out->packet_number = packet_;
       out->gamepad.buttons = buttons;
       out->gamepad.left_trigger = lt;
       out->gamepad.right_trigger = rt;
+      out->gamepad.thumb_lx = slx;
+      out->gamepad.thumb_ly = sly;
+      out->gamepad.thumb_rx = srx;
+      out->gamepad.thumb_ry = sry;
     }
     return X_ERROR_SUCCESS;
   }
@@ -133,6 +153,7 @@
   uint32_t packet_ = 1;
   uint16_t last_ = 0;
   uint8_t last_lt_ = 0, last_rt_ = 0;
+  int16_t last_lx_ = 0, last_ly_ = 0, last_rx_ = 0, last_ry_ = 0;  // patch 0011
 };
 
 }  // namespace
