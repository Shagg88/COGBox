+//        the colour/depth swap is 40 32bpp samples).
 constexpr const char* kWordTransferPs = R"(
 cbuffer XeTransfer : register(b0, space0) { uint4 t0; uint4 t1; uint4 t2; uint4 t3; };
 Texture2D<float> xe_src_depth : register(t0, space0);
@@ -476,18 +487,29 @@
   uint sx = p.x % tw, sy = p.y % 16u;
   uint tile = (t0.x + (p.y / 16u) * t0.y + p.x / tw) % 2048u;
   uint rel = (tile + 2048u - t0.z) % 2048u;
-  // Colour <-> depth: the source sample at this EDRAM position is in the other half of the tile.
-  uint half_w = tw / 2u;
-  uint qx = (t1.y != 0u) ? (sx >= half_w ? sx - half_w : sx + half_w) : sx;
-  int3 q = int3(int(((rel % t0.w) * tw + qx) * rss + ssub.x), int(((rel / t0.w) * 16u + sy) * rss + ssub.y), 0);
-  uint2 w;
-  if (t1.y != 0u) {
-    w = uint2((XeD24FromHost(xe_src_depth.Load(q), t1.z) << 8u) | (xe_src_stencil.Load(q).y & 0xFFu), 0u);
-  } else if (t2.x != 0u) {
-    w = XeBitsToGuestWords(xe_src_colour_bits.Load(q), t1.z);
-  } else {
