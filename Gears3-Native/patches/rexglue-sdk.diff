+      copy_dest_location.pResource = full_edram_render_target->resource();
+      copy_dest_location.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      copy_dest_location.SubresourceIndex = 0;
