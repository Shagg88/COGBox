+// Gears2-Native SDK patch 3: per-swap readback of the guest output (notes/33). Never waits on the GPU: a slot is only
+// reused or delivered once GetCompletedSubmission() has passed the submission that filled it.
+void D3D12CommandProcessor::QueueFrameReadback(ID3D12Resource* guest_output) {
+  DrawObserver* observer = GetDrawObserver();
+  if (!observer || !observer->WantsFrameImages() || !guest_output) {
+    return;
+  }
+  FrameReadbackSlot& slot = frame_readback_[frame_readback_next_ % frame_readback_.size()];
+  if (slot.pending) {
+    return;  // GPU still busy with this slot (or not delivered yet): skip this frame rather than stall.
+  }
+  D3D12_RESOURCE_DESC desc = guest_output->GetDesc();
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+  UINT64 total_bytes = 0;
+  device->GetCopyableFootprints(&desc, 0, 1, 0, &footprint, nullptr, nullptr, &total_bytes);
+  if (!slot.buffer || slot.width != uint32_t(desc.Width) || slot.height != desc.Height) {
+    slot.buffer.Reset();
+    slot.mapped = nullptr;
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC buffer_desc = {};
+    buffer_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer_desc.Width = total_bytes;
+    buffer_desc.Height = 1;
+    buffer_desc.DepthOrArraySize = 1;
+    buffer_desc.MipLevels = 1;
+    buffer_desc.SampleDesc.Count = 1;
+    buffer_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&slot.buffer)))) {
+      REXGPU_ERROR("Frame readback: failed to create a {}-byte readback buffer", total_bytes);
+      return;
+    }
+    D3D12_RANGE no_read = {0, 0};
+    void* mapped = nullptr;
+    if (FAILED(slot.buffer->Map(0, &no_read, &mapped))) {
+      slot.buffer.Reset();
+      return;
+    }
+    slot.mapped = static_cast<uint8_t*>(mapped);
+    slot.width = uint32_t(desc.Width);
+    slot.height = desc.Height;
+  }
+  slot.footprint = footprint;
+  PushTransitionBarrier(guest_output, ui::d3d12::D3D12Presenter::kGuestOutputInternalState,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION dst = {};
+  dst.pResource = slot.buffer.Get();
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  dst.PlacedFootprint = footprint;
+  D3D12_TEXTURE_COPY_LOCATION src = {};
+  src.pResource = guest_output;
+  src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  src.SubresourceIndex = 0;
+  deferred_command_list_.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        ui::d3d12::D3D12Presenter::kGuestOutputInternalState);
+  slot.submission = submission_current_;
+  slot.frame = frame_readback_counter_++;
+  slot.pending = true;
+  ++frame_readback_next_;
+}
+
+void D3D12CommandProcessor::DeliverFrameReadbacks() {
+  DrawObserver* observer = GetDrawObserver();
+  // Deliver in frame order.
+  for (;;) {
+    FrameReadbackSlot* oldest = nullptr;
+    for (FrameReadbackSlot& slot : frame_readback_) {
+      if (slot.pending && slot.submission <= GetCompletedSubmission() &&
+          (!oldest || slot.frame < oldest->frame)) {
+        oldest = &slot;
+      }
+    }
+    if (!oldest) {
+      return;
+    }
+    if (observer && oldest->mapped) {
+      observer->OnFrameImage(oldest->mapped + oldest->footprint.Offset, oldest->width, oldest->height,
+                             oldest->footprint.Footprint.RowPitch, oldest->frame);
+    }
+    oldest->pending = false;
+  }
+}
